{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/provider-evidence-repository-ingest-request-v1.json",
  "title": "SUNDERKEY Provider Evidence Repository Ingest Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_sha256",
    "custody_decision",
    "evidence_verification",
    "repository_policy",
    "lifecycle_bindings",
    "content_address",
    "requested_at",
    "expires_at",
    "request_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^EIR-[0-9A-F]{32}$"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "custody_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_sha256"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^ECR-[0-9A-F]{32}$"},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_verification": {
      "$ref": "collaboration-executor-provider-evidence-verification-v1.schema.json"
    },
    "repository_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_repository",
        "control_data_separation",
        "encryption_key_custody",
        "access_identity_scope",
        "retention_legal_hold",
        "integrity_immutability",
        "repository_provenance",
        "content_safety",
        "classification_redaction",
        "residency_resilience"
      ],
      "properties": {
        "artifact_repository": {"const": "immutable_content_addressed_object_repository"},
        "control_data_separation": {"const": "metadata_receipts_in_control_plane_bytes_in_repository"},
        "encryption_key_custody": {"const": "envelope_encryption_organization_kms_separate_key_scope"},
        "access_identity_scope": {"const": "dedicated_service_identity_mission_scoped_time_bounded_access"},
        "retention_legal_hold": {"const": "mission_policy_retention_with_independent_legal_hold_override"},
        "integrity_immutability": {"const": "conditional_create_version_lock_and_digest_reverification"},
        "repository_provenance": {"const": "signed_repository_receipt_bound_to_object_version_and_identity"},
        "content_safety": {"const": "quarantine_passive_detection_and_sandboxed_derivation"},
        "classification_redaction": {"const": "restricted_raw_and_separately_addressed_provenance_linked_derivatives"},
        "residency_resilience": {"const": "mission_allowed_regions_replication_and_integrity_drills"}
      }
    },
    "lifecycle_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_policy_id",
        "retention_policy_sha256",
        "residency_policy_id",
        "residency_policy_sha256",
        "encryption_profile_id",
        "encryption_profile_sha256",
        "access_policy_id",
        "access_policy_sha256"
      ],
      "properties": {
        "retention_policy_id": {"$ref": "#/$defs/identifier"},
        "retention_policy_sha256": {"$ref": "#/$defs/sha256"},
        "residency_policy_id": {"$ref": "#/$defs/identifier"},
        "residency_policy_sha256": {"$ref": "#/$defs/sha256"},
        "encryption_profile_id": {"$ref": "#/$defs/identifier"},
        "encryption_profile_sha256": {"$ref": "#/$defs/sha256"},
        "access_policy_id": {"$ref": "#/$defs/identifier"},
        "access_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "content_address": {"$ref": "#/$defs/sha256"},
    "requested_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "request_status": {"const": "prepared_quarantined_repository_ingest"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
