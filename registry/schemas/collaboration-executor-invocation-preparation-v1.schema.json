{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/collaboration-executor-invocation-preparation-v1.schema.json",
  "title": "SUNDERKEY Collaboration Executor Invocation Preparation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "attempt_sha256",
    "delivery_claim",
    "reservation",
    "session",
    "operation",
    "adapter",
    "idempotency",
    "prepared_at",
    "attempt_status",
    "external_effect_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "attempt_id": {"type": "string", "pattern": "^EIP-[0-9A-F]{32}$"},
    "attempt_sha256": {"$ref": "#/$defs/sha256"},
    "delivery_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_sha256", "claim_generation", "claimant_instance_id", "claimed_at", "lease_expires_at"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^DCL-[0-9A-F]{32}$"},
        "claim_sha256": {"$ref": "#/$defs/sha256"},
        "claim_generation": {"type": "integer", "minimum": 1},
        "claimant_instance_id": {"$ref": "#/$defs/identifier"},
        "claimed_at": {"$ref": "#/$defs/timestamp"},
        "lease_expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authentication_id", "authentication_sha256", "dispatch_id", "dispatch_sha256", "dispatch_expires_at"],
      "properties": {
        "authentication_id": {"type": "string", "pattern": "^EDA-[0-9A-F]{32}$"},
        "authentication_sha256": {"$ref": "#/$defs/sha256"},
        "dispatch_id": {"type": "string", "pattern": "^EXD-[0-9A-F]{32}$"},
        "dispatch_sha256": {"$ref": "#/$defs/sha256"},
        "dispatch_expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "session_sha256", "fence_generation"],
      "properties": {
        "session_id": {"$ref": "#/$defs/identifier"},
        "session_sha256": {"$ref": "#/$defs/sha256"},
        "fence_generation": {"type": "integer", "minimum": 1}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sequence", "operation_input_sha256"],
      "properties": {
        "name": {"enum": ["start", "action", "evidence", "heartbeat", "pause", "resume", "stop", "destroy"]},
        "sequence": {"type": "integer", "minimum": 1},
        "operation_input_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "adapter_build_sha256", "deployment_binding_sha256"],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/identifier"},
        "adapter_version": {"$ref": "#/$defs/identifier"},
        "adapter_build_sha256": {"$ref": "#/$defs/sha256"},
        "deployment_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "key_sha256"],
      "properties": {
        "status": {"enum": ["absent", "declared_unverified", "verified"]},
        "key_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    },
    "prepared_at": {"$ref": "#/$defs/timestamp"},
    "attempt_status": {"const": "prepared_before_invocation"},
    "external_effect_status": {"const": "not_started"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
