{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/collaboration-executor-invocation-resolution-commit-receipt-v1.schema.json",
  "title": "SUNDERKEY Collaboration Executor Invocation Resolution Commit Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invocation_resolution",
    "custody_status",
    "retry_disposition",
    "external_effect_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "invocation_resolution": {
      "$ref": "collaboration-executor-invocation-resolution-v1.schema.json"
    },
    "custody_status": {"const": "durable_terminal_local_resolution"},
    "retry_disposition": {
      "enum": [
        "retry_allowed_no_external_effect",
        "complete_provider_report_pending_authentication",
        "retry_allowed_verified_idempotency",
        "retry_forbidden_uncertain_effect"
      ]
    },
    "external_effect_status": {
      "enum": [
        "not_started",
        "provider_report_pending_authentication",
        "outcome_uncertain"
      ]
    },
    "runtime_effect": {"const": "none"}
  }
}
