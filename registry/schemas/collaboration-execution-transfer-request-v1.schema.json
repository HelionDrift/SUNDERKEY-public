{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-execution-transfer-request-v1.json",
  "title": "SUNDERKEY Collaboration Execution Transfer Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_sha256",
    "channel_policy",
    "mission_id",
    "collaboration_plan_id",
    "collaboration_plan_sha256",
    "work_item_id",
    "work_item_objective_sha256",
    "transfer_kind",
    "control_transition",
    "control_plane_requester",
    "source_session",
    "target_session",
    "required_acknowledgement_kinds",
    "requested_at",
    "acknowledgement_deadline",
    "request_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^ETR-[0-9A-F]{32}$"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "channel_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_policy_id", "channel_policy_sha256"],
      "properties": {
        "channel_policy_id": {"type": "string", "pattern": "^ECP-[0-9A-F]{32}$"},
        "channel_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mission_id": {"$ref": "#/$defs/identifier"},
    "collaboration_plan_id": {"$ref": "#/$defs/identifier"},
    "collaboration_plan_sha256": {"$ref": "#/$defs/sha256"},
    "work_item_id": {"$ref": "#/$defs/identifier"},
    "work_item_objective_sha256": {"$ref": "#/$defs/sha256"},
    "transfer_kind": {"enum": ["ownership_handoff", "work_cancellation"]},
    "control_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "transition_sha256"],
      "properties": {
        "transition_id": {
          "type": "string",
          "pattern": "^(OCE|WCN)-[0-9A-F]{32}$"
        },
        "transition_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "control_plane_requester": {"$ref": "#/$defs/assertion"},
    "source_session": {"$ref": "#/$defs/session"},
    "target_session": {"$ref": "#/$defs/optionalSession"},
    "required_acknowledgement_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["source_released", "target_accepted", "source_cancelled"]
      }
    },
    "requested_at": {"$ref": "#/$defs/timestamp"},
    "acknowledgement_deadline": {"$ref": "#/$defs/timestamp"},
    "request_status": {"const": "pending_external_acknowledgement"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "assertion_id", "assertion_sha256"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/identifier"},
        "assertion_id": {"type": "string", "pattern": "^PAS-[0-9A-F]{32}$"},
        "assertion_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "session_sha256",
        "worker_principal_id",
        "fence_generation",
        "credential_reference_id",
        "credential_sha256"
      ],
      "properties": {
        "session_id": {"type": "string", "pattern": "^ECS-[0-9A-F]{32}$"},
        "session_sha256": {"$ref": "#/$defs/sha256"},
        "worker_principal_id": {"$ref": "#/$defs/identifier"},
        "fence_generation": {"type": "integer", "minimum": 1},
        "credential_reference_id": {"$ref": "#/$defs/identifier"},
        "credential_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "optionalSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "session_sha256",
        "worker_principal_id",
        "fence_generation",
        "credential_reference_id",
        "credential_sha256"
      ],
      "properties": {
        "session_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^ECS-[0-9A-F]{32}$"}]},
        "session_sha256": {"$ref": "#/$defs/optionalSha256"},
        "worker_principal_id": {"$ref": "#/$defs/optionalIdentifier"},
        "fence_generation": {
          "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]
        },
        "credential_reference_id": {"$ref": "#/$defs/optionalIdentifier"},
        "credential_sha256": {"$ref": "#/$defs/optionalSha256"}
      }
    },
    "optionalIdentifier": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]
    },
    "optionalSha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    }
  }
}
