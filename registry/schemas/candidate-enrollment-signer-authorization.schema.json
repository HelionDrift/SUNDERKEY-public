{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/candidate-enrollment-signer-authorization-v1.json",
  "title": "SUNDERKEY Candidate Enrollment Signer Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "authorization_version",
    "d008_decision",
    "d009_decision",
    "issuer",
    "audience",
    "issued_at",
    "not_before",
    "expires_at",
    "keys",
    "root_key_id",
    "algorithm",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "authorization_id": {"type": "string", "pattern": "^CEA-[0-9A-F]{32}$"},
    "authorization_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "d008_decision": {"$ref": "#/$defs/d008Decision"},
    "d009_decision": {"$ref": "#/$defs/d009Decision"},
    "issuer": {"$ref": "#/$defs/identifier"},
    "audience": {"$ref": "#/$defs/identifier"},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "not_before": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/signerKey"}
    },
    "root_key_id": {"$ref": "#/$defs/identifier"},
    "algorithm": {"const": "Ed25519"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "publicKey": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "d008Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "sha256"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^QDR-[0-9A-F]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "d009Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "sha256"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^CER-[0-9A-F]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "signerKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "issuer",
        "public_key",
        "algorithm",
        "key_use",
        "state",
        "not_before",
        "not_after",
        "retire_at"
      ],
      "properties": {
        "key_id": {"$ref": "#/$defs/identifier"},
        "issuer": {"$ref": "#/$defs/identifier"},
        "public_key": {"$ref": "#/$defs/publicKey"},
        "algorithm": {"const": "Ed25519"},
        "key_use": {"const": "candidate_enrollment_catalog"},
        "state": {"enum": ["active", "retiring", "revoked"]},
        "not_before": {"$ref": "#/$defs/timestamp"},
        "not_after": {"$ref": "#/$defs/timestamp"},
        "retire_at": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/timestamp"}
          ]
        }
      }
    }
  }
}
