{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-executor-dispatch-v1.json",
  "title": "SUNDERKEY Collaboration Executor Dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dispatch_id", "dispatch_sha256", "operation",
    "operation_sequence", "authority_status", "session_authority", "mission",
    "work_item", "worker", "session", "credential", "policy", "issued_at",
    "expires_at", "dispatch_status", "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dispatch_id": {"type": "string", "pattern": "^EXD-[0-9A-F]{32}$"},
    "dispatch_sha256": {"$ref": "#/$defs/sha256"},
    "operation": {"enum": ["start", "action", "evidence", "heartbeat", "pause", "resume", "stop", "destroy"]},
    "operation_sequence": {"type": "integer", "minimum": 1},
    "authority_status": {
      "type": "object", "additionalProperties": false,
      "required": ["status_id", "status_sha256", "observed_at"],
      "properties": {
        "status_id": {"type": "string", "pattern": "^ESS-[0-9A-F]{32}$"},
        "status_sha256": {"$ref": "#/$defs/sha256"},
        "observed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "session_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["session_authority_id", "session_authority_sha256"],
      "properties": {
        "session_authority_id": {"type": "string", "pattern": "^ESA-[0-9A-F]{32}$"},
        "session_authority_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mission": {
      "type": "object", "additionalProperties": false,
      "required": ["mission_id", "mission_sha256", "collaboration_plan_id", "collaboration_plan_sha256", "scope_reference"],
      "properties": {
        "mission_id": {"$ref": "#/$defs/identifier"},
        "mission_sha256": {"$ref": "#/$defs/sha256"},
        "collaboration_plan_id": {"$ref": "#/$defs/identifier"},
        "collaboration_plan_sha256": {"$ref": "#/$defs/sha256"},
        "scope_reference": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "work_item": {
      "type": "object", "additionalProperties": false,
      "required": ["work_item_id", "work_item_objective_sha256"],
      "properties": {
        "work_item_id": {"$ref": "#/$defs/identifier"},
        "work_item_objective_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "worker": {
      "type": "object", "additionalProperties": false,
      "required": ["worker_principal_id", "owner_epoch", "fence_generation"],
      "properties": {
        "worker_principal_id": {"$ref": "#/$defs/identifier"},
        "owner_epoch": {"type": "integer", "minimum": 1},
        "fence_generation": {"type": "integer", "minimum": 1}
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "session_sha256"],
      "properties": {
        "session_id": {"$ref": "#/$defs/identifier"},
        "session_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "credential": {
      "type": "object", "additionalProperties": false,
      "required": ["credential_reference_id", "credential_sha256"],
      "properties": {
        "credential_reference_id": {"$ref": "#/$defs/identifier"},
        "credential_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_policy_sha256", "operation_input_sha256"],
      "properties": {
        "tool_policy_sha256": {"$ref": "#/$defs/sha256"},
        "operation_input_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "dispatch_status": {"const": "prepared_provider_dispatch"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
