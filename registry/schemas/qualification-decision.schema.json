{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/qualification-decision-v1.json",
  "title": "SUNDERKEY Qualification Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "decision_version",
    "decision_kind",
    "policy",
    "evidence_manifest",
    "profile_id",
    "candidate",
    "attestations",
    "decision_status",
    "registry_effect",
    "issued_at",
    "valid_from",
    "valid_until",
    "issuer",
    "signer_key_id",
    "algorithm",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decision_id": {
      "type": "string",
      "pattern": "^QKD-[0-9A-F]{32}$"
    },
    "decision_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "decision_kind": {
      "const": "initial_approval"
    },
    "policy": {
      "$ref": "#/$defs/policyBinding"
    },
    "evidence_manifest": {
      "$ref": "#/$defs/manifestBinding"
    },
    "profile_id": {
      "$ref": "#/$defs/profileId"
    },
    "candidate": {
      "$ref": "#/$defs/candidateBinding"
    },
    "attestations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/attestationBinding"
      }
    },
    "decision_status": {
      "const": "approved"
    },
    "registry_effect": {
      "const": "none"
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "valid_from": {
      "$ref": "#/$defs/timestamp"
    },
    "valid_until": {
      "$ref": "#/$defs/timestamp"
    },
    "issuer": {
      "$ref": "#/$defs/identifier"
    },
    "signer_key_id": {
      "$ref": "#/$defs/identifier"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^AOE-G[A-E]-D[0-9]{2}-S[0-9]{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "sha256"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^QTP-[0-9A-F]{32}$"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "manifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^QEM-[0-9A-F]{32}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_version",
        "candidate_artifact_sha256"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/identifier"
        },
        "candidate_version": {
          "$ref": "#/$defs/identifier"
        },
        "candidate_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "attestationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_id",
        "reviewer_id",
        "reviewer_role",
        "attestation_sha256",
        "credential_sha256",
        "reviewer_key_sha256"
      ],
      "properties": {
        "attestation_id": {
          "type": "string",
          "pattern": "^QRA-[0-9A-F]{32}$"
        },
        "reviewer_id": {
          "$ref": "#/$defs/identifier"
        },
        "reviewer_role": {
          "enum": [
            "technical_evaluator",
            "independent_control",
            "independent_assurance"
          ]
        },
        "attestation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "credential_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewer_key_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
