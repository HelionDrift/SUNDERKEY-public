{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/candidate-adapter-catalog-v1.json",
  "title": "SUNDERKEY Candidate Adapter Reference Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_version",
    "catalog_sha256",
    "strategy_id",
    "strategy_sha256",
    "blueprint_catalog_sha256",
    "development_mode",
    "reference_slice",
    "manifests",
    "coverage_summary",
    "qualification_effect",
    "routing_effect",
    "execution_effect",
    "deployment_effect",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "const": "sunderkey-candidate-adapters-v1"
    },
    "catalog_version": {
      "const": "0.1.0"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^CIS-[0-9A-F]{32}$"
    },
    "strategy_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "blueprint_catalog_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "development_mode": {
      "const": "offline_synthetic_only"
    },
    "reference_slice": {
      "type": "array",
      "prefixItems": [
        {
          "const": "AOE-GA-D01-S01"
        },
        {
          "const": "AOE-GB-D06-S09"
        },
        {
          "const": "AOE-GA-D03-S14"
        },
        {
          "const": "AOE-GC-D14-S01"
        },
        {
          "const": "AOE-GC-D11-S08"
        },
        {
          "const": "AOE-GD-D19-S01"
        }
      ],
      "items": false
    },
    "manifests": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/manifest"
      }
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_adapter_count",
        "profile_count",
        "oci_required_count",
        "microvm_required_count",
        "deny_all_resource_policy_count",
        "offline_synthetic_only_count"
      ],
      "properties": {
        "reference_adapter_count": {
          "const": 6
        },
        "profile_count": {
          "const": 6
        },
        "oci_required_count": {
          "const": 3
        },
        "microvm_required_count": {
          "const": 3
        },
        "deny_all_resource_policy_count": {
          "const": 6
        },
        "offline_synthetic_only_count": {
          "const": 6
        }
      }
    },
    "qualification_effect": {
      "const": "none"
    },
    "routing_effect": {
      "const": "none"
    },
    "execution_effect": {
      "const": "none"
    },
    "deployment_effect": {
      "const": "none"
    },
    "limitations": {
      "$ref": "#/$defs/textList"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\t\\n\\r -~]*[!-~][\\t\\n\\r -~]*$"
    },
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "denyList": {
      "type": "array",
      "maxItems": 0
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_version",
        "profile_id",
        "profile_name",
        "vector_id",
        "blueprint_sha256",
        "primary_capability_id",
        "reference_role",
        "implementation",
        "source_provenance",
        "runtime",
        "resource_policy",
        "contracts",
        "hooks",
        "evidence_semantics",
        "known_limitations",
        "implementation_status",
        "qualification_effect",
        "routing_effect",
        "execution_effect",
        "deployment_effect",
        "manifest_sha256"
      ],
      "properties": {
        "adapter_id": {
          "type": "string",
          "pattern": "^adapter\\.aoe-g[a-e]-d[0-9]{2}-s[0-9]{2}\\.[a-z0-9-]+$"
        },
        "adapter_version": {
          "const": "0.1.0"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^AOE-G[A-E]-D[0-9]{2}-S[0-9]{2}$"
        },
        "profile_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\t\\n\\r -~]*[!-~][\\t\\n\\r -~]*$"
        },
        "vector_id": {
          "type": "string",
          "pattern": "^AV-G[A-E]-D[0-9]{2}-S[0-9]{2}-01$"
        },
        "blueprint_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "primary_capability_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\t\\n\\r -~]*[!-~][\\t\\n\\r -~]*$"
        },
        "reference_role": {
          "enum": [
            "passive",
            "api",
            "identity",
            "cloud",
            "endpoint",
            "high_consequence_restoration"
          ]
        },
        "implementation": {
          "const": "reference_adapter"
        },
        "source_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "repository_path",
            "source_sha256",
            "license",
            "external_dependencies"
          ],
          "properties": {
            "kind": {
              "const": "sunderkey_native_python"
            },
            "repository_path": {
              "const": "src/sunderkey/reference_adapters.py"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "license": {
              "const": "LicenseRef-SUNDERKEY-All-Rights-Reserved"
            },
            "external_dependencies": {
              "$ref": "#/$defs/denyList"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language",
            "initial_host",
            "required_isolation",
            "development_mode",
            "maximum_action_tier"
          ],
          "properties": {
            "language": {
              "const": "python_3_11_or_newer"
            },
            "initial_host": {
              "const": "linux"
            },
            "required_isolation": {
              "enum": [
                "oci_container",
                "microvm"
              ]
            },
            "development_mode": {
              "const": "offline_synthetic_only"
            },
            "maximum_action_tier": {
              "const": "R0"
            }
          }
        },
        "resource_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network",
            "filesystem",
            "process",
            "credential"
          ],
          "properties": {
            "network": {
              "$ref": "#/$defs/denyList"
            },
            "filesystem": {
              "$ref": "#/$defs/denyList"
            },
            "process": {
              "$ref": "#/$defs/denyList"
            },
            "credential": {
              "$ref": "#/$defs/denyList"
            }
          }
        },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "output",
            "evidence",
            "restoration"
          ],
          "properties": {
            "input": {
              "type": "string",
              "pattern": "^sunderkey://"
            },
            "output": {
              "type": "string",
              "pattern": "^sunderkey://"
            },
            "evidence": {
              "type": "string",
              "pattern": "^sunderkey://"
            },
            "restoration": {
              "type": "string",
              "pattern": "^sunderkey://"
            }
          }
        },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dry_run",
            "timeout",
            "cancellation",
            "rate_limit",
            "structured_evidence",
            "cleanup_result"
          ],
          "properties": {
            "dry_run": {
              "const": true
            },
            "timeout": {
              "const": true
            },
            "cancellation": {
              "const": true
            },
            "rate_limit": {
              "const": true
            },
            "structured_evidence": {
              "const": true
            },
            "cleanup_result": {
              "const": true
            }
          }
        },
        "evidence_semantics": {
          "$ref": "#/$defs/textList"
        },
        "known_limitations": {
          "$ref": "#/$defs/textList"
        },
        "implementation_status": {
          "const": "sdk_bound_pending_qualification"
        },
        "qualification_effect": {
          "const": "none"
        },
        "routing_effect": {
          "const": "none"
        },
        "execution_effect": {
          "const": "none"
        },
        "deployment_effect": {
          "const": "none"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
