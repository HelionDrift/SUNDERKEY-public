{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/coverage-schedule-v1.schema.json",
  "title": "SUNDERKEY Coverage Schedule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_prior_outcome_ids",
    "blocked_reasons",
    "budget_summary",
    "effects",
    "effective_max_concurrency",
    "limits",
    "parent_schedule_sha256",
    "schedule_id",
    "schedule_sha256",
    "schema_version",
    "scope_sha256",
    "supersedes_schedule_id",
    "tasks",
    "world_snapshot_sha256"
  ],
  "properties": {
    "accepted_prior_outcome_ids": {
      "$ref": "#/$defs/taskIdArray"
    },
    "blocked_reasons": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "$ref": "#/$defs/blockedReason"
      }
    },
    "budget_summary": {
      "$ref": "#/$defs/budgetSummary"
    },
    "effects": {
      "$ref": "#/$defs/effects"
    },
    "effective_max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "parent_schedule_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "schedule_id": {
      "type": "string",
      "pattern": "^CSS-[0-9A-F]{32}$"
    },
    "schedule_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "schema_version": {
      "const": 1
    },
    "scope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "supersedes_schedule_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^CSS-[0-9A-F]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "tasks": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "world_snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "printableText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[ -~]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^CST-[0-9A-F]{32}$"
    },
    "taskIdArray": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taskId"
      }
    },
    "identifierArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "textArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/printableText"
      }
    },
    "impactTier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "max_concurrency",
        "max_snapshot_age_seconds",
        "max_tasks",
        "max_tasks_per_asset",
        "max_total_cost_units",
        "max_total_requests",
        "review_impact_tier"
      ],
      "properties": {
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_snapshot_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2678400
        },
        "max_tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_tasks_per_asset": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "max_total_cost_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "max_total_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "review_impact_tier": {
          "$ref": "#/$defs/impactTier"
        }
      }
    },
    "validatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "validator_id",
        "version"
      ],
      "properties": {
        "role": {
          "enum": [
            "evidence",
            "control",
            "assurance"
          ]
        },
        "validator_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_ids",
        "effects",
        "estimated_cost_units",
        "estimated_requests",
        "expected_evidence",
        "frontier_id",
        "impact_tier",
        "node_ids",
        "prerequisite_task_ids",
        "priority",
        "required_commander_id",
        "required_specialist_profile_id",
        "restoration_required",
        "scope_sha256",
        "stop_conditions",
        "supersedes_task_ids",
        "task_id",
        "task_key",
        "task_sha256",
        "task_type",
        "technique_ids",
        "validators",
        "wave",
        "world_snapshot_sha256"
      ],
      "properties": {
        "asset_ids": {
          "$ref": "#/$defs/identifierArray"
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "estimated_cost_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "estimated_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "expected_evidence": {
          "$ref": "#/$defs/textArray"
        },
        "frontier_id": {
          "$ref": "#/$defs/identifier"
        },
        "impact_tier": {
          "$ref": "#/$defs/impactTier"
        },
        "node_ids": {
          "$ref": "#/$defs/identifierArray"
        },
        "prerequisite_task_ids": {
          "$ref": "#/$defs/taskIdArray"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "required_commander_id": {
          "$ref": "#/$defs/identifier"
        },
        "required_specialist_profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "restoration_required": {
          "type": "boolean"
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stop_conditions": {
          "$ref": "#/$defs/textArray"
        },
        "supersedes_task_ids": {
          "$ref": "#/$defs/taskIdArray"
        },
        "task_id": {
          "$ref": "#/$defs/taskId"
        },
        "task_key": {
          "$ref": "#/$defs/sha256"
        },
        "task_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "task_type": {
          "enum": [
            "context_collection",
            "passive_analysis",
            "safe_probe",
            "validation",
            "restoration_check",
            "retest_plan"
          ]
        },
        "technique_ids": {
          "$ref": "#/$defs/identifierArray"
        },
        "validators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/validatorBinding"
          }
        },
        "wave": {
          "type": "integer",
          "minimum": 0
        },
        "world_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "blockedReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "code",
        "detail",
        "frontier_id",
        "technique_id"
      ],
      "properties": {
        "asset_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "detail": {
          "$ref": "#/$defs/printableText"
        },
        "frontier_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "technique_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "budgetSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduled_cost_units",
        "scheduled_requests",
        "scheduled_tasks"
      ],
      "properties": {
        "scheduled_cost_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "scheduled_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "scheduled_tasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "browser",
        "credential_values",
        "deployment",
        "execution",
        "network",
        "payload_generation",
        "qualification",
        "requests",
        "routing",
        "target_authority",
        "tools"
      ],
      "properties": {
        "authority": {
          "const": "none"
        },
        "browser": {
          "const": "none"
        },
        "credential_values": {
          "const": "none"
        },
        "deployment": {
          "const": "none"
        },
        "execution": {
          "const": "none"
        },
        "network": {
          "const": "none"
        },
        "payload_generation": {
          "const": "none"
        },
        "qualification": {
          "const": "none"
        },
        "requests": {
          "const": "none"
        },
        "routing": {
          "const": "none"
        },
        "target_authority": {
          "const": "none"
        },
        "tools": {
          "const": "none"
        }
      }
    }
  }
}
