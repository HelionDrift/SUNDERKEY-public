        "required": {
          "type": "boolean"
        },
        "value_type": {
          "enum": [
            "string",
            "identifier",
            "sha256",
            "integer",
            "boolean",
            "string_array"
          ]
        }
      },
      "required": [
        "name",
        "required",
        "value_type"
      ],
      "type": "object"
    }
