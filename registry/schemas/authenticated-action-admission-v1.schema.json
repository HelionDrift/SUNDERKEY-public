    "catalog_entry": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "type": "string"
        },
        "executor_supported": {
          "type": "boolean"
        },
        "maximum_action_tier": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4"
          ]
        },
        "parameter_contract": {
          "items": {
            "$ref": "#/$defs/parameter_contract"
          },
          "maxItems": 128,
          "type": "array",
          "uniqueItems": true
        },
        "parameter_contract_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "r4_executor_supported": {
          "type": "boolean"
        },
        "supported_environments": {
          "items": {
            "enum": [
              "sandbox",
              "replica",
              "live"
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "tool_artifact_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "type": "string"
        },
        "tool_artifact_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "tool_exact_version": {
          "pattern": "^(?!(?:[Aa][Uu][Tt][Oo]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Dd][Ee][Ff][Aa][Uu][Ll][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt]|[Ss][Tt][Aa][Bb][Ll][Ee])$)(?=.*[0-9])[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "action_type",
        "executor_supported",
        "maximum_action_tier",
        "parameter_contract",
        "parameter_contract_sha256",
        "r4_executor_supported",
        "supported_environments",
        "tool_artifact_ref",
        "tool_artifact_sha256",
        "tool_exact_version"
      ],
      "type": "object"
    },
    "effects": {
      "additionalProperties": false,
      "properties": {
        "authorization_effect": {
          "const": "none"
        },
        "dispatch_performed": {
          "const": false
        },
        "model_call_performed": {
          "const": false
        },
        "network_call_performed": {
          "const": false
        },
        "qualification_effect": {
          "const": "none"
