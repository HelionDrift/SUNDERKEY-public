{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/mcp-local-reference-closure-v1.schema.json",
  "title": "SUNDERKEY Offline MCP Local Reference Closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_revision", "manifest_sha256",
    "semantic_preflight_sha256", "tool_count", "tools", "closure_status",
    "external_references_resolved", "full_json_schema_evaluation",
    "live_server_schema_verified", "qualification_effect", "effects",
    "closure_id", "closure_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_revision": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_preflight_sha256": {"$ref": "#/$defs/sha256"},
    "tool_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "tools": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["tool_name", "schemas"],
        "properties": {
          "tool_name": {"type": "string", "minLength": 1},
          "schemas": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["schema_kind", "local_reference_count", "status"],
              "properties": {
                "schema_kind": {"enum": ["input_schema", "output_schema"]},
                "local_reference_count": {
                  "type": "integer", "minimum": 0, "maximum": 10000
                },
                "status": {"const": "local_pointer_targets_checked"}
              }
            }
          }
        }
      }
    },
    "closure_status": {"const": "local_json_pointer_targets_checked_only"},
    "external_references_resolved": {"const": false},
    "full_json_schema_evaluation": {"const": false},
    "live_server_schema_verified": {"const": false},
    "qualification_effect": {"const": "none"},
    "effects": {
      "const": {
        "authorization": "none", "catalog_publication": "none",
        "mcp_server": "none", "network": "none", "qualification": "none",
        "target_interaction": "none", "tool_execution": "none"
      }
    },
    "closure_id": {"type": "string", "pattern": "^MLR-[0-9A-F]{32}$"},
    "closure_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
