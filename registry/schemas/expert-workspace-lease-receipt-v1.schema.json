{
  "$defs": {
    "identifier": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "profileId": {
      "pattern": "^AOE-(?:G[A-E]-D[0-9]{2}-(?:S[0-9]{2}|CMD)|HQ-[0-9]{2})$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://sunderkey.dev/schemas/expert-workspace-lease-receipt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acquired_at": {
      "minimum": 0,
      "type": "integer"
    },
    "attempt_number": {
      "maximum": 8,
      "minimum": 1,
      "type": "integer"
    },
    "authorization_effect": {
      "const": "none"
    },
    "automatic_retry_performed": {
      "const": false
    },
    "envelope_id": {
      "pattern": "^EEE-[0-9A-F]{32}$",
      "type": "string"
    },
    "expires_at": {
      "minimum": 1,
      "type": "integer"
    },
    "fencing_token": {
      "minimum": 1,
      "type": "integer"
    },
    "lease_id": {
      "pattern": "^EWL-[0-9A-F]{32}$",
      "type": "string"
    },
    "model_call_performed": {
      "const": false
    },
    "network_call_performed": {
      "const": false
    },
    "schema_version": {
      "const": 1
    },
    "tool_effect": {
      "const": "none"
    },
    "work_id": {
      "$ref": "#/$defs/identifier"
    },
    "workspace_id": {
      "pattern": "^EWS-[0-9A-F]{32}$",
      "type": "string"
    },
    "workspace_revision": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "lease_id",
    "workspace_id",
    "work_id",
    "attempt_number",
    "fencing_token",
    "envelope_id",
    "acquired_at",
    "expires_at",
    "workspace_revision",
    "automatic_retry_performed",
    "model_call_performed",
    "network_call_performed",
    "tool_effect",
    "authorization_effect"
  ],
  "type": "object"
}
