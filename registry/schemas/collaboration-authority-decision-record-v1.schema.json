{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-authority-decision-record-v1.json",
  "title": "SUNDERKEY Collaboration Authority Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_sha256",
    "decision_ids",
    "decision_status",
    "decision_effect",
    "source_dossier",
    "approval",
    "selected_alternative",
    "selected_options",
    "recommendation_alignment",
    "nonnegotiable_requirements",
    "authorized_next_steps",
    "prohibited_effects",
    "implementation_status",
    "runtime_effect",
    "registry_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "pattern": "^CRD-[0-9A-F]{32}$"},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "decision_ids": {
      "const": ["D001", "D002", "D003", "D004", "D005"]
    },
    "decision_status": {"const": "approved_operator_asserted_unsigned"},
    "decision_effect": {
      "const": "collaboration_reconfiguration_contract_implementation_authorized"
    },
    "source_dossier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "sha256"],
      "properties": {
        "report_id": {"type": "string", "pattern": "^CAD-[0-9A-F]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_status",
        "authority_role",
        "approver_id",
        "approved_at",
        "rationale",
        "identity_assurance"
      ],
      "properties": {
        "decision_status": {"const": "approved"},
        "authority_role": {"const": "repository_owner"},
        "approver_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[ -~]+$"
        },
        "approved_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[ -~]+$"
        },
        "identity_assurance": {"const": "operator_asserted_unsigned"}
      }
    },
    "selected_alternative": {"const": "reviewed_reconfiguration_ledger"},
    "selected_options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["D001", "D002", "D003", "D004", "D005"],
      "properties": {
        "D001": {"const": "owner_replacement_and_independent_control"},
        "D002": {
          "const": "versioned_bounded_chain_with_return_and_control_revocation"
        },
        "D003": {
          "const": "reviewed_plan_replacement_with_capability_revalidation"
        },
        "D004": {"const": "independently_reviewed_exact_item_mapping"},
        "D005": {"const": "fenced_sessions_signed_acknowledgement_and_timeout"}
      }
    },
    "recommendation_alignment": {
      "const": {
        "all_recommended_options_selected": true,
        "recommended_alternative_selected": true,
        "selected_option_count": 5,
        "selected_recommended_option_count": 5
      }
    },
    "nonnegotiable_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_binding_requirements",
        "separation_requirements",
        "fail_closed_requirements",
        "history_requirements",
        "private_key_storage_in_sunderkey",
        "execution_credentials_in_reconfiguration",
        "direct_runtime_control"
      ],
      "properties": {
        "authority_binding_requirements": {"$ref": "#/$defs/identifierSet"},
        "separation_requirements": {"$ref": "#/$defs/identifierSet"},
        "fail_closed_requirements": {"$ref": "#/$defs/identifierSet"},
        "history_requirements": {"$ref": "#/$defs/identifierSet"},
        "private_key_storage_in_sunderkey": {"const": false},
        "execution_credentials_in_reconfiguration": {"const": false},
        "direct_runtime_control": {"const": false}
      }
    },
    "authorized_next_steps": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{8,128}$"}
    },
    "prohibited_effects": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^does_not_[a-z0-9_]{8,180}$"}
    },
    "implementation_status": {"const": "not_started"},
    "runtime_effect": {"const": "none"},
    "registry_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifierSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{8,128}$"}
    }
  }
}
