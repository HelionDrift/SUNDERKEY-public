{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/qualification-evidence-manifest-v1.json",
  "title": "SUNDERKEY Qualification Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "policy",
    "qualification_standard",
    "evaluation_suite",
    "observation_set",
    "evaluation_report",
    "repository_id",
    "profile_id",
    "candidate",
    "candidate_owner_id",
    "created_at",
    "artifacts",
    "cases",
    "algorithm",
    "public_key",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^QEM-[0-9A-F]{32}$"
    },
    "manifest_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "policy": {
      "$ref": "#/$defs/policyBinding"
    },
    "qualification_standard": {
      "$ref": "#/$defs/versionedBinding"
    },
    "evaluation_suite": {
      "$ref": "#/$defs/versionedBinding"
    },
    "observation_set": {
      "$ref": "#/$defs/versionedBinding"
    },
    "evaluation_report": {
      "$ref": "#/$defs/contentBinding"
    },
    "repository_id": {
      "$ref": "#/$defs/identifier"
    },
    "profile_id": {
      "$ref": "#/$defs/profileId"
    },
    "candidate": {
      "$ref": "#/$defs/candidateBinding"
    },
    "candidate_owner_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 65536,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/caseEvidence"
      }
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "public_key": {
      "$ref": "#/$defs/publicKey"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^AOE-G[A-E]-D[0-9]{2}-S[0-9]{2}$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^QCASE-[A-Z0-9-]{8,96}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "publicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "sha256"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^QTP-[0-9A-F]{32}$"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "versionedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "contentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_version",
        "candidate_artifact_sha256"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/identifier"
        },
        "candidate_version": {
          "$ref": "#/$defs/identifier"
        },
        "candidate_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "case_id",
        "artifact_type",
        "media_type",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "case_id": {
          "$ref": "#/$defs/caseId"
        },
        "artifact_type": {
          "enum": [
            "candidate_result",
            "supporting_evidence",
            "reproduction_material",
            "scenario_input",
            "expected_result"
          ]
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.+-]{0,62}/[a-z0-9][a-z0-9.+-]{0,62}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "caseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "gate_id",
        "scenario_sha256",
        "expected_result_sha256",
        "critical_failure_definition_sha256",
        "outcome",
        "critical_failure",
        "result_sha256",
        "artifact_ids",
        "case_evidence_sha256"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/caseId"
        },
        "gate_id": {
          "$ref": "#/$defs/identifier"
        },
        "scenario_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expected_result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "critical_failure_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "critical_failure": {
          "type": "boolean"
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "case_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
