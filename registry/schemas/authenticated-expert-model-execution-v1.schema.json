{
  "$defs": {
    "AdmissionReceipt": {
      "additionalProperties": false,
      "properties": {
        "active_plan_id": { "$ref": "#/$defs/Identifier" },
        "active_plan_sha256": { "$ref": "#/$defs/Digest" },
        "active_plan_version": { "minimum": 1, "type": "integer" },
        "admission_id": { "$ref": "#/$defs/Identifier" },
        "admission_sha256": { "$ref": "#/$defs/Digest" },
        "admission_status": { "const": "admitted_reserved" },
        "admitted_at": { "$ref": "#/$defs/Timestamp" },
        "assessment_id": { "$ref": "#/$defs/Identifier" },
        "assertion_id": { "$ref": "#/$defs/Identifier" },
        "assertion_issuer": { "$ref": "#/$defs/Identifier" },
        "assertion_sha256": { "$ref": "#/$defs/Digest" },
        "authority_id": { "$ref": "#/$defs/Identifier" },
        "authority_sha256": { "$ref": "#/$defs/Digest" },
        "budget_id_after": { "$ref": "#/$defs/Identifier" },
        "budget_id_before": { "$ref": "#/$defs/Identifier" },
        "budget_revision_after": { "$ref": "#/$defs/Identifier" },
        "budget_revision_before": { "$ref": "#/$defs/Identifier" },
        "budget_sha256_after": { "$ref": "#/$defs/Digest" },
        "budget_sha256_before": { "$ref": "#/$defs/Digest" },
        "canonical_replay_key_sha256": { "$ref": "#/$defs/Digest" },
        "capability_sha256": { "$ref": "#/$defs/Digest" },
        "execution_admission_core_sha256": { "$ref": "#/$defs/Digest" },
        "execution_envelope_sha256": { "$ref": "#/$defs/Digest" },
        "expert_profile_id": { "$ref": "#/$defs/Identifier" },
        "invocation_plan_id": { "$ref": "#/$defs/Identifier" },
        "invocation_plan_sha256": { "$ref": "#/$defs/Digest" },
        "kind": { "const": "sunderkey.authenticated-model-execution-admission.v1" },
        "mission_id": { "$ref": "#/$defs/Identifier" },
        "mission_revision": { "minimum": 0, "type": "integer" },
        "operation_intent_sha256": { "$ref": "#/$defs/Digest" },
        "reservation_commit_id": { "$ref": "#/$defs/Identifier" },
        "reservation_commit_sha256": { "$ref": "#/$defs/Digest" },
        "reservation_sha256": { "$ref": "#/$defs/Digest" },
        "routing_decision_sha256": { "$ref": "#/$defs/Digest" },
        "runtime_catalog_sha256": { "$ref": "#/$defs/Digest" },
        "runtime_pack_sha256": { "$ref": "#/$defs/Digest" },
        "schema_version": { "const": 1, "type": "integer" },
        "scope_grant_sha256": { "$ref": "#/$defs/Digest" },
        "tenant_id": { "$ref": "#/$defs/Identifier" },
        "trust_policy_sha256": { "$ref": "#/$defs/Digest" },
        "work_id": { "$ref": "#/$defs/Identifier" }
      },
      "required": [
        "schema_version",
        "kind",
        "admission_id",
        "admission_sha256",
        "mission_id",
        "mission_revision",
        "tenant_id",
        "assessment_id",
        "active_plan_id",
        "active_plan_sha256",
        "active_plan_version",
        "work_id",
        "expert_profile_id",
        "runtime_catalog_sha256",
        "runtime_pack_sha256",
        "execution_envelope_sha256",
        "routing_decision_sha256",
        "capability_sha256",
        "reservation_sha256",
        "authority_id",
        "authority_sha256",
        "invocation_plan_id",
        "invocation_plan_sha256",
        "assertion_issuer",
        "assertion_id",
        "assertion_sha256",
        "scope_grant_sha256",
        "trust_policy_sha256",
        "execution_admission_core_sha256",
        "operation_intent_sha256",
        "canonical_replay_key_sha256",
        "budget_id_before",
        "budget_sha256_before",
        "budget_revision_before",
        "budget_id_after",
        "budget_sha256_after",
        "budget_revision_after",
        "reservation_commit_id",
        "reservation_commit_sha256",
        "admitted_at",
        "admission_status"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Dispatch": {
      "additionalProperties": false,
      "properties": {
        "adapter_principal_id": { "$ref": "#/$defs/Identifier" },
        "admission_id": { "$ref": "#/$defs/Identifier" },
        "admission_sha256": { "$ref": "#/$defs/Digest" },
        "authority_id": { "$ref": "#/$defs/Identifier" },
        "claimed_at": { "$ref": "#/$defs/Timestamp" },
        "dispatch_id": { "$ref": "#/$defs/Identifier" },
        "dispatch_sha256": { "$ref": "#/$defs/Digest" },
        "invocation_plan_id": { "$ref": "#/$defs/Identifier" },
        "kind": { "const": "sunderkey.authenticated-model-execution-dispatch.v1" },
        "schema_version": { "const": 1, "type": "integer" }
      },
      "required": [
        "schema_version",
        "kind",
        "dispatch_id",
        "dispatch_sha256",
        "admission_id",
        "admission_sha256",
        "authority_id",
        "invocation_plan_id",
        "adapter_principal_id",
        "claimed_at"
      ],
      "type": "object"
    },
    "Identifier": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
      "type": "string"
    },
    "Timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$id": "https://sunderkey.local/schemas/authenticated-expert-model-execution-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    { "$ref": "#/$defs/AdmissionReceipt" },
    { "$ref": "#/$defs/Dispatch" }
  ],
  "title": "SUNDERKEY authenticated expert model execution records v1"
}
