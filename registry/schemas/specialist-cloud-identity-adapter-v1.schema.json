{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.dev/schemas/specialist-cloud-identity-adapter-v1.schema.json",
  "title": "SUNDERKEY Specialist Cloud and Identity Adapter Contract",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "reference": {
      "type": "string",
      "pattern": "^(tenantref|accountref|projectref|subscriptionref|clusterref|scoperef|missionref|workerref|actionref|approvalref|sessionref|principalref|evidenceref|adapterref|attestationref):[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "provider": {
      "enum": ["aws", "azure", "gcp", "kubernetes", "entra_id", "okta_federation", "saas_tenancy", "serverless_container"]
    },
    "operation": {
      "enum": [
        "inventory_read",
        "identity_policy_read",
        "federation_trust_read",
        "kubernetes_rbac_read",
        "workload_binding_read",
        "data_access_metadata_read",
        "role_session_validate",
        "federation_exchange_validate",
        "workload_identity_validate",
        "resource_access_safe_proof",
        "temporary_role_binding",
        "ephemeral_workload_identity",
        "reversible_configuration_probe"
      ]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_grant", "credential_resolution", "network_client", "qualification", "remote_execution", "provider_sdk"],
      "properties": {
        "authority_grant": { "const": "none" },
        "credential_resolution": { "const": "none" },
        "network_client": { "const": "not_included" },
        "qualification": { "const": "none" },
        "remote_execution": { "const": "injected_adapter_only" },
        "provider_sdk": { "const": "not_included" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_ref", "scope_ref", "account_refs", "project_refs", "subscription_refs", "cluster_refs"],
      "properties": {
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "scope_ref": { "$ref": "#/$defs/reference" },
        "account_refs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
        "project_refs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
        "subscription_refs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
        "cluster_refs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_ref", "worker_ref", "action_ref", "action_admission_sha256", "scope"],
      "properties": {
        "mission_ref": { "$ref": "#/$defs/reference" },
        "worker_ref": { "$ref": "#/$defs/reference" },
        "action_ref": { "$ref": "#/$defs/reference" },
        "action_admission_sha256": { "$ref": "#/$defs/sha256" },
        "scope": { "$ref": "#/$defs/scope" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "profile_id", "supported_operations", "required_scope_dimensions", "dry_run_operations", "repository_only", "qualification_status"],
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "profile_id": { "type": "string", "pattern": "^profile:[a-z0-9-]+-v1$" },
        "supported_operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/operation" } },
        "required_scope_dimensions": { "type": "array", "uniqueItems": true, "items": { "enum": ["account", "project", "subscription", "cluster"] } },
        "dry_run_operations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/operation" } },
        "repository_only": { "const": true },
        "qualification_status": { "const": "not_qualified" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "package_id", "mutation_class", "minimum_tier"],
      "properties": {
        "family": { "enum": ["identity_provider", "cloud_control_plane", "workload_identity", "cloud_iam", "container_orchestration", "data_platform"] },
        "package_id": { "pattern": "^C4\\.(3|4|5|6|7|8)$" },
        "mutation_class": { "enum": ["read_only", "validation", "reversible_mutation"] },
        "minimum_tier": { "enum": ["R1", "R2", "R3"] }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_ref", "approval_sha256", "context_sha256", "provider", "operation", "maximum_tier", "allow_mutation", "require_dry_run", "issued_at", "expires_at"],
      "properties": {
        "approval_ref": { "$ref": "#/$defs/reference" },
        "approval_sha256": { "$ref": "#/$defs/sha256" },
        "context_sha256": { "$ref": "#/$defs/sha256" },
        "provider": { "$ref": "#/$defs/provider" },
        "operation": { "$ref": "#/$defs/operation" },
        "maximum_tier": { "enum": ["R1", "R2", "R3", "R4", "R5"] },
        "allow_mutation": { "type": "boolean" },
        "require_dry_run": { "type": "boolean" },
        "issued_at": { "$ref": "#/$defs/utc" },
        "expires_at": { "$ref": "#/$defs/utc" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_ref", "principal_ref", "session_sha256", "context_sha256", "provider", "issued_at", "expires_at"],
      "properties": {
        "session_ref": { "$ref": "#/$defs/reference" },
        "principal_ref": { "$ref": "#/$defs/reference" },
        "session_sha256": { "$ref": "#/$defs/sha256" },
        "context_sha256": { "$ref": "#/$defs/sha256" },
        "provider": { "$ref": "#/$defs/provider" },
        "issued_at": { "$ref": "#/$defs/utc" },
        "expires_at": { "$ref": "#/$defs/utc" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_operations", "max_resources", "max_mutations", "max_evidence_items"],
      "properties": {
        "max_operations": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_resources": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_mutations": { "type": "integer", "minimum": 0, "maximum": 16 },
        "max_evidence_items": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_ref", "version", "provider", "supported_operations"],
      "properties": {
        "adapter_ref": { "$ref": "#/$defs/reference" },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$" },
        "provider": { "$ref": "#/$defs/provider" },
        "supported_operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/operation" } }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "request_sha256", "schema_version", "kind", "effects", "context", "provider", "profile", "operation", "policy", "requested_tier", "approval", "session", "evidence_refs", "evidence_sha256", "idempotency_key", "dry_run", "budget", "issued_at", "expires_at"],
      "properties": {
        "request_id": { "type": "string", "pattern": "^CIR-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": 1 },
        "kind": { "const": "cloud_identity_action_request" },
        "effects": { "$ref": "#/$defs/effects" },
        "context": { "$ref": "#/$defs/context" },
        "provider": { "$ref": "#/$defs/provider" },
        "profile": { "$ref": "#/$defs/profile" },
        "operation": { "$ref": "#/$defs/operation" },
        "policy": { "$ref": "#/$defs/policy" },
        "requested_tier": { "enum": ["R1", "R2", "R3", "R4", "R5"] },
        "approval": { "$ref": "#/$defs/approval" },
        "session": { "$ref": "#/$defs/session" },
        "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
        "evidence_sha256": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "idempotency_key": { "type": "string", "pattern": "^idem:[A-Za-z0-9][A-Za-z0-9._/-]{7,190}$" },
        "dry_run": { "type": "boolean" },
        "budget": { "$ref": "#/$defs/budget" },
        "issued_at": { "$ref": "#/$defs/utc" },
        "expires_at": { "$ref": "#/$defs/utc" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "receipt_sha256", "schema_version", "kind", "effects", "request_id", "request_sha256", "context_sha256", "scope_binding_sha256", "provider", "operation", "mutation_class", "adapter", "state", "operations_performed", "resources_observed", "mutations_performed", "evidence_refs", "evidence_sha256", "result_attestation_ref", "result_attestation_sha256", "restoration_evidence_refs", "observed_at"],
      "properties": {
        "receipt_id": { "type": "string", "pattern": "^CIO-[0-9A-F]{32}$" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": 1 },
        "kind": { "const": "cloud_identity_action_receipt" },
        "effects": { "$ref": "#/$defs/effects" },
        "request_id": { "type": "string", "pattern": "^CIR-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "context_sha256": { "$ref": "#/$defs/sha256" },
        "scope_binding_sha256": { "$ref": "#/$defs/sha256" },
        "provider": { "$ref": "#/$defs/provider" },
        "operation": { "$ref": "#/$defs/operation" },
        "mutation_class": { "enum": ["read_only", "validation", "reversible_mutation"] },
        "adapter": { "$ref": "#/$defs/adapter" },
        "state": { "enum": ["completed", "blocked", "stopped"] },
        "operations_performed": { "type": "integer", "minimum": 0, "maximum": 64 },
        "resources_observed": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "mutations_performed": { "type": "integer", "minimum": 0, "maximum": 16 },
        "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
        "evidence_sha256": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "result_attestation_ref": { "$ref": "#/$defs/reference" },
        "result_attestation_sha256": { "$ref": "#/$defs/sha256" },
        "restoration_evidence_refs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
        "observed_at": { "$ref": "#/$defs/utc" }
      }
    }
  }
}
