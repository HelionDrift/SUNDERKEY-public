{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-mission-reconfiguration-policy-v1.json",
  "title": "SUNDERKEY Collaboration Mission Reconfiguration Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_sha256",
    "authority_policy",
    "policy_version",
    "previous_policy_sha256",
    "mission_id",
    "collaboration_plan_id",
    "collaboration_plan_sha256",
    "selected_parameters",
    "transition_activation",
    "approval_bindings",
    "effective_at",
    "expires_at",
    "authentication_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "pattern": "^MRP-[0-9A-F]{32}$"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "authority_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_sha256"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^RAP-[0-9A-F]{32}$"},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy_version": {"type": "integer", "minimum": 1},
    "previous_policy_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "mission_id": {"$ref": "#/$defs/identifier"},
    "collaboration_plan_id": {"$ref": "#/$defs/identifier"},
    "collaboration_plan_sha256": {"$ref": "#/$defs/sha256"},
    "selected_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_delegation_depth",
        "reconfiguration_validity_seconds",
        "execution_ack_timeout_seconds",
        "maximum_plan_replacement_items"
      ],
      "properties": {
        "maximum_delegation_depth": {"type": "integer", "minimum": 1, "maximum": 8},
        "reconfiguration_validity_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "execution_ack_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "maximum_plan_replacement_items": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "transition_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privileged_role_reassignment",
        "delegation_return_and_revocation",
        "cross_command_transfer",
        "activated_plan_replacement",
        "distributed_execution_transfer_or_cancellation"
      ],
      "properties": {
        "privileged_role_reassignment": {"type": "boolean"},
        "delegation_return_and_revocation": {"type": "boolean"},
        "cross_command_transfer": {"type": "boolean"},
        "activated_plan_replacement": {"type": "boolean"},
        "distributed_execution_transfer_or_cancellation": {"type": "boolean"}
      }
    },
    "approval_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_owner", "independent_control"],
      "properties": {
        "mission_owner": {"$ref": "#/$defs/assertionBinding"},
        "independent_control": {"$ref": "#/$defs/assertionBinding"}
      }
    },
    "effective_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "authentication_status": {"const": "assertions_pending_verification"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "assertionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "assertion_id", "assertion_sha256"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/identifier"},
        "assertion_id": {"type": "string", "pattern": "^PAS-[0-9A-F]{32}$"},
        "assertion_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
