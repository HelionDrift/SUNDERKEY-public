{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/model-routing-decision-v1.schema.json",
  "title": "SUNDERKEY Model Routing Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "decision_id",
    "decision_sha256",
    "tenant_id",
    "assessment_id",
    "task_id",
    "decided_at",
    "requirements_sha256",
    "authority_binding_sha256",
    "budget_sha256",
    "routing_policy_version",
    "status",
    "evaluations",
    "selection",
    "fallback_plan",
    "substitution_requires_new_decision",
    "blockers",
    "budget_reservation",
    "effects"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "sunderkey.model-routing-decision.v1"},
    "decision_id": {"type": "string", "pattern": "^MRD-[0-9A-F]{32}$"},
    "decision_sha256": {"$ref": "#/$defs/sha256"},
    "tenant_id": {"$ref": "#/$defs/identifier"},
    "assessment_id": {"$ref": "#/$defs/identifier"},
    "task_id": {"$ref": "#/$defs/identifier"},
    "decided_at": {"$ref": "#/$defs/timestamp"},
    "requirements_sha256": {"$ref": "#/$defs/sha256"},
    "authority_binding_sha256": {"$ref": "#/$defs/sha256"},
    "budget_sha256": {"$ref": "#/$defs/sha256"},
    "routing_policy_version": {"const": "cost_latency_availability_v1"},
    "status": {"enum": ["selected", "abstained"]},
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evaluation"}
    },
    "selection": {
      "oneOf": [
        {"$ref": "#/$defs/selection"},
        {"type": "null"}
      ]
    },
    "fallback_plan": {
      "type": "array",
      "items": {"$ref": "#/$defs/selection"}
    },
    "substitution_requires_new_decision": {"const": true},
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "budget_reservation": {
      "oneOf": [
        {"$ref": "#/$defs/reservation"},
        {"type": "null"}
      ]
    },
    "effects": {"$ref": "#/$defs/effects"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "selected"}}},
      "then": {
        "properties": {
          "selection": {"$ref": "#/$defs/selection"},
          "blockers": {"maxItems": 0},
          "budget_reservation": {"$ref": "#/$defs/reservation"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "abstained"}}},
      "then": {
        "properties": {
          "selection": {"type": "null"},
          "fallback_plan": {"maxItems": 0},
          "blockers": {"minItems": 1},
          "budget_reservation": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_sha256",
        "eligible",
        "score",
        "estimated_cost_micros",
        "blockers"
      ],
      "properties": {
        "capability_sha256": {"$ref": "#/$defs/sha256"},
        "eligible": {"type": "boolean"},
        "score": {"type": ["integer", "null"], "minimum": 0},
        "estimated_cost_micros": {"type": "integer", "minimum": 0},
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_sha256",
        "provider_id",
        "provider_api_version",
        "model_id",
        "model_version",
        "pricing_revision",
        "score"
      ],
      "properties": {
        "capability_sha256": {"$ref": "#/$defs/sha256"},
        "provider_id": {"$ref": "#/$defs/identifier"},
        "provider_api_version": {"$ref": "#/$defs/version"},
        "model_id": {"$ref": "#/$defs/identifier"},
        "model_version": {"$ref": "#/$defs/version"},
        "pricing_revision": {"$ref": "#/$defs/version"},
        "score": {"type": "integer", "minimum": 0}
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "reservation_id",
        "reservation_sha256",
        "tenant_id",
        "assessment_id",
        "task_id",
        "budget_sha256",
        "capability_sha256",
        "input_tokens",
        "output_tokens",
        "estimated_cost_micros",
        "aggregate_input_tokens_after",
        "aggregate_output_tokens_after",
        "aggregate_cost_micros_after",
        "reservation_state",
        "planning_only"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "sunderkey.model-budget-reservation.v1"},
        "reservation_id": {"type": "string", "pattern": "^MBR-[0-9A-F]{32}$"},
        "reservation_sha256": {"$ref": "#/$defs/sha256"},
        "tenant_id": {"$ref": "#/$defs/identifier"},
        "assessment_id": {"$ref": "#/$defs/identifier"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "budget_sha256": {"$ref": "#/$defs/sha256"},
        "capability_sha256": {"$ref": "#/$defs/sha256"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost_micros": {"type": "integer", "minimum": 0},
        "aggregate_input_tokens_after": {"type": "integer", "minimum": 0},
        "aggregate_output_tokens_after": {"type": "integer", "minimum": 0},
        "aggregate_cost_micros_after": {"type": "integer", "minimum": 0},
        "reservation_state": {"const": "proposed"},
        "planning_only": {"const": true}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "budget_reservation",
        "budget_spend",
        "credential_values",
        "execution",
        "model_calls",
        "network",
        "pricing_lookup",
        "provider_clients",
        "provider_state",
        "qualification",
        "requests",
        "secrets",
        "tools"
      ],
      "properties": {
        "authority": {"const": "none"},
        "budget_reservation": {"const": "planning_only"},
        "budget_spend": {"const": "none"},
        "credential_values": {"const": "none"},
        "execution": {"const": "none"},
        "model_calls": {"const": "none"},
        "network": {"const": "none"},
        "pricing_lookup": {"const": "none"},
        "provider_clients": {"const": "none"},
        "provider_state": {"const": "none"},
        "qualification": {"const": "none"},
        "requests": {"const": "none"},
        "secrets": {"const": "none"},
        "tools": {"const": "none"}
      }
    }
  }
}
