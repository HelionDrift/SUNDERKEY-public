{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/local-api-runtime-adapter-v1.schema.json",
  "title": "SUNDERKEY Local API Runtime Adapter Wire Contract v1",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "principal_id", "session_ref", "tenant_id"],
      "properties": {
        "context_id": {"$ref": "#/$defs/safeIdentifier"},
        "principal_id": {"$ref": "#/$defs/safeIdentifier"},
        "session_ref": {"$ref": "#/$defs/safeIdentifier"},
        "tenant_id": {"$ref": "#/$defs/safeIdentifier"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "operation", "request_id", "requested_at", "resource_kind"],
      "properties": {
        "access": {"$ref": "#/$defs/access"},
        "cursor": {
          "type": "string",
          "pattern": "^cursor:[A-Za-z0-9_-]+\\.[0-9a-f]{64}$"
        },
        "expected_concurrency_token": {
          "type": "string",
          "pattern": "^ct:[0-9a-f]{64}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^idem:[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"
        },
        "operation": {
          "enum": [
            "append_evidence",
            "attach_target_context",
            "create_asset",
            "create_mission",
            "create_report",
            "get_resource",
            "list_resources",
            "publish_operator_projection",
            "record_approval",
            "record_remediation",
            "transition_mission",
            "update_asset",
            "update_health",
            "upsert_finding"
          ]
        },
        "page_size": {"type": "integer", "minimum": 1, "maximum": 100},
        "payload": {"type": "object"},
        "request_id": {"$ref": "#/$defs/safeIdentifier"},
        "requested_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "resource_id": {"$ref": "#/$defs/safeIdentifier"},
        "resource_kind": {
          "enum": [
            "approval",
            "asset",
            "evidence",
            "finding",
            "health",
            "mission",
            "operator_projection",
            "remediation",
            "report",
            "target_context"
          ]
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_id", "data", "schema_version"],
      "properties": {
        "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorization_audit_ref",
            "authorization_ref",
            "integration_event",
            "mutation_audit_ref",
            "page",
            "request_id",
            "request_sha256",
            "resource",
            "schema_version",
            "status"
          ],
          "properties": {
            "authorization_audit_ref": {"type": "string"},
            "authorization_ref": {"type": "string"},
            "integration_event": {"type": ["object", "null"]},
            "mutation_audit_ref": {"type": ["string", "null"]},
            "page": {"type": ["object", "null"]},
            "request_id": {"$ref": "#/$defs/safeIdentifier"},
            "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "resource": {"type": ["object", "null"]},
            "schema_version": {"const": 1},
            "status": {"enum": ["completed", "replayed"]}
          }
        },
        "schema_version": {"const": 1}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_id", "error", "schema_version"],
      "properties": {
        "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
            "message": {"type": "string", "minLength": 1, "maxLength": 160}
          }
        },
        "schema_version": {"const": 1}
      }
    }
  }
}
