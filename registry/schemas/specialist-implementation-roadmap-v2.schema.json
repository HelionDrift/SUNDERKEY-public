{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/specialist-implementation-roadmap-v2.json",
  "title": "SUNDERKEY Army v2 Specialist Implementation Roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "roadmap_id",
    "roadmap_version",
    "roadmap_sha256",
    "expert_catalog_id",
    "expert_catalog_version",
    "expert_catalog_sha256",
    "blueprint_catalog_id",
    "blueprint_catalog_version",
    "blueprint_catalog_sha256",
    "package_catalog_id",
    "package_catalog_version",
    "package_catalog_sha256",
    "scheduling_policy",
    "roadmap_status",
    "qualification_effect",
    "routing_effect",
    "execution_effect",
    "deployment_effect",
    "waves",
    "commander_queues",
    "coverage_summary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "roadmap_id": {
      "const": "sunderkey-specialist-implementation-roadmap-v2"
    },
    "roadmap_version": {
      "const": "2.0.0"
    },
    "roadmap_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expert_catalog_id": {
      "const": "sunderkey-offensive-expert-army"
    },
    "expert_catalog_version": {
      "const": "2.0.0"
    },
    "expert_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "blueprint_catalog_id": {
      "const": "sunderkey-specialist-blueprints-v2"
    },
    "blueprint_catalog_version": {
      "const": "2.0.0"
    },
    "blueprint_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "package_catalog_id": {
      "const": "sunderkey-implementation-work-packages-v2"
    },
    "package_catalog_version": {
      "const": "2.0.0"
    },
    "package_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "scheduling_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordering",
        "maximum_packages_per_wave",
        "maximum_packages_per_command_per_wave",
        "validator_capacity_per_wave",
        "command_queue_concurrency",
        "selection_effect"
      ],
      "properties": {
        "ordering": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": "priority_score_descending"
            },
            {
              "const": "profile_id_ascending"
            },
            {
              "const": "earliest_capacity_eligible_wave"
            }
          ],
          "items": false
        },
        "maximum_packages_per_wave": {
          "const": 20
        },
        "maximum_packages_per_command_per_wave": {
          "const": 1
        },
        "validator_capacity_per_wave": {
          "$ref": "#/$defs/validatorCapacity"
        },
        "command_queue_concurrency": {
          "const": 1
        },
        "selection_effect": {
          "const": "none"
        }
      }
    },
    "roadmap_status": {
      "const": "planned_unassigned"
    },
    "qualification_effect": {
      "const": "none"
    },
    "routing_effect": {
      "const": "none"
    },
    "execution_effect": {
      "const": "none"
    },
    "deployment_effect": {
      "const": "none"
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/wave"
      }
    },
    "commander_queues": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/queue"
      }
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_count",
        "new_specialist_package_count",
        "command_count",
        "commander_queue_count",
        "collaboration_edge_count",
        "work_item_count",
        "wave_count"
      ],
      "properties": {
        "package_count": {
          "const": 391
        },
        "new_specialist_package_count": {
          "const": 43
        },
        "command_count": {
          "const": 25
        },
        "commander_queue_count": {
          "const": 25
        },
        "collaboration_edge_count": {
          "const": 782
        },
        "work_item_count": {
          "const": 3128
        },
        "wave_count": {
          "const": 30
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/asciiText"
      }
    }
  },
  "$defs": {
    "asciiText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\t\\n\\r -~]*[!-~][\\t\\n\\r -~]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^AOE-(?:H[QC]|G[A-H])-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "validatorCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AOE-HQ-19",
        "AOE-HQ-33",
        "AOE-HQ-34",
        "AOE-HQ-35"
      ],
      "properties": {
        "AOE-HQ-19": {
          "const": 12
        },
        "AOE-HQ-33": {
          "const": 3
        },
        "AOE-HQ-34": {
          "const": 3
        },
        "AOE-HQ-35": {
          "const": 2
        }
      }
    },
    "validatorLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AOE-HQ-19",
        "AOE-HQ-33",
        "AOE-HQ-34",
        "AOE-HQ-35"
      ],
      "properties": {
        "AOE-HQ-19": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "AOE-HQ-33": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "AOE-HQ-34": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "AOE-HQ-35": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "riskClassByValidator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AOE-HQ-19",
        "AOE-HQ-33",
        "AOE-HQ-34",
        "AOE-HQ-35"
      ],
      "properties": {
        "AOE-HQ-19": {
          "const": "standard_independent_reproduction"
        },
        "AOE-HQ-33": {
          "const": "human_safety_or_restoration"
        },
        "AOE-HQ-34": {
          "const": "hostile_content_or_redaction"
        },
        "AOE-HQ-35": {
          "const": "cross_system_reconciliation"
        }
      }
    },
    "riskWeightByValidator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AOE-HQ-19",
        "AOE-HQ-33",
        "AOE-HQ-34",
        "AOE-HQ-35"
      ],
      "properties": {
        "AOE-HQ-19": {
          "const": 200
        },
        "AOE-HQ-33": {
          "const": 400
        },
        "AOE-HQ-34": {
          "const": 300
        },
        "AOE-HQ-35": {
          "const": 350
        }
      }
    },
    "verificationCostByValidator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AOE-HQ-19",
        "AOE-HQ-33",
        "AOE-HQ-34",
        "AOE-HQ-35"
      ],
      "properties": {
        "AOE-HQ-19": {
          "const": 3
        },
        "AOE-HQ-33": {
          "const": 5
        },
        "AOE-HQ-34": {
          "const": 4
        },
        "AOE-HQ-35": {
          "const": 5
        }
      }
    },
    "riskClassCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard_independent_reproduction",
        "human_safety_or_restoration",
        "hostile_content_or_redaction",
        "cross_system_reconciliation"
      ],
      "properties": {
        "standard_independent_reproduction": {
          "type": "integer",
          "minimum": 0
        },
        "human_safety_or_restoration": {
          "type": "integer",
          "minimum": 0
        },
        "hostile_content_or_redaction": {
          "type": "integer",
          "minimum": 0
        },
        "cross_system_reconciliation": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stageDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_number",
        "stage_id",
        "objective",
        "required_evidence"
      ],
      "properties": {
        "stage_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "stage_id": {
          "$ref": "#/$defs/asciiText"
        },
        "objective": {
          "$ref": "#/$defs/asciiText"
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asciiText"
          }
        }
      }
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wave_id",
        "wave_number",
        "package_ids",
        "command_ids",
        "validator_load",
        "risk_class_counts",
        "new_specialist_package_count",
        "wave_status",
        "operational_effect"
      ],
      "properties": {
        "wave_id": {
          "type": "string",
          "pattern": "^IW2-[0-9]{3}$"
        },
        "wave_number": {
          "type": "integer",
          "minimum": 1
        },
        "package_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asciiText"
          }
        },
        "command_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asciiText"
          }
        },
        "validator_load": {
          "$ref": "#/$defs/validatorLoad"
        },
        "risk_class_counts": {
          "$ref": "#/$defs/riskClassCounts"
        },
        "new_specialist_package_count": {
          "type": "integer",
          "minimum": 0
        },
        "wave_status": {
          "const": "planned_unassigned"
        },
        "operational_effect": {
          "const": "none"
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "commander_profile_id",
        "package_ids",
        "scheduled_wave_ids",
        "package_count",
        "maximum_concurrent_packages",
        "queue_status"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/asciiText"
        },
        "commander_profile_id": {
          "$ref": "#/$defs/profileId"
        },
        "package_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asciiText"
          }
        },
        "scheduled_wave_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asciiText"
          }
        },
        "package_count": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_concurrent_packages": {
          "const": 1
        },
        "queue_status": {
          "const": "defined_unassigned"
        }
      }
    }
  }
}
