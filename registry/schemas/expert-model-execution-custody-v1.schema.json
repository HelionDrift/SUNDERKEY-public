          "minLength": 1,
          "pattern": "^[\\t\\n\\r\\u0020-\\u007E]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "input_tokens": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "invocation_plan_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "type": "string"
        },
        "invocation_plan_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "kind": {
          "const": "sunderkey.expert-provider-observation.v1"
        },
        "model_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "type": "string"
        },
        "observation_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "output_tokens": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "provider_api_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "type": "string"
        },
        "provider_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "type": "string"
        },
        "provider_request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "type": "string"
        },
        "schema_version": {
          "const": 1
        },
        "started_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        "structured_output_json": {
          "maxLength": 131072,
          "type": [
            "string",
            "null"
          ]
        },
        "structured_output_reference": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "terminal_state": {
          "enum": [
            "completed",
            "incomplete",
            "failed"
          ],
          "type": "string"
        },
        "usage_trustworthy": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "invocation_plan_id",
        "invocation_plan_sha256",
        "provider_id",
        "provider_api_version",
        "model_id",
        "model_version",
        "provider_request_id",
        "terminal_state",
        "usage_trustworthy",
        "input_tokens",
        "output_tokens",
        "billable_cost_micros",
        "structured_output_json",
        "structured_output_reference",
        "incomplete_reason",
        "started_at",
        "completed_at",
        "observation_id",
        "observation_sha256"
      ],
      "type": "object"
    }
  },
