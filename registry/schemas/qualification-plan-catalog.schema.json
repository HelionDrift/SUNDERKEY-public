{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.local/schemas/qualification-plan-catalog.schema.json",
  "title": "SUNDERKEY Qualification Plan Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_catalog_id",
    "plan_catalog_version",
    "qualification_standard_id",
    "qualification_standard_version",
    "qualification_standard_sha256",
    "expert_catalog_id",
    "expert_catalog_version",
    "capability_catalog_id",
    "capability_catalog_version",
    "capability_catalog_sha256",
    "profile_plans"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_catalog_id": {
      "$ref": "#/$defs/asciiText"
    },
    "plan_catalog_version": {
      "$ref": "#/$defs/asciiText"
    },
    "qualification_standard_id": {
      "$ref": "#/$defs/asciiText"
    },
    "qualification_standard_version": {
      "$ref": "#/$defs/asciiText"
    },
    "qualification_standard_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expert_catalog_id": {
      "$ref": "#/$defs/asciiText"
    },
    "expert_catalog_version": {
      "$ref": "#/$defs/asciiText"
    },
    "capability_catalog_id": {
      "$ref": "#/$defs/asciiText"
    },
    "capability_catalog_version": {
      "$ref": "#/$defs/asciiText"
    },
    "capability_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "profile_plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profilePlan"
      }
    }
  },
  "$defs": {
    "asciiText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\t\\n\\r -~]*[!-~][\\t\\n\\r -~]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profilePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "scenario_family_id",
        "technical_focus",
        "evaluation_objective",
        "primary_capability_ids",
        "required_gate_ids"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^AOE-G[A-E]-D[0-9]{2}-S[0-9]{2}$"
        },
        "scenario_family_id": {
          "type": "string",
          "pattern": "^qualification\\.aoe-g[a-e]-d[0-9]{2}-s[0-9]{2}$"
        },
        "technical_focus": {
          "$ref": "#/$defs/asciiText"
        },
        "evaluation_objective": {
          "$ref": "#/$defs/asciiText"
        },
        "primary_capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          }
        },
        "required_gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^qualification\\.gate\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
