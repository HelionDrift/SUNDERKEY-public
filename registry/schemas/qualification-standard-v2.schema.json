{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/qualification-standard-v2.json",
  "title": "SUNDERKEY Specialist Qualification Standard v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "standard_id",
    "standard_version",
    "expert_catalog_id",
    "expert_catalog_version",
    "capability_catalog_id",
    "capability_catalog_version",
    "capability_catalog_sha256",
    "allowed_environments",
    "decision_policy",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "standard_id": {
      "const": "sunderkey-specialist-qualification-v2"
    },
    "standard_version": {
      "const": "2.0.0"
    },
    "expert_catalog_id": {
      "const": "sunderkey-offensive-expert-army"
    },
    "expert_catalog_version": {
      "const": "2.0.0"
    },
    "capability_catalog_id": {
      "const": "sunderkey-army-capabilities-v2"
    },
    "capability_catalog_version": {
      "const": "2.0.0"
    },
    "capability_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "allowed_environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "offline",
          "synthetic",
          "test",
          "production"
        ]
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_distinct_evaluators",
        "require_independent_control_review",
        "require_independent_assurance_review",
        "allow_self_attestation",
        "qualification_validity_days"
      ],
      "properties": {
        "minimum_distinct_evaluators": {
          "type": "integer",
          "minimum": 1
        },
        "require_independent_control_review": {
          "type": "boolean"
        },
        "require_independent_assurance_review": {
          "type": "boolean"
        },
        "allow_self_attestation": {
          "type": "boolean"
        },
        "qualification_validity_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate"
      }
    }
  },
  "$defs": {
    "asciiText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\t\\n\\r -~]*[!-~][\\t\\n\\r -~]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "evaluation_objective",
        "minimum_scenarios",
        "minimum_passing_scenarios",
        "maximum_critical_failures",
        "independent_review_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^qualification\\.gate\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "name": {
          "$ref": "#/$defs/asciiText"
        },
        "category": {
          "enum": [
            "authority",
            "boundary",
            "collaboration",
            "evidence",
            "quality",
            "resilience",
            "safety",
            "technical"
          ]
        },
        "evaluation_objective": {
          "$ref": "#/$defs/asciiText"
        },
        "minimum_scenarios": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_passing_scenarios": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_critical_failures": {
          "type": "integer",
          "minimum": 0
        },
        "independent_review_required": {
          "type": "boolean"
        }
      }
    }
  }
}
