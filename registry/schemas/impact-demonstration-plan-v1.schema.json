{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/impact-demonstration-plan-v1.schema.json",
  "title": "SUNDERKEY Impact Demonstration Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_total_byte_ceiling",
    "binding_sha256",
    "cleanup_verification_required",
    "denial_reasons",
    "effects",
    "evaluated_at",
    "independent_review_required",
    "independent_review_satisfied",
    "kind",
    "operator_approval_required",
    "operator_approval_satisfied",
    "plan_id",
    "plan_sha256",
    "qualification_effect",
    "request",
    "request_sha256",
    "schema_version",
    "status",
    "steps"
  ],
  "properties": {
    "artifact_total_byte_ceiling": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16384
    },
    "binding_sha256": { "$ref": "#/$defs/sha256" },
    "cleanup_verification_required": { "type": "boolean" },
    "denial_reasons": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/code" }
    },
    "effects": { "$ref": "#/$defs/effects" },
    "evaluated_at": { "$ref": "#/$defs/timestamp" },
    "independent_review_required": { "type": "boolean" },
    "independent_review_satisfied": { "type": "boolean" },
    "kind": { "const": "sunderkey.impact-demonstration-plan.v1" },
    "operator_approval_required": { "type": "boolean" },
    "operator_approval_satisfied": { "type": "boolean" },
    "plan_id": { "type": "string", "pattern": "^IDP-[0-9A-F]{32}$" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "qualification_effect": { "const": "none" },
    "request": { "$ref": "#/$defs/request" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "schema_version": { "const": 1 },
    "status": { "enum": ["off", "evidence_plan_only", "denied"] },
    "steps": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$",
      "maxLength": 256
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "mode": { "enum": ["off", "moderate", "deep"] },
    "category": {
      "enum": [
        "captured_credential",
        "role_change",
        "lateral_pivot",
        "data_modification",
        "availability_impact",
        "destructive_proof"
      ]
    },
    "artifact_class": {
      "enum": [
        "aggregate_metric",
        "metadata_snapshot",
        "redacted_transcript",
        "state_delta"
      ]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "availability_change",
        "credential_access",
        "data_change",
        "execution",
        "lateral_movement",
        "network",
        "role_change",
        "target_contact"
      ],
      "properties": {
        "authorization": { "const": "none" },
        "availability_change": { "const": "none" },
        "credential_access": { "const": "none" },
        "data_change": { "const": "none" },
        "execution": { "const": "none" },
        "lateral_movement": { "const": "none" },
        "network": { "const": "none" },
        "role_change": { "const": "none" },
        "target_contact": { "const": "none" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_ref",
        "policy_ref",
        "policy_sha256",
        "production_data_present",
        "protected_target",
        "scope_ref",
        "scope_sha256",
        "session_ref",
        "session_sha256",
        "target_ref",
        "target_sha256",
        "tenant_ref"
      ],
      "properties": {
        "context_ref": { "$ref": "#/$defs/ref" },
        "policy_ref": { "$ref": "#/$defs/ref" },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "production_data_present": { "type": "boolean" },
        "protected_target": { "type": "boolean" },
        "scope_ref": { "$ref": "#/$defs/ref" },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "session_ref": { "$ref": "#/$defs/ref" },
        "session_sha256": { "$ref": "#/$defs/sha256" },
        "target_ref": { "$ref": "#/$defs/ref" },
        "target_sha256": { "$ref": "#/$defs/sha256" },
        "tenant_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_byte_limit",
        "artifact_class",
        "category",
        "cleanup_plan_ref",
        "cleanup_plan_sha256",
        "evidence_ref",
        "evidence_sha256",
        "reversible_proof_ref",
        "reversible_proof_sha256"
      ],
      "properties": {
        "artifact_byte_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "category": { "$ref": "#/$defs/category" },
        "cleanup_plan_ref": { "$ref": "#/$defs/ref" },
        "cleanup_plan_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_ref": { "$ref": "#/$defs/ref" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "reversible_proof_ref": { "$ref": "#/$defs/ref" },
        "reversible_proof_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_ref",
        "approval_sha256",
        "approved_categories",
        "approved_mode",
        "binding_sha256",
        "expires_at",
        "issued_at",
        "operator_ref"
      ],
      "properties": {
        "approval_ref": { "$ref": "#/$defs/ref" },
        "approval_sha256": { "$ref": "#/$defs/sha256" },
        "approved_categories": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/category" }
        },
        "approved_mode": { "$ref": "#/$defs/mode" },
        "binding_sha256": { "$ref": "#/$defs/sha256" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "operator_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_sha256",
        "binding_sha256",
        "decision",
        "expires_at",
        "issued_at",
        "review_ref",
        "review_sha256",
        "reviewed_categories",
        "reviewed_mode",
        "reviewer_ref"
      ],
      "properties": {
        "approval_sha256": { "$ref": "#/$defs/sha256" },
        "binding_sha256": { "$ref": "#/$defs/sha256" },
        "decision": { "const": "accepted" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "review_ref": { "$ref": "#/$defs/ref" },
        "review_sha256": { "$ref": "#/$defs/sha256" },
        "reviewed_categories": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/category" }
        },
        "reviewed_mode": { "$ref": "#/$defs/mode" },
        "reviewer_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "created_at",
        "expires_at",
        "independent_review",
        "intents",
        "mode",
        "operator_approval"
      ],
      "properties": {
        "binding": { "$ref": "#/$defs/binding" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "independent_review": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/review" }]
        },
        "intents": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/intent" }
        },
        "mode": { "$ref": "#/$defs/mode" },
        "operator_approval": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/approval" }]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_byte_limit",
        "artifact_class",
        "category",
        "cleanup_plan_ref",
        "cleanup_plan_sha256",
        "cleanup_verification_code",
        "disposition",
        "evidence_ref",
        "evidence_sha256",
        "persist_raw_content",
        "persist_secret_material",
        "proof_method",
        "reversible_proof_ref",
        "reversible_proof_sha256"
      ],
      "properties": {
        "artifact_byte_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "category": { "$ref": "#/$defs/category" },
        "cleanup_plan_ref": { "$ref": "#/$defs/ref" },
        "cleanup_plan_sha256": { "$ref": "#/$defs/sha256" },
        "cleanup_verification_code": {
          "enum": [
            "credential_invalidation_verified",
            "role_restoration_verified",
            "pivot_session_termination_verified",
            "data_restoration_verified",
            "availability_restoration_verified",
            "destructive_recovery_verified"
          ]
        },
        "disposition": {
          "enum": ["suppressed", "planned_evidence_only", "prohibited"]
        },
        "evidence_ref": { "$ref": "#/$defs/ref" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "persist_raw_content": { "const": false },
        "persist_secret_material": { "const": false },
        "proof_method": { "const": "existing_evidence_reference" },
        "reversible_proof_ref": { "$ref": "#/$defs/ref" },
        "reversible_proof_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
