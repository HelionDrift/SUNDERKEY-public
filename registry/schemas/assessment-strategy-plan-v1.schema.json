{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.local/schemas/assessment-strategy-plan-v1.schema.json",
  "title": "SUNDERKEY effect-free assessment strategy plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blocked_reasons",
    "claims",
    "context_ref",
    "effects",
    "independent_review_required",
    "input_identities",
    "input_lineage",
    "inputs",
    "kind",
    "plan_id",
    "plan_sha256",
    "qualification_effect",
    "schema_version",
    "scope_ref",
    "scope_sha256",
    "status",
    "stop_conditions",
    "tenant_ref",
    "work_items"
  ],
  "properties": {
    "blocked_reasons": {"$ref": "#/$defs/uniqueCodes"},
    "claims": {"$ref": "#/$defs/claims"},
    "context_ref": {"$ref": "#/$defs/reference"},
    "effects": {"$ref": "#/$defs/effects"},
    "independent_review_required": {"type": "boolean"},
    "input_identities": {"$ref": "#/$defs/inputIdentities"},
    "input_lineage": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "prefixItems": [
        {"$ref": "#/$defs/guidanceLineage"},
        {"$ref": "#/$defs/coverageLineage"},
        {"$ref": "#/$defs/riskLineage"},
        {"$ref": "#/$defs/impactLineage"}
      ],
      "items": false
    },
    "inputs": {"$ref": "#/$defs/sourceInputs"},
    "kind": {"const": "sunderkey.assessment-strategy-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^ASP-[0-9A-F]{32}$"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "qualification_effect": {"const": "none"},
    "schema_version": {"const": 1},
    "scope_ref": {"$ref": "#/$defs/reference"},
    "scope_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "proposal_only"},
    "stop_conditions": {"$ref": "#/$defs/nonemptyUniqueCodes"},
    "tenant_ref": {"$ref": "#/$defs/reference"},
    "work_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {"$ref": "#/$defs/workItem"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+\\-]*$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{0,95}$"
    },
    "uniqueCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/code"}
    },
    "nonemptyUniqueCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/code"}
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "credential_access",
        "deployment",
        "execution",
        "network",
        "routing",
        "scheduling",
        "target_contact"
      ],
      "properties": {
        "authorization": {"const": "none"},
        "credential_access": {"const": "none"},
        "deployment": {"const": "none"},
        "execution": {"const": "none"},
        "network": {"const": "none"},
        "routing": {"const": "none"},
        "scheduling": {"const": "none"},
        "target_contact": {"const": "none"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competitive_parity",
        "live_validation",
        "production_readiness",
        "qualification"
      ],
      "properties": {
        "competitive_parity": {"const": "not_claimed"},
        "live_validation": {"const": "not_claimed"},
        "production_readiness": {"const": "not_claimed"},
        "qualification": {"const": "not_claimed"}
      }
    },
    "inputIdentities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_matrix_id",
        "coverage_matrix_sha256",
        "guidance_card_id",
        "guidance_card_sha256",
        "impact_plan_id",
        "impact_plan_sha256",
        "risk_portfolio_id",
        "risk_portfolio_sha256"
      ],
      "properties": {
        "coverage_matrix_id": {"type": "string", "pattern": "^ACM-[0-9A-F]{32}$"},
        "coverage_matrix_sha256": {"$ref": "#/$defs/sha256"},
        "guidance_card_id": {"type": "string", "pattern": "^AGC-[0-9A-F]{32}$"},
        "guidance_card_sha256": {"$ref": "#/$defs/sha256"},
        "impact_plan_id": {"type": "string", "pattern": "^IDP-[0-9A-F]{32}$"},
        "impact_plan_sha256": {"$ref": "#/$defs/sha256"},
        "risk_portfolio_id": {"type": "string", "pattern": "^ARP-[0-9A-F]{32}$"},
        "risk_portfolio_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "content_sha256", "input_kind"],
      "properties": {
        "content_id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9A-F]{32}$"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "input_kind": {
          "enum": [
            "assessment_guidance",
            "attack_coverage_matrix",
            "asset_risk_portfolio",
            "impact_demonstration_plan"
          ]
        }
      }
    },
    "guidanceLineage": {
      "allOf": [
        {"$ref": "#/$defs/lineage"},
        {"properties": {"content_id": {"pattern": "^AGC-"}, "input_kind": {"const": "assessment_guidance"}}}
      ]
    },
    "coverageLineage": {
      "allOf": [
        {"$ref": "#/$defs/lineage"},
        {"properties": {"content_id": {"pattern": "^ACM-"}, "input_kind": {"const": "attack_coverage_matrix"}}}
      ]
    },
    "riskLineage": {
      "allOf": [
        {"$ref": "#/$defs/lineage"},
        {"properties": {"content_id": {"pattern": "^ARP-"}, "input_kind": {"const": "asset_risk_portfolio"}}}
      ]
    },
    "impactLineage": {
      "allOf": [
        {"$ref": "#/$defs/lineage"},
        {"properties": {"content_id": {"pattern": "^IDP-"}, "input_kind": {"const": "impact_demonstration_plan"}}}
      ]
    },
    "sourceInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_guidance",
        "asset_risk_portfolio",
        "attack_coverage_matrix",
        "impact_demonstration_plan"
      ],
      "properties": {
        "assessment_guidance": {
          "type": "object",
          "required": ["card_id", "card_sha256", "kind", "schema_version"],
          "properties": {
            "card_id": {"type": "string", "pattern": "^AGC-[0-9A-F]{32}$"},
            "card_sha256": {"$ref": "#/$defs/sha256"},
            "kind": {"const": "sunderkey.assessment-guidance-card.v1"},
            "schema_version": {"const": 1}
          }
        },
        "asset_risk_portfolio": {
          "type": "object",
          "required": ["contract_type", "portfolio_id", "portfolio_sha256", "schema_version"],
          "properties": {
            "contract_type": {"const": "asset_risk_portfolio"},
            "portfolio_id": {"type": "string", "pattern": "^ARP-[0-9A-F]{32}$"},
            "portfolio_sha256": {"$ref": "#/$defs/sha256"},
            "schema_version": {"const": 1}
          }
        },
        "attack_coverage_matrix": {
          "type": "object",
          "required": ["matrix_id", "matrix_sha256", "schema_version"],
          "properties": {
            "matrix_id": {"type": "string", "pattern": "^ACM-[0-9A-F]{32}$"},
            "matrix_sha256": {"$ref": "#/$defs/sha256"},
            "schema_version": {"const": 1}
          }
        },
        "impact_demonstration_plan": {
          "type": "object",
          "required": ["kind", "plan_id", "plan_sha256", "schema_version"],
          "properties": {
            "kind": {"const": "sunderkey.impact-demonstration-plan.v1"},
            "plan_id": {"type": "string", "pattern": "^IDP-[0-9A-F]{32}$"},
            "plan_sha256": {"$ref": "#/$defs/sha256"},
            "schema_version": {"const": 1}
          }
        }
      }
    },
    "scoreComponents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/code"},
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 1000000}
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_reasons",
        "impact_ceiling",
        "independent_review_required",
        "order",
        "prerequisite_refs",
        "priority_score",
        "reason_codes",
        "risk_ceiling_points",
        "score_components",
        "source_content_ids",
        "specialist_reference_ids",
        "status",
        "stop_conditions",
        "subject_ref",
        "work_item_id",
        "work_item_sha256",
        "work_kind"
      ],
      "properties": {
        "blocked_reasons": {"$ref": "#/$defs/uniqueCodes"},
        "impact_ceiling": {"enum": ["low", "moderate", "high"]},
        "independent_review_required": {"type": "boolean"},
        "order": {"type": "integer", "minimum": 1, "maximum": 20000},
        "prerequisite_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "priority_score": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "reason_codes": {"$ref": "#/$defs/nonemptyUniqueCodes"},
        "risk_ceiling_points": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "score_components": {"$ref": "#/$defs/scoreComponents"},
        "source_content_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]{3}-[0-9A-F]{32}$"}
        },
        "specialist_reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^SCR-[0-9A-F]{32}$"}
        },
        "status": {"const": "proposal_only"},
        "stop_conditions": {"$ref": "#/$defs/nonemptyUniqueCodes"},
        "subject_ref": {"$ref": "#/$defs/reference"},
        "work_item_id": {"type": "string", "pattern": "^SWI-[0-9A-F]{32}$"},
        "work_item_sha256": {"$ref": "#/$defs/sha256"},
        "work_kind": {
          "enum": [
            "asset_risk",
            "explicit_goal",
            "guidance_gap",
            "guidance_frontier",
            "coverage_gap",
            "impact_evidence"
          ]
        }
      }
    }
  }
}
