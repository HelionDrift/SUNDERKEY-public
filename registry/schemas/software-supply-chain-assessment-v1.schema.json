{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.local/schemas/software-supply-chain-assessment-v1.schema.json",
  "title": "SUNDERKEY software supply-chain assessment report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch",
    "candidate_plans",
    "edges",
    "evidence_level",
    "findings",
    "generated_at",
    "nodes",
    "operational_status",
    "qualification_effect",
    "report_id",
    "report_sha256",
    "schema_version"
  ],
  "properties": {
    "batch": { "$ref": "#/$defs/batch" },
    "candidate_plans": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidatePlan" },
      "maxItems": 25000
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" },
      "maxItems": 100000
    },
    "evidence_level": { "const": "repository_only" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" },
      "maxItems": 25000
    },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" },
      "maxItems": 50000
    },
    "operational_status": { "const": "nonqualified" },
    "qualification_effect": { "const": "none" },
    "report_id": { "pattern": "^SCR-[0-9A-F]{32}$", "type": "string" },
    "report_sha256": { "$ref": "#/$defs/digest" },
    "schema_version": { "const": 1 }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_version",
        "evidence_kinds",
        "evidence_source_ref",
        "passive_only",
        "record_limit",
        "required_action_tier"
      ],
      "properties": {
        "adapter_id": { "$ref": "#/$defs/identifier" },
        "adapter_version": { "$ref": "#/$defs/identifier" },
        "evidence_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceKind" }
        },
        "evidence_source_ref": {
          "type": "string",
          "pattern": "^evidence:[A-Za-z0-9._:/-]{1,247}$"
        },
        "passive_only": { "const": true },
        "record_limit": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "required_action_tier": { "const": "R0" }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "batch_sha256",
        "evidence_level",
        "imported_at",
        "operational_status",
        "plan",
        "qualification_effect",
        "records"
      ],
      "properties": {
        "batch_id": { "pattern": "^SCB-[0-9A-F]{32}$", "type": "string" },
        "batch_sha256": { "$ref": "#/$defs/digest" },
        "evidence_level": { "const": "repository_only" },
        "imported_at": { "$ref": "#/$defs/timestamp" },
        "operational_status": { "const": "nonqualified" },
        "plan": { "$ref": "#/$defs/plan" },
        "qualification_effect": { "const": "none" },
        "records": {
          "type": "array",
          "items": { "$ref": "#/$defs/record" },
          "maxItems": 50000
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_adapters",
        "max_edges",
        "max_findings",
        "max_nodes",
        "max_proposals",
        "max_records"
      ],
      "properties": {
        "max_adapters": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_edges": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_findings": { "type": "integer", "minimum": 1, "maximum": 25000 },
        "max_nodes": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "max_proposals": { "type": "integer", "minimum": 1, "maximum": 25000 },
        "max_records": { "type": "integer", "minimum": 1, "maximum": 50000 }
      }
    },
    "candidatePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_refs",
        "command_execution_permitted",
        "finding_id",
        "max_records",
        "minimum_action_tier",
        "network_access_permitted",
        "plan_kind",
        "proposal_id",
        "proposal_sha256",
        "registry_contact_permitted",
        "repository_mutation_permitted",
        "separate_admission_required",
        "status"
      ],
      "properties": {
        "adapter_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "command_execution_permitted": { "const": false },
        "finding_id": { "pattern": "^SCF-[0-9A-F]{32}$", "type": "string" },
        "max_records": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "minimum_action_tier": { "enum": ["R0", "R1", "R2", "R3"] },
        "network_access_permitted": { "const": false },
        "plan_kind": { "$ref": "#/$defs/identifier" },
        "proposal_id": { "pattern": "^SCV-[0-9A-F]{32}$", "type": "string" },
        "proposal_sha256": { "$ref": "#/$defs/digest" },
        "registry_contact_permitted": { "const": false },
        "repository_mutation_permitted": { "const": false },
        "separate_admission_required": { "const": true },
        "status": { "const": "proposal_only" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_ref",
        "context_id",
        "repository_ref",
        "revision_sha256",
        "scope_binding_sha256",
        "tenant_id"
      ],
      "properties": {
        "build_ref": { "type": "string", "pattern": "^build:[A-Za-z0-9._:/-]{1,250}$" },
        "context_id": { "$ref": "#/$defs/identifier" },
        "repository_ref": { "type": "string", "pattern": "^repository:[A-Za-z0-9._:/-]{1,245}$" },
        "revision_sha256": { "$ref": "#/$defs/digest" },
        "scope_binding_sha256": { "$ref": "#/$defs/digest" },
        "tenant_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_kind", "source_key_sha256", "target_key_sha256"],
      "properties": {
        "relation_kind": {
          "enum": ["depends_on", "built_by", "produces", "derived_from", "published_as", "deploys"]
        },
        "source_key_sha256": { "$ref": "#/$defs/digest" },
        "target_key_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "evidenceKind": {
      "enum": [
        "source_manifest",
        "dependency_manifest",
        "cicd_configuration",
        "infrastructure_as_code",
        "container_image_manifest",
        "artifact_registry_export",
        "build_provenance",
        "sbom",
        "scanner_finding"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_record_sha256s",
        "finding_id",
        "finding_kind",
        "finding_sha256",
        "priority",
        "related_key_sha256",
        "subject_key_sha256",
        "summary"
      ],
      "properties": {
        "evidence_record_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "finding_id": { "pattern": "^SCF-[0-9A-F]{32}$", "type": "string" },
        "finding_kind": {
          "enum": [
            "stale_evidence",
            "unpinned_dependency",
            "unverified_build_provenance",
            "missing_artifact_provenance",
            "cross_boundary_flow",
            "public_build_exposure"
          ]
        },
        "finding_sha256": { "$ref": "#/$defs/digest" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "related_key_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "subject_key_sha256": { "$ref": "#/$defs/digest" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure",
        "integrity_sha256",
        "node_key_sha256",
        "node_kind",
        "subject_ref",
        "trust_boundary_ref"
      ],
      "properties": {
        "exposure": { "enum": ["private", "internal", "public", "unknown"] },
        "integrity_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "node_key_sha256": { "$ref": "#/$defs/digest" },
        "node_kind": {
          "enum": [
            "source",
            "dependency",
            "pipeline",
            "infrastructure",
            "image",
            "artifact",
            "builder",
            "provenance"
          ]
        },
        "subject_ref": { "type": "string", "pattern": "^subject:[A-Za-z0-9._:/-]{1,248}$" },
        "trust_boundary_ref": { "type": "string", "pattern": "^boundary:[A-Za-z0-9._:/-]{1,247}$" }
      }
    },
    "noEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_execution",
        "credential_access",
        "network",
        "registry_contact",
        "repository_mutation"
      ],
      "properties": {
        "command_execution": { "const": "none" },
        "credential_access": { "const": "none" },
        "network": { "const": "none" },
        "registry_contact": { "const": "none" },
        "repository_mutation": { "const": "none" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapters",
        "budgets",
        "context",
        "idempotency_key_sha256",
        "no_effects",
        "plan_id",
        "plan_sha256",
        "planned_at",
        "qualification_effect",
        "schema_version",
        "valid_until"
      ],
      "properties": {
        "adapters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/adapter" }
        },
        "budgets": { "$ref": "#/$defs/budgets" },
        "context": { "$ref": "#/$defs/context" },
        "idempotency_key_sha256": { "$ref": "#/$defs/digest" },
        "no_effects": { "$ref": "#/$defs/noEffects" },
        "plan_id": { "pattern": "^SCP-[0-9A-F]{32}$", "type": "string" },
        "plan_sha256": { "$ref": "#/$defs/digest" },
        "planned_at": { "$ref": "#/$defs/timestamp" },
        "qualification_effect": { "const": "none" },
        "schema_version": { "const": 1 },
        "valid_until": { "$ref": "#/$defs/timestamp" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_sha256",
        "edges",
        "evidence_kind",
        "evidence_ref",
        "fresh_until",
        "nodes",
        "observed_at",
        "record_sha256",
        "request_sha256",
        "sequence"
      ],
      "properties": {
        "content_sha256": { "$ref": "#/$defs/digest" },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" },
          "maxItems": 100000
        },
        "evidence_kind": { "$ref": "#/$defs/evidenceKind" },
        "evidence_ref": { "type": "string", "pattern": "^evidence:[A-Za-z0-9._:/-]{1,247}$" },
        "fresh_until": { "$ref": "#/$defs/timestamp" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" },
          "maxItems": 50000
        },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "record_sha256": { "$ref": "#/$defs/digest" },
        "request_sha256": { "$ref": "#/$defs/digest" },
        "sequence": { "type": "integer", "minimum": 0 }
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
