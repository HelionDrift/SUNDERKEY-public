{
  "$defs": {
    "deliveryAttempt": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "attempt_id": { "pattern": "^DLA-[0-9A-F]{32}$", "type": "string" },
            "attempt_number": { "maximum": 32, "minimum": 1, "type": "integer" },
            "attempt_sha256": { "$ref": "#/$defs/sha256" },
            "claim_id": { "pattern": "^JCL-[0-9A-F]{32}$", "type": "string" },
            "claim_sha256": { "$ref": "#/$defs/sha256" },
            "fence_token": { "maximum": 2147483647, "minimum": 1, "type": "integer" },
            "job_id": { "pattern": "^JOB-[0-9A-F]{32}$", "type": "string" },
            "kind": { "const": "sunderkey.orchestration-delivery-attempt.v1" },
            "message_id": { "pattern": "^MSG-[0-9A-F]{32}$", "type": "string" },
            "message_sha256": { "$ref": "#/$defs/sha256" },
            "observed_at": { "$ref": "#/$defs/timestamp" },
            "outcome": {
              "enum": [
                "acknowledged_observation",
                "retryable_failure_observation",
                "permanent_failure_observation"
              ],
              "type": "string"
            },
            "remote_receipt_ref": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
            "remote_receipt_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "tenant_id": { "$ref": "#/$defs/identifier" }
          },
          "required": [
            "attempt_id",
            "attempt_number",
            "attempt_sha256",
            "claim_id",
            "claim_sha256",
            "fence_token",
            "job_id",
            "message_id",
            "message_sha256",
            "observed_at",
            "outcome",
            "remote_receipt_ref",
            "remote_receipt_sha256",
            "tenant_id"
          ],
          "type": "object"
        },
        {
          "oneOf": [
            {
              "properties": {
                "remote_receipt_ref": { "$ref": "#/$defs/identifier" },
                "remote_receipt_sha256": { "$ref": "#/$defs/sha256" }
              }
            },
            {
              "properties": {
                "outcome": {
                  "enum": ["retryable_failure_observation", "permanent_failure_observation"]
                },
                "remote_receipt_ref": { "type": "null" },
                "remote_receipt_sha256": { "type": "null" }
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "actionExecutionIntent": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "action_execute_intent_sha256": { "$ref": "#/$defs/sha256" },
            "action_execution_envelope_ref": { "$ref": "#/$defs/identifier" },
            "action_execution_envelope_sha256": { "$ref": "#/$defs/sha256" },
            "action_execution_request_id": { "pattern": "^AXR-[0-9A-F]{32}$", "type": "string" },
            "action_execution_request_sha256": { "$ref": "#/$defs/sha256" },
            "assertion_id": { "$ref": "#/$defs/identifier" },
            "assertion_sha256": { "$ref": "#/$defs/sha256" },
            "authentication_context_sha256": { "$ref": "#/$defs/sha256" },
            "authorization_expires_at": { "$ref": "#/$defs/timestamp" },
            "authorization_sha256": { "$ref": "#/$defs/sha256" },
            "available_at": { "$ref": "#/$defs/timestamp" },
            "command_sha256": { "$ref": "#/$defs/sha256" },
            "idempotency_key_sha256": { "$ref": "#/$defs/sha256" },
            "intent_id": { "pattern": "^AEI-[0-9A-F]{32}$", "type": "string" },
            "intent_sha256": { "$ref": "#/$defs/sha256" },
            "kind": { "const": "sunderkey.action-execution-intent.v1" },
            "mission_id": { "$ref": "#/$defs/identifier" },
            "receipt_id": { "pattern": "^AARX-[0-9A-F]{32}$", "type": "string" },
            "receipt_sha256": { "$ref": "#/$defs/sha256" },
            "requested_at": { "$ref": "#/$defs/timestamp" },
            "requested_by_subject_id": { "$ref": "#/$defs/identifier" },
            "source_bindings": { "$ref": "#/$defs/sourceBindings" },
            "source_bindings_sha256": { "$ref": "#/$defs/sha256" },
            "tenant_id": { "$ref": "#/$defs/identifier" }
          },
          "required": [
            "action_execute_intent_sha256", "action_execution_envelope_ref",
            "action_execution_envelope_sha256", "action_execution_request_id",
            "action_execution_request_sha256", "assertion_id", "assertion_sha256",
            "authentication_context_sha256", "authorization_expires_at",
            "authorization_sha256", "available_at", "command_sha256",
            "idempotency_key_sha256", "intent_id", "intent_sha256", "mission_id",
            "receipt_id", "receipt_sha256", "requested_at", "requested_by_subject_id",
            "source_bindings", "source_bindings_sha256", "tenant_id"
          ],
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "actionExecutionAttempt": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "action_execute_intent_sha256": { "$ref": "#/$defs/sha256" },
            "action_execution_envelope_ref": { "$ref": "#/$defs/identifier" },
            "action_execution_envelope_sha256": { "$ref": "#/$defs/sha256" },
            "action_execution_request_id": { "pattern": "^AXR-[0-9A-F]{32}$", "type": "string" },
            "action_execution_request_sha256": { "$ref": "#/$defs/sha256" },
            "assertion_id": { "$ref": "#/$defs/identifier" },
            "assertion_sha256": { "$ref": "#/$defs/sha256" },
            "attempt_id": { "pattern": "^AEA-[0-9A-F]{32}$", "type": "string" },
            "attempt_number": { "const": 1, "type": "integer" },
            "attempt_sha256": { "$ref": "#/$defs/sha256" },
            "authorization_expires_at": { "$ref": "#/$defs/timestamp" },
            "authorization_sha256": { "$ref": "#/$defs/sha256" },
            "claim_id": { "pattern": "^JCL-[0-9A-F]{32}$", "type": "string" },
            "claim_sha256": { "$ref": "#/$defs/sha256" },
            "command_sha256": { "$ref": "#/$defs/sha256" },
            "expires_at": { "$ref": "#/$defs/timestamp" },
            "intent_id": { "pattern": "^AEI-[0-9A-F]{32}$", "type": "string" },
            "intent_sha256": { "$ref": "#/$defs/sha256" },
            "job_id": { "pattern": "^JOB-[0-9A-F]{32}$", "type": "string" },
            "job_sha256": { "$ref": "#/$defs/sha256" },
            "kind": { "const": "sunderkey.action-execution-attempt.v1" },
            "message_id": { "pattern": "^MSG-[0-9A-F]{32}$", "type": "string" },
            "message_sha256": { "$ref": "#/$defs/sha256" },
            "mission_id": { "$ref": "#/$defs/identifier" },
            "receipt_id": { "pattern": "^AARX-[0-9A-F]{32}$", "type": "string" },
            "receipt_sha256": { "$ref": "#/$defs/sha256" },
            "source_bindings": { "$ref": "#/$defs/sourceBindings" },
            "source_bindings_sha256": { "$ref": "#/$defs/sha256" },
            "tenant_id": { "$ref": "#/$defs/identifier" },
            "trusted_at": { "$ref": "#/$defs/timestamp" },
            "worker_assertion_id": { "$ref": "#/$defs/identifier" },
            "worker_assertion_sha256": { "$ref": "#/$defs/sha256" },
            "worker_capability_id": { "$ref": "#/$defs/identifier" },
            "worker_capability_sha256": { "$ref": "#/$defs/sha256" },
            "worker_id": { "$ref": "#/$defs/identifier" },
            "worker_lease_id": { "$ref": "#/$defs/identifier" },
            "worker_lease_sha256": { "$ref": "#/$defs/sha256" },
            "worker_scope_id": { "$ref": "#/$defs/identifier" },
            "worker_scope_sha256": { "$ref": "#/$defs/sha256" },
            "worker_session_id": { "$ref": "#/$defs/identifier" },
            "worker_session_sha256": { "$ref": "#/$defs/sha256" },
            "worker_trust_policy_id": { "$ref": "#/$defs/identifier" },
            "worker_trust_policy_sha256": { "$ref": "#/$defs/sha256" }
          },
          "required": [
            "action_execute_intent_sha256", "action_execution_envelope_ref",
            "action_execution_envelope_sha256", "action_execution_request_id",
            "action_execution_request_sha256", "assertion_id", "assertion_sha256",
            "attempt_id", "attempt_number", "attempt_sha256", "authorization_expires_at",
            "authorization_sha256", "claim_id", "claim_sha256", "command_sha256",
            "expires_at", "intent_id", "intent_sha256", "job_id", "job_sha256",
            "message_id", "message_sha256", "mission_id", "receipt_id", "receipt_sha256",
            "source_bindings", "source_bindings_sha256", "tenant_id", "trusted_at",
            "worker_assertion_id", "worker_assertion_sha256", "worker_capability_id",
            "worker_capability_sha256", "worker_id", "worker_lease_id",
            "worker_lease_sha256", "worker_scope_id", "worker_scope_sha256",
            "worker_session_id", "worker_session_sha256", "worker_trust_policy_id",
            "worker_trust_policy_sha256"
          ],
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "actionExecutionHandoffQuarantine": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "authorization_expires_at": { "$ref": "#/$defs/timestamp" },
            "custody_effect": { "const": "not_attempted_no_action_inference" },
            "intent_id": { "pattern": "^AEI-[0-9A-F]{32}$", "type": "string" },
            "intent_sha256": { "$ref": "#/$defs/sha256" },
            "job_id": { "pattern": "^JOB-[0-9A-F]{32}$", "type": "string" },
            "job_sha256": { "$ref": "#/$defs/sha256" },
            "kind": { "const": "sunderkey.action-execution-handoff-quarantine.v1" },
            "message_id": { "pattern": "^MSG-[0-9A-F]{32}$", "type": "string" },
            "message_sha256": { "$ref": "#/$defs/sha256" },
            "quarantine_id": { "pattern": "^AEQ-[0-9A-F]{32}$", "type": "string" },
            "quarantine_sha256": { "$ref": "#/$defs/sha256" },
            "reason": { "const": "authorization_window_ineligible_before_claim" },
            "tenant_id": { "$ref": "#/$defs/identifier" },
            "trusted_at": { "$ref": "#/$defs/timestamp" }
          },
          "required": ["authorization_expires_at", "custody_effect", "intent_id",
            "intent_sha256", "job_id", "job_sha256", "message_id", "message_sha256",
            "quarantine_id", "quarantine_sha256", "reason", "tenant_id", "trusted_at"],
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "actionExecutionTerminalObservation": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "action_execution_request_id": { "pattern": "^AXR-[0-9A-F]{32}$", "type": "string" },
            "action_execution_request_sha256": { "$ref": "#/$defs/sha256" },
            "action_outcome": { "enum": ["failed", "indeterminate", "succeeded"], "type": "string" },
            "adapter_call_count": { "oneOf": [{ "minimum": 0, "maximum": 1, "type": "integer" }, { "type": "null" }] },
            "adapter_call_count_status": { "enum": ["exactly_one", "exactly_zero", "unknown_zero_or_one"], "type": "string" },
            "attempt_id": { "pattern": "^AEA-[0-9A-F]{32}$", "type": "string" },
            "attempt_sha256": { "$ref": "#/$defs/sha256" },
            "automatic_retry_count": { "const": 0, "type": "integer" },
            "claim_id": { "pattern": "^JCL-[0-9A-F]{32}$", "type": "string" },
            "claim_sha256": { "$ref": "#/$defs/sha256" },
            "cleanup_status": { "enum": ["complete", "pending", "failed", "unknown"], "type": "string" },
            "evidence_status": { "enum": ["complete", "pending", "failed", "unknown"], "type": "string" },
            "intent_id": { "pattern": "^AEI-[0-9A-F]{32}$", "type": "string" },
            "intent_sha256": { "$ref": "#/$defs/sha256" },
            "job_id": { "pattern": "^JOB-[0-9A-F]{32}$", "type": "string" },
            "job_sha256": { "$ref": "#/$defs/sha256" },
            "journal_effect": { "const": "terminal_observed_not_action_success" },
            "kind": { "const": "sunderkey.action-execution-terminal-observation.v1" },
            "message_id": { "pattern": "^MSG-[0-9A-F]{32}$", "type": "string" },
            "message_sha256": { "$ref": "#/$defs/sha256" },
            "observation_id": { "pattern": "^AEO-[0-9A-F]{32}$", "type": "string" },
            "observation_sha256": { "$ref": "#/$defs/sha256" },
            "observed_at": { "$ref": "#/$defs/timestamp" },
            "phase196_claim_id": { "$ref": "#/$defs/identifier" },
            "phase196_claim_sha256": { "$ref": "#/$defs/sha256" },
            "phase196_terminal_id": { "$ref": "#/$defs/identifier" },
            "phase196_terminal_sha256": { "$ref": "#/$defs/sha256" },
            "restoration_status": { "enum": ["complete", "pending", "failed", "unknown"], "type": "string" },
            "result_sha256": { "$ref": "#/$defs/sha256" },
            "settled_at": { "$ref": "#/$defs/timestamp" },
            "tenant_id": { "$ref": "#/$defs/identifier" },
            "terminal_status": { "enum": ["completed", "failed_known", "predispatch_aborted", "indeterminate_quarantined"], "type": "string" }
          },
          "required": ["action_execution_request_id", "action_execution_request_sha256",
            "action_outcome", "adapter_call_count", "adapter_call_count_status", "attempt_id",
            "attempt_sha256", "automatic_retry_count", "claim_id", "claim_sha256",
            "cleanup_status", "evidence_status", "intent_id", "intent_sha256", "job_id",
            "job_sha256", "journal_effect", "message_id", "message_sha256", "observation_id",
            "observation_sha256", "observed_at", "phase196_claim_id", "phase196_claim_sha256",
            "phase196_terminal_id", "phase196_terminal_sha256", "restoration_status",
            "result_sha256", "settled_at", "tenant_id", "terminal_status"],
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "actionExecutionReconciliation": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "attempt_id": { "pattern": "^AEA-[0-9A-F]{32}$", "type": "string" },
            "attempt_sha256": { "$ref": "#/$defs/sha256" },
            "authority_expires_at": { "$ref": "#/$defs/timestamp" },
            "authority_issued_at": { "$ref": "#/$defs/timestamp" },
            "claim_id": { "pattern": "^JCL-[0-9A-F]{32}$", "type": "string" },
            "claim_sha256": { "$ref": "#/$defs/sha256" },
            "intent_id": { "pattern": "^AEI-[0-9A-F]{32}$", "type": "string" },
            "intent_sha256": { "$ref": "#/$defs/sha256" },
            "job_id": { "pattern": "^JOB-[0-9A-F]{32}$", "type": "string" },
            "job_sha256": { "$ref": "#/$defs/sha256" },
            "kind": { "const": "sunderkey.action-execution-reconciliation.v1" },
            "message_id": { "pattern": "^MSG-[0-9A-F]{32}$", "type": "string" },
            "message_sha256": { "$ref": "#/$defs/sha256" },
            "phase196_terminal_id": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
            "phase196_terminal_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "reconciler_assertion_id": { "$ref": "#/$defs/identifier" },
            "reconciler_assertion_sha256": { "$ref": "#/$defs/sha256" },
            "reconciler_capability_id": { "$ref": "#/$defs/identifier" },
            "reconciler_capability_sha256": { "$ref": "#/$defs/sha256" },
            "reconciler_scope_id": { "$ref": "#/$defs/identifier" },
            "reconciler_scope_sha256": { "$ref": "#/$defs/sha256" },
            "reconciler_session_id": { "$ref": "#/$defs/identifier" },
            "reconciler_session_sha256": { "$ref": "#/$defs/sha256" },
            "reconciler_subject_id": { "$ref": "#/$defs/identifier" },
            "reconciler_trust_policy_id": { "$ref": "#/$defs/identifier" },
            "reconciler_trust_policy_sha256": { "$ref": "#/$defs/sha256" },
            "reconciliation_id": { "pattern": "^AER-[0-9A-F]{32}$", "type": "string" },
            "reconciliation_lineage_sha256": { "$ref": "#/$defs/sha256" },
            "reconciliation_sha256": { "$ref": "#/$defs/sha256" },
            "resolution_status": { "enum": ["terminal_observed", "indeterminate_quarantined"], "type": "string" },
            "resolved_at": { "$ref": "#/$defs/timestamp" },
            "tenant_id": { "$ref": "#/$defs/identifier" }
          },
          "required": ["attempt_id", "attempt_sha256", "authority_expires_at",
            "authority_issued_at", "claim_id", "claim_sha256", "intent_id",
            "intent_sha256", "job_id", "job_sha256", "message_id", "message_sha256",
            "phase196_terminal_id", "phase196_terminal_sha256", "reconciler_assertion_id",
            "reconciler_assertion_sha256", "reconciler_capability_id",
            "reconciler_capability_sha256", "reconciler_scope_id",
            "reconciler_scope_sha256", "reconciler_session_id",
            "reconciler_session_sha256", "reconciler_subject_id",
            "reconciler_trust_policy_id", "reconciler_trust_policy_sha256",
            "reconciliation_id", "reconciliation_lineage_sha256",
            "reconciliation_sha256", "resolution_status", "resolved_at", "tenant_id"],
          "type": "object"
        },
        {
          "oneOf": [
            {
              "properties": {
                "phase196_terminal_id": { "$ref": "#/$defs/identifier" },
                "phase196_terminal_sha256": { "$ref": "#/$defs/sha256" },
                "resolution_status": { "const": "terminal_observed" }
              }
            },
            {
              "properties": {
                "phase196_terminal_id": { "type": "null" },
                "phase196_terminal_sha256": { "type": "null" },
                "resolution_status": { "const": "indeterminate_quarantined" }
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "outboxDeliveryClaimCustody": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "attempt_number": { "const": 1, "type": "integer" },
            "claim_id": { "pattern": "^JCL-[0-9A-F]{32}$", "type": "string" },
            "claim_sha256": { "$ref": "#/$defs/sha256" },
            "custody_id": { "pattern": "^ODC-[0-9A-F]{32}$", "type": "string" },
            "custody_sha256": { "$ref": "#/$defs/sha256" },
            "expires_at": { "$ref": "#/$defs/timestamp" },
            "job_id": { "pattern": "^JOB-[0-9A-F]{32}$", "type": "string" },
            "job_sha256": { "$ref": "#/$defs/sha256" },
            "kind": { "const": "sunderkey.outbox-delivery-claim-custody.v1" },
            "message_id": { "pattern": "^MSG-[0-9A-F]{32}$", "type": "string" },
            "message_sha256": { "$ref": "#/$defs/sha256" },
            "tenant_id": { "$ref": "#/$defs/identifier" },
            "trusted_at": { "$ref": "#/$defs/timestamp" },
            "worker_assertion_id": { "$ref": "#/$defs/identifier" },
            "worker_assertion_sha256": { "$ref": "#/$defs/sha256" },
            "worker_capability_id": { "$ref": "#/$defs/identifier" },
            "worker_capability_sha256": { "$ref": "#/$defs/sha256" },
            "worker_id": { "$ref": "#/$defs/identifier" },
            "worker_session_id": { "$ref": "#/$defs/identifier" },
            "worker_session_sha256": { "$ref": "#/$defs/sha256" }
          },
          "required": ["attempt_number", "claim_id", "claim_sha256", "custody_id",
            "custody_sha256", "expires_at", "job_id", "job_sha256", "message_id",
            "message_sha256", "tenant_id", "trusted_at", "worker_assertion_id",
            "worker_assertion_sha256", "worker_capability_id",
            "worker_capability_sha256", "worker_id", "worker_session_id",
            "worker_session_sha256"],
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "effects": {
      "additionalProperties": false,
      "properties": {
        "action_authority": { "const": "none" },
        "authoritative_state": { "const": "unchanged" },
        "completion_inference": { "const": "forbidden" },
        "credential_access": { "const": "none" },
        "network": { "const": "none" },
        "target_interaction": { "const": "none" }
      },
      "required": [
        "action_authority",
        "authoritative_state",
        "completion_inference",
        "credential_access",
        "network",
        "target_interaction"
      ],
      "type": "object"
    },
    "identifier": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "type": "string"
    },
    "job": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "available_at": { "$ref": "#/$defs/timestamp" },
            "created_at": { "$ref": "#/$defs/timestamp" },
            "idempotency_key_sha256": { "$ref": "#/$defs/sha256" },
            "input_ref": { "$ref": "#/$defs/identifier" },
            "input_sha256": { "$ref": "#/$defs/sha256" },
            "job_id": { "pattern": "^JOB-[0-9A-F]{32}$", "type": "string" },
            "kind": { "const": "sunderkey.orchestration-job.v1" },
            "job_kind": {
              "enum": [
                "source_reconciliation",
                "projection_refresh",
                "inbox_processing",
                "outbox_delivery",
                "action_execution_handoff",
                "saga_coordination"
              ],
              "type": "string"
            },
            "job_sha256": { "$ref": "#/$defs/sha256" },
            "lease_seconds": { "maximum": 86400, "minimum": 5, "type": "integer" },
            "maximum_attempts": { "maximum": 32, "minimum": 1, "type": "integer" },
            "source_bindings": { "$ref": "#/$defs/sourceBindings" },
            "subject_ref": { "$ref": "#/$defs/identifier" },
            "tenant_id": { "$ref": "#/$defs/identifier" }
          },
          "required": [
            "available_at",
            "created_at",
            "idempotency_key_sha256",
            "input_ref",
            "input_sha256",
            "job_id",
            "job_kind",
            "job_sha256",
            "lease_seconds",
            "maximum_attempts",
            "source_bindings",
            "subject_ref",
            "tenant_id"
          ],
          "type": "object"
        },
        {
          "if": {
            "properties": {
              "job_kind": {
                "enum": ["outbox_delivery", "action_execution_handoff"]
              }
            },
            "required": ["job_kind"]
          },
          "then": {
            "properties": { "maximum_attempts": { "const": 1 } }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "jobClaim": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "attempt_number": { "maximum": 32, "minimum": 1, "type": "integer" },
            "claim_id": { "pattern": "^JCL-[0-9A-F]{32}$", "type": "string" },
            "claim_sha256": { "$ref": "#/$defs/sha256" },
            "claimed_at": { "$ref": "#/$defs/timestamp" },
            "expires_at": { "$ref": "#/$defs/timestamp" },
            "fence_token": { "maximum": 2147483647, "minimum": 1, "type": "integer" },
            "job_id": { "pattern": "^JOB-[0-9A-F]{32}$", "type": "string" },
            "job_sha256": { "$ref": "#/$defs/sha256" },
            "kind": { "const": "sunderkey.orchestration-job-claim.v1" },
            "lease_version": { "maximum": 2147483647, "minimum": 1, "type": "integer" },
            "prior_claim_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "tenant_id": { "$ref": "#/$defs/identifier" },
            "worker_id": { "$ref": "#/$defs/identifier" }
          },
          "required": [
            "attempt_number",
            "claim_id",
            "claim_sha256",
            "claimed_at",
            "expires_at",
            "fence_token",
            "job_id",
            "job_sha256",
            "lease_version",
            "prior_claim_sha256",
            "tenant_id",
            "worker_id"
          ],
          "type": "object"
        },
        {
          "if": {
            "properties": { "lease_version": { "const": 1 } },
            "required": ["lease_version"]
          },
          "then": { "properties": { "prior_claim_sha256": { "type": "null" } } },
          "else": {
            "properties": { "prior_claim_sha256": { "$ref": "#/$defs/sha256" } }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "jobOutcome": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "claim_id": { "pattern": "^JCL-[0-9A-F]{32}$", "type": "string" },
            "claim_sha256": { "$ref": "#/$defs/sha256" },
            "fence_token": { "maximum": 2147483647, "minimum": 1, "type": "integer" },
            "job_id": { "pattern": "^JOB-[0-9A-F]{32}$", "type": "string" },
            "kind": { "const": "sunderkey.orchestration-job-outcome.v1" },
            "observed_at": { "$ref": "#/$defs/timestamp" },
            "outcome_code": {
              "enum": [
                "handled_observation",
                "retryable_failure_observation",
                "permanent_failure_observation",
                "lease_exhausted_observation"
              ],
              "type": "string"
            },
            "outcome_id": { "pattern": "^JOU-[0-9A-F]{32}$", "type": "string" },
            "outcome_sha256": { "$ref": "#/$defs/sha256" },
            "result_ref": { "$ref": "#/$defs/identifier" },
            "result_sha256": { "$ref": "#/$defs/sha256" },
            "retry_available_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
            "tenant_id": { "$ref": "#/$defs/identifier" },
            "worker_id": { "$ref": "#/$defs/identifier" }
          },
          "required": [
            "claim_id",
            "claim_sha256",
            "fence_token",
            "job_id",
            "observed_at",
            "outcome_code",
            "outcome_id",
            "outcome_sha256",
            "result_ref",
            "result_sha256",
            "retry_available_at",
            "tenant_id",
            "worker_id"
          ],
          "type": "object"
        },
        {
          "if": {
            "properties": { "outcome_code": { "const": "retryable_failure_observation" } },
            "required": ["outcome_code"]
          },
          "then": {
            "properties": { "retry_available_at": { "$ref": "#/$defs/timestamp" } }
          },
          "else": { "properties": { "retry_available_at": { "type": "null" } } }
        }
      ],
      "unevaluatedProperties": false
    },
    "message": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "correlation_ref": { "$ref": "#/$defs/identifier" },
            "direction": { "enum": ["inbox", "outbox"], "type": "string" },
            "external_ref": { "$ref": "#/$defs/identifier" },
            "external_sha256": { "$ref": "#/$defs/sha256" },
            "idempotency_key_sha256": { "$ref": "#/$defs/sha256" },
            "message_id": { "pattern": "^MSG-[0-9A-F]{32}$", "type": "string" },
            "message_sha256": { "$ref": "#/$defs/sha256" },
            "kind": { "const": "sunderkey.orchestration-message.v1" },
            "recorded_at": { "$ref": "#/$defs/timestamp" },
            "source_bindings": { "$ref": "#/$defs/sourceBindings" },
            "tenant_id": { "$ref": "#/$defs/identifier" },
            "topic": {
              "enum": [
                "source_event",
                "projection_change",
                "action_execution_handoff",
                "worker_observation"
              ],
              "type": "string"
            }
          },
          "required": [
            "correlation_ref",
            "direction",
            "external_ref",
            "external_sha256",
            "idempotency_key_sha256",
            "message_id",
            "message_sha256",
            "recorded_at",
            "source_bindings",
            "tenant_id",
            "topic"
          ],
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "journalEvent": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "aggregate_id": { "$ref": "#/$defs/identifier" },
            "aggregate_type": {
              "enum": ["action_execution", "job", "message", "projection", "saga"],
              "type": "string"
            },
            "event_id": { "pattern": "^JEV-[0-9A-F]{32}$", "type": "string" },
            "event_sha256": { "$ref": "#/$defs/sha256" },
            "event_type": {
              "enum": [
                "action_execution.attempt_claimed",
                "action_execution.handoff_quarantined",
                "action_execution.intent_recorded",
                "action_execution.terminal_observed",
                "job.claimed",
                "job.claim_renewed",
                "job.lease_exhausted",
                "job.submitted",
                "job.worker_observation",
                "message.delivery_observed",
                "message.recorded",
                "projection.reconciled",
                "saga.step_recorded"
              ],
              "type": "string"
            },
            "kind": { "const": "sunderkey.orchestration-journal-event.v1" },
            "occurred_at": { "$ref": "#/$defs/timestamp" },
            "prior_event_sha256": {
              "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
            },
            "record_id": {
              "pattern": "^(?:AEA|AEI|AEO|AEQ|DLA|JCL|JOB|JOU|MSG|PRJ|SGS)-[0-9A-F]{32}$",
              "type": "string"
            },
            "record_sha256": { "$ref": "#/$defs/sha256" },
            "tenant_id": { "$ref": "#/$defs/identifier" }
          },
          "required": [
            "aggregate_id",
            "aggregate_type",
            "event_id",
            "event_sha256",
            "event_type",
            "occurred_at",
            "prior_event_sha256",
            "record_id",
            "record_sha256",
            "tenant_id"
          ],
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "metadata": {
      "properties": {
        "effects": { "$ref": "#/$defs/effects" },
        "kind": {
          "enum": [
            "sunderkey.orchestration-job.v1",
            "sunderkey.orchestration-job-claim.v1",
            "sunderkey.orchestration-job-outcome.v1",
            "sunderkey.orchestration-message.v1",
            "sunderkey.orchestration-saga-step.v1",
            "sunderkey.orchestration-delivery-attempt.v1",
            "sunderkey.orchestration-read-model-projection.v1",
            "sunderkey.orchestration-journal-event.v1"
            ,"sunderkey.action-execution-intent.v1"
            ,"sunderkey.action-execution-attempt.v1"
            ,"sunderkey.action-execution-handoff-quarantine.v1"
            ,"sunderkey.action-execution-terminal-observation.v1"
            ,"sunderkey.action-execution-reconciliation.v1"
            ,"sunderkey.outbox-delivery-claim-custody.v1"
          ],
          "type": "string"
        },
        "schema_version": { "const": 1, "type": "integer" }
      },
      "required": ["effects", "kind", "schema_version"],
      "type": "object"
    },
    "projection": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "payload": { "maxProperties": 256, "type": "object" },
            "projected_at": { "$ref": "#/$defs/timestamp" },
            "projection_id": { "pattern": "^PRJ-[0-9A-F]{32}$", "type": "string" },
            "kind": { "const": "sunderkey.orchestration-read-model-projection.v1" },
            "projection_kind": {
              "enum": [
                "mission",
                "plan",
                "expert_work",
                "review_queue",
                "action_approval",
                "action_execution",
                "finding",
                "evidence",
                "health",
                "audit"
              ],
              "type": "string"
            },
            "projection_sha256": { "$ref": "#/$defs/sha256" },
            "projection_status": { "const": "source_bound_cache_only" },
            "projection_version": { "maximum": 2147483647, "minimum": 1, "type": "integer" },
            "source_bindings": { "$ref": "#/$defs/sourceBindings" },
            "subject_ref": { "$ref": "#/$defs/identifier" },
            "tenant_id": { "$ref": "#/$defs/identifier" }
          },
          "required": [
            "payload",
            "projected_at",
            "projection_id",
            "projection_kind",
            "projection_sha256",
            "projection_status",
            "projection_version",
            "source_bindings",
            "subject_ref",
            "tenant_id"
          ],
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "sagaStep": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "properties": {
            "observation_ref": { "$ref": "#/$defs/identifier" },
            "observation_sha256": { "$ref": "#/$defs/sha256" },
            "prior_step_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "recorded_at": { "$ref": "#/$defs/timestamp" },
            "saga_id": { "$ref": "#/$defs/identifier" },
            "saga_kind": {
              "enum": [
                "mission_lifecycle",
                "expert_work",
                "review",
                "action_approval",
                "action_execution",
                "evidence_custody",
                "reconciliation"
              ],
              "type": "string"
            },
            "sequence": { "maximum": 2147483647, "minimum": 1, "type": "integer" },
            "source_bindings": { "$ref": "#/$defs/sourceBindings" },
            "kind": { "const": "sunderkey.orchestration-saga-step.v1" },
            "step_id": { "pattern": "^SGS-[0-9A-F]{32}$", "type": "string" },
            "step_sha256": { "$ref": "#/$defs/sha256" },
            "step_state": {
              "enum": ["planned", "worker_reported", "blocked_observation"],
              "type": "string"
            },
            "subject_ref": { "$ref": "#/$defs/identifier" },
            "tenant_id": { "$ref": "#/$defs/identifier" }
          },
          "required": [
            "observation_ref",
            "observation_sha256",
            "prior_step_sha256",
            "recorded_at",
            "saga_id",
            "saga_kind",
            "sequence",
            "source_bindings",
            "step_id",
            "step_sha256",
            "step_state",
            "subject_ref",
            "tenant_id"
          ],
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "sha256": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "sourceBinding": {
      "additionalProperties": false,
      "properties": {
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "source_head_sha256": { "$ref": "#/$defs/sha256" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "source_kind": {
          "enum": ["mission_store", "expert_workspace", "evidence_repository"],
          "type": "string"
        },
        "source_revision": { "maximum": 2147483647, "minimum": 0, "type": "integer" }
      },
      "required": [
        "observed_at",
        "source_head_sha256",
        "source_id",
        "source_kind",
        "source_revision"
      ],
      "type": "object"
    },
    "sourceBindings": {
      "items": { "$ref": "#/$defs/sourceBinding" },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$id": "https://schemas.sunderkey.invalid/orchestration-journal-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    { "$ref": "#/$defs/actionExecutionIntent" },
    { "$ref": "#/$defs/actionExecutionAttempt" },
    { "$ref": "#/$defs/actionExecutionHandoffQuarantine" },
    { "$ref": "#/$defs/actionExecutionTerminalObservation" },
    { "$ref": "#/$defs/actionExecutionReconciliation" },
    { "$ref": "#/$defs/outboxDeliveryClaimCustody" },
    { "$ref": "#/$defs/job" },
    { "$ref": "#/$defs/jobClaim" },
    { "$ref": "#/$defs/jobOutcome" },
    { "$ref": "#/$defs/message" },
    { "$ref": "#/$defs/sagaStep" },
    { "$ref": "#/$defs/deliveryAttempt" },
    { "$ref": "#/$defs/projection" },
    { "$ref": "#/$defs/journalEvent" }
  ],
  "title": "SUNDERKEY Phase197 Orchestration Journal Records"
}
