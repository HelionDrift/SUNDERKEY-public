{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.dev/schemas/health-state-contract-v1.schema.json",
  "title": "SUNDERKEY health-state contract version 1",
  "oneOf": [
    { "$ref": "#/$defs/probeDefinition" },
    { "$ref": "#/$defs/probeObservation" },
    { "$ref": "#/$defs/healthSnapshot" },
    { "$ref": "#/$defs/recoveryAdmission" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.]+)?$"
    },
    "reference": {
      "type": "string",
      "pattern": "^(?:tenantref|missionref|workerref|dependencyref|proberef|provenanceref|artifactref|principalref):[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_ref",
        "system_version",
        "tenant_ref",
        "worker_ref",
        "worker_version"
      ],
      "properties": {
        "mission_ref": { "$ref": "#/$defs/reference" },
        "system_version": { "$ref": "#/$defs/version" },
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "worker_ref": { "$ref": "#/$defs/reference" },
        "worker_version": { "$ref": "#/$defs/version" }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "execution",
        "health_probe",
        "network",
        "pause",
        "persistence",
        "qualification",
        "recovery",
        "resume"
      ],
      "properties": {
        "authorization": { "const": "none" },
        "execution": { "const": "none" },
        "health_probe": { "const": "none" },
        "network": { "const": "none" },
        "pause": { "const": "none" },
        "persistence": { "const": "none" },
        "qualification": { "const": "none" },
        "recovery": { "const": "none" },
        "resume": { "const": "none" }
      }
    },
    "probeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "definition_id",
        "definition_sha256",
        "dependency_ref",
        "effects",
        "failure_threshold",
        "interval_seconds",
        "issued_at",
        "kind",
        "max_age_seconds",
        "probe_kind",
        "probe_ref",
        "probe_version",
        "recovery_threshold",
        "required",
        "schema_version"
      ],
      "properties": {
        "context": { "$ref": "#/$defs/context" },
        "definition_id": { "type": "string", "pattern": "^HPD-[0-9A-F]{32}$" },
        "definition_sha256": { "$ref": "#/$defs/sha256" },
        "dependency_ref": { "$ref": "#/$defs/reference" },
        "effects": { "$ref": "#/$defs/effects" },
        "failure_threshold": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "interval_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "kind": { "const": "sunderkey.health-probe-definition.v1" },
        "max_age_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "probe_kind": { "enum": ["liveness", "readiness", "dependency", "integrity"] },
        "probe_ref": { "$ref": "#/$defs/reference" },
        "probe_version": { "$ref": "#/$defs/version" },
        "recovery_threshold": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "required": { "type": "boolean" },
        "schema_version": { "const": 1 }
      }
    },
    "probeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collected_at",
        "context",
        "definition_id",
        "definition_sha256",
        "detail_sha256",
        "effects",
        "kind",
        "observation_id",
        "observation_sha256",
        "observed_at",
        "probe_ref",
        "probe_version",
        "provenance_ref",
        "provenance_sha256",
        "schema_version",
        "sequence",
        "status"
      ],
      "properties": {
        "collected_at": { "$ref": "#/$defs/timestamp" },
        "context": { "$ref": "#/$defs/context" },
        "definition_id": { "type": "string", "pattern": "^HPD-[0-9A-F]{32}$" },
        "definition_sha256": { "$ref": "#/$defs/sha256" },
        "detail_sha256": { "$ref": "#/$defs/sha256" },
        "effects": { "$ref": "#/$defs/effects" },
        "kind": { "const": "sunderkey.health-probe-observation.v1" },
        "observation_id": { "type": "string", "pattern": "^HPO-[0-9A-F]{32}$" },
        "observation_sha256": { "$ref": "#/$defs/sha256" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "probe_ref": { "$ref": "#/$defs/reference" },
        "probe_version": { "$ref": "#/$defs/version" },
        "provenance_ref": { "$ref": "#/$defs/reference" },
        "provenance_sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": 1 },
        "sequence": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["pass", "fail", "unknown"] }
      }
    },
    "dependencyHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "definition_sha256",
        "dependency_ref",
        "failure_streak",
        "reason_codes",
        "required",
        "selected_observation_id",
        "selected_observation_sha256",
        "state",
        "success_streak"
      ],
      "properties": {
        "definition_id": { "type": "string", "pattern": "^HPD-[0-9A-F]{32}$" },
        "definition_sha256": { "$ref": "#/$defs/sha256" },
        "dependency_ref": { "$ref": "#/$defs/reference" },
        "failure_streak": { "type": "integer", "minimum": 0 },
        "reason_codes": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "required": { "type": "boolean" },
        "selected_observation_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^HPO-[0-9A-F]{32}$" }
          ]
        },
        "selected_observation_sha256": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "state": { "enum": ["healthy", "degraded", "recovering", "unhealthy", "unknown"] },
        "success_streak": { "type": "integer", "minimum": 0 }
      }
    },
    "healthSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "dependencies",
        "effects",
        "evaluated_at",
        "kind",
        "pause_causes",
        "prior_snapshot_id",
        "prior_snapshot_sha256",
        "schema_version",
        "snapshot_id",
        "snapshot_sha256",
        "state"
      ],
      "properties": {
        "context": { "$ref": "#/$defs/context" },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/dependencyHealth" }
        },
        "effects": { "$ref": "#/$defs/effects" },
        "evaluated_at": { "$ref": "#/$defs/timestamp" },
        "kind": { "const": "sunderkey.health-snapshot.v1" },
        "pause_causes": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "prior_snapshot_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^HSS-[0-9A-F]{32}$" }
          ]
        },
        "prior_snapshot_sha256": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "schema_version": { "const": 1 },
        "snapshot_id": { "type": "string", "pattern": "^HSS-[0-9A-F]{32}$" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "state": { "enum": ["healthy", "degraded", "recovering", "unhealthy", "unknown"] }
      }
    },
    "snapshotBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "snapshot_sha256"],
      "properties": {
        "snapshot_id": { "type": "string", "pattern": "^HSS-[0-9A-F]{32}$" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "recoveryAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_id",
        "admission_sha256",
        "authorization_effect",
        "blocker_codes",
        "context",
        "effects",
        "evaluated_at",
        "kind",
        "max_snapshot_age_seconds",
        "required_consecutive_healthy_snapshots",
        "schema_version",
        "snapshot_bindings",
        "status"
      ],
      "properties": {
        "admission_id": { "type": "string", "pattern": "^HRA-[0-9A-F]{32}$" },
        "admission_sha256": { "$ref": "#/$defs/sha256" },
        "authorization_effect": { "const": "none" },
        "blocker_codes": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "context": { "$ref": "#/$defs/context" },
        "effects": { "$ref": "#/$defs/effects" },
        "evaluated_at": { "$ref": "#/$defs/timestamp" },
        "kind": { "const": "sunderkey.health-execution-recovery-admission.v1" },
        "max_snapshot_age_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "required_consecutive_healthy_snapshots": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "schema_version": { "const": 1 },
        "snapshot_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/snapshotBinding" }
        },
        "status": { "enum": ["denied", "eligible_for_separate_authorization"] }
      }
    }
  }
}
