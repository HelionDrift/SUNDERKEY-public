{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/evaluation-drift-assessment-v1.schema.json",
  "title": "SUNDERKEY Evaluation Drift Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessed_at",
    "assessment_id",
    "assessment_sha256",
    "baseline_sha256",
    "candidate_id",
    "candidate_observations",
    "candidate_version",
    "cohort_sha256",
    "distribution_artifact_sha256",
    "effects",
    "metric_results",
    "mode",
    "operational_decision",
    "outcome",
    "policy_id",
    "policy_version",
    "schema_version",
    "stop_reasons"
  ],
  "properties": {
    "assessed_at": { "$ref": "#/$defs/timestamp" },
    "assessment_id": { "type": "string", "pattern": "^EDA-[0-9A-F]{32}$" },
    "assessment_sha256": { "$ref": "#/$defs/sha256" },
    "baseline_sha256": { "$ref": "#/$defs/sha256" },
    "candidate_id": { "$ref": "#/$defs/identifier" },
    "candidate_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/observation" }
    },
    "candidate_version": { "$ref": "#/$defs/version" },
    "cohort_sha256": { "$ref": "#/$defs/sha256" },
    "distribution_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "effects": { "$ref": "#/$defs/effects" },
    "metric_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/metricResult" }
    },
    "mode": { "enum": ["offline", "shadow", "canary_plan"] },
    "operational_decision": { "const": false },
    "outcome": { "enum": ["pass", "regression", "stopped"] },
    "policy_id": { "$ref": "#/$defs/identifier" },
    "policy_version": { "$ref": "#/$defs/version" },
    "schema_version": { "const": 1 },
    "stop_reasons": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "metric": {
      "enum": [
        "abstention",
        "correctness",
        "cost",
        "false_negative",
        "false_positive",
        "finding_quality",
        "latency",
        "safety"
      ]
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_sha256",
        "metric",
        "observation_id",
        "observation_sha256",
        "observed_at",
        "role",
        "sample_count",
        "source_sha256",
        "strata",
        "subject_id",
        "subject_version",
        "value_microunits"
      ],
      "properties": {
        "cohort_sha256": { "$ref": "#/$defs/sha256" },
        "metric": { "$ref": "#/$defs/metric" },
        "observation_id": { "type": "string", "pattern": "^EOB-[0-9A-F]{32}$" },
        "observation_sha256": { "$ref": "#/$defs/sha256" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "role": { "const": "candidate" },
        "sample_count": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "strata": { "$ref": "#/$defs/strata" },
        "subject_id": { "$ref": "#/$defs/identifier" },
        "subject_version": { "$ref": "#/$defs/version" },
        "value_microunits": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 }
      }
    },
    "metricResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_regression_microunits",
        "candidate_value_microunits",
        "confidence",
        "control_value_microunits",
        "disposition",
        "metric",
        "reason",
        "regression_microunits"
      ],
      "properties": {
        "allowed_regression_microunits": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 },
        "candidate_value_microunits": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 },
        "confidence": { "enum": ["minimum", "moderate", "strong"] },
        "control_value_microunits": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 },
        "disposition": { "enum": ["pass", "regression", "critical_regression"] },
        "metric": { "$ref": "#/$defs/metric" },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[ -~]+$"
        },
        "regression_microunits": {
          "type": "integer",
          "minimum": -1000000000000000,
          "maximum": 1000000000000000
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "deployment",
        "model_calls",
        "network",
        "operational_decisions",
        "provider_clients",
        "routing",
        "traffic_duplication"
      ],
      "properties": {
        "authorization": { "const": "none" },
        "deployment": { "const": "none" },
        "model_calls": { "const": "none" },
        "network": { "const": "none" },
        "operational_decisions": { "const": "none" },
        "provider_clients": { "const": "none" },
        "routing": { "const": "none" },
        "traffic_duplication": { "const": "none" }
      }
    }
  }
}
