{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-plan-replacement-preparation-v1.json",
  "title": "SUNDERKEY Prepared Collaboration Plan Replacement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preparation_id",
    "preparation_sha256",
    "prepared_at",
    "readiness",
    "authority_plan",
    "authority_upgrade",
    "expected_plan_version",
    "preparation_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "preparation_id": {"type": "string", "pattern": "^RPP-[0-9A-F]{32}$"},
    "preparation_sha256": {"$ref": "#/$defs/sha256"},
    "prepared_at": {"$ref": "#/$defs/timestamp"},
    "readiness": {
      "$ref": "https://schemas.sunderkey.dev/collaboration-plan-replacement-readiness-v1.json"
    },
    "authority_plan": {
      "$ref": "https://schemas.sunderkey.dev/collaboration-plan-replacement-authority-plan-v1.json"
    },
    "authority_upgrade": {
      "$ref": "https://schemas.sunderkey.dev/collaboration-plan-replacement-authority-upgrade-v2.json"
    },
    "expected_plan_version": {"type": "integer", "minimum": 1},
    "preparation_status": {"const": "awaiting_exact_signed_authority"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
