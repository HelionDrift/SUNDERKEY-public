{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.local/schemas/routing-request.schema.json",
  "title": "SUNDERKEY Structured Routing Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission",
    "required_capability_ids",
    "optional_capability_ids",
    "pinned_specialist_ids",
    "preferred_specialist_ids",
    "excluded_specialist_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mission": {
      "$ref": "#/$defs/missionTemplate"
    },
    "required_capability_ids": {
      "$ref": "#/$defs/requiredCapabilityIds"
    },
    "optional_capability_ids": {
      "$ref": "#/$defs/capabilityIds"
    },
    "pinned_specialist_ids": {
      "$ref": "#/$defs/profileIds"
    },
    "preferred_specialist_ids": {
      "$ref": "#/$defs/profileIds"
    },
    "excluded_specialist_ids": {
      "$ref": "#/$defs/profileIds"
    }
  },
  "$defs": {
    "asciiText": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "^[\\u0009\\u000A\\u000D\\u0020-\\u007E]+$"
        },
        {
          "pattern": "[\\u0021-\\u007E]"
        }
      ]
    },
    "missionTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mission_id",
        "objective",
        "environment",
        "max_action_tier",
        "required_evidence_level",
        "scope_reference",
        "constraints"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "mission_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
        },
        "objective": {
          "$ref": "#/$defs/asciiText"
        },
        "environment": {
          "enum": [
            "offline",
            "synthetic",
            "test",
            "production"
          ]
        },
        "max_action_tier": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4",
            "R5"
          ]
        },
        "required_evidence_level": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4"
          ]
        },
        "scope_reference": {
          "$ref": "#/$defs/asciiText"
        },
        "scope_document_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "production": {
              "type": "boolean",
              "default": false
            },
            "third_party": {
              "type": "boolean",
              "default": false
            },
            "synthetic_data_only": {
              "type": "boolean",
              "default": false
            },
            "isolated_research_range": {
              "type": "boolean",
              "default": false
            },
            "max_cell_size": {
              "type": "integer",
              "minimum": 1,
              "default": 20
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "environment": {
                "const": "production"
              }
            },
            "required": [
              "environment"
            ]
          },
          "then": {
            "properties": {
              "constraints": {
                "properties": {
                  "production": {
                    "const": true
                  }
                },
                "required": [
                  "production"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "constraints": {
                "properties": {
                  "production": {
                    "const": true
                  }
                },
                "required": [
                  "production"
                ]
              }
            },
            "required": [
              "constraints"
            ]
          },
          "then": {
            "properties": {
              "environment": {
                "const": "production"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "max_action_tier": {
                "const": "R5"
              }
            },
            "required": [
              "max_action_tier"
            ]
          },
          "then": {
            "properties": {
              "environment": {
                "const": "synthetic"
              },
              "constraints": {
                "properties": {
                  "isolated_research_range": {
                    "const": true
                  }
                },
                "required": [
                  "isolated_research_range"
                ]
              }
            }
          }
        }
      ]
    },
    "capabilityIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "requiredCapabilityIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "profileIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AOE-G[A-E]-D[0-9]{2}-S[0-9]{2}$"
      }
    }
  }
}
