{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.local/schemas/egress-proxy-contract-v1.schema.json",
  "title": "SUNDERKEY Egress Proxy Contract",
  "oneOf": [
    { "$ref": "#/$defs/egressPolicy" },
    { "$ref": "#/$defs/resolutionAttestation" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}:[A-Za-z0-9._~:/+\\-]{1,255}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "endpointRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_ip_networks",
        "allowed_methods",
        "allowed_path_prefixes",
        "host",
        "max_request_bytes",
        "max_response_bytes",
        "port",
        "rule_ref",
        "tls_spki_sha256"
      ],
      "properties": {
        "allowed_ip_networks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 43 }
        },
        "allowed_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT"] }
        },
        "allowed_path_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/" }
        },
        "host": { "type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 253 },
        "max_request_bytes": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "max_response_bytes": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "rule_ref": { "$ref": "#/$defs/reference" },
        "tls_spki_sha256": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "egressPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_disposition",
        "endpoint_rules",
        "kind",
        "maximum_resolution_age_seconds",
        "mission_ref",
        "policy_id",
        "policy_sha256",
        "policy_version",
        "redirects_allowed",
        "schema_version",
        "scope_ref",
        "tenant_ref",
        "valid_from",
        "valid_until",
        "worker_ref"
      ],
      "properties": {
        "default_disposition": { "const": "deny" },
        "endpoint_rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/endpointRule" }
        },
        "kind": { "const": "egress_policy" },
        "maximum_resolution_age_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "mission_ref": { "$ref": "#/$defs/reference" },
        "policy_id": { "type": "string", "pattern": "^EGP-[0-9A-F]{32}$" },
        "policy_sha256": { "$ref": "#/$defs/digest" },
        "policy_version": { "type": "integer", "minimum": 1 },
        "redirects_allowed": { "const": false },
        "schema_version": { "const": 1 },
        "scope_ref": { "$ref": "#/$defs/reference" },
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "valid_from": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "worker_ref": { "$ref": "#/$defs/reference" }
      }
    },
    "resolutionAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_id",
        "attestation_sha256",
        "collector_signature_ref",
        "collector_signature_sha256",
        "expires_at",
        "host",
        "kind",
        "mission_ref",
        "observed_at",
        "resolved_addresses",
        "resolver_ref",
        "schema_version",
        "tenant_ref",
        "worker_ref"
      ],
      "properties": {
        "attestation_id": { "type": "string", "pattern": "^ERA-[0-9A-F]{32}$" },
        "attestation_sha256": { "$ref": "#/$defs/digest" },
        "collector_signature_ref": { "$ref": "#/$defs/reference" },
        "collector_signature_sha256": { "$ref": "#/$defs/digest" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "host": { "type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 253 },
        "kind": { "const": "resolution_attestation" },
        "mission_ref": { "$ref": "#/$defs/reference" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "resolved_addresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 45 }
        },
        "resolver_ref": { "$ref": "#/$defs/reference" },
        "schema_version": { "const": 1 },
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "worker_ref": { "$ref": "#/$defs/reference" }
      }
    }
  }
}
