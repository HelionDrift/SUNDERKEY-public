{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/qualification-status-transition-v1.json",
  "title": "SUNDERKEY Qualification Status Transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "transition_version",
    "transition_kind",
    "policy",
    "prior_status",
    "resulting_status",
    "reason_code",
    "reason_evidence_sha256",
    "issued_at",
    "effective_at",
    "signer_id",
    "registry_effect",
    "algorithm",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "transition_id": {
      "type": "string",
      "pattern": "^QST-[0-9A-F]{32}$"
    },
    "transition_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "transition_kind": {
      "enum": [
        "suspend",
        "revoke",
        "renew",
        "reinstate"
      ]
    },
    "policy": {
      "$ref": "#/$defs/policyBinding"
    },
    "prior_status": {
      "$ref": "#/$defs/statusBinding"
    },
    "resulting_status": {
      "enum": [
        "active",
        "suspended",
        "revoked"
      ]
    },
    "reason_code": {
      "type": "string"
    },
    "reason_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "supporting_decision": {
      "$ref": "#/$defs/decisionBinding"
    },
    "reviewer_credential": {
      "$ref": "#/$defs/credentialBinding"
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "effective_at": {
      "$ref": "#/$defs/timestamp"
    },
    "signer_id": {
      "$ref": "#/$defs/identifier"
    },
    "authority_key_id": {
      "$ref": "#/$defs/identifier"
    },
    "registry_effect": {
      "const": "none"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transition_kind": {
            "const": "suspend"
          }
        }
      },
      "then": {
        "required": [
          "reviewer_credential"
        ],
        "properties": {
          "resulting_status": {
            "const": "suspended"
          },
          "reason_code": {
            "enum": [
              "evidence_integrity_concern",
              "key_compromise_suspected",
              "operational_safety",
              "policy_violation_investigation"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "supporting_decision"
              ]
            },
            {
              "required": [
                "authority_key_id"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "transition_kind": {
            "const": "revoke"
          }
        }
      },
      "then": {
        "required": [
          "authority_key_id"
        ],
        "properties": {
          "resulting_status": {
            "const": "revoked"
          },
          "reason_code": {
            "enum": [
              "confirmed_key_compromise",
              "fraudulent_evidence",
              "material_policy_violation",
              "qualification_withdrawn"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "supporting_decision"
              ]
            },
            {
              "required": [
                "reviewer_credential"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "transition_kind": {
            "const": "renew"
          }
        }
      },
      "then": {
        "required": [
          "authority_key_id",
          "supporting_decision"
        ],
        "not": {
          "required": [
            "reviewer_credential"
          ]
        },
        "properties": {
          "resulting_status": {
            "const": "active"
          },
          "reason_code": {
            "enum": [
              "material_scope_change",
              "periodic_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transition_kind": {
            "const": "reinstate"
          }
        }
      },
      "then": {
        "required": [
          "authority_key_id",
          "supporting_decision"
        ],
        "not": {
          "required": [
            "reviewer_credential"
          ]
        },
        "properties": {
          "resulting_status": {
            "const": "active"
          },
          "reason_code": {
            "enum": [
              "corrective_review_complete",
              "incident_resolved"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^AOE-G[A-E]-D[0-9]{2}-S[0-9]{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "sha256"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^QTP-[0-9A-F]{32}$"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_version",
        "candidate_artifact_sha256"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/identifier"
        },
        "candidate_version": {
          "$ref": "#/$defs/identifier"
        },
        "candidate_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "eventBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(QKD|QST)-[0-9A-F]{32}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "decisionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^QKD-[0-9A-F]{32}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "credentialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^QRC-[0-9A-F]{32}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "statusBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "candidate",
        "sequence",
        "status",
        "source_event",
        "current_review_decision",
        "qualification_valid_until",
        "changed_at"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/profileId"
        },
        "candidate": {
          "$ref": "#/$defs/candidateBinding"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "status": {
          "enum": [
            "active",
            "suspended",
            "revoked"
          ]
        },
        "source_event": {
          "$ref": "#/$defs/eventBinding"
        },
        "current_review_decision": {
          "$ref": "#/$defs/decisionBinding"
        },
        "qualification_valid_until": {
          "$ref": "#/$defs/timestamp"
        },
        "changed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
