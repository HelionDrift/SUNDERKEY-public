{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/assessment-guidance-card-v1.schema.json",
  "title": "SUNDERKEY Assessment Guidance Card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "card_sha256",
    "conflict_reasons",
    "coverage_objectives",
    "effects",
    "expires_at",
    "gap_reasons",
    "independent_review_required",
    "kind",
    "qualification_effect",
    "request",
    "request_sha256",
    "scheduler_hints",
    "schema_version"
  ],
  "properties": {
    "card_id": { "type": "string", "pattern": "^AGC-[0-9A-F]{32}$" },
    "card_sha256": { "$ref": "#/$defs/sha256" },
    "conflict_reasons": { "$ref": "#/$defs/codes" },
    "coverage_objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "items": { "$ref": "#/$defs/coverage_objective" }
    },
    "effects": { "$ref": "#/$defs/effects" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "gap_reasons": { "$ref": "#/$defs/codes" },
    "independent_review_required": { "type": "boolean" },
    "kind": { "const": "sunderkey.assessment-guidance-card.v1" },
    "qualification_effect": { "const": "none" },
    "request": { "$ref": "#/$defs/request" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "scheduler_hints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "items": { "$ref": "#/$defs/scheduler_hint" }
    },
    "schema_version": { "const": 1 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "codes": {
      "type": "array",
      "maxItems": 2048,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/code" }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9][a-z0-9.-]{0,31})?$"
    },
    "risk_tier": {
      "enum": ["low", "moderate", "high"]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack_surface_sha256",
        "context_ref",
        "scope_ref",
        "scope_sha256",
        "service_contract_sha256",
        "target_context_sha256",
        "tenant_ref",
        "world_model_sha256"
      ],
      "properties": {
        "attack_surface_sha256": { "$ref": "#/$defs/sha256" },
        "context_ref": { "$ref": "#/$defs/ref" },
        "scope_ref": { "$ref": "#/$defs/ref" },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "service_contract_sha256": { "$ref": "#/$defs/sha256" },
        "target_context_sha256": { "$ref": "#/$defs/sha256" },
        "tenant_ref": { "$ref": "#/$defs/ref" },
        "world_model_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_sha256", "coverage_weight", "goal_ref", "objective_code"],
      "properties": {
        "acceptance_sha256": { "$ref": "#/$defs/sha256" },
        "coverage_weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "goal_ref": { "$ref": "#/$defs/ref" },
        "objective_code": { "$ref": "#/$defs/code" }
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "reason_code", "subject_kind", "subject_ref"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "reason_code": { "$ref": "#/$defs/code" },
        "subject_kind": {
          "enum": [
            "goal",
            "endpoint",
            "role",
            "attack_type",
            "attack_surface_gap",
            "world_model_frontier"
          ]
        },
        "subject_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_ref",
        "endpoint_ref",
        "endpoint_sha256",
        "in_scope",
        "protected",
        "scope_ref",
        "service_contract_sha256",
        "tenant_ref"
      ],
      "properties": {
        "context_ref": { "$ref": "#/$defs/ref" },
        "endpoint_ref": { "$ref": "#/$defs/ref" },
        "endpoint_sha256": { "$ref": "#/$defs/sha256" },
        "in_scope": { "const": true },
        "protected": { "type": "boolean" },
        "scope_ref": { "$ref": "#/$defs/ref" },
        "service_contract_sha256": { "$ref": "#/$defs/sha256" },
        "tenant_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_ref", "in_scope", "role_ref", "role_sha256", "scope_ref", "tenant_ref"],
      "properties": {
        "context_ref": { "$ref": "#/$defs/ref" },
        "in_scope": { "const": true },
        "role_ref": { "$ref": "#/$defs/ref" },
        "role_sha256": { "$ref": "#/$defs/sha256" },
        "scope_ref": { "$ref": "#/$defs/ref" },
        "tenant_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "attack_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack_type_code",
        "attack_type_ref",
        "catalog_sha256",
        "catalog_version",
        "estimated_risk_points",
        "risk_tier"
      ],
      "properties": {
        "attack_type_code": { "$ref": "#/$defs/code" },
        "attack_type_ref": { "$ref": "#/$defs/ref" },
        "catalog_sha256": { "$ref": "#/$defs/sha256" },
        "catalog_version": { "$ref": "#/$defs/version" },
        "estimated_risk_points": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "risk_tier": { "$ref": "#/$defs/risk_tier" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_sha256",
        "artifact_version",
        "contains_credentials",
        "content_type",
        "executable",
        "fixture_ref"
      ],
      "properties": {
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_version": { "$ref": "#/$defs/version" },
        "contains_credentials": { "const": false },
        "content_type": { "enum": ["application/json", "application/octet-stream", "text/plain"] },
        "executable": { "const": false },
        "fixture_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_ref", "gap_ref", "gap_sha256", "reason_code", "severity"],
      "properties": {
        "context_ref": { "$ref": "#/$defs/ref" },
        "gap_ref": { "$ref": "#/$defs/ref" },
        "gap_sha256": { "$ref": "#/$defs/sha256" },
        "reason_code": { "$ref": "#/$defs/code" },
        "severity": { "$ref": "#/$defs/risk_tier" }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "context_ref", "frontier_ref", "frontier_sha256", "reason_code"],
      "properties": {
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "context_ref": { "$ref": "#/$defs/ref" },
        "frontier_ref": { "$ref": "#/$defs/ref" },
        "frontier_sha256": { "$ref": "#/$defs/sha256" },
        "reason_code": { "$ref": "#/$defs/code" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impact_ceiling",
        "max_parallelism",
        "request_budget",
        "risk_budget_points",
        "token_budget"
      ],
      "properties": {
        "impact_ceiling": { "$ref": "#/$defs/risk_tier" },
        "max_parallelism": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "request_budget": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "risk_budget_points": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "token_budget": { "type": "integer", "minimum": 0, "maximum": 100000000 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack_types",
        "binding",
        "constraints",
        "created_at",
        "custom_strategy",
        "endpoints",
        "exclusion_priorities",
        "expires_at",
        "focus_priorities",
        "frontiers",
        "gaps",
        "goals",
        "payload_fixtures",
        "roles"
      ],
      "properties": {
        "attack_types": {
          "type": "array",
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/attack_type" }
        },
        "binding": { "$ref": "#/$defs/binding" },
        "constraints": { "$ref": "#/$defs/constraints" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "custom_strategy": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^[ -~]*$"
        },
        "endpoints": {
          "type": "array",
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/endpoint" }
        },
        "exclusion_priorities": {
          "type": "array",
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/priority" }
        },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "focus_priorities": {
          "type": "array",
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/priority" }
        },
        "frontiers": {
          "type": "array",
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/frontier" }
        },
        "gaps": {
          "type": "array",
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/gap" }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/goal" }
        },
        "payload_fixtures": {
          "type": "array",
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/fixture" }
        },
        "roles": {
          "type": "array",
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/role" }
        }
      }
    },
    "coverage_objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_kind", "objective_ref", "order", "reason_codes", "subject_ref"],
      "properties": {
        "objective_kind": { "enum": ["goal", "endpoint", "role", "attack_type", "gap", "frontier"] },
        "objective_ref": { "$ref": "#/$defs/ref" },
        "order": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "reason_codes": {
          "allOf": [
            { "$ref": "#/$defs/codes" },
            { "minItems": 1 }
          ]
        },
        "subject_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "scheduler_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack_type_refs",
        "blocker_codes",
        "hint_ref",
        "objective_refs",
        "order",
        "reason_codes",
        "status",
        "subject_ref"
      ],
      "properties": {
        "attack_type_refs": {
          "type": "array",
          "maxItems": 2048,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ref" }
        },
        "blocker_codes": { "$ref": "#/$defs/codes" },
        "hint_ref": { "$ref": "#/$defs/ref" },
        "objective_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ref" }
        },
        "order": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "reason_codes": {
          "allOf": [
            { "$ref": "#/$defs/codes" },
            { "minItems": 1 }
          ]
        },
        "status": { "const": "proposal_only" },
        "subject_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "credential_access",
        "deployment",
        "discovery",
        "execution",
        "network",
        "routing",
        "scheduling",
        "target_contact"
      ],
      "properties": {
        "authorization": { "const": "none" },
        "credential_access": { "const": "none" },
        "deployment": { "const": "none" },
        "discovery": { "const": "none" },
        "execution": { "const": "none" },
        "network": { "const": "none" },
        "routing": { "const": "none" },
        "scheduling": { "const": "none" },
        "target_contact": { "const": "none" }
      }
    }
  }
}
