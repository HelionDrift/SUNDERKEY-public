{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/qualification-plan-catalog-v2.json",
  "title": "SUNDERKEY Army v2 Qualification Plan Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_catalog_id",
    "plan_catalog_version",
    "catalog_sha256",
    "qualification_standard_id",
    "qualification_standard_version",
    "qualification_standard_sha256",
    "expert_catalog_id",
    "expert_catalog_version",
    "capability_catalog_id",
    "capability_catalog_version",
    "capability_catalog_sha256",
    "vector_catalog_id",
    "vector_catalog_version",
    "vector_catalog_sha256",
    "plan_status",
    "qualification_effect",
    "profile_plans",
    "coverage_summary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "plan_catalog_id": {
      "const": "sunderkey-army-qualification-plans-v2"
    },
    "plan_catalog_version": {
      "const": "2.0.0"
    },
    "catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "qualification_standard_id": {
      "const": "sunderkey-specialist-qualification-v2"
    },
    "qualification_standard_version": {
      "const": "2.0.0"
    },
    "qualification_standard_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expert_catalog_id": {
      "const": "sunderkey-offensive-expert-army"
    },
    "expert_catalog_version": {
      "const": "2.0.0"
    },
    "capability_catalog_id": {
      "const": "sunderkey-army-capabilities-v2"
    },
    "capability_catalog_version": {
      "const": "2.0.0"
    },
    "capability_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "vector_catalog_id": {
      "const": "sunderkey-attack-vectors-v2"
    },
    "vector_catalog_version": {
      "const": "2.0.0"
    },
    "vector_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plan_status": {
      "const": "defined_unexecuted"
    },
    "qualification_effect": {
      "const": "none"
    },
    "profile_plans": {
      "type": "array",
      "minItems": 391,
      "maxItems": 391,
      "items": {
        "$ref": "#/$defs/profilePlan"
      }
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_plan_count",
        "vector_bound_plan_count",
        "plans_with_supporting_capabilities",
        "plans_with_independent_validator",
        "plans_with_cleanup_requirements",
        "plans_with_critical_failures"
      ],
      "properties": {
        "profile_plan_count": {
          "const": 391
        },
        "vector_bound_plan_count": {
          "const": 391
        },
        "plans_with_supporting_capabilities": {
          "const": 391
        },
        "plans_with_independent_validator": {
          "const": 391
        },
        "plans_with_cleanup_requirements": {
          "const": 391
        },
        "plans_with_critical_failures": {
          "const": 391
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/asciiText"
      }
    }
  },
  "$defs": {
    "asciiText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\t\\n\\r -~]*[!-~][\\t\\n\\r -~]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^AOE-(?:H[QC]|G[A-H])-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "profilePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "vector_id",
        "scenario_family_id",
        "technical_focus",
        "evaluation_objective",
        "primary_capability_ids",
        "supporting_capability_ids",
        "independent_validator_id",
        "allowed_action_tiers",
        "required_scenario_variants",
        "required_observations",
        "required_evidence",
        "cleanup_and_restoration",
        "required_gate_ids",
        "critical_failures"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/profileId"
        },
        "vector_id": {
          "type": "string",
          "pattern": "^AV-G[A-H]-D[0-9]{2}-S[0-9]{2}-01$"
        },
        "scenario_family_id": {
          "type": "string",
          "pattern": "^qualification\\.aoe-g[a-h]-d[0-9]{2}-s[0-9]{2}$"
        },
        "technical_focus": {
          "$ref": "#/$defs/asciiText"
        },
        "evaluation_objective": {
          "$ref": "#/$defs/asciiText"
        },
        "primary_capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asciiText"
          }
        },
        "supporting_capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asciiText"
          }
        },
        "independent_validator_id": {
          "$ref": "#/$defs/profileId"
        },
        "allowed_action_tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "R0",
              "R1",
              "R2",
              "R3"
            ]
          }
        },
        "required_scenario_variants": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asciiText"
          }
        },
        "required_observations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asciiText"
          }
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asciiText"
          }
        },
        "cleanup_and_restoration": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asciiText"
          }
        },
        "required_gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^qualification\\.gate\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          }
        },
        "critical_failures": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asciiText"
          }
        }
      }
    }
  }
}
