{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.dev/schemas/ai-protocol-specialist-contract-v1.schema.json",
  "title": "SUNDERKEY AI and Protocol Specialist Contract",
  "oneOf": [
    { "$ref": "#/$defs/declaration" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "reference": {
      "type": "string",
      "pattern": "^(tenantref|contextref|scoperef|modelref|toolref|corpusref|sessionref|evidenceref|budgetref|admissionref|agentref|delegationref|protocolref|fixtureref|capabilityref):[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "family": {
      "enum": [
        "ai_application",
        "agent_protocol",
        "tool_boundary",
        "retrieval",
        "model_supply_chain",
        "machine_to_machine_protocol"
      ]
    },
    "scenario": {
      "enum": [
        "prompt_context_boundary_validation",
        "tool_authorization_checks",
        "retrieval_provenance_tests",
        "indirect_instruction_resistance_scenarios",
        "agent_identity_and_delegation_checks",
        "model_artifact_provenance",
        "protocol_state_validation",
        "data_boundary_leakage_controls"
      ]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builtin_model_execution",
        "builtin_network",
        "builtin_provider_call",
        "builtin_tool_execution",
        "payload_library",
        "injected_adapter_invocation"
      ],
      "properties": {
        "builtin_model_execution": { "const": "none" },
        "builtin_network": { "const": "none" },
        "builtin_provider_call": { "const": "none" },
        "builtin_tool_execution": { "const": "none" },
        "payload_library": { "const": "none" },
        "injected_adapter_invocation": { "const": "caller_supplied_only" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_ref",
        "maximum_adapter_requests",
        "maximum_observed_bytes",
        "maximum_observed_tokens",
        "maximum_duration_seconds"
      ],
      "properties": {
        "budget_ref": { "$ref": "#/$defs/reference" },
        "maximum_adapter_requests": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maximum_observed_bytes": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "maximum_observed_tokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "maximum_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_ref",
        "context_ref",
        "context_binding_sha256",
        "scope_ref",
        "scope_sha256",
        "model_ref",
        "model_sha256",
        "tool_policy_ref",
        "tool_policy_sha256",
        "corpus_ref",
        "corpus_sha256",
        "session_ref",
        "agent_identity_ref",
        "agent_identity_sha256",
        "delegation_ref",
        "delegation_sha256",
        "protocol_ref",
        "protocol_state_sha256",
        "evidence_plan_ref",
        "evidence_plan_sha256",
        "action_admission_ref",
        "action_admission_sha256",
        "budget",
        "budget_sha256"
      ],
      "properties": {
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "context_ref": { "$ref": "#/$defs/reference" },
        "context_binding_sha256": { "$ref": "#/$defs/sha256" },
        "scope_ref": { "$ref": "#/$defs/reference" },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "model_ref": { "$ref": "#/$defs/reference" },
        "model_sha256": { "$ref": "#/$defs/sha256" },
        "tool_policy_ref": { "$ref": "#/$defs/reference" },
        "tool_policy_sha256": { "$ref": "#/$defs/sha256" },
        "corpus_ref": { "$ref": "#/$defs/reference" },
        "corpus_sha256": { "$ref": "#/$defs/sha256" },
        "session_ref": { "$ref": "#/$defs/reference" },
        "agent_identity_ref": { "$ref": "#/$defs/reference" },
        "agent_identity_sha256": { "$ref": "#/$defs/sha256" },
        "delegation_ref": { "$ref": "#/$defs/reference" },
        "delegation_sha256": { "$ref": "#/$defs/sha256" },
        "protocol_ref": { "$ref": "#/$defs/reference" },
        "protocol_state_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_plan_ref": { "$ref": "#/$defs/reference" },
        "evidence_plan_sha256": { "$ref": "#/$defs/sha256" },
        "action_admission_ref": { "$ref": "#/$defs/reference" },
        "action_admission_sha256": { "$ref": "#/$defs/sha256" },
        "budget": { "$ref": "#/$defs/budget" },
        "budget_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_ref",
        "fixture_manifest_sha256",
        "synthetic",
        "contains_real_credentials",
        "contains_live_target_data",
        "contains_harmful_payload_body"
      ],
      "properties": {
        "fixture_ref": { "$ref": "#/$defs/reference" },
        "fixture_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "synthetic": { "const": true },
        "contains_real_credentials": { "const": false },
        "contains_live_target_data": { "const": false },
        "contains_harmful_payload_body": { "const": false }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_id",
        "declaration_sha256",
        "kind",
        "schema_version",
        "boundary_effects",
        "family",
        "capability_ref",
        "scenarios",
        "fixture_policy",
        "qualification_effect"
      ],
      "properties": {
        "declaration_id": { "type": "string", "pattern": "^APD-[0-9A-F]{32}$" },
        "declaration_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "ai_protocol_specialist_capability_declaration" },
        "schema_version": { "const": 1 },
        "boundary_effects": { "$ref": "#/$defs/effects" },
        "family": { "$ref": "#/$defs/family" },
        "capability_ref": { "$ref": "#/$defs/reference" },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scenario" }
        },
        "fixture_policy": { "const": "safe_synthetic_only" },
        "qualification_effect": { "const": "none" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_sha256",
        "kind",
        "schema_version",
        "boundary_effects",
        "declaration_id",
        "declaration_sha256",
        "family",
        "capability_ref",
        "scenario",
        "context",
        "assessment_context_sha256",
        "fixture",
        "fixture_sha256",
        "expected_control_sha256",
        "estimated_adapter_requests",
        "estimated_observed_bytes",
        "estimated_observed_tokens",
        "estimated_duration_seconds",
        "idempotency_sha256",
        "issued_at",
        "expires_at",
        "qualification_effect"
      ],
      "properties": {
        "request_id": { "type": "string", "pattern": "^APR-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "ai_protocol_specialist_assessment_request" },
        "schema_version": { "const": 1 },
        "boundary_effects": { "$ref": "#/$defs/effects" },
        "declaration_id": { "type": "string", "pattern": "^APD-[0-9A-F]{32}$" },
        "declaration_sha256": { "$ref": "#/$defs/sha256" },
        "family": { "$ref": "#/$defs/family" },
        "capability_ref": { "$ref": "#/$defs/reference" },
        "scenario": { "$ref": "#/$defs/scenario" },
        "context": { "$ref": "#/$defs/context" },
        "assessment_context_sha256": { "$ref": "#/$defs/sha256" },
        "fixture": { "$ref": "#/$defs/fixture" },
        "fixture_sha256": { "$ref": "#/$defs/sha256" },
        "expected_control_sha256": { "$ref": "#/$defs/sha256" },
        "estimated_adapter_requests": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "estimated_observed_bytes": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "estimated_observed_tokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "estimated_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "idempotency_sha256": { "$ref": "#/$defs/sha256" },
        "issued_at": { "$ref": "#/$defs/utc" },
        "expires_at": { "$ref": "#/$defs/utc" },
        "qualification_effect": { "const": "none" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_sha256",
        "assessment_context_sha256",
        "fixture_sha256",
        "disposition",
        "outcome",
        "evidence_sha256",
        "actual_adapter_requests",
        "actual_observed_bytes",
        "actual_observed_tokens",
        "actual_duration_seconds",
        "network_call_performed",
        "provider_call_performed",
        "model_execution_performed",
        "tool_execution_performed",
        "raw_secret_observed",
        "live_target_data_observed",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "request_id": { "type": "string", "pattern": "^APR-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "assessment_context_sha256": { "$ref": "#/$defs/sha256" },
        "fixture_sha256": { "$ref": "#/$defs/sha256" },
        "disposition": { "enum": ["completed", "denied", "failed"] },
        "outcome": { "enum": ["pass", "control_gap", "inconclusive"] },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "actual_adapter_requests": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "actual_observed_bytes": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "actual_observed_tokens": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "actual_duration_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "network_call_performed": { "const": false },
        "provider_call_performed": { "const": false },
        "model_execution_performed": { "const": false },
        "tool_execution_performed": { "const": false },
        "raw_secret_observed": { "const": false },
        "live_target_data_observed": { "const": false },
        "started_at": { "$ref": "#/$defs/utc" },
        "completed_at": { "$ref": "#/$defs/utc" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_sha256",
        "kind",
        "schema_version",
        "boundary_effects",
        "request_id",
        "request_sha256",
        "declaration_id",
        "declaration_sha256",
        "family",
        "capability_ref",
        "scenario",
        "assessment_context_sha256",
        "fixture_sha256",
        "idempotency_sha256",
        "observation",
        "status",
        "qualification_effect"
      ],
      "properties": {
        "receipt_id": { "type": "string", "pattern": "^APC-[0-9A-F]{32}$" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "ai_protocol_specialist_assessment_receipt" },
        "schema_version": { "const": 1 },
        "boundary_effects": { "$ref": "#/$defs/effects" },
        "request_id": { "type": "string", "pattern": "^APR-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "declaration_id": { "type": "string", "pattern": "^APD-[0-9A-F]{32}$" },
        "declaration_sha256": { "$ref": "#/$defs/sha256" },
        "family": { "$ref": "#/$defs/family" },
        "capability_ref": { "$ref": "#/$defs/reference" },
        "scenario": { "$ref": "#/$defs/scenario" },
        "assessment_context_sha256": { "$ref": "#/$defs/sha256" },
        "fixture_sha256": { "$ref": "#/$defs/sha256" },
        "idempotency_sha256": { "$ref": "#/$defs/sha256" },
        "observation": { "$ref": "#/$defs/observation" },
        "status": { "enum": ["completed", "denied", "failed"] },
        "qualification_effect": { "const": "none" }
      }
    }
  }
}
