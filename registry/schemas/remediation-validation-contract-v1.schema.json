{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.dev/schemas/remediation-validation-contract-v1.schema.json",
  "title": "SUNDERKEY remediation planning and validation contract version 1",
  "oneOf": [
    { "$ref": "#/$defs/context" },
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/retestPlan" },
    { "$ref": "#/$defs/observation" },
    { "$ref": "#/$defs/exception" },
    { "$ref": "#/$defs/decision" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reference": {
      "type": "string",
      "pattern": "^(?:tenantref|assessmentref|findingref|pathref|evidenceref|itemref|controlref|principalref|handoffref|actionref|cleanupref|rollbackref|gateref|exceptionref|idemref):[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "contextId": { "type": "string", "pattern": "^RMC-[0-9A-F]{32}$" },
    "planId": { "type": "string", "pattern": "^RMP-[0-9A-F]{32}$" },
    "retestPlanId": { "type": "string", "pattern": "^RTP-[0-9A-F]{32}$" },
    "observationId": { "type": "string", "pattern": "^RTO-[0-9A-F]{32}$" },
    "exceptionId": { "type": "string", "pattern": "^REX-[0-9A-F]{32}$" },
    "decisionId": { "type": "string", "pattern": "^RCD-[0-9A-F]{32}$" },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "integration",
        "network",
        "persistence",
        "qualification",
        "target_execution",
        "ticketing"
      ],
      "properties": {
        "authorization": { "const": "none" },
        "integration": { "const": "none" },
        "network": { "const": "none" },
        "persistence": { "const": "none" },
        "qualification": { "const": "none" },
        "target_execution": { "const": "none" },
        "ticketing": { "const": "none" }
      }
    },
    "referenceArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "optionalReferenceArray": {
      "type": "array",
      "maxItems": 2048,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "digestArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "optionalDigestArray": {
      "type": "array",
      "maxItems": 2048,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_ref",
        "assessment_sha256",
        "attack_paths_sha256",
        "context_id",
        "context_sha256",
        "evidence_bundle_sha256",
        "expires_at",
        "findings_sha256",
        "kind",
        "observed_at",
        "schema_version",
        "scope_sha256",
        "tenant_ref",
        "tenant_sha256",
        "world_sha256"
      ],
      "properties": {
        "assessment_ref": { "$ref": "#/$defs/reference" },
        "assessment_sha256": { "$ref": "#/$defs/sha256" },
        "attack_paths_sha256": { "$ref": "#/$defs/sha256" },
        "context_id": { "$ref": "#/$defs/contextId" },
        "context_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "findings_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "sunderkey.remediation-context.v1" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "schema_version": { "const": 1 },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "tenant_sha256": { "$ref": "#/$defs/sha256" },
        "world_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_sha256",
        "attack_path_refs",
        "cleanup_ref",
        "cleanup_sha256",
        "dependency_refs",
        "effort_points",
        "evidence_digests",
        "finding_refs",
        "inherent_risk_points",
        "item_ref",
        "owner_ref",
        "priority_score",
        "residual_risk_points",
        "risk_reduction_points",
        "rollback_ref",
        "rollback_sha256"
      ],
      "properties": {
        "action_sha256": { "$ref": "#/$defs/sha256" },
        "attack_path_refs": { "$ref": "#/$defs/referenceArray" },
        "cleanup_ref": { "$ref": "#/$defs/reference" },
        "cleanup_sha256": { "$ref": "#/$defs/sha256" },
        "dependency_refs": { "$ref": "#/$defs/optionalReferenceArray" },
        "effort_points": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "evidence_digests": { "$ref": "#/$defs/digestArray" },
        "finding_refs": { "$ref": "#/$defs/referenceArray" },
        "inherent_risk_points": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "item_ref": { "$ref": "#/$defs/reference" },
        "owner_ref": { "$ref": "#/$defs/reference" },
        "priority_score": { "type": "integer", "minimum": 1, "maximum": 1000000000000 },
        "residual_risk_points": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "risk_reduction_points": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "rollback_ref": { "$ref": "#/$defs/reference" },
        "rollback_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_ref",
        "control_sha256",
        "evidence_digests",
        "expected_risk_reduction_points",
        "expires_at",
        "item_refs",
        "owner_ref"
      ],
      "properties": {
        "control_ref": { "$ref": "#/$defs/reference" },
        "control_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_digests": { "$ref": "#/$defs/digestArray" },
        "expected_risk_reduction_points": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "item_refs": { "$ref": "#/$defs/referenceArray" },
        "owner_ref": { "$ref": "#/$defs/reference" }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_evidence_sha256",
        "accepted_at",
        "from_owner_ref",
        "handoff_ref",
        "item_refs",
        "to_owner_ref"
      ],
      "properties": {
        "acceptance_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "accepted_at": { "$ref": "#/$defs/timestamp" },
        "from_owner_ref": { "$ref": "#/$defs/reference" },
        "handoff_ref": { "$ref": "#/$defs/reference" },
        "item_refs": { "$ref": "#/$defs/referenceArray" },
        "to_owner_ref": { "$ref": "#/$defs/reference" }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_refs",
        "item_refs",
        "owner_refs",
        "priority_score",
        "risk_reduction_points",
        "sequence"
      ],
      "properties": {
        "dependency_refs": { "$ref": "#/$defs/optionalReferenceArray" },
        "item_refs": { "$ref": "#/$defs/referenceArray" },
        "owner_refs": { "$ref": "#/$defs/referenceArray" },
        "priority_score": { "type": "integer", "minimum": 1, "maximum": 1000000000000 },
        "risk_reduction_points": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 2048 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batches",
        "compensating_controls",
        "context_id",
        "context_sha256",
        "created_at",
        "effects",
        "expires_at",
        "idempotency_key",
        "items",
        "kind",
        "ownership_handoffs",
        "plan_id",
        "plan_sha256",
        "proposed_by",
        "schema_version"
      ],
      "properties": {
        "batches": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "$ref": "#/$defs/batch" } },
        "compensating_controls": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "$ref": "#/$defs/control" } },
        "context_id": { "$ref": "#/$defs/contextId" },
        "context_sha256": { "$ref": "#/$defs/sha256" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "effects": { "$ref": "#/$defs/effects" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "idempotency_key": { "$ref": "#/$defs/reference" },
        "items": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "$ref": "#/$defs/item" } },
        "kind": { "const": "sunderkey.remediation-plan.v1" },
        "ownership_handoffs": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "$ref": "#/$defs/handoff" } },
        "plan_id": { "$ref": "#/$defs/planId" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "proposed_by": { "$ref": "#/$defs/reference" },
        "schema_version": { "const": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_code", "gate_ref", "gate_sha256", "item_refs", "required_evidence_digests"],
      "properties": {
        "failure_code": { "$ref": "#/$defs/code" },
        "gate_ref": { "$ref": "#/$defs/reference" },
        "gate_sha256": { "$ref": "#/$defs/sha256" },
        "item_refs": { "$ref": "#/$defs/referenceArray" },
        "required_evidence_digests": { "$ref": "#/$defs/digestArray" }
      }
    },
    "retestPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanup_evidence_digests",
        "context_id",
        "context_sha256",
        "created_at",
        "effects",
        "expires_at",
        "gates",
        "idempotency_key",
        "item_refs",
        "kind",
        "proposed_by",
        "remediation_plan_id",
        "remediation_plan_sha256",
        "retest_plan_id",
        "retest_plan_sha256",
        "rollback_evidence_digests",
        "schema_version"
      ],
      "properties": {
        "cleanup_evidence_digests": { "$ref": "#/$defs/digestArray" },
        "context_id": { "$ref": "#/$defs/contextId" },
        "context_sha256": { "$ref": "#/$defs/sha256" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "effects": { "$ref": "#/$defs/effects" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "gates": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "$ref": "#/$defs/gate" } },
        "idempotency_key": { "$ref": "#/$defs/reference" },
        "item_refs": { "$ref": "#/$defs/referenceArray" },
        "kind": { "const": "sunderkey.remediation-retest-plan.v1" },
        "proposed_by": { "$ref": "#/$defs/reference" },
        "remediation_plan_id": { "$ref": "#/$defs/planId" },
        "remediation_plan_sha256": { "$ref": "#/$defs/sha256" },
        "retest_plan_id": { "$ref": "#/$defs/retestPlanId" },
        "retest_plan_sha256": { "$ref": "#/$defs/sha256" },
        "rollback_evidence_digests": { "$ref": "#/$defs/digestArray" },
        "schema_version": { "const": 1 }
      }
    },
    "gateObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "evidence_digests", "gate_ref", "reason_code"],
      "properties": {
        "disposition": { "enum": ["pass", "fail", "inconclusive", "not_observed"] },
        "evidence_digests": { "$ref": "#/$defs/optionalDigestArray" },
        "gate_ref": { "$ref": "#/$defs/reference" },
        "reason_code": { "$ref": "#/$defs/code" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanup_evidence_digests",
        "context_id",
        "context_sha256",
        "effects",
        "gate_observations",
        "kind",
        "observation_id",
        "observation_sha256",
        "observed_at",
        "observed_by",
        "remediation_plan_id",
        "remediation_plan_sha256",
        "retest_plan_id",
        "retest_plan_sha256",
        "rollback_evidence_digests",
        "schema_version"
      ],
      "properties": {
        "cleanup_evidence_digests": { "$ref": "#/$defs/optionalDigestArray" },
        "context_id": { "$ref": "#/$defs/contextId" },
        "context_sha256": { "$ref": "#/$defs/sha256" },
        "effects": { "$ref": "#/$defs/effects" },
        "gate_observations": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "$ref": "#/$defs/gateObservation" } },
        "kind": { "const": "sunderkey.remediation-retest-observation.v1" },
        "observation_id": { "$ref": "#/$defs/observationId" },
        "observation_sha256": { "$ref": "#/$defs/sha256" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "observed_by": { "$ref": "#/$defs/reference" },
        "remediation_plan_id": { "$ref": "#/$defs/planId" },
        "remediation_plan_sha256": { "$ref": "#/$defs/sha256" },
        "retest_plan_id": { "$ref": "#/$defs/retestPlanId" },
        "retest_plan_sha256": { "$ref": "#/$defs/sha256" },
        "rollback_evidence_digests": { "$ref": "#/$defs/optionalDigestArray" },
        "schema_version": { "const": 1 }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_at",
        "approved_by",
        "context_id",
        "context_sha256",
        "control_refs",
        "effects",
        "exception_id",
        "exception_ref",
        "exception_sha256",
        "expires_at",
        "item_refs",
        "kind",
        "rationale_code",
        "remediation_plan_id",
        "remediation_plan_sha256",
        "requested_by",
        "schema_version"
      ],
      "properties": {
        "approved_at": { "$ref": "#/$defs/timestamp" },
        "approved_by": { "$ref": "#/$defs/reference" },
        "context_id": { "$ref": "#/$defs/contextId" },
        "context_sha256": { "$ref": "#/$defs/sha256" },
        "control_refs": { "$ref": "#/$defs/referenceArray" },
        "effects": { "$ref": "#/$defs/effects" },
        "exception_id": { "$ref": "#/$defs/exceptionId" },
        "exception_ref": { "$ref": "#/$defs/reference" },
        "exception_sha256": { "$ref": "#/$defs/sha256" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "item_refs": { "$ref": "#/$defs/referenceArray" },
        "kind": { "const": "sunderkey.remediation-risk-exception.v1" },
        "rationale_code": { "$ref": "#/$defs/code" },
        "remediation_plan_id": { "$ref": "#/$defs/planId" },
        "remediation_plan_sha256": { "$ref": "#/$defs/sha256" },
        "requested_by": { "$ref": "#/$defs/reference" },
        "schema_version": { "const": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "context_sha256",
        "decision_id",
        "decision_sha256",
        "disposition",
        "effects",
        "exception_id",
        "exception_sha256",
        "idempotency_key",
        "kind",
        "observation_id",
        "observation_sha256",
        "reason_codes",
        "remediation_plan_id",
        "remediation_plan_sha256",
        "retest_plan_id",
        "retest_plan_sha256",
        "reviewed_at",
        "reviewer_ref",
        "schema_version"
      ],
      "properties": {
        "context_id": { "$ref": "#/$defs/contextId" },
        "context_sha256": { "$ref": "#/$defs/sha256" },
        "decision_id": { "$ref": "#/$defs/decisionId" },
        "decision_sha256": { "$ref": "#/$defs/sha256" },
        "disposition": { "enum": ["closed_nonqualified", "open", "exception_active_nonqualified"] },
        "effects": { "$ref": "#/$defs/effects" },
        "exception_id": { "oneOf": [{ "$ref": "#/$defs/exceptionId" }, { "type": "null" }] },
        "exception_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "idempotency_key": { "$ref": "#/$defs/reference" },
        "kind": { "const": "sunderkey.remediation-closure-decision.v1" },
        "observation_id": { "$ref": "#/$defs/observationId" },
        "observation_sha256": { "$ref": "#/$defs/sha256" },
        "reason_codes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/code" } },
        "remediation_plan_id": { "$ref": "#/$defs/planId" },
        "remediation_plan_sha256": { "$ref": "#/$defs/sha256" },
        "retest_plan_id": { "$ref": "#/$defs/retestPlanId" },
        "retest_plan_sha256": { "$ref": "#/$defs/sha256" },
        "reviewed_at": { "$ref": "#/$defs/timestamp" },
        "reviewer_ref": { "$ref": "#/$defs/reference" },
        "schema_version": { "const": 1 }
      }
    }
  }
}
