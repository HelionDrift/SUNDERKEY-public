{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/regional-custody-contract-v1.schema.json",
  "title": "SUNDERKEY regional custody contracts v1",
  "oneOf": [
    {"$ref": "#/$defs/tenantRegionBinding"},
    {"$ref": "#/$defs/artifactCustodyDescriptor"},
    {"$ref": "#/$defs/crossRegionTransferRequest"},
    {"$ref": "#/$defs/retentionSchedule"},
    {"$ref": "#/$defs/custodyHold"},
    {"$ref": "#/$defs/deletionEligibilityPlan"},
    {"$ref": "#/$defs/operationAdmissionDecision"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.]+)?$"},
    "region": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "reference": {
      "type": "string",
      "pattern": "^(tenantref|artifactref|evidenceref|scoperef|policyref|keyref|approvalref|principalref|roleref|legalbasisref|scheduleref|holdref|authorityref|operationref):[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization", "deletion", "encryption_key_access", "network", "persistence", "qualification", "storage", "transfer"],
      "properties": {
        "authorization": {"const": "none"},
        "deletion": {"const": "none"},
        "encryption_key_access": {"const": "none"},
        "network": {"const": "none"},
        "persistence": {"const": "none"},
        "qualification": {"const": "none"},
        "storage": {"const": "none"},
        "transfer": {"const": "none"}
      }
    },
    "tenantRegionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_processing_regions", "allowed_storage_regions", "binding_id", "binding_sha256", "effects", "effective_at", "encryption_key_ref", "home_region", "kind", "policy_ref", "policy_sha256", "policy_version", "schema_version", "tenant_ref"],
      "properties": {
        "allowed_processing_regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/region"}},
        "allowed_storage_regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/region"}},
        "binding_id": {"type": "string", "pattern": "^TRB-[0-9A-F]{32}$"},
        "binding_sha256": {"$ref": "#/$defs/sha256"},
        "effects": {"$ref": "#/$defs/effects"},
        "effective_at": {"$ref": "#/$defs/timestamp"},
        "encryption_key_ref": {"$ref": "#/$defs/reference"},
        "home_region": {"$ref": "#/$defs/region"},
        "kind": {"const": "sunderkey.tenant-region-binding.v1"},
        "policy_ref": {"$ref": "#/$defs/reference"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "policy_version": {"$ref": "#/$defs/version"},
        "schema_version": {"const": 1},
        "tenant_ref": {"$ref": "#/$defs/reference"}
      }
    },
    "artifactCustodyDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_sha256", "captured_at", "classification", "descriptor_id", "descriptor_sha256", "effects", "encryption_key_ref", "evidence_ref", "evidence_sha256", "kind", "policy_ref", "policy_sha256", "policy_version", "processing_region", "retention_schedule_ref", "retention_schedule_version", "schema_version", "scope_ref", "scope_sha256", "storage_region", "tenant_ref"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/reference"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "captured_at": {"$ref": "#/$defs/timestamp"},
        "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "descriptor_id": {"type": "string", "pattern": "^ACD-[0-9A-F]{32}$"},
        "descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "effects": {"$ref": "#/$defs/effects"},
        "encryption_key_ref": {"$ref": "#/$defs/reference"},
        "evidence_ref": {"$ref": "#/$defs/reference"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"const": "sunderkey.artifact-custody-descriptor.v1"},
        "policy_ref": {"$ref": "#/$defs/reference"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "policy_version": {"$ref": "#/$defs/version"},
        "processing_region": {"$ref": "#/$defs/region"},
        "retention_schedule_ref": {"$ref": "#/$defs/reference"},
        "retention_schedule_version": {"$ref": "#/$defs/version"},
        "schema_version": {"const": 1},
        "scope_ref": {"$ref": "#/$defs/reference"},
        "scope_sha256": {"$ref": "#/$defs/sha256"},
        "storage_region": {"$ref": "#/$defs/region"},
        "tenant_ref": {"$ref": "#/$defs/reference"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_ref", "approved_at", "principal_ref", "role_ref"],
      "properties": {
        "approval_ref": {"$ref": "#/$defs/reference"},
        "approved_at": {"$ref": "#/$defs/timestamp"},
        "principal_ref": {"$ref": "#/$defs/reference"},
        "role_ref": {"enum": ["roleref:independent-assurance", "roleref:independent-control"]}
      }
    },
    "crossRegionTransferRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvals", "artifact_ref", "artifact_sha256", "destination_region", "effects", "evidence_ref", "evidence_sha256", "execution_status", "kind", "legal_basis_ref", "policy_ref", "policy_sha256", "policy_version", "purpose", "request_id", "request_sha256", "requested_at", "schema_version", "scope_ref", "scope_sha256", "source_region", "tenant_ref"],
      "properties": {
        "approvals": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/approval"}},
        "artifact_ref": {"$ref": "#/$defs/reference"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "destination_region": {"$ref": "#/$defs/region"},
        "effects": {"$ref": "#/$defs/effects"},
        "evidence_ref": {"$ref": "#/$defs/reference"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "execution_status": {"const": "planned_only"},
        "kind": {"const": "sunderkey.cross-region-transfer-request.v1"},
        "legal_basis_ref": {"$ref": "#/$defs/reference"},
        "policy_ref": {"$ref": "#/$defs/reference"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "policy_version": {"$ref": "#/$defs/version"},
        "purpose": {"enum": ["storage", "processing"]},
        "request_id": {"type": "string", "pattern": "^CRT-[0-9A-F]{32}$"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "requested_at": {"$ref": "#/$defs/timestamp"},
        "schema_version": {"const": 1},
        "scope_ref": {"$ref": "#/$defs/reference"},
        "scope_sha256": {"$ref": "#/$defs/sha256"},
        "source_region": {"$ref": "#/$defs/region"},
        "tenant_ref": {"$ref": "#/$defs/reference"}
      }
    },
    "retentionSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "deletion_grace_days", "effects", "effective_at", "kind", "policy_ref", "policy_sha256", "policy_version", "required_minimum_days", "retention_days", "schedule_id", "schedule_ref", "schedule_sha256", "schedule_version", "schema_version", "tenant_ref"],
      "properties": {
        "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "deletion_grace_days": {"type": "integer", "minimum": 0, "maximum": 3650},
        "effects": {"$ref": "#/$defs/effects"},
        "effective_at": {"$ref": "#/$defs/timestamp"},
        "kind": {"const": "sunderkey.retention-schedule.v1"},
        "policy_ref": {"$ref": "#/$defs/reference"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "policy_version": {"$ref": "#/$defs/version"},
        "required_minimum_days": {"type": "integer", "minimum": 1, "maximum": 36500},
        "retention_days": {"type": "integer", "minimum": 1, "maximum": 36500},
        "schedule_id": {"type": "string", "pattern": "^RSC-[0-9A-F]{32}$"},
        "schedule_ref": {"$ref": "#/$defs/reference"},
        "schedule_sha256": {"$ref": "#/$defs/sha256"},
        "schedule_version": {"$ref": "#/$defs/version"},
        "schema_version": {"const": 1},
        "tenant_ref": {"$ref": "#/$defs/reference"}
      }
    },
    "custodyHold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_sha256", "authority_ref", "effects", "evidence_ref", "evidence_sha256", "hold_id", "hold_kind", "hold_ref", "hold_sha256", "kind", "placed_at", "policy_ref", "policy_sha256", "policy_version", "released_at", "schema_version", "scope_ref", "scope_sha256", "status", "tenant_ref"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/reference"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "authority_ref": {"$ref": "#/$defs/reference"},
        "effects": {"$ref": "#/$defs/effects"},
        "evidence_ref": {"$ref": "#/$defs/reference"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "hold_id": {"type": "string", "pattern": "^HLD-[0-9A-F]{32}$"},
        "hold_kind": {"enum": ["litigation", "incident", "regulatory"]},
        "hold_ref": {"$ref": "#/$defs/reference"},
        "hold_sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"const": "sunderkey.custody-hold.v1"},
        "placed_at": {"$ref": "#/$defs/timestamp"},
        "policy_ref": {"$ref": "#/$defs/reference"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "policy_version": {"$ref": "#/$defs/version"},
        "released_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "schema_version": {"const": 1},
        "scope_ref": {"$ref": "#/$defs/reference"},
        "scope_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["active", "released"]},
        "tenant_ref": {"$ref": "#/$defs/reference"}
      }
    },
    "deletionEligibilityPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_hold_ids", "artifact_ref", "artifact_sha256", "blocker_codes", "effects", "evaluated_at", "evidence_ref", "evidence_sha256", "execution_status", "kind", "plan_id", "plan_sha256", "policy_ref", "policy_sha256", "policy_version", "retention_expires_at", "schedule_id", "schedule_sha256", "schema_version", "scope_ref", "scope_sha256", "status", "tenant_ref"],
      "properties": {
        "active_hold_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^HLD-[0-9A-F]{32}$"}},
        "artifact_ref": {"$ref": "#/$defs/reference"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "blocker_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
        "effects": {"$ref": "#/$defs/effects"},
        "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "evidence_ref": {"$ref": "#/$defs/reference"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "execution_status": {"const": "planned_only"},
        "kind": {"const": "sunderkey.deletion-eligibility-plan.v1"},
        "plan_id": {"type": "string", "pattern": "^DEP-[0-9A-F]{32}$"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "policy_ref": {"$ref": "#/$defs/reference"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "policy_version": {"$ref": "#/$defs/version"},
        "retention_expires_at": {"$ref": "#/$defs/timestamp"},
        "schedule_id": {"type": "string", "pattern": "^RSC-[0-9A-F]{32}$"},
        "schedule_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": 1},
        "scope_ref": {"$ref": "#/$defs/reference"},
        "scope_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["ineligible", "eligible_for_external_execution"]},
        "tenant_ref": {"$ref": "#/$defs/reference"}
      }
    },
    "operationAdmissionDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_sha256", "authorization_effect", "blocker_codes", "decision_id", "decision_sha256", "deletion_plan_id", "deletion_plan_sha256", "effects", "evaluated_at", "evidence_ref", "evidence_sha256", "kind", "operation", "operation_ref", "policy_ref", "policy_sha256", "policy_version", "requested_region", "schema_version", "scope_ref", "scope_sha256", "status", "tenant_ref", "transfer_request_id", "transfer_request_sha256"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/reference"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_effect": {"const": "none"},
        "blocker_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
        "decision_id": {"type": "string", "pattern": "^RAD-[0-9A-F]{32}$"},
        "decision_sha256": {"$ref": "#/$defs/sha256"},
        "deletion_plan_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^DEP-[0-9A-F]{32}$"}]},
        "deletion_plan_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "effects": {"$ref": "#/$defs/effects"},
        "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "evidence_ref": {"$ref": "#/$defs/reference"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"const": "sunderkey.regional-operation-admission.v1"},
        "operation": {"enum": ["store", "process", "transfer", "delete"]},
        "operation_ref": {"$ref": "#/$defs/reference"},
        "policy_ref": {"$ref": "#/$defs/reference"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "policy_version": {"$ref": "#/$defs/version"},
        "requested_region": {"$ref": "#/$defs/region"},
        "schema_version": {"const": 1},
        "scope_ref": {"$ref": "#/$defs/reference"},
        "scope_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["denied", "eligible_for_external_authorization"]},
        "tenant_ref": {"$ref": "#/$defs/reference"},
        "transfer_request_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^CRT-[0-9A-F]{32}$"}]},
        "transfer_request_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    }
  }
}
