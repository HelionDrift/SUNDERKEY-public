{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/evaluation-scorecard-receipt-v1.schema.json",
  "title": "SUNDERKEY Evaluation Scorecard Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bindings",
    "contract_type",
    "effects",
    "observations",
    "receipt_id",
    "receipt_sha256",
    "result",
    "schema_version",
    "scoring_context"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_type": {"const": "evaluation_scorecard_receipt"},
    "receipt_id": {"type": "string", "pattern": "^ESR-[0-9A-F]{32}$"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "scoring_context": {"$ref": "#/$defs/scoringContext"},
    "observations": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/observation"}
    },
    "result": {"$ref": "#/$defs/result"},
    "effects": {"$ref": "#/$defs/effects"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "boundedInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000000
    },
    "partition": {
      "enum": ["public", "private_holdout", "adversarial_safety", "regression", "pilot"]
    },
    "role": {
      "enum": ["deterministic", "generalist", "prior_release", "candidate"]
    },
    "measure": {
      "enum": [
        "ground_truth_recall",
        "validated_finding_precision",
        "validator_reproduction_rate",
        "attack_path_depth",
        "unauthorized_target_actions",
        "cleanup_completion",
        "time_to_first_verified_finding",
        "cost_per_verified_finding",
        "run_to_run_stability",
        "evidence_completeness",
        "customer_remediation_acceptance"
      ]
    },
    "gate": {
      "enum": [
        "qualification.gate.adversarial-robustness",
        "qualification.gate.collaboration-handoff",
        "qualification.gate.evidence-reproducibility",
        "qualification.gate.false-positive-control",
        "qualification.gate.safe-abstention-stop",
        "qualification.gate.scope-authority",
        "qualification.gate.specialist-technical-accuracy",
        "qualification.gate.tool-data-boundary"
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_program_contract_id",
        "evaluation_program_contract_sha256",
        "result_manifest_sha256"
      ],
      "properties": {
        "evaluation_program_contract_id": {"$ref": "#/$defs/identifier"},
        "evaluation_program_contract_sha256": {"$ref": "#/$defs/sha256"},
        "result_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evaluationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_sha256",
        "partition_type",
        "repeat_group_id",
        "run_index"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "case_sha256": {"$ref": "#/$defs/sha256"},
        "partition_type": {"$ref": "#/$defs/partition"},
        "repeat_group_id": {"$ref": "#/$defs/identifier"},
        "run_index": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_identity_id", "role", "subject_id", "subject_sha256"],
      "properties": {
        "owner_identity_id": {"$ref": "#/$defs/identifier"},
        "role": {"$ref": "#/$defs/role"},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "subject_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contaminationAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_at",
        "checker_identity_id",
        "evidence_sha256",
        "partition_type",
        "status"
      ],
      "properties": {
        "checked_at": {"$ref": "#/$defs/timestamp"},
        "checker_identity_id": {"$ref": "#/$defs/identifier"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "partition_type": {"$ref": "#/$defs/partition"},
        "status": {"enum": ["clean", "unknown", "contaminated"]}
      }
    },
    "regressionThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack_path_depth",
        "cleanup_completion",
        "cost_per_verified_finding",
        "customer_remediation_acceptance",
        "evidence_completeness",
        "ground_truth_recall",
        "run_to_run_stability",
        "time_to_first_verified_finding",
        "unauthorized_target_actions",
        "validated_finding_precision",
        "validator_reproduction_rate"
      ],
      "properties": {
        "attack_path_depth": {"$ref": "#/$defs/boundedInteger"},
        "cleanup_completion": {"$ref": "#/$defs/boundedInteger"},
        "cost_per_verified_finding": {"$ref": "#/$defs/boundedInteger"},
        "customer_remediation_acceptance": {"$ref": "#/$defs/boundedInteger"},
        "evidence_completeness": {"$ref": "#/$defs/boundedInteger"},
        "ground_truth_recall": {"$ref": "#/$defs/boundedInteger"},
        "run_to_run_stability": {"$ref": "#/$defs/boundedInteger"},
        "time_to_first_verified_finding": {"$ref": "#/$defs/boundedInteger"},
        "unauthorized_target_actions": {"$ref": "#/$defs/boundedInteger"},
        "validated_finding_precision": {"$ref": "#/$defs/boundedInteger"},
        "validator_reproduction_rate": {"$ref": "#/$defs/boundedInteger"}
      }
    },
    "scoringContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calculated_at",
        "contamination_attestations",
        "evaluation_cases",
        "evaluator_identity_ids",
        "minimum_cases_per_partition",
        "minimum_repeated_runs",
        "regression_thresholds",
        "scorecard_version",
        "scoring_controller_identity_id",
        "subjects"
      ],
      "properties": {
        "calculated_at": {"$ref": "#/$defs/timestamp"},
        "contamination_attestations": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/contaminationAttestation"}
        },
        "evaluation_cases": {
          "type": "array",
          "minItems": 15,
          "maxItems": 25000,
          "items": {"$ref": "#/$defs/evaluationCase"}
        },
        "evaluator_identity_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "minimum_cases_per_partition": {"$ref": "#/$defs/positiveInteger"},
        "minimum_repeated_runs": {"const": 3},
        "regression_thresholds": {"$ref": "#/$defs/regressionThresholds"},
        "scorecard_version": {"$ref": "#/$defs/version"},
        "scoring_controller_identity_id": {"$ref": "#/$defs/identifier"},
        "subjects": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/subject"}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_cost_microusd",
        "maximum_latency_ms",
        "maximum_requests",
        "maximum_tokens",
        "maximum_tool_calls",
        "used_cost_microusd",
        "used_latency_ms",
        "used_requests",
        "used_tokens",
        "used_tool_calls"
      ],
      "properties": {
        "maximum_cost_microusd": {"$ref": "#/$defs/positiveInteger"},
        "maximum_latency_ms": {"$ref": "#/$defs/positiveInteger"},
        "maximum_requests": {"$ref": "#/$defs/positiveInteger"},
        "maximum_tokens": {"$ref": "#/$defs/positiveInteger"},
        "maximum_tool_calls": {"$ref": "#/$defs/positiveInteger"},
        "used_cost_microusd": {"$ref": "#/$defs/boundedInteger"},
        "used_latency_ms": {"$ref": "#/$defs/boundedInteger"},
        "used_requests": {"$ref": "#/$defs/boundedInteger"},
        "used_tokens": {"$ref": "#/$defs/boundedInteger"},
        "used_tool_calls": {"$ref": "#/$defs/boundedInteger"}
      }
    },
    "metricValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_remediation_findings",
        "completed_evaluation_runs",
        "elapsed_milliseconds_to_first_verified_finding",
        "evaluation_cost_micro_usd",
        "findings_submitted_for_validation",
        "ground_truth_findings",
        "independently_validated_findings",
        "remediation_findings_reviewed",
        "repeated_case_outcomes",
        "reported_findings",
        "reproduced_ground_truth_findings",
        "required_cleanup_obligations",
        "required_evidence_requirements",
        "runs_with_ground_truth_findings",
        "satisfied_evidence_requirements",
        "stable_repeated_case_outcomes",
        "unauthorized_target_actions",
        "validator_reproduced_findings",
        "verified_attack_path_hops_milli",
        "verified_cleanup_obligations",
        "verified_findings"
      ],
      "properties": {
        "accepted_remediation_findings": {"$ref": "#/$defs/boundedInteger"},
        "completed_evaluation_runs": {"$ref": "#/$defs/boundedInteger"},
        "elapsed_milliseconds_to_first_verified_finding": {"$ref": "#/$defs/boundedInteger"},
        "evaluation_cost_micro_usd": {"$ref": "#/$defs/boundedInteger"},
        "findings_submitted_for_validation": {"$ref": "#/$defs/boundedInteger"},
        "ground_truth_findings": {"$ref": "#/$defs/boundedInteger"},
        "independently_validated_findings": {"$ref": "#/$defs/boundedInteger"},
        "remediation_findings_reviewed": {"$ref": "#/$defs/boundedInteger"},
        "repeated_case_outcomes": {"$ref": "#/$defs/boundedInteger"},
        "reported_findings": {"$ref": "#/$defs/boundedInteger"},
        "reproduced_ground_truth_findings": {"$ref": "#/$defs/boundedInteger"},
        "required_cleanup_obligations": {"$ref": "#/$defs/boundedInteger"},
        "required_evidence_requirements": {"$ref": "#/$defs/boundedInteger"},
        "runs_with_ground_truth_findings": {"$ref": "#/$defs/boundedInteger"},
        "satisfied_evidence_requirements": {"$ref": "#/$defs/boundedInteger"},
        "stable_repeated_case_outcomes": {"$ref": "#/$defs/boundedInteger"},
        "unauthorized_target_actions": {"$ref": "#/$defs/boundedInteger"},
        "validator_reproduced_findings": {"$ref": "#/$defs/boundedInteger"},
        "verified_attack_path_hops_milli": {"$ref": "#/$defs/boundedInteger"},
        "verified_cleanup_obligations": {"$ref": "#/$defs/boundedInteger"},
        "verified_findings": {"$ref": "#/$defs/boundedInteger"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget",
        "case_id",
        "case_sha256",
        "critical_failure_gate_ids",
        "evaluator_identity_id",
        "evidence_manifest_sha256",
        "metric_values",
        "partition_type",
        "result_status",
        "subject_id",
        "subject_role",
        "subject_sha256"
      ],
      "properties": {
        "budget": {"$ref": "#/$defs/budget"},
        "case_id": {"$ref": "#/$defs/identifier"},
        "case_sha256": {"$ref": "#/$defs/sha256"},
        "critical_failure_gate_ids": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/gate"},
          "uniqueItems": true
        },
        "evaluator_identity_id": {"$ref": "#/$defs/identifier"},
        "evidence_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "metric_values": {
          "oneOf": [
            {"$ref": "#/$defs/metricValues"},
            {"type": "null"}
          ]
        },
        "partition_type": {"$ref": "#/$defs/partition"},
        "result_status": {"enum": ["completed", "failed", "abstained", "safety_failure"]},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "subject_role": {"$ref": "#/$defs/role"},
        "subject_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "metricResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_status",
        "denominator",
        "direction",
        "measure_id",
        "minimum_denominator",
        "numerator",
        "outcome",
        "pass_threshold",
        "sample_count",
        "unit",
        "value"
      ],
      "properties": {
        "confidence_status": {"enum": ["sufficient", "insufficient"]},
        "denominator": {"$ref": "#/$defs/boundedInteger"},
        "direction": {"enum": ["higher_is_better", "lower_is_better"]},
        "measure_id": {"$ref": "#/$defs/measure"},
        "minimum_denominator": {"$ref": "#/$defs/positiveInteger"},
        "numerator": {"$ref": "#/$defs/boundedInteger"},
        "outcome": {"enum": ["pass", "fail", "hard_stop", "insufficient", "invalid_evidence"]},
        "pass_threshold": {"$ref": "#/$defs/boundedInteger"},
        "sample_count": {"$ref": "#/$defs/boundedInteger"},
        "unit": {"enum": ["basis_points", "count", "micro_usd", "milli_hops_per_run", "milliseconds"]},
        "value": {
          "oneOf": [
            {"$ref": "#/$defs/boundedInteger"},
            {"type": "null"}
          ]
        }
      }
    },
    "budgetSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_cost_microusd",
        "normalized_cost_basis_points",
        "used_cost_microusd"
      ],
      "properties": {
        "maximum_cost_microusd": {"$ref": "#/$defs/boundedInteger"},
        "normalized_cost_basis_points": {"$ref": "#/$defs/boundedInteger"},
        "used_cost_microusd": {"$ref": "#/$defs/boundedInteger"}
      }
    },
    "subjectScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_summary",
        "disposition",
        "hard_failure_gate_ids",
        "metric_results",
        "observation_count",
        "role",
        "subject_id",
        "subject_sha256"
      ],
      "properties": {
        "budget_summary": {"$ref": "#/$defs/budgetSummary"},
        "disposition": {
          "enum": [
            "invalid_evidence",
            "hard_failure",
            "insufficient_evidence",
            "scored_fail",
            "scored_pass"
          ]
        },
        "hard_failure_gate_ids": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/gate"},
          "uniqueItems": true
        },
        "metric_results": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {"$ref": "#/$defs/metricResult"}
        },
        "observation_count": {"$ref": "#/$defs/boundedInteger"},
        "role": {"$ref": "#/$defs/role"},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "subject_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_role",
        "baseline_value",
        "candidate_value",
        "confidence_status",
        "directional_delta",
        "measure_id",
        "regression_threshold",
        "status"
      ],
      "properties": {
        "baseline_role": {"enum": ["deterministic", "generalist", "prior_release"]},
        "baseline_value": {
          "oneOf": [
            {"$ref": "#/$defs/boundedInteger"},
            {"type": "null"}
          ]
        },
        "candidate_value": {
          "oneOf": [
            {"$ref": "#/$defs/boundedInteger"},
            {"type": "null"}
          ]
        },
        "confidence_status": {"enum": ["sufficient", "insufficient"]},
        "directional_delta": {
          "oneOf": [
            {"type": "integer", "minimum": -1000000000000000, "maximum": 1000000000000000},
            {"type": "null"}
          ]
        },
        "measure_id": {"$ref": "#/$defs/measure"},
        "regression_threshold": {"$ref": "#/$defs/boundedInteger"},
        "status": {
          "enum": [
            "improvement",
            "no_improvement",
            "regression",
            "hard_stop",
            "insufficient",
            "invalid_evidence"
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_disposition",
        "comparisons",
        "evidence_status",
        "independent_review_location",
        "insufficiency_reason_codes",
        "invalid_reason_codes",
        "metric_definition_sha256",
        "promotion_disposition",
        "qualification_effect",
        "scorecard_measure_ids",
        "subject_scores"
      ],
      "properties": {
        "candidate_disposition": {
          "enum": [
            "invalid_evidence",
            "hard_failure",
            "insufficient_evidence",
            "scored_fail",
            "regression",
            "scored_pass"
          ]
        },
        "comparisons": {
          "type": "array",
          "minItems": 33,
          "maxItems": 33,
          "items": {"$ref": "#/$defs/comparison"}
        },
        "evidence_status": {"enum": ["complete", "insufficient", "invalid"]},
        "independent_review_location": {"const": "outside_runtime"},
        "insufficiency_reason_codes": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "invalid_reason_codes": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "metric_definition_sha256": {"$ref": "#/$defs/sha256"},
        "promotion_disposition": {"enum": ["blocked", "independent_review_required"]},
        "qualification_effect": {"const": "none"},
        "scorecard_measure_ids": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {"$ref": "#/$defs/measure"},
          "uniqueItems": true
        },
        "subject_scores": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/subjectScore"}
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "evaluation_execution",
        "filesystem_discovery",
        "model_calls",
        "network",
        "promotion",
        "provider_calls",
        "qualification",
        "target_actions",
        "tool_calls"
      ],
      "properties": {
        "authorization": {"const": "none"},
        "evaluation_execution": {"const": "none"},
        "filesystem_discovery": {"const": "none"},
        "model_calls": {"const": "none"},
        "network": {"const": "none"},
        "promotion": {"const": "none"},
        "provider_calls": {"const": "none"},
        "qualification": {"const": "none"},
        "target_actions": {"const": "none"},
        "tool_calls": {"const": "none"}
      }
    }
  }
}
