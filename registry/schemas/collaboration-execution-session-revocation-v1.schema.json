{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-execution-session-revocation-v1.json",
  "title": "SUNDERKEY Collaboration Execution Session Revocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revocation_id",
    "revocation_sha256",
    "session_authority",
    "mission_id",
    "work_item_id",
    "session",
    "credential",
    "decision_owner",
    "reason_code",
    "revoked_at",
    "revocation_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "revocation_id": {"type": "string", "pattern": "^ESR-[0-9A-F]{32}$"},
    "revocation_sha256": {"$ref": "#/$defs/sha256"},
    "session_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_authority_id", "session_authority_sha256"],
      "properties": {
        "session_authority_id": {
          "type": "string",
          "pattern": "^ESA-[0-9A-F]{32}$"
        },
        "session_authority_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mission_id": {"$ref": "#/$defs/identifier"},
    "work_item_id": {"$ref": "#/$defs/identifier"},
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "session_sha256"],
      "properties": {
        "session_id": {"type": "string", "pattern": "^ECS-[0-9A-F]{32}$"},
        "session_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_reference_id", "credential_sha256"],
      "properties": {
        "credential_reference_id": {"$ref": "#/$defs/identifier"},
        "credential_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "decision_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "assertion_id", "assertion_sha256"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/identifier"},
        "assertion_id": {"type": "string", "pattern": "^PAS-[0-9A-F]{32}$"},
        "assertion_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reason_code": {
      "enum": [
        "credential_compromise",
        "health_failure",
        "mission_stop",
        "normal_completion",
        "operator_request",
        "ownership_change",
        "policy_superseded",
        "timeout_recovery"
      ]
    },
    "revoked_at": {"$ref": "#/$defs/timestamp"},
    "revocation_status": {"const": "pending_control_authentication"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
