{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-ownership-revocation-commit-receipt-v1.json",
  "title": "SUNDERKEY Collaboration Ownership Revocation Commit Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revocation",
    "entry",
    "preflight_id",
    "preflight_sha256",
    "authentication_id",
    "authentication_sha256",
    "committed_at",
    "effective_owner",
    "planned_owner",
    "independent_control",
    "commit_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "revocation": {
      "$ref": "collaboration-ownership-revocation-v1.schema.json"
    },
    "entry": {
      "$ref": "collaboration-ownership-chain-entry-v1.schema.json"
    },
    "preflight_id": {"type": "string", "pattern": "^ORF-[0-9A-F]{32}$"},
    "preflight_sha256": {"$ref": "#/$defs/sha256"},
    "authentication_id": {"type": "string", "pattern": "^ORA-[0-9A-F]{32}$"},
    "authentication_sha256": {"$ref": "#/$defs/sha256"},
    "committed_at": {"$ref": "#/$defs/timestamp"},
    "effective_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "owner_epoch"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/identifier"},
        "owner_epoch": {"type": "integer", "minimum": 1}
      }
    },
    "planned_owner": {"$ref": "#/$defs/assertionCommit"},
    "independent_control": {"$ref": "#/$defs/assertionCommit"},
    "commit_status": {"const": "committed_active"},
    "runtime_effect": {"const": "ownership_projection_updated"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "assertionCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "assertion_sha256",
        "ledger_entry_sha256"
      ],
      "properties": {
        "assertion_id": {"type": "string", "pattern": "^PAS-[0-9A-F]{32}$"},
        "assertion_sha256": {"$ref": "#/$defs/sha256"},
        "ledger_entry_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
