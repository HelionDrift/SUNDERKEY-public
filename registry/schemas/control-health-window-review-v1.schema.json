{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/control-health-window-review-v1.schema.json",
  "title": "SUNDERKEY Offline Control Health Window Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "contract_sha256", "assessment_id",
    "execution_id", "scope_sha256", "action_sha256",
    "action_window_started_at", "action_window_completed_at", "as_of",
    "declarations_sha256", "objective_count", "missing_or_partial_count",
    "conflict_count", "effective_claim_health_review_count", "objectives",
    "source_provenance", "control_health_authenticated", "authorization_effect",
    "execution_effect", "network_call_performed", "qualification_effect",
    "review_status", "review_id", "review_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"$ref": "#/$defs/id"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "assessment_id": {"$ref": "#/$defs/id"},
    "execution_id": {"$ref": "#/$defs/id"},
    "scope_sha256": {"$ref": "#/$defs/sha256"},
    "action_sha256": {"$ref": "#/$defs/sha256"},
    "action_window_started_at": {"$ref": "#/$defs/utc"},
    "action_window_completed_at": {"$ref": "#/$defs/utc"},
    "as_of": {"$ref": "#/$defs/utc"},
    "declarations_sha256": {"$ref": "#/$defs/sha256"},
    "objective_count": {"type": "integer", "minimum": 1, "maximum": 512},
    "missing_or_partial_count": {"type": "integer", "minimum": 0, "maximum": 512},
    "conflict_count": {"type": "integer", "minimum": 0, "maximum": 512},
    "effective_claim_health_review_count": {
      "type": "integer", "minimum": 0, "maximum": 512
    },
    "objectives": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {"$ref": "#/$defs/objective"}
    },
    "source_provenance": {"const": "caller_asserted_not_authenticated"},
    "control_health_authenticated": {"const": false},
    "authorization_effect": {"const": "none"},
    "execution_effect": {"const": "none"},
    "network_call_performed": {"const": false},
    "qualification_effect": {"const": "none"},
    "review_status": {"const": "independent_review_required"},
    "review_id": {"type": "string", "pattern": "^CHWR-[0-9A-F]{32}$"},
    "review_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "objective": {
      "type": "object", "additionalProperties": false,
      "required": [
        "objective_id", "control_id", "control_config_sha256",
        "contract_outcome_state", "health_disposition", "full_window_coverage_declared",
        "overlapping_declaration_sha256", "covering_declaration_sha256",
        "effective_claim_needs_health_review"
      ],
      "properties": {
        "objective_id": {"$ref": "#/$defs/id"},
        "control_id": {"$ref": "#/$defs/id"},
        "control_config_sha256": {"$ref": "#/$defs/sha256"},
        "contract_outcome_state": {
          "enum": ["effective", "partially_effective", "ineffective", "inconclusive"]
        },
        "health_disposition": {
          "enum": [
            "missing", "partial_coverage", "conflict", "declared_operational",
            "declared_degraded", "declared_unavailable", "declared_unknown"
          ]
        },
        "full_window_coverage_declared": {"type": "boolean"},
        "overlapping_declaration_sha256": {
          "type": "array", "maxItems": 512, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "covering_declaration_sha256": {
          "type": "array", "maxItems": 512, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "effective_claim_needs_health_review": {"type": "boolean"}
      }
    }
  }
}
