{
  "$defs": {
    "identifier": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "profileId": {
      "pattern": "^AOE-(?:G[A-E]-D[0-9]{2}-(?:S[0-9]{2}|CMD)|HQ-[0-9]{2})$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[\\t\\n\\r -~]*[!-~][\\t\\n\\r -~]*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "authorization_effect": {
          "const": "none"
        },
        "confidence": {
          "enum": [
            "unknown",
            "low",
            "moderate",
            "high"
          ]
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "execution_envelope_id": {
          "pattern": "^EEE-[0-9A-F]{32}$",
          "type": "string"
        },
        "execution_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "independent_review": {
          "additionalProperties": false,
          "properties": {
            "producer_excluded": {
              "const": true
            },
            "required": {
              "type": "boolean"
            },
            "reviewer_profile_ids": {
              "const": []
            },
            "status": {
              "const": "not_reviewed"
            }
          },
          "required": [
            "required",
            "status",
            "reviewer_profile_ids",
            "producer_excluded"
          ],
          "type": "object"
        },
        "lineage_product_ids": {
          "items": {
            "pattern": "^EWP-[0-9A-F]{32}$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        },
        "mission_id": {
          "$ref": "#/$defs/identifier"
        },
        "model_output_effect": {
          "const": "advisory_only"
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "collection_limits": {
              "items": {
                "maxLength": 4096,
                "minLength": 1,
                "pattern": "^[\\t\\n\\r -~]*[!-~][\\t\\n\\r -~]*$",
                "type": "string"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "observed_facts": {
              "items": {
                "maxLength": 4096,
                "minLength": 1,
                "pattern": "^[\\t\\n\\r -~]*[!-~][\\t\\n\\r -~]*$",
                "type": "string"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "observed_facts",
            "collection_limits"
          ],
          "type": "object"
        },
        "plan_id": {
          "$ref": "#/$defs/identifier"
        },
        "producer_profile_id": {
          "$ref": "#/$defs/profileId"
        },
        "product_id": {
          "pattern": "^EWP-[0-9A-F]{32}$",
          "type": "string"
        },
        "product_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "product_type": {
          "const": "observation"
        },
        "runtime_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_pack_id": {
          "pattern": "^ERP-[0-9A-F]{32}$",
          "type": "string"
        },
        "runtime_pack_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_version": {
          "const": 1
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "tool_effect": {
          "const": "none"
        },
        "uncertainty": {
          "$ref": "#/$defs/text"
        },
        "work_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "schema_version",
        "product_id",
        "product_sha256",
        "runtime_catalog_sha256",
        "runtime_pack_id",
        "runtime_pack_sha256",
