{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.example/schemas/credential-broker-contract-v1.schema.json",
  "title": "SUNDERKEY Credential Broker Contract v1",
  "oneOf": [
    { "$ref": "#/$defs/descriptor" },
    { "$ref": "#/$defs/accessRequest" },
    { "$ref": "#/$defs/approval" },
    { "$ref": "#/$defs/identitySet" },
    { "$ref": "#/$defs/lease" },
    { "$ref": "#/$defs/receipt" },
    { "$ref": "#/$defs/obligation" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){1,3}([-+][A-Za-z0-9.]+)?$"
    },
    "tenantRef": {
      "type": "string",
      "pattern": "^tenantref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "assessmentRef": {
      "type": "string",
      "pattern": "^assessmentref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "taskRef": {
      "type": "string",
      "pattern": "^taskref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "principalRef": {
      "type": "string",
      "pattern": "^principalref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "targetRef": {
      "type": "string",
      "pattern": "^targetref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "techniqueRef": {
      "type": "string",
      "pattern": "^techniqueref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "purposeRef": {
      "type": "string",
      "pattern": "^purposeref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "credentialRef": {
      "type": "string",
      "pattern": "^credentialref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "providerRef": {
      "type": "string",
      "pattern": "^providerref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "adapterRef": {
      "type": "string",
      "pattern": "^adapterref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "scopeRef": {
      "type": "string",
      "pattern": "^scoperef:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "roleRef": {
      "type": "string",
      "pattern": "^roleref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "sessionRef": {
      "type": ["string", "null"],
      "pattern": "^sessionref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "issuanceRef": {
      "type": "string",
      "pattern": "^issuanceref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "obligationRef": {
      "type": "string",
      "pattern": "^obligationref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "reasonRef": {
      "type": "string",
      "pattern": "^reasonref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "actionTier": {
      "enum": ["R0", "R1", "R2", "R3", "R4", "R5"]
    },
    "leaseMode": {
      "enum": ["one_time", "session_bound"]
    },
    "scopeRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/scopeRef" }
    },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_ref", "adapter_version", "provider_ref"],
      "properties": {
        "adapter_ref": { "$ref": "#/$defs/adapterRef" },
        "adapter_version": { "$ref": "#/$defs/version" },
        "provider_ref": { "$ref": "#/$defs/providerRef" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver_principal_ref", "evidence_sha256", "role_ref"],
      "properties": {
        "approver_principal_ref": { "$ref": "#/$defs/principalRef" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "role_ref": { "$ref": "#/$defs/roleRef" }
      }
    },
    "principalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptor_sha256", "principal_ref"],
      "properties": {
        "descriptor_sha256": { "$ref": "#/$defs/sha256" },
        "principal_ref": { "$ref": "#/$defs/principalRef" }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "allowed_modes",
        "allowed_purpose_refs",
        "allowed_scope_refs",
        "allowed_target_refs",
        "allowed_technique_refs",
        "assessment_ref",
        "created_at",
        "credential_ref",
        "descriptor_id",
        "descriptor_sha256",
        "expires_at",
        "max_lease_ttl_seconds",
        "max_uses_per_lease",
        "revocation_obligation_ref",
        "rotation_obligation_ref",
        "subject_principal_ref",
        "tenant_ref"
      ],
      "properties": {
        "adapter": { "$ref": "#/$defs/adapter" },
        "allowed_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/leaseMode" }
        },
        "allowed_purpose_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/purposeRef" }
        },
        "allowed_scope_refs": { "$ref": "#/$defs/scopeRefs" },
        "allowed_target_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/targetRef" }
        },
        "allowed_technique_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/techniqueRef" }
        },
        "assessment_ref": { "$ref": "#/$defs/assessmentRef" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "credential_ref": { "$ref": "#/$defs/credentialRef" },
        "descriptor_id": { "type": "string", "pattern": "^CBD-[0-9A-F]{32}$" },
        "descriptor_sha256": { "$ref": "#/$defs/sha256" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "max_lease_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "max_uses_per_lease": { "type": "integer", "minimum": 1, "maximum": 100 },
        "revocation_obligation_ref": { "$ref": "#/$defs/obligationRef" },
        "rotation_obligation_ref": { "$ref": "#/$defs/obligationRef" },
        "subject_principal_ref": { "$ref": "#/$defs/principalRef" },
        "tenant_ref": { "$ref": "#/$defs/tenantRef" }
      }
    },
    "accessRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_tier",
        "assessment_ref",
        "descriptor_sha256",
        "expires_at",
        "lease_mode",
        "purpose_ref",
        "renewal_of_lease_sha256",
        "request_id",
        "request_sha256",
        "requested_at",
        "requested_max_uses",
        "requested_scope_refs",
        "requested_ttl_seconds",
        "requester_principal_ref",
        "subject_principal_ref",
        "target_ref",
        "task_ref",
        "technique_ref",
        "tenant_ref"
      ],
      "properties": {
        "action_tier": { "$ref": "#/$defs/actionTier" },
        "assessment_ref": { "$ref": "#/$defs/assessmentRef" },
        "descriptor_sha256": { "$ref": "#/$defs/sha256" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "lease_mode": { "$ref": "#/$defs/leaseMode" },
        "purpose_ref": { "$ref": "#/$defs/purposeRef" },
        "renewal_of_lease_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "request_id": { "type": "string", "pattern": "^CAR-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "requested_at": { "$ref": "#/$defs/timestamp" },
        "requested_max_uses": { "type": "integer", "minimum": 1, "maximum": 100 },
        "requested_scope_refs": { "$ref": "#/$defs/scopeRefs" },
        "requested_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "requester_principal_ref": { "$ref": "#/$defs/principalRef" },
        "subject_principal_ref": { "$ref": "#/$defs/principalRef" },
        "target_ref": { "$ref": "#/$defs/targetRef" },
        "task_ref": { "$ref": "#/$defs/taskRef" },
        "technique_ref": { "$ref": "#/$defs/techniqueRef" },
        "tenant_ref": { "$ref": "#/$defs/tenantRef" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_tier",
        "approval_id",
        "approval_sha256",
        "approved_at",
        "approved_max_uses",
        "approved_scope_refs",
        "approved_ttl_seconds",
        "attestations",
        "expires_at",
        "lease_mode",
        "request_sha256"
      ],
      "properties": {
        "action_tier": { "$ref": "#/$defs/actionTier" },
        "approval_id": { "type": "string", "pattern": "^CAB-[0-9A-F]{32}$" },
        "approval_sha256": { "$ref": "#/$defs/sha256" },
        "approved_at": { "$ref": "#/$defs/timestamp" },
        "approved_max_uses": { "type": "integer", "minimum": 1, "maximum": 100 },
        "approved_scope_refs": { "$ref": "#/$defs/scopeRefs" },
        "approved_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "attestations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/attestation" }
        },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "lease_mode": { "$ref": "#/$defs/leaseMode" },
        "request_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "identitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_ref",
        "bindings",
        "identity_set_id",
        "identity_set_sha256",
        "tenant_ref"
      ],
      "properties": {
        "assessment_ref": { "$ref": "#/$defs/assessmentRef" },
        "bindings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/principalBinding" }
        },
        "identity_set_id": { "type": "string", "pattern": "^CIS-[0-9A-F]{32}$" },
        "identity_set_sha256": { "$ref": "#/$defs/sha256" },
        "tenant_ref": { "$ref": "#/$defs/tenantRef" }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_tier",
        "approval_sha256",
        "assessment_ref",
        "descriptor_sha256",
        "expires_at",
        "issuance_ref",
        "issued_at",
        "lease_id",
        "lease_mode",
        "lease_sha256",
        "max_uses",
        "purpose_ref",
        "renewal_of_lease_sha256",
        "request_sha256",
        "requester_principal_ref",
        "scope_refs",
        "session_ref",
        "subject_principal_ref",
        "target_ref",
        "task_ref",
        "technique_ref",
        "tenant_ref"
      ],
      "properties": {
        "action_tier": { "$ref": "#/$defs/actionTier" },
        "approval_sha256": { "$ref": "#/$defs/sha256" },
        "assessment_ref": { "$ref": "#/$defs/assessmentRef" },
        "descriptor_sha256": { "$ref": "#/$defs/sha256" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "issuance_ref": { "$ref": "#/$defs/issuanceRef" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "lease_id": { "type": "string", "pattern": "^CLZ-[0-9A-F]{32}$" },
        "lease_mode": { "$ref": "#/$defs/leaseMode" },
        "lease_sha256": { "$ref": "#/$defs/sha256" },
        "max_uses": { "type": "integer", "minimum": 1, "maximum": 100 },
        "purpose_ref": { "$ref": "#/$defs/purposeRef" },
        "renewal_of_lease_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "requester_principal_ref": { "$ref": "#/$defs/principalRef" },
        "scope_refs": { "$ref": "#/$defs/scopeRefs" },
        "session_ref": { "$ref": "#/$defs/sessionRef" },
        "subject_principal_ref": { "$ref": "#/$defs/principalRef" },
        "target_ref": { "$ref": "#/$defs/targetRef" },
        "task_ref": { "$ref": "#/$defs/taskRef" },
        "technique_ref": { "$ref": "#/$defs/techniqueRef" },
        "tenant_ref": { "$ref": "#/$defs/tenantRef" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_ref",
        "evidence_hashes",
        "lease_sha256",
        "outcome",
        "purpose_ref",
        "receipt_id",
        "receipt_sha256",
        "session_ref",
        "subject_principal_ref",
        "target_ref",
        "task_ref",
        "technique_ref",
        "tenant_ref",
        "use_number",
        "used_at"
      ],
      "properties": {
        "assessment_ref": { "$ref": "#/$defs/assessmentRef" },
        "evidence_hashes": { "$ref": "#/$defs/hashes" },
        "lease_sha256": { "$ref": "#/$defs/sha256" },
        "outcome": { "enum": ["used", "denied", "failed"] },
        "purpose_ref": { "$ref": "#/$defs/purposeRef" },
        "receipt_id": { "type": "string", "pattern": "^CUR-[0-9A-F]{32}$" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "session_ref": { "$ref": "#/$defs/sessionRef" },
        "subject_principal_ref": { "$ref": "#/$defs/principalRef" },
        "target_ref": { "$ref": "#/$defs/targetRef" },
        "task_ref": { "$ref": "#/$defs/taskRef" },
        "technique_ref": { "$ref": "#/$defs/techniqueRef" },
        "tenant_ref": { "$ref": "#/$defs/tenantRef" },
        "use_number": { "type": "integer", "minimum": 1, "maximum": 100 },
        "used_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_ref",
        "completed_at",
        "completion_evidence_sha256",
        "descriptor_sha256",
        "lease_sha256",
        "obligation_id",
        "obligation_kind",
        "obligation_ref",
        "obligation_sha256",
        "reason_ref",
        "required_by",
        "responsible_role_ref",
        "status",
        "tenant_ref",
        "trigger_sha256"
      ],
      "properties": {
        "assessment_ref": { "$ref": "#/$defs/assessmentRef" },
        "completed_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "completion_evidence_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "descriptor_sha256": { "$ref": "#/$defs/sha256" },
        "lease_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "obligation_id": { "type": "string", "pattern": "^CLO-[0-9A-F]{32}$" },
        "obligation_kind": { "enum": ["revocation", "rotation"] },
        "obligation_ref": { "$ref": "#/$defs/obligationRef" },
        "obligation_sha256": { "$ref": "#/$defs/sha256" },
        "reason_ref": { "$ref": "#/$defs/reasonRef" },
        "required_by": { "$ref": "#/$defs/timestamp" },
        "responsible_role_ref": { "$ref": "#/$defs/roleRef" },
        "status": { "enum": ["pending", "completed"] },
        "tenant_ref": { "$ref": "#/$defs/tenantRef" },
        "trigger_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": {
            "properties": {
              "completed_at": { "type": "null" },
              "completion_evidence_sha256": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "completed_at": { "$ref": "#/$defs/timestamp" },
              "completion_evidence_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ]
    }
  }
}
