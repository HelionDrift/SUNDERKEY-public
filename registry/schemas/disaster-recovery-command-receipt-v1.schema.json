{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.example/schemas/disaster-recovery-command-receipt-v1.schema.json",
  "title": "SUNDERKEY disaster recovery command records",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/observation" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.]+)?$"
    },
    "commandKind": {
      "enum": [
        "create_backup",
        "verify_backup",
        "rehearse_restore",
        "verify_restore",
        "cleanup_rehearsal"
      ]
    },
    "outcome": {
      "enum": [
        "completed",
        "retryable_failure",
        "terminal_failure",
        "partial_cleanup",
        "blocked_preflight"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,63}$"
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_command_kinds",
        "approver_ref",
        "authorization_ref",
        "authorization_sha256",
        "authorized_at",
        "backend_ref",
        "backend_version",
        "destination_ref",
        "destination_sha256",
        "expires_at",
        "manifest_id",
        "manifest_sha256",
        "objective_id",
        "objective_sha256",
        "operator_ref",
        "plan_id",
        "plan_sha256",
        "scope_ref",
        "scope_sha256",
        "system_ref",
        "tenant_ref"
      ],
      "properties": {
        "allowed_command_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/commandKind" }
        },
        "approver_ref": { "type": "string", "pattern": "^principalref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "authorization_ref": { "type": "string", "pattern": "^authorizationref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "authorization_sha256": { "$ref": "#/$defs/sha256" },
        "authorized_at": { "$ref": "#/$defs/utc" },
        "backend_ref": { "type": "string", "pattern": "^backendref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "backend_version": { "$ref": "#/$defs/version" },
        "destination_ref": { "type": "string", "pattern": "^rehearsalref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "destination_sha256": { "$ref": "#/$defs/sha256" },
        "expires_at": { "$ref": "#/$defs/utc" },
        "manifest_id": { "type": "string", "pattern": "^DRB-[0-9A-F]{32}$" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "objective_id": { "type": "string", "pattern": "^DRO-[0-9A-F]{32}$" },
        "objective_sha256": { "$ref": "#/$defs/sha256" },
        "operator_ref": { "type": "string", "pattern": "^principalref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "plan_id": { "type": "string", "pattern": "^DRP-[0-9A-F]{32}$" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "scope_ref": { "type": "string", "pattern": "^scoperef:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "system_ref": { "type": "string", "pattern": "^systemref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "tenant_ref": { "type": "string", "pattern": "^tenantref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_backend_calls", "max_bytes", "max_objects", "max_runtime_seconds"],
      "properties": {
        "max_backend_calls": { "const": 1 },
        "max_bytes": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
        "max_objects": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "max_runtime_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caller_proved_isolated",
        "destination_ref",
        "destination_sha256",
        "isolation_class",
        "isolation_proof_ref",
        "isolation_proof_sha256",
        "network_mode",
        "production_destination"
      ],
      "properties": {
        "caller_proved_isolated": { "const": true },
        "destination_ref": { "type": "string", "pattern": "^rehearsalref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "destination_sha256": { "$ref": "#/$defs/sha256" },
        "isolation_class": { "const": "ephemeral_rehearsal" },
        "isolation_proof_ref": { "type": "string", "pattern": "^evidenceref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "isolation_proof_sha256": { "$ref": "#/$defs/sha256" },
        "network_mode": { "const": "isolated" },
        "production_destination": { "const": false }
      }
    },
    "fence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fence_epoch", "fence_ref", "fence_sha256", "scope_ref", "scope_sha256"],
      "properties": {
        "fence_epoch": { "type": "integer", "minimum": 1 },
        "fence_ref": { "type": "string", "pattern": "^fenceref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "fence_sha256": { "$ref": "#/$defs/sha256" },
        "scope_ref": { "type": "string", "pattern": "^scoperef:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "scope_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanup_ref",
        "cleanup_required",
        "cleanup_sha256",
        "destination_ref",
        "destination_sha256",
        "destination_absence_required",
        "max_cleanup_seconds"
      ],
      "properties": {
        "cleanup_ref": { "type": "string", "pattern": "^cleanupref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "cleanup_required": { "const": true },
        "cleanup_sha256": { "$ref": "#/$defs/sha256" },
        "destination_ref": { "type": "string", "pattern": "^rehearsalref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "destination_sha256": { "$ref": "#/$defs/sha256" },
        "destination_absence_required": { "const": true },
        "max_cleanup_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "backend_ref",
        "backend_version",
        "budget",
        "cleanup",
        "command_kind",
        "expires_at",
        "fence",
        "idempotency_key",
        "isolation",
        "kind",
        "manifest_id",
        "manifest_sha256",
        "objective_id",
        "objective_sha256",
        "plan_id",
        "plan_sha256",
        "preflight_evidence_ref",
        "preflight_evidence_sha256",
        "preflight_passed",
        "preflight_reason_codes",
        "request_id",
        "request_sha256",
        "requested_at",
        "schema_version",
        "scope_ref",
        "scope_sha256",
        "system_ref",
        "system_version",
        "tenant_ref"
      ],
      "properties": {
        "authorization": { "$ref": "#/$defs/authorization" },
        "backend_ref": { "type": "string", "pattern": "^backendref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "backend_version": { "$ref": "#/$defs/version" },
        "budget": { "$ref": "#/$defs/budget" },
        "cleanup": { "$ref": "#/$defs/cleanup" },
        "command_kind": { "$ref": "#/$defs/commandKind" },
        "expires_at": { "$ref": "#/$defs/utc" },
        "fence": { "$ref": "#/$defs/fence" },
        "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{15,190}$" },
        "isolation": { "$ref": "#/$defs/isolation" },
        "kind": { "const": "sunderkey.disaster-recovery-command-request.v1" },
        "manifest_id": { "type": "string", "pattern": "^DRB-[0-9A-F]{32}$" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "objective_id": { "type": "string", "pattern": "^DRO-[0-9A-F]{32}$" },
        "objective_sha256": { "$ref": "#/$defs/sha256" },
        "plan_id": { "type": "string", "pattern": "^DRP-[0-9A-F]{32}$" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "preflight_evidence_ref": { "type": "string", "pattern": "^evidenceref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "preflight_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "preflight_passed": { "type": "boolean" },
        "preflight_reason_codes": { "$ref": "#/$defs/reasonCodes" },
        "request_id": { "type": "string", "pattern": "^DRCQ-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "requested_at": { "$ref": "#/$defs/utc" },
        "schema_version": { "const": 1 },
        "scope_ref": { "type": "string", "pattern": "^scoperef:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "system_ref": { "type": "string", "pattern": "^systemref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "system_version": { "$ref": "#/$defs/version" },
        "tenant_ref": { "type": "string", "pattern": "^tenantref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "preflight_passed": { "const": true } }, "required": ["preflight_passed"] },
          "then": { "properties": { "preflight_reason_codes": { "maxItems": 0 } } },
          "else": { "properties": { "preflight_reason_codes": { "minItems": 1 } } }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_call_performed",
        "backend_ref",
        "backend_version",
        "backup_observed",
        "cleanup_observed_complete",
        "command_kind",
        "evidence_ref",
        "evidence_sha256",
        "idempotency_key",
        "kind",
        "observation_id",
        "observation_sha256",
        "observation_source",
        "observed_at",
        "outcome",
        "reason_codes",
        "recovery_objectives_observed_passed",
        "request_id",
        "request_sha256",
        "restore_observed",
        "schema_version"
      ],
      "properties": {
        "backend_call_performed": { "type": "boolean" },
        "backend_ref": { "type": "string", "pattern": "^backendref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "backend_version": { "$ref": "#/$defs/version" },
        "backup_observed": { "type": "boolean" },
        "cleanup_observed_complete": { "type": "boolean" },
        "command_kind": { "$ref": "#/$defs/commandKind" },
        "evidence_ref": { "type": "string", "pattern": "^evidenceref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{15,190}$" },
        "kind": { "const": "sunderkey.disaster-recovery-command-observation.v1" },
        "observation_id": { "type": "string", "pattern": "^DRCO-[0-9A-F]{32}$" },
        "observation_sha256": { "$ref": "#/$defs/sha256" },
        "observation_source": { "enum": ["request_preflight", "supplied_backend_result"] },
        "observed_at": { "$ref": "#/$defs/utc" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "reason_codes": { "$ref": "#/$defs/reasonCodes" },
        "recovery_objectives_observed_passed": { "type": "boolean" },
        "request_id": { "type": "string", "pattern": "^DRCQ-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "restore_observed": { "type": "boolean" },
        "schema_version": { "const": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "completed" } }, "required": ["outcome"] },
          "then": { "properties": { "reason_codes": { "maxItems": 0 } } },
          "else": { "properties": { "reason_codes": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "outcome": { "const": "blocked_preflight" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "backend_call_performed": { "const": false },
              "backup_observed": { "const": false },
              "cleanup_observed_complete": { "const": false },
              "observation_source": { "const": "request_preflight" },
              "recovery_objectives_observed_passed": { "const": false },
              "restore_observed": { "const": false }
            }
          },
          "else": {
            "properties": {
              "backend_call_performed": { "const": true },
              "observation_source": { "const": "supplied_backend_result" }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "partial_cleanup" } }, "required": ["outcome"] },
          "then": { "properties": { "cleanup_observed_complete": { "const": false } } }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backup_observed",
        "claim_source",
        "cleanup_observed_complete",
        "command_kind",
        "idempotency_key",
        "kind",
        "observation_id",
        "observation_sha256",
        "outcome",
        "qualification_effect",
        "receipt_id",
        "receipt_sha256",
        "recovery_objectives_observed_passed",
        "request_id",
        "request_sha256",
        "restore_observed",
        "schema_version",
        "scope_ref",
        "system_ref",
        "tenant_ref"
      ],
      "properties": {
        "backup_observed": { "type": "boolean" },
        "claim_source": { "enum": ["request_preflight", "supplied_backend_result"] },
        "cleanup_observed_complete": { "type": "boolean" },
        "command_kind": { "$ref": "#/$defs/commandKind" },
        "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{15,190}$" },
        "kind": { "const": "sunderkey.disaster-recovery-command-receipt.v1" },
        "observation_id": { "type": "string", "pattern": "^DRCO-[0-9A-F]{32}$" },
        "observation_sha256": { "$ref": "#/$defs/sha256" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "qualification_effect": { "const": "none" },
        "receipt_id": { "type": "string", "pattern": "^DRCR-[0-9A-F]{32}$" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "recovery_objectives_observed_passed": { "type": "boolean" },
        "request_id": { "type": "string", "pattern": "^DRCQ-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "restore_observed": { "type": "boolean" },
        "schema_version": { "const": 1 },
        "scope_ref": { "type": "string", "pattern": "^scoperef:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "system_ref": { "type": "string", "pattern": "^systemref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" },
        "tenant_ref": { "type": "string", "pattern": "^tenantref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "claim_source": { "const": "request_preflight" } }, "required": ["claim_source"] },
          "then": {
            "properties": {
              "backup_observed": { "const": false },
              "cleanup_observed_complete": { "const": false },
              "outcome": { "const": "blocked_preflight" },
              "recovery_objectives_observed_passed": { "const": false },
              "restore_observed": { "const": false }
            }
          },
          "else": { "not": { "properties": { "outcome": { "const": "blocked_preflight" } }, "required": ["outcome"] } }
        }
      ]
    }
  }
}
