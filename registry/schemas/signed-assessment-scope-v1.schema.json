{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/signed-assessment-scope-v1.schema.json",
  "title": "SUNDERKEY Signed Assessment Scope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "scope_id",
    "issuer",
    "key_id",
    "nonce",
    "sequence_number",
    "issued_at",
    "expires_at",
    "assessment_window",
    "targets",
    "exclusions",
    "protected_endpoints",
    "budgets",
    "impact_tier_ceiling",
    "allowed_technique_ids",
    "data_handling",
    "emergency_stop_contact_id",
    "effects",
    "content_sha256",
    "signature_algorithm",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "sunderkey.signed-assessment-scope.v1"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^SAS-[0-9A-F]{32}$"
    },
    "issuer": {
      "$ref": "#/$defs/identifier"
    },
    "key_id": {
      "$ref": "#/$defs/identifier"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "assessment_window": {
      "$ref": "#/$defs/window"
    },
    "targets": {
      "$ref": "#/$defs/targets"
    },
    "exclusions": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    },
    "protected_endpoints": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/https_endpoint"
      }
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "impact_tier_ceiling": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "allowed_technique_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "data_handling": {
      "$ref": "#/$defs/data_handling"
    },
    "emergency_stop_contact_id": {
      "$ref": "#/$defs/identifier"
    },
    "effects": {
      "$ref": "#/$defs/effects"
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "signature_algorithm": {
      "const": "Ed25519"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "https_origin": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://(?:[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$"
    },
    "https_endpoint": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2048,
      "pattern": "^https://(?:[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?/[^%\\\\?#]*$"
    },
    "host": {
      "type": "string",
      "minLength": 3,
      "maxLength": 253,
      "pattern": "^[a-z0-9:.-]+$"
    },
    "wildcard": {
      "type": "string",
      "minLength": 5,
      "maxLength": 255,
      "pattern": "^\\*\\.[a-z0-9](?:[a-z0-9.-]*[a-z0-9])$"
    },
    "cidr": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[0-9a-f:.]+/[0-9]{1,3}$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
    },
    "path_prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/(?:[^%\\\\?#/]+(?:/[^%\\\\?#/]+)*)?$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starts_at",
        "ends_at"
      ],
      "properties": {
        "starts_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ends_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "https_origins",
        "exact_hosts",
        "wildcard_subdomains",
        "cidrs",
        "ports",
        "http_methods",
        "path_prefixes"
      ],
      "properties": {
        "https_origins": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/https_origin"
          }
        },
        "exact_hosts": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/host"
          }
        },
        "wildcard_subdomains": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/wildcard"
          }
        },
        "cidrs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/cidr"
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "http_methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/method"
          }
        },
        "path_prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path_prefix"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "https_origins": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "exact_hosts": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "wildcard_subdomains": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "cidrs": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclusion_id",
        "https_origins",
        "exact_hosts",
        "wildcard_subdomains",
        "cidrs",
        "ports",
        "http_methods",
        "path_prefixes"
      ],
      "properties": {
        "exclusion_id": {
          "$ref": "#/$defs/identifier"
        },
        "https_origins": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/https_origin"
          }
        },
        "exact_hosts": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/host"
          }
        },
        "wildcard_subdomains": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/wildcard"
          }
        },
        "cidrs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/cidr"
          }
        },
        "ports": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "http_methods": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/method"
          }
        },
        "path_prefixes": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path_prefix"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "https_origins": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "exact_hosts": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "wildcard_subdomains": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "cidrs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "ports": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "http_methods": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "path_prefixes": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_requests",
        "max_concurrency",
        "max_requests_per_minute"
      ],
      "properties": {
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_requests_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "data_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "collection",
        "storage",
        "retention_days",
        "redaction_required"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "collection": {
          "enum": [
            "metadata_only",
            "minimized_content",
            "authorized_content"
          ]
        },
        "storage": {
          "enum": [
            "none",
            "ephemeral_encrypted",
            "approved_encrypted_repository"
          ]
        },
        "retention_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365
        },
        "redaction_required": {
          "type": "boolean"
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "qualification",
        "routing",
        "deployment",
        "network",
        "execution"
      ],
      "properties": {
        "authority": {
          "const": "none"
        },
        "qualification": {
          "const": "none"
        },
        "routing": {
          "const": "none"
        },
        "deployment": {
          "const": "none"
        },
        "network": {
          "const": "none"
        },
        "execution": {
          "const": "none"
        }
      }
    }
  }
}
