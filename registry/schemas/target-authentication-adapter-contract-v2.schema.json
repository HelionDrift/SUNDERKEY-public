{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.dev/schemas/target-authentication-adapter-contract-v2.schema.json",
  "title": "SUNDERKEY Target Authentication Adapter Contract v2",
  "type": "object",
  "unevaluatedProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/providerBinding" },
    { "$ref": "#/$defs/credentialProvenance" },
    { "$ref": "#/$defs/policy" },
    { "$ref": "#/$defs/command" },
    { "$ref": "#/$defs/flowEvidence" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "tenantRef": {
      "type": "string",
      "pattern": "^tenantref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,190}$"
    },
    "missionRef": {
      "type": "string",
      "pattern": "^missionref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,190}$"
    },
    "scopeRef": {
      "type": "string",
      "pattern": "^scoperef:[A-Za-z0-9][A-Za-z0-9._:/-]{0,190}$"
    },
    "targetRef": {
      "type": "string",
      "pattern": "^targetref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,190}$"
    },
    "principalRef": {
      "type": "string",
      "pattern": "^principalref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,190}$"
    },
    "sessionRef": {
      "type": "string",
      "pattern": "^sessionref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,190}$"
    },
    "nullableSessionRef": {
      "oneOf": [
        { "$ref": "#/$defs/sessionRef" },
        { "type": "null" }
      ]
    },
    "providerRef": {
      "type": "string",
      "pattern": "^providerref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,190}$"
    },
    "instanceRef": {
      "type": "string",
      "pattern": "^instanceref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,190}$"
    },
    "fixtureRef": {
      "type": "string",
      "pattern": "^fixtureref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,190}$"
    },
    "nullableFixtureRef": {
      "oneOf": [
        { "$ref": "#/$defs/fixtureRef" },
        { "type": "null" }
      ]
    },
    "credentialSourceRef": {
      "type": "string",
      "pattern": "^credentialref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,247}$"
    },
    "executionEnvironment": {
      "enum": ["deterministic_fixture", "external_runtime_observation"]
    },
    "mode": {
      "enum": [
        "basic_reference",
        "bearer_reference",
        "form_login_email_otp",
        "form_login_password",
        "form_login_totp",
        "magic_link_reference",
        "oauth2_pkce",
        "oidc_pkce"
      ]
    },
    "protocol": {
      "enum": ["html_form", "http_basic", "http_bearer", "magic_link", "oauth2", "oidc"]
    },
    "factor": {
      "enum": [
        "bearer_reference",
        "email_otp_reference",
        "federated_identity_session_reference",
        "magic_link_reference",
        "password_reference",
        "pkce_verifier_reference",
        "totp_reference"
      ]
    },
    "carrier": {
      "enum": [
        "authorization_header_reference",
        "browser_cookie_jar_reference",
        "browser_redirect_callback_reference",
        "magic_link_callback_reference"
      ]
    },
    "topology": {
      "enum": ["federated_principal", "multi_principal", "single_principal"]
    },
    "operation": {
      "enum": ["acquire_session", "refresh_session", "terminate_session"]
    },
    "flowStage": {
      "enum": [
        "callback_observed",
        "challenge_observed",
        "credential_reference_bound",
        "failure_observed",
        "redirect_observed",
        "session_observed",
        "termination_observed"
      ]
    },
    "outcome": {
      "enum": ["authenticated", "failed", "stopped", "terminated"]
    },
    "failure": {
      "enum": [
        "callback_invalid",
        "challenge_not_satisfied",
        "command_expired",
        "credential_provenance_mismatch",
        "credential_reference_unavailable",
        "evidence_incomplete",
        "fixture_scenario_invalid",
        "mission_stop",
        "operator_stop",
        "policy_binding_mismatch",
        "provider_identity_mismatch",
        "provider_unavailable",
        "session_not_established",
        "session_refresh_failed",
        "session_termination_failed",
        "timeout",
        "unsupported_mode"
      ]
    },
    "nullableFailure": {
      "oneOf": [
        { "$ref": "#/$defs/failure" },
        { "type": "null" }
      ]
    },
    "lifecycleObligation": {
      "enum": [
        "logout_required",
        "mfa_operator_bound",
        "refresh_predecessor_bound",
        "revocation_observation_required",
        "secret_non_persistence",
        "session_isolation"
      ]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser_automation",
        "credential_resolution",
        "lifecycle_action",
        "mfa_response",
        "network",
        "provider_invocation",
        "remote_authentication",
        "session_mutation"
      ],
      "properties": {
        "browser_automation": { "const": "none" },
        "credential_resolution": { "const": "none" },
        "lifecycle_action": { "const": "none" },
        "mfa_response": { "const": "none" },
        "network": { "const": "none" },
        "provider_invocation": { "const": "none" },
        "remote_authentication": { "const": "none" },
        "session_mutation": { "const": "none" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "deployment",
        "live_readiness",
        "parity",
        "qualification",
        "successful_authentication",
        "superiority"
      ],
      "properties": {
        "authorization": { "const": "none" },
        "deployment": { "const": "none" },
        "live_readiness": { "const": "none" },
        "parity": { "const": "none" },
        "qualification": { "const": "none" },
        "successful_authentication": { "const": "none" },
        "superiority": { "const": "none" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_sha256"],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^(?:TAPB|TACP|TAAP|TAAC|TAFE|TAAR|TAAT)-[0-9A-F]{32}$"
        },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "providerBindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_sha256"],
      "properties": {
        "record_id": { "type": "string", "pattern": "^TAPB-[0-9A-F]{32}$" },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "provenanceBindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_sha256"],
      "properties": {
        "record_id": { "type": "string", "pattern": "^TACP-[0-9A-F]{32}$" },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "policyBindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_sha256"],
      "properties": {
        "record_id": { "type": "string", "pattern": "^TAAP-[0-9A-F]{32}$" },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "commandBindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_sha256"],
      "properties": {
        "record_id": { "type": "string", "pattern": "^TAAC-[0-9A-F]{32}$" },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "flowBindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_sha256"],
      "properties": {
        "record_id": { "type": "string", "pattern": "^TAFE-[0-9A-F]{32}$" },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "resultBindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_sha256"],
      "properties": {
        "record_id": { "type": "string", "pattern": "^TAAR-[0-9A-F]{32}$" },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "baseObligations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "logout_required" },
        { "const": "revocation_observation_required" },
        { "const": "secret_non_persistence" },
        { "const": "session_isolation" }
      ],
      "items": false
    },
    "mfaObligations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "logout_required" },
        { "const": "mfa_operator_bound" },
        { "const": "revocation_observation_required" },
        { "const": "secret_non_persistence" },
        { "const": "session_isolation" }
      ],
      "items": false
    },
    "refreshObligations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "logout_required" },
        { "const": "refresh_predecessor_bound" },
        { "const": "revocation_observation_required" },
        { "const": "secret_non_persistence" },
        { "const": "session_isolation" }
      ],
      "items": false
    },
    "mfaRefreshObligations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "logout_required" },
        { "const": "mfa_operator_bound" },
        { "const": "refresh_predecessor_bound" },
        { "const": "revocation_observation_required" },
        { "const": "secret_non_persistence" },
        { "const": "session_isolation" }
      ],
      "items": false
    },
    "profileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "factors",
        "lifecycle_obligations",
        "mode",
        "profile_id",
        "profile_sha256",
        "protocol",
        "successful_flow_stages",
        "topology"
      ],
      "properties": {
        "carrier": { "$ref": "#/$defs/carrier" },
        "factors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/factor" }
        },
        "lifecycle_obligations": {
          "type": "array",
          "minItems": 4,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lifecycleObligation" }
        },
        "mode": { "$ref": "#/$defs/mode" },
        "profile_id": { "type": "string", "pattern": "^TAPE-[0-9A-F]{32}$" },
        "profile_sha256": { "$ref": "#/$defs/digest" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "successful_flow_stages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/flowStage" }
        },
        "topology": { "$ref": "#/$defs/topology" }
      },
      "oneOf": [
        {
          "properties": {
            "carrier": { "const": "authorization_header_reference" },
            "factors": { "const": ["password_reference"] },
            "lifecycle_obligations": { "$ref": "#/$defs/baseObligations" },
            "mode": { "const": "basic_reference" },
            "protocol": { "const": "http_basic" },
            "successful_flow_stages": {
              "const": ["credential_reference_bound", "session_observed"]
            },
            "topology": { "enum": ["multi_principal", "single_principal"] }
          }
        },
        {
          "properties": {
            "carrier": { "const": "authorization_header_reference" },
            "factors": { "const": ["bearer_reference"] },
            "lifecycle_obligations": { "$ref": "#/$defs/baseObligations" },
            "mode": { "const": "bearer_reference" },
            "protocol": { "const": "http_bearer" },
            "successful_flow_stages": {
              "const": ["credential_reference_bound", "session_observed"]
            },
            "topology": { "enum": ["multi_principal", "single_principal"] }
          }
        },
        {
          "properties": {
            "carrier": { "const": "browser_cookie_jar_reference" },
            "factors": { "const": ["password_reference"] },
            "lifecycle_obligations": { "$ref": "#/$defs/baseObligations" },
            "mode": { "const": "form_login_password" },
            "protocol": { "const": "html_form" },
            "successful_flow_stages": {
              "const": ["credential_reference_bound", "session_observed"]
            },
            "topology": { "enum": ["multi_principal", "single_principal"] }
          }
        },
        {
          "properties": {
            "carrier": { "const": "browser_cookie_jar_reference" },
            "factors": { "const": ["email_otp_reference", "password_reference"] },
            "lifecycle_obligations": { "$ref": "#/$defs/mfaObligations" },
            "mode": { "const": "form_login_email_otp" },
            "protocol": { "const": "html_form" },
            "successful_flow_stages": {
              "const": ["credential_reference_bound", "challenge_observed", "session_observed"]
            },
            "topology": { "enum": ["multi_principal", "single_principal"] }
          }
        },
        {
          "properties": {
            "carrier": { "const": "browser_cookie_jar_reference" },
            "factors": { "const": ["password_reference", "totp_reference"] },
            "lifecycle_obligations": { "$ref": "#/$defs/mfaObligations" },
            "mode": { "const": "form_login_totp" },
            "protocol": { "const": "html_form" },
            "successful_flow_stages": {
              "const": ["credential_reference_bound", "challenge_observed", "session_observed"]
            },
            "topology": { "enum": ["multi_principal", "single_principal"] }
          }
        },
        {
          "properties": {
            "carrier": { "const": "magic_link_callback_reference" },
            "factors": { "const": ["magic_link_reference"] },
            "lifecycle_obligations": { "$ref": "#/$defs/baseObligations" },
            "mode": { "const": "magic_link_reference" },
            "protocol": { "const": "magic_link" },
            "successful_flow_stages": {
              "const": ["credential_reference_bound", "callback_observed", "session_observed"]
            },
            "topology": { "enum": ["multi_principal", "single_principal"] }
          }
        },
        {
          "properties": {
            "carrier": { "const": "browser_redirect_callback_reference" },
            "factors": {
              "const": ["federated_identity_session_reference", "pkce_verifier_reference"]
            },
            "lifecycle_obligations": { "$ref": "#/$defs/baseObligations" },
            "mode": { "const": "oauth2_pkce" },
            "protocol": { "const": "oauth2" },
            "successful_flow_stages": {
              "const": [
                "credential_reference_bound",
                "redirect_observed",
                "callback_observed",
                "session_observed"
              ]
            },
            "topology": { "enum": ["federated_principal", "multi_principal"] }
          }
        },
        {
          "properties": {
            "carrier": { "const": "browser_redirect_callback_reference" },
            "factors": {
              "const": ["federated_identity_session_reference", "pkce_verifier_reference"]
            },
            "lifecycle_obligations": { "$ref": "#/$defs/baseObligations" },
            "mode": { "const": "oidc_pkce" },
            "protocol": { "const": "oidc" },
            "successful_flow_stages": {
              "const": [
                "credential_reference_bound",
                "redirect_observed",
                "callback_observed",
                "session_observed"
              ]
            },
            "topology": { "enum": ["federated_principal", "multi_principal"] }
          }
        }
      ]
    },
    "v1Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_receipt_id",
        "admission_receipt_sha256",
        "execution_policy_id",
        "execution_policy_sha256",
        "execution_request_id",
        "execution_request_sha256",
        "intent_sha256",
        "runtime_policy_id",
        "runtime_policy_sha256",
        "runtime_receipt_id",
        "runtime_receipt_sha256"
      ],
      "properties": {
        "admission_receipt_id": {
          "type": "string",
          "pattern": "^ECAR-[0-9A-F]{32}$"
        },
        "admission_receipt_sha256": { "$ref": "#/$defs/digest" },
        "execution_policy_id": {
          "type": "string",
          "pattern": "^ECP-[0-9A-F]{32}$"
        },
        "execution_policy_sha256": { "$ref": "#/$defs/digest" },
        "execution_request_id": {
          "type": "string",
          "pattern": "^ECRQ-[0-9A-F]{32}$"
        },
        "execution_request_sha256": { "$ref": "#/$defs/digest" },
        "intent_sha256": { "$ref": "#/$defs/digest" },
        "runtime_policy_id": {
          "type": "string",
          "pattern": "^ATSP-[0-9A-F]{32}$"
        },
        "runtime_policy_sha256": { "$ref": "#/$defs/digest" },
        "runtime_receipt_id": {
          "type": "string",
          "pattern": "^ASR-[0-9A-F]{32}$"
        },
        "runtime_receipt_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "providerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_sha256",
        "binding_id",
        "binding_sha256",
        "claims",
        "configuration_sha256",
        "effects",
        "environment_attestation_sha256",
        "execution_environment",
        "expires_at",
        "implementation_name",
        "implementation_version",
        "instance_ref",
        "issued_at",
        "provider_ref",
        "record_kind",
        "schema_version",
        "supported_operations",
        "supported_profiles"
      ],
      "properties": {
        "artifact_sha256": { "$ref": "#/$defs/digest" },
        "binding_id": { "type": "string", "pattern": "^TAPB-[0-9A-F]{32}$" },
        "binding_sha256": { "$ref": "#/$defs/digest" },
        "claims": { "$ref": "#/$defs/claims" },
        "configuration_sha256": { "$ref": "#/$defs/digest" },
        "effects": { "$ref": "#/$defs/effects" },
        "environment_attestation_sha256": { "$ref": "#/$defs/digest" },
        "execution_environment": { "$ref": "#/$defs/executionEnvironment" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "implementation_name": { "$ref": "#/$defs/identifier" },
        "implementation_version": { "$ref": "#/$defs/version" },
        "instance_ref": { "$ref": "#/$defs/instanceRef" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "provider_ref": { "$ref": "#/$defs/providerRef" },
        "record_kind": { "const": "target_authentication_provider_binding" },
        "schema_version": { "type": "integer", "const": 2 },
        "supported_operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operation" }
        },
        "supported_profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profileEvidence" }
        }
      }
    },
    "credentialProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "created_at",
        "descriptor_id",
        "descriptor_sha256",
        "effects",
        "factor",
        "lease_expires_at",
        "lease_id",
        "lease_issued_at",
        "lease_mode",
        "lease_sha256",
        "lease_use_number",
        "mapping_attestation_sha256",
        "principal_ref",
        "provenance_id",
        "provenance_sha256",
        "provider_binding",
        "record_kind",
        "reference_relation",
        "schema_version",
        "source_credential_ref",
        "transport_credential_ref_sha256"
      ],
      "properties": {
        "claims": { "$ref": "#/$defs/claims" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "descriptor_id": { "type": "string", "pattern": "^CBD-[0-9A-F]{32}$" },
        "descriptor_sha256": { "$ref": "#/$defs/digest" },
        "effects": { "$ref": "#/$defs/effects" },
        "factor": { "$ref": "#/$defs/factor" },
        "lease_expires_at": { "$ref": "#/$defs/timestamp" },
        "lease_id": { "type": "string", "pattern": "^CLZ-[0-9A-F]{32}$" },
        "lease_issued_at": { "$ref": "#/$defs/timestamp" },
        "lease_mode": { "enum": ["one_time", "session_bound"] },
        "lease_sha256": { "$ref": "#/$defs/digest" },
        "lease_use_number": { "type": "integer", "minimum": 1, "maximum": 100 },
        "mapping_attestation_sha256": { "$ref": "#/$defs/digest" },
        "principal_ref": { "$ref": "#/$defs/principalRef" },
        "provenance_id": { "type": "string", "pattern": "^TACP-[0-9A-F]{32}$" },
        "provenance_sha256": { "$ref": "#/$defs/digest" },
        "provider_binding": { "$ref": "#/$defs/providerBindingRef" },
        "record_kind": { "const": "target_credential_provenance" },
        "reference_relation": { "const": "source_reference_to_transport_reference_digest" },
        "schema_version": { "type": "integer", "const": 2 },
        "source_credential_ref": { "$ref": "#/$defs/credentialSourceRef" },
        "transport_credential_ref_sha256": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "lease_mode": { "const": "one_time" } },
            "required": ["lease_mode"]
          },
          "then": {
            "properties": { "lease_use_number": { "const": 1 } }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "credential_provenance",
        "effects",
        "expires_at",
        "issued_at",
        "lifecycle_obligations",
        "maximum_attempts",
        "mission_ref",
        "mode",
        "policy_id",
        "policy_sha256",
        "profile_evidence",
        "provider_binding",
        "record_kind",
        "schema_version",
        "scope_ref",
        "target_ref",
        "tenant_ref",
        "v1_evidence"
      ],
      "properties": {
        "claims": { "$ref": "#/$defs/claims" },
        "credential_provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/provenanceBindingRef" }
        },
        "effects": { "$ref": "#/$defs/effects" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "lifecycle_obligations": {
          "type": "array",
          "minItems": 4,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lifecycleObligation" }
        },
        "maximum_attempts": { "type": "integer", "minimum": 1, "maximum": 1 },
        "mission_ref": { "$ref": "#/$defs/missionRef" },
        "mode": { "$ref": "#/$defs/mode" },
        "policy_id": { "type": "string", "pattern": "^TAAP-[0-9A-F]{32}$" },
        "policy_sha256": { "$ref": "#/$defs/digest" },
        "profile_evidence": { "$ref": "#/$defs/profileEvidence" },
        "provider_binding": { "$ref": "#/$defs/providerBindingRef" },
        "record_kind": { "const": "target_authentication_policy" },
        "schema_version": { "type": "integer", "const": 2 },
        "scope_ref": { "$ref": "#/$defs/scopeRef" },
        "target_ref": { "$ref": "#/$defs/targetRef" },
        "tenant_ref": { "$ref": "#/$defs/tenantRef" },
        "v1_evidence": { "$ref": "#/$defs/v1Evidence" }
      },
      "allOf": [
        { "$ref": "#/$defs/modeAndProfileMatch" },
        { "$ref": "#/$defs/policyLifecycleByMode" },
        { "$ref": "#/$defs/credentialCardinalityByProfile" }
      ]
    },
    "modeAndProfileMatch": {
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "basic_reference" } } },
          "then": { "properties": { "profile_evidence": { "properties": { "mode": { "const": "basic_reference" } } } } }
        },
        {
          "if": { "properties": { "mode": { "const": "bearer_reference" } } },
          "then": { "properties": { "profile_evidence": { "properties": { "mode": { "const": "bearer_reference" } } } } }
        },
        {
          "if": { "properties": { "mode": { "const": "form_login_email_otp" } } },
          "then": { "properties": { "profile_evidence": { "properties": { "mode": { "const": "form_login_email_otp" } } } } }
        },
        {
          "if": { "properties": { "mode": { "const": "form_login_password" } } },
          "then": { "properties": { "profile_evidence": { "properties": { "mode": { "const": "form_login_password" } } } } }
        },
        {
          "if": { "properties": { "mode": { "const": "form_login_totp" } } },
          "then": { "properties": { "profile_evidence": { "properties": { "mode": { "const": "form_login_totp" } } } } }
        },
        {
          "if": { "properties": { "mode": { "const": "magic_link_reference" } } },
          "then": { "properties": { "profile_evidence": { "properties": { "mode": { "const": "magic_link_reference" } } } } }
        },
        {
          "if": { "properties": { "mode": { "const": "oauth2_pkce" } } },
          "then": { "properties": { "profile_evidence": { "properties": { "mode": { "const": "oauth2_pkce" } } } } }
        },
        {
          "if": { "properties": { "mode": { "const": "oidc_pkce" } } },
          "then": { "properties": { "profile_evidence": { "properties": { "mode": { "const": "oidc_pkce" } } } } }
        }
      ]
    },
    "policyLifecycleByMode": {
      "if": {
        "properties": {
          "mode": { "enum": ["form_login_email_otp", "form_login_totp"] }
        },
        "required": ["mode"]
      },
      "then": { "properties": { "lifecycle_obligations": { "$ref": "#/$defs/mfaObligations" } } },
      "else": { "properties": { "lifecycle_obligations": { "$ref": "#/$defs/baseObligations" } } }
    },
    "credentialCardinalityByProfile": {
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "form_login_email_otp",
                  "form_login_totp",
                  "oauth2_pkce",
                  "oidc_pkce"
                ]
              },
              "profile_evidence": {
                "properties": { "topology": { "const": "multi_principal" } },
                "required": ["topology"]
              }
            },
            "required": ["mode", "profile_evidence"]
          },
          "then": {
            "properties": { "credential_provenance": { "minItems": 4 } }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "basic_reference",
                  "bearer_reference",
                  "form_login_password",
                  "magic_link_reference"
                ]
              },
              "profile_evidence": {
                "properties": { "topology": { "const": "multi_principal" } },
                "required": ["topology"]
              }
            },
            "required": ["mode", "profile_evidence"]
          },
          "then": {
            "properties": { "credential_provenance": { "minItems": 2 } }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "form_login_email_otp",
                  "form_login_totp",
                  "oauth2_pkce",
                  "oidc_pkce"
                ]
              },
              "profile_evidence": {
                "properties": {
                  "topology": { "enum": ["federated_principal", "single_principal"] }
                },
                "required": ["topology"]
              }
            },
            "required": ["mode", "profile_evidence"]
          },
          "then": {
            "properties": {
              "credential_provenance": { "minItems": 2, "maxItems": 2 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "basic_reference",
                  "bearer_reference",
                  "form_login_password",
                  "magic_link_reference"
                ]
              },
              "profile_evidence": {
                "properties": {
                  "topology": { "enum": ["federated_principal", "single_principal"] }
                },
                "required": ["topology"]
              }
            },
            "required": ["mode", "profile_evidence"]
          },
          "then": {
            "properties": {
              "credential_provenance": { "minItems": 1, "maxItems": 1 }
            }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "command_id",
        "command_sha256",
        "credential_provenance",
        "effects",
        "execution_environment",
        "expires_at",
        "fixture_scenario_ref",
        "issued_at",
        "lifecycle_obligations",
        "mode",
        "operation",
        "policy_binding",
        "predecessor_session_ref",
        "profile_evidence",
        "provider_binding",
        "record_kind",
        "requested_session_ref",
        "schema_version",
        "v1_evidence"
      ],
      "properties": {
        "claims": { "$ref": "#/$defs/claims" },
        "command_id": { "type": "string", "pattern": "^TAAC-[0-9A-F]{32}$" },
        "command_sha256": { "$ref": "#/$defs/digest" },
        "credential_provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/provenanceBindingRef" }
        },
        "effects": { "$ref": "#/$defs/effects" },
        "execution_environment": { "$ref": "#/$defs/executionEnvironment" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "fixture_scenario_ref": { "$ref": "#/$defs/nullableFixtureRef" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "lifecycle_obligations": {
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lifecycleObligation" }
        },
        "mode": { "$ref": "#/$defs/mode" },
        "operation": { "$ref": "#/$defs/operation" },
        "policy_binding": { "$ref": "#/$defs/policyBindingRef" },
        "predecessor_session_ref": { "$ref": "#/$defs/nullableSessionRef" },
        "profile_evidence": { "$ref": "#/$defs/profileEvidence" },
        "provider_binding": { "$ref": "#/$defs/providerBindingRef" },
        "record_kind": { "const": "target_authentication_command" },
        "requested_session_ref": { "$ref": "#/$defs/nullableSessionRef" },
        "schema_version": { "type": "integer", "const": 2 },
        "v1_evidence": { "$ref": "#/$defs/v1Evidence" }
      },
      "allOf": [
        { "$ref": "#/$defs/modeAndProfileMatch" },
        { "$ref": "#/$defs/credentialCardinalityByProfile" },
        {
          "if": {
            "properties": { "execution_environment": { "const": "deterministic_fixture" } },
            "required": ["execution_environment"]
          },
          "then": { "properties": { "fixture_scenario_ref": { "$ref": "#/$defs/fixtureRef" } } },
          "else": { "properties": { "fixture_scenario_ref": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "operation": { "const": "acquire_session" } },
            "required": ["operation"]
          },
          "then": {
            "properties": {
              "predecessor_session_ref": { "type": "null" },
              "requested_session_ref": { "$ref": "#/$defs/sessionRef" }
            }
          }
        },
        {
          "if": {
            "properties": { "operation": { "const": "refresh_session" } },
            "required": ["operation"]
          },
          "then": {
            "properties": {
              "predecessor_session_ref": { "$ref": "#/$defs/sessionRef" },
              "requested_session_ref": { "$ref": "#/$defs/sessionRef" }
            }
          }
        },
        {
          "if": {
            "properties": { "operation": { "const": "terminate_session" } },
            "required": ["operation"]
          },
          "then": {
            "properties": {
              "predecessor_session_ref": { "$ref": "#/$defs/sessionRef" },
              "requested_session_ref": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": { "enum": ["form_login_email_otp", "form_login_totp"] },
              "operation": { "const": "refresh_session" }
            },
            "required": ["mode", "operation"]
          },
          "then": { "properties": { "lifecycle_obligations": { "$ref": "#/$defs/mfaRefreshObligations" } } }
        },
        {
          "if": {
            "properties": {
              "mode": { "enum": ["form_login_email_otp", "form_login_totp"] },
              "operation": { "enum": ["acquire_session", "terminate_session"] }
            },
            "required": ["mode", "operation"]
          },
          "then": { "properties": { "lifecycle_obligations": { "$ref": "#/$defs/mfaObligations" } } }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "basic_reference",
                  "bearer_reference",
                  "form_login_password",
                  "magic_link_reference",
                  "oauth2_pkce",
                  "oidc_pkce"
                ]
              },
              "operation": { "const": "refresh_session" }
            },
            "required": ["mode", "operation"]
          },
          "then": { "properties": { "lifecycle_obligations": { "$ref": "#/$defs/refreshObligations" } } }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "basic_reference",
                  "bearer_reference",
                  "form_login_password",
                  "magic_link_reference",
                  "oauth2_pkce",
                  "oidc_pkce"
                ]
              },
              "operation": { "enum": ["acquire_session", "terminate_session"] }
            },
            "required": ["mode", "operation"]
          },
          "then": { "properties": { "lifecycle_obligations": { "$ref": "#/$defs/baseObligations" } } }
        }
      ]
    },
    "flowEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "command_binding",
        "effects",
        "environment_attestation_sha256",
        "evidence_id",
        "evidence_sha256",
        "execution_environment",
        "failure_code",
        "input_evidence_sha256",
        "observed_at",
        "output_evidence_sha256",
        "provider_attestation_sha256",
        "provider_binding",
        "record_kind",
        "schema_version",
        "sequence",
        "stage"
      ],
      "properties": {
        "claims": { "$ref": "#/$defs/claims" },
        "command_binding": { "$ref": "#/$defs/commandBindingRef" },
        "effects": { "$ref": "#/$defs/effects" },
        "environment_attestation_sha256": { "$ref": "#/$defs/nullableDigest" },
        "evidence_id": { "type": "string", "pattern": "^TAFE-[0-9A-F]{32}$" },
        "evidence_sha256": { "$ref": "#/$defs/digest" },
        "execution_environment": { "$ref": "#/$defs/executionEnvironment" },
        "failure_code": { "$ref": "#/$defs/nullableFailure" },
        "input_evidence_sha256": { "$ref": "#/$defs/digest" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "output_evidence_sha256": { "$ref": "#/$defs/nullableDigest" },
        "provider_attestation_sha256": { "$ref": "#/$defs/nullableDigest" },
        "provider_binding": { "$ref": "#/$defs/providerBindingRef" },
        "record_kind": { "const": "target_authentication_flow_evidence" },
        "schema_version": { "type": "integer", "const": 2 },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 128 },
        "stage": { "$ref": "#/$defs/flowStage" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "execution_environment": { "const": "deterministic_fixture" } },
            "required": ["execution_environment"]
          },
          "then": {
            "properties": {
              "environment_attestation_sha256": { "type": "null" },
              "provider_attestation_sha256": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "environment_attestation_sha256": { "$ref": "#/$defs/digest" },
              "provider_attestation_sha256": { "$ref": "#/$defs/digest" }
            }
          }
        },
        {
          "if": {
            "properties": { "stage": { "const": "failure_observed" } },
            "required": ["stage"]
          },
          "then": { "properties": { "failure_code": { "$ref": "#/$defs/failure" } } },
          "else": { "properties": { "failure_code": { "type": "null" } } }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "command_binding",
        "completed_at",
        "effects",
        "environment_attestation_sha256",
        "execution_environment",
        "failure_code",
        "flow_evidence",
        "outcome",
        "pending_lifecycle_obligations",
        "provider_attestation_sha256",
        "provider_binding",
        "record_kind",
        "result_id",
        "result_sha256",
        "resulting_session_ref",
        "satisfied_lifecycle_obligations",
        "schema_version",
        "session_evidence_sha256"
      ],
      "properties": {
        "claims": { "$ref": "#/$defs/claims" },
        "command_binding": { "$ref": "#/$defs/commandBindingRef" },
        "completed_at": { "$ref": "#/$defs/timestamp" },
        "effects": { "$ref": "#/$defs/effects" },
        "environment_attestation_sha256": { "$ref": "#/$defs/nullableDigest" },
        "execution_environment": { "$ref": "#/$defs/executionEnvironment" },
        "failure_code": { "$ref": "#/$defs/nullableFailure" },
        "flow_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/flowBindingRef" }
        },
        "outcome": { "$ref": "#/$defs/outcome" },
        "pending_lifecycle_obligations": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lifecycleObligation" }
        },
        "provider_attestation_sha256": { "$ref": "#/$defs/nullableDigest" },
        "provider_binding": { "$ref": "#/$defs/providerBindingRef" },
        "record_kind": { "const": "target_authentication_result" },
        "result_id": { "type": "string", "pattern": "^TAAR-[0-9A-F]{32}$" },
        "result_sha256": { "$ref": "#/$defs/digest" },
        "resulting_session_ref": { "$ref": "#/$defs/nullableSessionRef" },
        "satisfied_lifecycle_obligations": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lifecycleObligation" }
        },
        "schema_version": { "type": "integer", "const": 2 },
        "session_evidence_sha256": { "$ref": "#/$defs/nullableDigest" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "execution_environment": { "const": "deterministic_fixture" } },
            "required": ["execution_environment"]
          },
          "then": {
            "properties": {
              "environment_attestation_sha256": { "type": "null" },
              "provider_attestation_sha256": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "environment_attestation_sha256": { "$ref": "#/$defs/digest" },
              "provider_attestation_sha256": { "$ref": "#/$defs/digest" }
            }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "const": "authenticated" } },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "failure_code": { "type": "null" },
              "pending_lifecycle_obligations": {
                "allOf": [
                  { "contains": { "const": "logout_required" } },
                  { "contains": { "const": "revocation_observation_required" } }
                ]
              },
              "resulting_session_ref": { "$ref": "#/$defs/sessionRef" },
              "session_evidence_sha256": { "$ref": "#/$defs/digest" }
            }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "const": "terminated" } },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "failure_code": { "type": "null" },
              "pending_lifecycle_obligations": { "maxItems": 0 },
              "resulting_session_ref": { "type": "null" },
              "session_evidence_sha256": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "enum": ["failed", "stopped"] } },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "failure_code": { "$ref": "#/$defs/failure" },
              "resulting_session_ref": { "type": "null" },
              "session_evidence_sha256": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "const": "stopped" } },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "failure_code": { "enum": ["mission_stop", "operator_stop"] }
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "command_binding",
        "effects",
        "execution_environment",
        "flow_evidence",
        "issued_at",
        "lifecycle_complete",
        "policy_binding",
        "provider_binding",
        "receipt_id",
        "receipt_sha256",
        "record_kind",
        "result_binding",
        "schema_version",
        "verification_status"
      ],
      "properties": {
        "claims": { "$ref": "#/$defs/claims" },
        "command_binding": { "$ref": "#/$defs/commandBindingRef" },
        "effects": { "$ref": "#/$defs/effects" },
        "execution_environment": { "$ref": "#/$defs/executionEnvironment" },
        "flow_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/flowBindingRef" }
        },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "lifecycle_complete": { "type": "boolean" },
        "policy_binding": { "$ref": "#/$defs/policyBindingRef" },
        "provider_binding": { "$ref": "#/$defs/providerBindingRef" },
        "receipt_id": { "type": "string", "pattern": "^TAAT-[0-9A-F]{32}$" },
        "receipt_sha256": { "$ref": "#/$defs/digest" },
        "record_kind": { "const": "target_authentication_receipt" },
        "result_binding": { "$ref": "#/$defs/resultBindingRef" },
        "schema_version": { "type": "integer", "const": 2 },
        "verification_status": { "const": "verified_contract_chain" }
      }
    }
  }
}
