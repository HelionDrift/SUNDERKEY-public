{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/provider-evidence-custody-decision-record-v1.json",
  "title": "SUNDERKEY Provider Evidence Custody Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_sha256",
    "decision_id",
    "decision_status",
    "decision_effect",
    "source_dossier",
    "approval",
    "selected_options",
    "recommendation_alignment",
    "required_owner_inputs",
    "nonnegotiable_requirements",
    "authorized_next_steps",
    "prohibited_effects",
    "implementation_status",
    "qualification_effect",
    "registry_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "pattern": "^ECR-[0-9A-F]{32}$"},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "decision_id": {"const": "D013"},
    "decision_status": {"const": "approved_operator_asserted_unsigned"},
    "decision_effect": {
      "const": "provider_evidence_custody_contract_implementation_authorized"
    },
    "source_dossier": {"$ref": "#/$defs/sourceDossier"},
    "approval": {"$ref": "#/$defs/approval"},
    "selected_options": {
      "type": "object",
      "minProperties": 12,
      "maxProperties": 12,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9_]{8,100}$"
      },
      "propertyNames": {"pattern": "^[a-z0-9_]{8,64}$"}
    },
    "recommendation_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_option_count",
        "selected_recommended_option_count",
        "all_recommended_options_selected"
      ],
      "properties": {
        "selected_option_count": {"const": 12},
        "selected_recommended_option_count": {"const": 12},
        "all_recommended_options_selected": {"const": true}
      }
    },
    "required_owner_inputs": {"$ref": "#/$defs/ownerInputs"},
    "nonnegotiable_requirements": {"$ref": "#/$defs/nonnegotiables"},
    "authorized_next_steps": {"$ref": "#/$defs/authorizedSteps"},
    "prohibited_effects": {"$ref": "#/$defs/prohibitedEffects"},
    "implementation_status": {"const": "not_started"},
    "qualification_effect": {"const": "none"},
    "registry_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceDossier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "sha256"],
      "properties": {
        "report_id": {"type": "string", "pattern": "^ECD-[0-9A-F]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_status",
        "authority_role",
        "approver_id",
        "approved_at",
        "rationale",
        "identity_assurance"
      ],
      "properties": {
        "decision_status": {"const": "approved"},
        "authority_role": {"const": "repository_owner"},
        "approver_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "approved_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "rationale": {"type": "string", "minLength": 16, "maxLength": 2000},
        "identity_assurance": {"const": "operator_asserted_unsigned"}
      }
    },
    "ownerInputs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{8,160}$"}
    },
    "nonnegotiables": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{8,180}$"}
    },
    "authorizedSteps": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{8,180}$"}
    },
    "prohibitedEffects": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^does_not_[a-z0-9_]{8,180}$"}
    }
  }
}
