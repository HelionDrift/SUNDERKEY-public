{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.dev/schemas/crypto-pki-specialist-contract-v1.schema.json",
  "title": "SUNDERKEY Cryptography and PKI Specialist Contract",
  "oneOf": [
    { "$ref": "#/$defs/declaration" },
    { "$ref": "#/$defs/evidence" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reference": {
      "type": "string",
      "pattern": "^(tenantref|contextref|scoperef|authorizationref|admissionref|evidenceplanref|policyref|trustref|budgetref|capabilityref|evidenceref|collectorref|ruleref|remediationref):[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "family": {
      "enum": [
        "cryptographic_protocols",
        "pki_trust",
        "tls_mtls",
        "certificate_lifecycle",
        "secrets_key_management",
        "signing_verification",
        "token_identity_protocols",
        "cryptographic_misuse"
      ]
    },
    "check": {
      "enum": [
        "protocol_version_policy",
        "cipher_suite_policy",
        "trust_path_policy",
        "revocation_status_policy",
        "tls_endpoint_configuration",
        "mtls_identity_binding",
        "certificate_issuance",
        "certificate_renewal_rotation",
        "secret_inventory_hygiene",
        "key_custody_rotation",
        "signature_verification",
        "token_validation",
        "identity_protocol_binding",
        "algorithm_parameter_misuse",
        "nonce_iv_reuse_policy",
        "key_usage_separation"
      ]
    },
    "evidenceKind": {
      "enum": [
        "synthetic_certificate_manifest",
        "sanitized_tls_configuration",
        "sanitized_handshake_summary",
        "sanitized_trust_path_summary",
        "sanitized_revocation_summary",
        "sanitized_key_lifecycle_metadata",
        "sanitized_secret_inventory_summary",
        "sanitized_signature_policy",
        "sanitized_token_claims_schema",
        "sanitized_identity_protocol_metadata",
        "sanitized_source_analysis_finding"
      ]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builtin_network",
        "builtin_scanner",
        "builtin_command_execution",
        "builtin_key_generation",
        "builtin_key_access",
        "builtin_secret_access",
        "builtin_credential_handling",
        "builtin_target_interaction",
        "injected_adapter_invocation"
      ],
      "properties": {
        "builtin_network": { "const": "none" },
        "builtin_scanner": { "const": "none" },
        "builtin_command_execution": { "const": "none" },
        "builtin_key_generation": { "const": "none" },
        "builtin_key_access": { "const": "none" },
        "builtin_secret_access": { "const": "none" },
        "builtin_credential_handling": { "const": "none" },
        "builtin_target_interaction": { "const": "none" },
        "injected_adapter_invocation": { "const": "caller_supplied_repository_only" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_ref",
        "maximum_evidence_items",
        "maximum_findings",
        "maximum_observed_bytes",
        "maximum_duration_seconds"
      ],
      "properties": {
        "budget_ref": { "$ref": "#/$defs/reference" },
        "maximum_evidence_items": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maximum_findings": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maximum_observed_bytes": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "maximum_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_ref",
        "context_ref",
        "context_binding_sha256",
        "scope_ref",
        "scope_sha256",
        "authorization_ref",
        "authorization_sha256",
        "action_admission_ref",
        "action_admission_sha256",
        "evidence_plan_ref",
        "evidence_plan_sha256",
        "cryptographic_policy_ref",
        "cryptographic_policy_sha256",
        "trust_policy_ref",
        "trust_policy_sha256",
        "authorized_at",
        "authorization_expires_at",
        "repository_assessment_authorized",
        "target_interaction_authorized",
        "budget",
        "budget_sha256"
      ],
      "properties": {
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "context_ref": { "$ref": "#/$defs/reference" },
        "context_binding_sha256": { "$ref": "#/$defs/sha256" },
        "scope_ref": { "$ref": "#/$defs/reference" },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "authorization_ref": { "$ref": "#/$defs/reference" },
        "authorization_sha256": { "$ref": "#/$defs/sha256" },
        "action_admission_ref": { "$ref": "#/$defs/reference" },
        "action_admission_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_plan_ref": { "$ref": "#/$defs/reference" },
        "evidence_plan_sha256": { "$ref": "#/$defs/sha256" },
        "cryptographic_policy_ref": { "$ref": "#/$defs/reference" },
        "cryptographic_policy_sha256": { "$ref": "#/$defs/sha256" },
        "trust_policy_ref": { "$ref": "#/$defs/reference" },
        "trust_policy_sha256": { "$ref": "#/$defs/sha256" },
        "authorized_at": { "$ref": "#/$defs/utc" },
        "authorization_expires_at": { "$ref": "#/$defs/utc" },
        "repository_assessment_authorized": { "const": true },
        "target_interaction_authorized": { "const": false },
        "budget": { "$ref": "#/$defs/budget" },
        "budget_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_id",
        "declaration_sha256",
        "kind",
        "schema_version",
        "boundary_effects",
        "family",
        "capability_ref",
        "checks",
        "evidence_policy",
        "qualification_effect"
      ],
      "properties": {
        "declaration_id": { "type": "string", "pattern": "^CPD-[0-9A-F]{32}$" },
        "declaration_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "crypto_pki_specialist_capability_declaration" },
        "schema_version": { "const": 1 },
        "boundary_effects": { "$ref": "#/$defs/effects" },
        "family": { "$ref": "#/$defs/family" },
        "capability_ref": { "$ref": "#/$defs/reference" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/check" }
        },
        "evidence_policy": { "const": "sanitized_or_synthetic_digest_only" },
        "qualification_effect": { "const": "none" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_sha256",
        "kind",
        "schema_version",
        "evidence_ref",
        "evidence_kind",
        "content_sha256",
        "source_manifest_sha256",
        "collector_ref",
        "collected_at",
        "observed_bytes",
        "provenance_chain",
        "sanitized",
        "contains_private_key",
        "contains_secret_value",
        "contains_credential",
        "contains_live_target_capture",
        "includes_executable_material",
        "qualification_effect"
      ],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^CPE-[0-9A-F]{32}$" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "crypto_pki_evidence_provenance" },
        "schema_version": { "const": 1 },
        "evidence_ref": { "$ref": "#/$defs/reference" },
        "evidence_kind": { "$ref": "#/$defs/evidenceKind" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "collector_ref": { "$ref": "#/$defs/reference" },
        "collected_at": { "$ref": "#/$defs/utc" },
        "observed_bytes": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "provenance_chain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "sanitized": { "const": true },
        "contains_private_key": { "const": false },
        "contains_secret_value": { "const": false },
        "contains_credential": { "const": false },
        "contains_live_target_capture": { "const": false },
        "includes_executable_material": { "const": false },
        "qualification_effect": { "const": "none" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_sha256",
        "kind",
        "schema_version",
        "boundary_effects",
        "declaration_id",
        "declaration_sha256",
        "family",
        "capability_ref",
        "check",
        "context",
        "assessment_context_sha256",
        "evidence",
        "evidence_set_sha256",
        "expected_policy_sha256",
        "estimated_evidence_items",
        "estimated_findings",
        "estimated_observed_bytes",
        "estimated_duration_seconds",
        "idempotency_sha256",
        "issued_at",
        "expires_at",
        "qualification_effect"
      ],
      "properties": {
        "request_id": { "type": "string", "pattern": "^CPR-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "crypto_pki_specialist_assessment_request" },
        "schema_version": { "const": 1 },
        "boundary_effects": { "$ref": "#/$defs/effects" },
        "declaration_id": { "type": "string", "pattern": "^CPD-[0-9A-F]{32}$" },
        "declaration_sha256": { "$ref": "#/$defs/sha256" },
        "family": { "$ref": "#/$defs/family" },
        "capability_ref": { "$ref": "#/$defs/reference" },
        "check": { "$ref": "#/$defs/check" },
        "context": { "$ref": "#/$defs/context" },
        "assessment_context_sha256": { "$ref": "#/$defs/sha256" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "evidence_set_sha256": { "$ref": "#/$defs/sha256" },
        "expected_policy_sha256": { "$ref": "#/$defs/sha256" },
        "estimated_evidence_items": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "estimated_findings": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "estimated_observed_bytes": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "estimated_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "idempotency_sha256": { "$ref": "#/$defs/sha256" },
        "issued_at": { "$ref": "#/$defs/utc" },
        "expires_at": { "$ref": "#/$defs/utc" },
        "qualification_effect": { "const": "none" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "finding_sha256",
        "category",
        "severity",
        "rule_ref",
        "evidence_refs",
        "remediation_ref",
        "confidence_basis"
      ],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^CPF-[0-9A-F]{32}$" },
        "finding_sha256": { "$ref": "#/$defs/sha256" },
        "category": {
          "enum": [
            "deprecated_algorithm",
            "weak_parameter_policy",
            "protocol_downgrade_policy",
            "trust_path_gap",
            "revocation_gap",
            "host_identity_gap",
            "mtls_binding_gap",
            "certificate_lifecycle_gap",
            "secret_custody_gap",
            "key_lifecycle_gap",
            "signature_validation_gap",
            "token_validation_gap",
            "identity_protocol_gap",
            "nonce_iv_policy_gap",
            "key_usage_separation_gap"
          ]
        },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "rule_ref": { "$ref": "#/$defs/reference" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "remediation_ref": { "$ref": "#/$defs/reference" },
        "confidence_basis": {
          "enum": [
            "deterministic_policy_match",
            "provenance_bounded_inference",
            "manual_review_required"
          ]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_sha256",
        "assessment_context_sha256",
        "evidence_set_sha256",
        "disposition",
        "outcome",
        "findings",
        "analysis_evidence_sha256",
        "actual_evidence_items",
        "actual_findings",
        "actual_observed_bytes",
        "actual_duration_seconds",
        "network_call_performed",
        "scanner_execution_performed",
        "command_execution_performed",
        "key_generation_performed",
        "key_access_performed",
        "secret_access_performed",
        "credential_handling_performed",
        "target_interaction_performed",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "request_id": { "type": "string", "pattern": "^CPR-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "assessment_context_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_set_sha256": { "$ref": "#/$defs/sha256" },
        "disposition": { "enum": ["completed", "denied", "failed"] },
        "outcome": { "enum": ["pass", "control_gap", "inconclusive"] },
        "findings": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/finding" }
        },
        "analysis_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "actual_evidence_items": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "actual_findings": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "actual_observed_bytes": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "actual_duration_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "network_call_performed": { "const": false },
        "scanner_execution_performed": { "const": false },
        "command_execution_performed": { "const": false },
        "key_generation_performed": { "const": false },
        "key_access_performed": { "const": false },
        "secret_access_performed": { "const": false },
        "credential_handling_performed": { "const": false },
        "target_interaction_performed": { "const": false },
        "started_at": { "$ref": "#/$defs/utc" },
        "completed_at": { "$ref": "#/$defs/utc" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_sha256",
        "kind",
        "schema_version",
        "boundary_effects",
        "request",
        "observation",
        "status",
        "qualification_effect"
      ],
      "properties": {
        "receipt_id": { "type": "string", "pattern": "^CPC-[0-9A-F]{32}$" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "crypto_pki_specialist_assessment_receipt" },
        "schema_version": { "const": 1 },
        "boundary_effects": { "$ref": "#/$defs/effects" },
        "request": { "$ref": "#/$defs/request" },
        "observation": { "$ref": "#/$defs/observation" },
        "status": { "enum": ["completed", "denied", "failed"] },
        "qualification_effect": { "const": "none" }
      }
    }
  }
}
