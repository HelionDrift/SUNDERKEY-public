{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/finding-lifecycle-snapshot-v1.schema.json",
  "title": "SUNDERKEY Finding Lifecycle Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "snapshot_id",
    "snapshot_sha256",
    "parent_snapshot_sha256",
    "finding_id",
    "finding_version",
    "state",
    "identity",
    "dedupe_fingerprint",
    "classification",
    "evidence_digests",
    "created_at",
    "updated_at",
    "actor_id",
    "authority_ref",
    "provenance_digests",
    "review_decision",
    "events",
    "effects"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "sunderkey.finding-lifecycle-snapshot.v1"},
    "snapshot_id": {"$ref": "#/$defs/snapshot_id"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "parent_snapshot_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "finding_id": {"$ref": "#/$defs/finding_id"},
    "finding_version": {"$ref": "#/$defs/positive_integer"},
    "state": {"$ref": "#/$defs/state"},
    "identity": {"$ref": "#/$defs/identity"},
    "dedupe_fingerprint": {"$ref": "#/$defs/sha256"},
    "classification": {"$ref": "#/$defs/classification"},
    "evidence_digests": {"$ref": "#/$defs/digest_list"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "actor_id": {"$ref": "#/$defs/identifier"},
    "authority_ref": {"$ref": "#/$defs/identifier"},
    "provenance_digests": {
      "allOf": [
        {"$ref": "#/$defs/digest_list"},
        {"minItems": 1}
      ]
    },
    "review_decision": {"$ref": "#/$defs/review_decision"},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2147483647,
      "items": {"$ref": "#/$defs/event"}
    },
    "effects": {"$ref": "#/$defs/no_effects"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^FSN-[0-9A-F]{32}$"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^FND-[0-9A-F]{32}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^FEV-[0-9A-F]{32}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "state": {
      "enum": [
        "new",
        "triaged",
        "validated",
        "accepted",
        "remediation_in_progress",
        "retest_pending",
        "resolved",
        "risk_accepted",
        "false_positive",
        "reopened"
      ]
    },
    "review_decision": {
      "enum": ["pending", "approved", "rejected", "abstained", "not_required"]
    },
    "digest_list": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "surface",
        "vulnerability_class",
        "root_cause",
        "affected_boundary",
        "semantic_claim"
      ],
      "properties": {
        "asset": {"$ref": "#/$defs/semantic_text"},
        "surface": {"$ref": "#/$defs/semantic_text"},
        "vulnerability_class": {"$ref": "#/$defs/semantic_text"},
        "root_cause": {"$ref": "#/$defs/semantic_text"},
        "affected_boundary": {"$ref": "#/$defs/semantic_text"},
        "semantic_claim": {"$ref": "#/$defs/semantic_text"}
      }
    },
    "semantic_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[ -~]+$"
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "cwe_refs", "cvss_refs"],
      "properties": {
        "severity": {
          "enum": ["unrated", "informational", "low", "medium", "high", "critical"]
        },
        "cwe_refs": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CWE-[1-9][0-9]{0,5}$"
          }
        },
        "cvss_refs": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CVSS:(?:3\\.[01]|4\\.0)(?:/[A-Z][A-Z0-9]*:[A-Za-z0-9.]+)+$"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "event_id",
        "event_sha256",
        "finding_id",
        "sequence",
        "finding_version",
        "event_type",
        "occurred_at",
        "actor_id",
        "authority_ref",
        "provenance_digests",
        "review_decision",
        "previous_event_sha256",
        "from_state",
        "to_state",
        "evidence_digests",
        "subject_digest",
        "reason_code",
        "effects"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "sunderkey.finding-event.v1"},
        "event_id": {"$ref": "#/$defs/event_id"},
        "event_sha256": {"$ref": "#/$defs/sha256"},
        "finding_id": {"$ref": "#/$defs/finding_id"},
        "sequence": {"$ref": "#/$defs/positive_integer"},
        "finding_version": {"$ref": "#/$defs/positive_integer"},
        "event_type": {
          "enum": ["created", "state_transition", "evidence_added", "retest_recorded"]
        },
        "occurred_at": {"$ref": "#/$defs/timestamp"},
        "actor_id": {"$ref": "#/$defs/identifier"},
        "authority_ref": {"$ref": "#/$defs/identifier"},
        "provenance_digests": {
          "allOf": [
            {"$ref": "#/$defs/digest_list"},
            {"minItems": 1}
          ]
        },
        "review_decision": {"$ref": "#/$defs/review_decision"},
        "previous_event_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "from_state": {
          "oneOf": [
            {"$ref": "#/$defs/state"},
            {"type": "null"}
          ]
        },
        "to_state": {"$ref": "#/$defs/state"},
        "evidence_digests": {"$ref": "#/$defs/digest_list"},
        "subject_digest": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "reason_code": {"$ref": "#/$defs/token"},
        "effects": {"$ref": "#/$defs/no_effects"}
      }
    },
    "no_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment",
        "execution",
        "exploit_generation",
        "network",
        "qualification",
        "routing",
        "target_authority",
        "tools"
      ],
      "properties": {
        "deployment": {"const": "none"},
        "execution": {"const": "none"},
        "exploit_generation": {"const": "none"},
        "network": {"const": "none"},
        "qualification": {"const": "none"},
        "routing": {"const": "none"},
        "target_authority": {"const": "none"},
        "tools": {"const": "none"}
      }
    }
  }
}
