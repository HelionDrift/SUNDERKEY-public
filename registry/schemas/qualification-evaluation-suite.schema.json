{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.local/schemas/qualification-evaluation-suite.schema.json",
  "title": "SUNDERKEY Qualification Evaluation Suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "suite_version",
    "suite_mode",
    "advisory_only",
    "expert_catalog_id",
    "expert_catalog_version",
    "capability_catalog_id",
    "capability_catalog_version",
    "capability_catalog_sha256",
    "qualification_standard_id",
    "qualification_standard_version",
    "qualification_standard_sha256",
    "qualification_plan_catalog_id",
    "qualification_plan_catalog_version",
    "qualification_plan_catalog_sha256",
    "profile_id",
    "scenario_family_id",
    "candidate",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "suite_id": {
      "$ref": "#/$defs/asciiText"
    },
    "suite_version": {
      "$ref": "#/$defs/asciiText"
    },
    "suite_mode": {
      "const": "synthetic"
    },
    "advisory_only": {
      "const": true
    },
    "expert_catalog_id": {
      "$ref": "#/$defs/asciiText"
    },
    "expert_catalog_version": {
      "$ref": "#/$defs/asciiText"
    },
    "capability_catalog_id": {
      "$ref": "#/$defs/asciiText"
    },
    "capability_catalog_version": {
      "$ref": "#/$defs/asciiText"
    },
    "capability_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "qualification_standard_id": {
      "$ref": "#/$defs/asciiText"
    },
    "qualification_standard_version": {
      "$ref": "#/$defs/asciiText"
    },
    "qualification_standard_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "qualification_plan_catalog_id": {
      "$ref": "#/$defs/asciiText"
    },
    "qualification_plan_catalog_version": {
      "$ref": "#/$defs/asciiText"
    },
    "qualification_plan_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^AOE-G[A-E]-D[0-9]{2}-S[0-9]{2}$"
    },
    "scenario_family_id": {
      "type": "string",
      "pattern": "^qualification\\.aoe-g[a-e]-d[0-9]{2}-s[0-9]{2}$"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "asciiText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\t\\n\\r -~]*[!-~][\\t\\n\\r -~]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_version",
        "candidate_artifact_sha256"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/asciiText"
        },
        "candidate_version": {
          "$ref": "#/$defs/asciiText"
        },
        "candidate_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "gate_id",
        "ordinal",
        "environment",
        "scenario_sha256",
        "expected_result_sha256",
        "critical_failure_definition_sha256"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^QCASE-[A-Z0-9-]{8,96}$"
        },
        "gate_id": {
          "type": "string",
          "pattern": "^qualification\\.gate\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "environment": {
          "enum": [
            "offline",
            "synthetic",
            "test",
            "production"
          ]
        },
        "scenario_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expected_result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "critical_failure_definition_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
