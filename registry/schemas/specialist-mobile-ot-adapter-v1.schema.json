{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.dev/schemas/specialist-mobile-ot-adapter-v1.schema.json",
  "title": "SUNDERKEY Mobile and OT Specialist Adapter Contract",
  "oneOf": [
    { "$ref": "#/$defs/declaration" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "reference": {
      "type": "string",
      "pattern": "^(tenantref|missionref|scoperef|targetref|protocolref|deviceref|sessionref|evidenceref|budgetref|restorationref|approvalref|actorref|capabilityref):[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "domain": { "enum": ["mobile", "desktop_client", "wireless", "embedded_iot", "ot_ics"] },
    "environment": { "enum": ["simulation", "lab", "staging", "production"] },
    "criticality": { "enum": ["standard", "business_critical", "safety_critical", "critical_infrastructure"] },
    "actionClass": { "enum": ["passive", "authenticated_read", "validation", "controlled_change", "disruptive"] },
    "actionTier": { "enum": ["R0", "R1", "R2", "R3"] },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autonomous_execution",
        "builtin_device_commands",
        "builtin_exploit_payloads",
        "builtin_network",
        "builtin_process_execution",
        "builtin_radio_transmission",
        "injected_adapter_invocation"
      ],
      "properties": {
        "autonomous_execution": { "const": "none" },
        "builtin_device_commands": { "const": "none" },
        "builtin_exploit_payloads": { "const": "none" },
        "builtin_network": { "const": "none" },
        "builtin_process_execution": { "const": "none" },
        "builtin_radio_transmission": { "const": "none" },
        "injected_adapter_invocation": { "const": "caller_supplied_only" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_ref", "maximum_operations", "maximum_bytes", "maximum_changes", "maximum_duration_seconds", "budget_sha256"],
      "properties": {
        "budget_ref": { "$ref": "#/$defs/reference" },
        "maximum_operations": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximum_bytes": { "type": "integer", "minimum": 1, "maximum": 1000000000000 },
        "maximum_changes": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "maximum_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "budget_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_ref",
        "mission_ref",
        "environment",
        "criticality",
        "scope_ref",
        "scope_sha256",
        "target_ref",
        "target_sha256",
        "protocol_ref",
        "protocol_sha256",
        "device_ref",
        "device_sha256",
        "session_ref",
        "session_sha256",
        "evidence_plan_ref",
        "evidence_plan_sha256",
        "restoration_plan_ref",
        "restoration_plan_sha256",
        "approval_ref",
        "approval_sha256",
        "approving_actor_ref",
        "independent_approval_ref",
        "independent_approval_sha256",
        "independent_actor_ref",
        "budget",
        "context_sha256"
      ],
      "properties": {
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "mission_ref": { "$ref": "#/$defs/reference" },
        "environment": { "$ref": "#/$defs/environment" },
        "criticality": { "$ref": "#/$defs/criticality" },
        "scope_ref": { "$ref": "#/$defs/reference" },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "target_ref": { "$ref": "#/$defs/reference" },
        "target_sha256": { "$ref": "#/$defs/sha256" },
        "protocol_ref": { "$ref": "#/$defs/reference" },
        "protocol_sha256": { "$ref": "#/$defs/sha256" },
        "device_ref": { "$ref": "#/$defs/reference" },
        "device_sha256": { "$ref": "#/$defs/sha256" },
        "session_ref": { "$ref": "#/$defs/reference" },
        "session_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_plan_ref": { "$ref": "#/$defs/reference" },
        "evidence_plan_sha256": { "$ref": "#/$defs/sha256" },
        "restoration_plan_ref": { "$ref": "#/$defs/reference" },
        "restoration_plan_sha256": { "$ref": "#/$defs/sha256" },
        "approval_ref": { "$ref": "#/$defs/reference" },
        "approval_sha256": { "$ref": "#/$defs/sha256" },
        "approving_actor_ref": { "$ref": "#/$defs/reference" },
        "independent_approval_ref": { "$ref": "#/$defs/reference" },
        "independent_approval_sha256": { "$ref": "#/$defs/sha256" },
        "independent_actor_ref": { "$ref": "#/$defs/reference" },
        "budget": { "$ref": "#/$defs/budget" },
        "context_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration_id", "declaration_sha256", "kind", "schema_version", "boundary_effects", "domain", "capability_ref", "capability_names", "maximum_tier", "qualification_effect"],
      "properties": {
        "declaration_id": { "type": "string", "pattern": "^MOD-[0-9A-F]{32}$" },
        "declaration_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "mobile_ot_capability_declaration" },
        "schema_version": { "const": 1 },
        "boundary_effects": { "$ref": "#/$defs/effects" },
        "domain": { "$ref": "#/$defs/domain" },
        "capability_ref": { "$ref": "#/$defs/reference" },
        "capability_names": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 96 }
        },
        "maximum_tier": { "const": "R3" },
        "qualification_effect": { "const": "none" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_sha256",
        "kind",
        "schema_version",
        "boundary_effects",
        "declaration_id",
        "declaration_sha256",
        "domain",
        "capability_ref",
        "action_class",
        "action_tier",
        "context",
        "intent_sha256",
        "estimated_operations",
        "estimated_bytes",
        "estimated_changes",
        "estimated_duration_seconds",
        "idempotency_sha256",
        "issued_at",
        "expires_at",
        "qualification_effect"
      ],
      "properties": {
        "request_id": { "type": "string", "pattern": "^MOR-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "mobile_ot_action_request" },
        "schema_version": { "const": 1 },
        "boundary_effects": { "$ref": "#/$defs/effects" },
        "declaration_id": { "type": "string", "pattern": "^MOD-[0-9A-F]{32}$" },
        "declaration_sha256": { "$ref": "#/$defs/sha256" },
        "domain": { "$ref": "#/$defs/domain" },
        "capability_ref": { "$ref": "#/$defs/reference" },
        "action_class": { "$ref": "#/$defs/actionClass" },
        "action_tier": { "$ref": "#/$defs/actionTier" },
        "context": { "$ref": "#/$defs/context" },
        "intent_sha256": { "$ref": "#/$defs/sha256" },
        "estimated_operations": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "estimated_bytes": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
        "estimated_changes": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "estimated_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "idempotency_sha256": { "$ref": "#/$defs/sha256" },
        "issued_at": { "$ref": "#/$defs/utc" },
        "expires_at": { "$ref": "#/$defs/utc" },
        "qualification_effect": { "const": "none" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_sha256",
        "context_sha256",
        "target_sha256",
        "protocol_sha256",
        "device_sha256",
        "session_sha256",
        "disposition",
        "evidence_sha256",
        "actual_operations",
        "actual_bytes",
        "actual_changes",
        "actual_duration_seconds",
        "restoration_complete",
        "restoration_evidence_sha256",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "request_id": { "type": "string", "pattern": "^MOR-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "context_sha256": { "$ref": "#/$defs/sha256" },
        "target_sha256": { "$ref": "#/$defs/sha256" },
        "protocol_sha256": { "$ref": "#/$defs/sha256" },
        "device_sha256": { "$ref": "#/$defs/sha256" },
        "session_sha256": { "$ref": "#/$defs/sha256" },
        "disposition": { "enum": ["completed", "denied", "failed"] },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "actual_operations": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "actual_bytes": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
        "actual_changes": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "actual_duration_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "restoration_complete": { "type": "boolean" },
        "restoration_evidence_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "started_at": { "$ref": "#/$defs/utc" },
        "completed_at": { "$ref": "#/$defs/utc" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_sha256",
        "kind",
        "schema_version",
        "boundary_effects",
        "request_id",
        "request_sha256",
        "declaration_id",
        "declaration_sha256",
        "domain",
        "capability_ref",
        "action_class",
        "action_tier",
        "context_sha256",
        "idempotency_sha256",
        "observation",
        "status",
        "qualification_effect"
      ],
      "properties": {
        "receipt_id": { "type": "string", "pattern": "^MOC-[0-9A-F]{32}$" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "mobile_ot_action_receipt" },
        "schema_version": { "const": 1 },
        "boundary_effects": { "$ref": "#/$defs/effects" },
        "request_id": { "type": "string", "pattern": "^MOR-[0-9A-F]{32}$" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "declaration_id": { "type": "string", "pattern": "^MOD-[0-9A-F]{32}$" },
        "declaration_sha256": { "$ref": "#/$defs/sha256" },
        "domain": { "$ref": "#/$defs/domain" },
        "capability_ref": { "$ref": "#/$defs/reference" },
        "action_class": { "$ref": "#/$defs/actionClass" },
        "action_tier": { "$ref": "#/$defs/actionTier" },
        "context_sha256": { "$ref": "#/$defs/sha256" },
        "idempotency_sha256": { "$ref": "#/$defs/sha256" },
        "observation": { "$ref": "#/$defs/observation" },
        "status": { "enum": ["completed", "denied", "failed", "halted_restoration_required"] },
        "qualification_effect": { "const": "none" }
      }
    }
  }
}
