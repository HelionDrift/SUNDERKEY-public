{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-ownership-revocation-v1.json",
  "title": "SUNDERKEY Collaboration Ownership Revocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revocation_id",
    "revocation_sha256",
    "chain_id",
    "current_head_entry_id",
    "current_head_sha256",
    "current_owner_id",
    "planned_owner_id",
    "independent_control_id",
    "independent_control_approval_id",
    "planned_owner_acceptance_id",
    "reason_code",
    "requested_at",
    "expires_at",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "revocation_id": {"type": "string", "pattern": "^OCR-[0-9A-F]{32}$"},
    "revocation_sha256": {"$ref": "#/$defs/sha256"},
    "chain_id": {"type": "string", "pattern": "^OCN-[0-9A-F]{32}$"},
    "current_head_entry_id": {"type": "string", "pattern": "^OCE-[0-9A-F]{32}$"},
    "current_head_sha256": {"$ref": "#/$defs/sha256"},
    "current_owner_id": {"$ref": "#/$defs/identifier"},
    "planned_owner_id": {"$ref": "#/$defs/identifier"},
    "independent_control_id": {"$ref": "#/$defs/identifier"},
    "independent_control_approval_id": {"$ref": "#/$defs/identifier"},
    "planned_owner_acceptance_id": {"$ref": "#/$defs/identifier"},
    "reason_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{2,95}$"},
    "requested_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
