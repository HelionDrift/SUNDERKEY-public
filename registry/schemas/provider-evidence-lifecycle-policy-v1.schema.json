{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/provider-evidence-lifecycle-policy-v1.json",
  "title": "SUNDERKEY Provider Evidence Lifecycle Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_sha256",
    "policy_version",
    "custody_decision",
    "mission",
    "classification",
    "retention",
    "deletion",
    "encryption",
    "access",
    "residency",
    "content_safety",
    "created_at",
    "policy_status",
    "activation_effect",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "pattern": "^ELP-[0-9A-F]{32}$"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "policy_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "custody_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_sha256"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^ECR-[0-9A-F]{32}$"},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_id", "mission_sha256", "scope_reference_sha256"],
      "properties": {
        "mission_id": {"$ref": "#/$defs/identifier"},
        "mission_sha256": {"$ref": "#/$defs/sha256"},
        "scope_reference_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_classification",
        "derived_classification",
        "redacted_classification",
        "raw_object_immutable",
        "in_place_redaction_permitted",
        "derivative_provenance_required"
      ],
      "properties": {
        "raw_classification": {"const": "restricted_raw"},
        "derived_classification": {"const": "restricted_derived"},
        "redacted_classification": {"const": "redacted_reviewer"},
        "raw_object_immutable": {"const": true},
        "in_place_redaction_permitted": {"const": false},
        "derivative_provenance_required": {"const": true}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_seconds",
        "legal_hold_authority_role",
        "independent_legal_hold_required",
        "hold_release_dual_control_required",
        "expiry_requires_deletion_transition"
      ],
      "properties": {
        "retention_seconds": {"type": "integer", "minimum": 3600, "maximum": 315360000},
        "legal_hold_authority_role": {"$ref": "#/$defs/identifier"},
        "independent_legal_hold_required": {"const": true},
        "hold_release_dual_control_required": {"const": true},
        "expiry_requires_deletion_transition": {"const": true}
      }
    },
    "deletion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "signed_tombstone_required",
        "all_versions_required",
        "replica_and_backup_key_material_required",
        "deletion_deadline_seconds"
      ],
      "properties": {
        "method": {"const": "cryptographic_erasure"},
        "signed_tombstone_required": {"const": true},
        "all_versions_required": {"const": true},
        "replica_and_backup_key_material_required": {"const": true},
        "deletion_deadline_seconds": {"type": "integer", "minimum": 3600, "maximum": 2592000}
      }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_sha256",
        "organization_kms_required",
        "separate_evidence_key_scope_required",
        "key_material_in_sunderkey_prohibited"
      ],
      "properties": {
        "profile_id": {"$ref": "#/$defs/identifier"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "organization_kms_required": {"const": true},
        "separate_evidence_key_scope_required": {"const": true},
        "key_material_in_sunderkey_prohibited": {"const": true}
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_sha256",
        "dedicated_service_identity_required",
        "mission_scope_required",
        "time_bound_required",
        "maximum_access_seconds",
        "audit_required"
      ],
      "properties": {
        "policy_id": {"$ref": "#/$defs/identifier"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "dedicated_service_identity_required": {"const": true},
        "mission_scope_required": {"const": true},
        "time_bound_required": {"const": true},
        "maximum_access_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "audit_required": {"const": true}
      }
    },
    "residency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_sha256",
        "allowed_region_ids",
        "minimum_replica_count",
        "unlisted_regions_prohibited",
        "recovery_drill_required"
      ],
      "properties": {
        "policy_id": {"$ref": "#/$defs/identifier"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "allowed_region_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "minimum_replica_count": {"type": "integer", "minimum": 2, "maximum": 16},
        "unlisted_regions_prohibited": {"const": true},
        "recovery_drill_required": {"const": true}
      }
    },
    "content_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quarantine_required",
        "passive_type_detection_required",
        "direct_rendering_prohibited",
        "direct_execution_prohibited",
        "sandboxed_derivation_required"
      ],
      "properties": {
        "quarantine_required": {"const": true},
        "passive_type_detection_required": {"const": true},
        "direct_rendering_prohibited": {"const": true},
        "direct_execution_prohibited": {"const": true},
        "sandboxed_derivation_required": {"const": true}
      }
    },
    "created_at": {"$ref": "#/$defs/timestamp"},
    "policy_status": {"const": "prepared_not_activated"},
    "activation_effect": {"const": "none"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
