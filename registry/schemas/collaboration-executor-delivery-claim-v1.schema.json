{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/collaboration-executor-delivery-claim-v1.schema.json",
  "title": "SUNDERKEY Collaboration Executor Delivery Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "claim_sha256",
    "reservation",
    "mission",
    "session",
    "operation",
    "claimant",
    "claim_generation",
    "predecessor",
    "claimed_at",
    "lease_expires_at",
    "claim_status",
    "claimant_identity_status",
    "external_effect_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "claim_id": {"type": "string", "pattern": "^DCL-[0-9A-F]{32}$"},
    "claim_sha256": {"$ref": "#/$defs/sha256"},
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authentication_id",
        "authentication_sha256",
        "dispatch_id",
        "dispatch_sha256",
        "reserved_at",
        "dispatch_expires_at"
      ],
      "properties": {
        "authentication_id": {"type": "string", "pattern": "^EDA-[0-9A-F]{32}$"},
        "authentication_sha256": {"$ref": "#/$defs/sha256"},
        "dispatch_id": {"type": "string", "pattern": "^EXD-[0-9A-F]{32}$"},
        "dispatch_sha256": {"$ref": "#/$defs/sha256"},
        "reserved_at": {"$ref": "#/$defs/timestamp"},
        "dispatch_expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_id", "collaboration_plan_id"],
      "properties": {
        "mission_id": {"$ref": "#/$defs/identifier"},
        "collaboration_plan_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "session_sha256", "fence_generation"],
      "properties": {
        "session_id": {"$ref": "#/$defs/identifier"},
        "session_sha256": {"$ref": "#/$defs/sha256"},
        "fence_generation": {"type": "integer", "minimum": 1}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sequence", "operation_input_sha256"],
      "properties": {
        "name": {
          "enum": ["start", "action", "evidence", "heartbeat", "pause", "resume", "stop", "destroy"]
        },
        "sequence": {"type": "integer", "minimum": 1},
        "operation_input_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "claimant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id"],
      "properties": {"instance_id": {"$ref": "#/$defs/identifier"}}
    },
    "claim_generation": {"type": "integer", "minimum": 1},
    "predecessor": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_id", "claim_sha256", "claim_generation", "lease_expires_at"],
          "properties": {
            "claim_id": {"type": "string", "pattern": "^DCL-[0-9A-F]{32}$"},
            "claim_sha256": {"$ref": "#/$defs/sha256"},
            "claim_generation": {"type": "integer", "minimum": 1},
            "lease_expires_at": {"$ref": "#/$defs/timestamp"}
          }
        }
      ]
    },
    "claimed_at": {"$ref": "#/$defs/timestamp"},
    "lease_expires_at": {"$ref": "#/$defs/timestamp"},
    "claim_status": {"const": "claimed_pending_invocation"},
    "claimant_identity_status": {"const": "deployment_instance_unverified"},
    "external_effect_status": {"const": "not_started"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
