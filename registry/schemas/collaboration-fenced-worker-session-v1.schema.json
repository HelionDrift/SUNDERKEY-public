{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-fenced-worker-session-v1.json",
  "title": "SUNDERKEY Collaboration Fenced Worker Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "session_sha256",
    "channel_policy",
    "mission_id",
    "collaboration_plan_id",
    "collaboration_plan_sha256",
    "work_item_id",
    "work_item_objective_sha256",
    "ownership_chain_id",
    "ownership_entry_id",
    "ownership_entry_sha256",
    "owner_profile_id",
    "owner_epoch",
    "worker_principal_id",
    "fence_generation",
    "credential_reference_id",
    "credential_sha256",
    "predecessor",
    "prepared_at",
    "expires_at",
    "session_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "pattern": "^ECS-[0-9A-F]{32}$"},
    "session_sha256": {"$ref": "#/$defs/sha256"},
    "channel_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_policy_id", "channel_policy_sha256"],
      "properties": {
        "channel_policy_id": {"type": "string", "pattern": "^ECP-[0-9A-F]{32}$"},
        "channel_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mission_id": {"$ref": "#/$defs/identifier"},
    "collaboration_plan_id": {"$ref": "#/$defs/identifier"},
    "collaboration_plan_sha256": {"$ref": "#/$defs/sha256"},
    "work_item_id": {"$ref": "#/$defs/identifier"},
    "work_item_objective_sha256": {"$ref": "#/$defs/sha256"},
    "ownership_chain_id": {"type": "string", "pattern": "^OCN-[0-9A-F]{32}$"},
    "ownership_entry_id": {"type": "string", "pattern": "^OCE-[0-9A-F]{32}$"},
    "ownership_entry_sha256": {"$ref": "#/$defs/sha256"},
    "owner_profile_id": {"$ref": "#/$defs/identifier"},
    "owner_epoch": {"type": "integer", "minimum": 1},
    "worker_principal_id": {"$ref": "#/$defs/identifier"},
    "fence_generation": {"type": "integer", "minimum": 1},
    "credential_reference_id": {"$ref": "#/$defs/identifier"},
    "credential_sha256": {"$ref": "#/$defs/sha256"},
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "session_sha256",
        "credential_reference_id",
        "credential_sha256",
        "revocation_reference_id",
        "revocation_sha256"
      ],
      "properties": {
        "session_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^ECS-[0-9A-F]{32}$"}]},
        "session_sha256": {"$ref": "#/$defs/optionalSha256"},
        "credential_reference_id": {"$ref": "#/$defs/optionalIdentifier"},
        "credential_sha256": {"$ref": "#/$defs/optionalSha256"},
        "revocation_reference_id": {"$ref": "#/$defs/optionalIdentifier"},
        "revocation_sha256": {"$ref": "#/$defs/optionalSha256"}
      }
    },
    "prepared_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "session_status": {"const": "prepared_pending_channel_activation"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "optionalIdentifier": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "optionalSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
