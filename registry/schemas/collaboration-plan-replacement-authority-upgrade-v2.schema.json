{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-plan-replacement-authority-upgrade-v2.json",
  "title": "SUNDERKEY Collaboration Plan Replacement Authority Upgrade v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "upgrade_id",
    "upgrade_sha256",
    "source_preflight",
    "army_registry",
    "mission_id",
    "prior_plan",
    "replacement_plan",
    "selection_sha256",
    "authority_requirements",
    "authentication_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "upgrade_id": {"type": "string", "pattern": "^PRU-[0-9A-F]{32}$"},
    "upgrade_sha256": {"$ref": "#/$defs/sha256"},
    "source_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight_id", "preflight_sha256"],
      "properties": {
        "preflight_id": {"type": "string", "pattern": "^PRF-[0-9A-F]{32}$"},
        "preflight_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "army_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "catalog_version", "registry_sha256"],
      "properties": {
        "catalog_id": {"const": "sunderkey-offensive-expert-army"},
        "catalog_version": {"const": "2.0.0"},
        "registry_sha256": {
          "const": "sha256:2f9c94a2baa3f8445c646b473a87ee54c006a9d1298d2013ec484be83cc0882b"
        }
      }
    },
    "mission_id": {"$ref": "#/$defs/missionId"},
    "prior_plan": {"$ref": "#/$defs/planReference"},
    "replacement_plan": {"$ref": "#/$defs/planReference"},
    "selection_sha256": {"$ref": "#/$defs/sha256"},
    "authority_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/profileRequirement"},
          {"$ref": "#/$defs/commandRequirement"}
        ]
      }
    },
    "authentication_status": {"const": "principal_assertions_required"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "missionId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "planId": {"type": "string", "pattern": "^CLP-[0-9A-F]{24}$"},
    "workItemId": {
      "type": "string",
      "pattern": "^WIT-[A-Z]{2,16}-[0-9A-F]{16}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^AOE-(?:G[A-E]-D[0-9]{2}-(?:S[0-9]{2}|CMD)|HQ-[0-9]{2})$"
    },
    "commandId": {
      "type": "string",
      "pattern": "^AOE-G[A-E]-D[0-9]{2}$"
    },
    "planReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "plan_sha256"],
      "properties": {
        "plan_id": {"$ref": "#/$defs/planId"},
        "plan_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "profileRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "source_requirement_id",
        "role",
        "authority_id",
        "authority_kind",
        "operation",
        "work_item_id",
        "selection_sha256",
        "authority_intent_sha256",
        "principal_profile_id",
        "principal_operation_intent_sha256"
      ],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^PRA-[0-9A-F]{32}$"},
        "source_requirement_id": {"type": "string", "pattern": "^PAR-[0-9A-F]{32}$"},
        "role": {
          "enum": [
            "mission_owner",
            "independent_control",
            "current_owner",
            "proposed_owner",
            "independent_assurance",
            "second_control"
          ]
        },
        "authority_id": {"$ref": "#/$defs/profileId"},
        "authority_kind": {"const": "principal_profile"},
        "operation": {
          "enum": [
            "sunderkey.collaboration.plan-replacement.owner-authorize.v1",
            "sunderkey.collaboration.plan-replacement.control-approve.v1",
            "sunderkey.collaboration.plan-replacement.current-owner-authorize.v1",
            "sunderkey.collaboration.plan-replacement.proposed-owner-accept.v1",
            "sunderkey.collaboration.plan-replacement.current-owner-cancel.v1",
            "sunderkey.collaboration.plan-replacement.assurance-approve.v1",
            "sunderkey.collaboration.plan-replacement.second-control-approve.v1"
          ]
        },
        "work_item_id": {
          "oneOf": [
            {"$ref": "#/$defs/workItemId"},
            {"type": "null"}
          ]
        },
        "selection_sha256": {"$ref": "#/$defs/sha256"},
        "authority_intent_sha256": {"$ref": "#/$defs/sha256"},
        "principal_profile_id": {"$ref": "#/$defs/profileId"},
        "principal_operation_intent_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "role": {"const": "mission_owner"},
                "operation": {"const": "sunderkey.collaboration.plan-replacement.owner-authorize.v1"},
                "work_item_id": {"type": "null"}
              }
            },
            {
              "properties": {
                "role": {"const": "independent_control"},
                "operation": {"const": "sunderkey.collaboration.plan-replacement.control-approve.v1"},
                "work_item_id": {"type": "null"}
              }
            },
            {
              "properties": {
                "role": {"const": "current_owner"},
                "operation": {
                  "enum": [
                    "sunderkey.collaboration.plan-replacement.current-owner-authorize.v1",
                    "sunderkey.collaboration.plan-replacement.current-owner-cancel.v1"
                  ]
                },
                "work_item_id": {"$ref": "#/$defs/workItemId"}
              }
            },
            {
              "properties": {
                "role": {"const": "proposed_owner"},
                "operation": {"const": "sunderkey.collaboration.plan-replacement.proposed-owner-accept.v1"},
                "work_item_id": {"$ref": "#/$defs/workItemId"}
              }
            },
            {
              "properties": {
                "role": {"const": "independent_assurance"},
                "operation": {"const": "sunderkey.collaboration.plan-replacement.assurance-approve.v1"},
                "work_item_id": {"type": "null"}
              }
            },
            {
              "properties": {
                "role": {"const": "second_control"},
                "operation": {"const": "sunderkey.collaboration.plan-replacement.second-control-approve.v1"},
                "work_item_id": {"type": "null"}
              }
            }
          ]
        }
      ]
    },
    "commandRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "source_requirement_id",
        "role",
        "authority_id",
        "authority_kind",
        "operation",
        "work_item_id",
        "selection_sha256",
        "authority_intent_sha256",
        "principal_profile_id",
        "principal_operation_intent_sha256",
        "command_authority_binding_sha256"
      ],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^PRA-[0-9A-F]{32}$"},
        "source_requirement_id": {"type": "string", "pattern": "^PAR-[0-9A-F]{32}$"},
        "role": {
          "enum": ["source_technical_command", "destination_technical_command"]
        },
        "authority_id": {"$ref": "#/$defs/commandId"},
        "authority_kind": {"const": "command"},
        "operation": {
          "enum": [
            "sunderkey.collaboration.plan-replacement.source-command-review.v1",
            "sunderkey.collaboration.plan-replacement.destination-command-review.v1"
          ]
        },
        "work_item_id": {"$ref": "#/$defs/workItemId"},
        "selection_sha256": {"$ref": "#/$defs/sha256"},
        "authority_intent_sha256": {"$ref": "#/$defs/sha256"},
        "principal_profile_id": {"$ref": "#/$defs/profileId"},
        "principal_operation_intent_sha256": {"$ref": "#/$defs/sha256"},
        "command_authority_binding_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "role": {"const": "source_technical_command"},
                "operation": {"const": "sunderkey.collaboration.plan-replacement.source-command-review.v1"}
              }
            },
            {
              "properties": {
                "role": {"const": "destination_technical_command"},
                "operation": {"const": "sunderkey.collaboration.plan-replacement.destination-command-review.v1"}
              }
            }
          ]
        }
      ]
    }
  }
}
