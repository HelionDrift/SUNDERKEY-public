{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-reconfiguration-authority-policy-v1.json",
  "title": "SUNDERKEY Collaboration Reconfiguration Authority Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_sha256",
    "decision",
    "approved_model",
    "transition_rules",
    "nonnegotiable_requirements",
    "parameter_contracts",
    "current_boundary",
    "limitations",
    "network_call_performed",
    "runtime_effect",
    "registry_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "pattern": "^RAP-[0-9A-F]{32}$"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "sha256"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^CRD-[0-9A-F]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "approved_model": {"const": "reviewed_reconfiguration_ledger"},
    "transition_rules": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/transitionRule"}
    },
    "nonnegotiable_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_binding_requirements",
        "separation_requirements",
        "fail_closed_requirements",
        "history_requirements",
        "private_key_storage_in_sunderkey",
        "execution_credentials_in_reconfiguration",
        "direct_runtime_control"
      ],
      "properties": {
        "authority_binding_requirements": {"$ref": "#/$defs/identifierSet"},
        "separation_requirements": {"$ref": "#/$defs/identifierSet"},
        "fail_closed_requirements": {"$ref": "#/$defs/identifierSet"},
        "history_requirements": {"$ref": "#/$defs/identifierSet"},
        "private_key_storage_in_sunderkey": {"const": false},
        "execution_credentials_in_reconfiguration": {"const": false},
        "direct_runtime_control": {"const": false}
      }
    },
    "parameter_contracts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/parameterContract"}
    },
    "current_boundary": {
      "const": {
        "activated_plan_replacement_enabled": false,
        "authorized_next_action": "implement_bounded_ownership_chain_and_revocation_contracts",
        "cross_command_handoff_enabled": false,
        "distributed_execution_acknowledgement_enabled": false,
        "maximum_handoffs_per_work_item": 1,
        "policy_status": "contract_defined_inactive"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^does_not_[a-z0-9_]{8,180}$"}
    },
    "network_call_performed": {"const": false},
    "runtime_effect": {"const": "none"},
    "registry_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifierSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{8,160}$"}
    },
    "transitionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "transition_family",
        "approved_rule",
        "required_parties",
        "conditional_parties",
        "result_boundary"
      ],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^D00[1-5]$"},
        "transition_family": {"type": "string", "pattern": "^[a-z0-9_]{8,96}$"},
        "approved_rule": {"type": "string", "pattern": "^[a-z0-9_]{8,128}$"},
        "required_parties": {"$ref": "#/$defs/identifierSet"},
        "conditional_parties": {"$ref": "#/$defs/identifierSet"},
        "result_boundary": {"type": "string", "pattern": "^[a-z0-9_]{8,160}$"}
      }
    },
    "parameterContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "value_type",
        "minimum",
        "maximum",
        "selected_value",
        "selection_authority"
      ],
      "properties": {
        "parameter_id": {"type": "string", "pattern": "^[a-z0-9_]{8,96}$"},
        "value_type": {"const": "integer"},
        "minimum": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1},
        "selected_value": {"type": "null"},
        "selection_authority": {
          "type": "string",
          "pattern": "^[a-z0-9_]{8,96}$"
        }
      }
    }
  }
}
