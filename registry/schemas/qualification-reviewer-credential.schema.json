{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/qualification-reviewer-credential-v1.json",
  "title": "SUNDERKEY Qualification Reviewer Credential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "credential_id",
    "policy_id",
    "policy_version",
    "policy_sha256",
    "issuer",
    "issuer_key_id",
    "reviewer_id",
    "reviewer_role",
    "allowed_profile_ids",
    "issued_at",
    "not_before",
    "expires_at",
    "algorithm",
    "public_key",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "credential_id": {
      "type": "string",
      "pattern": "^QRC-[0-9A-F]{32}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^QTP-[0-9A-F]{32}$"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "issuer": {
      "$ref": "#/$defs/identifier"
    },
    "issuer_key_id": {
      "$ref": "#/$defs/identifier"
    },
    "reviewer_id": {
      "$ref": "#/$defs/identifier"
    },
    "reviewer_role": {
      "enum": [
        "technical_evaluator",
        "independent_control",
        "independent_assurance"
      ]
    },
    "allowed_profile_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AOE-G[A-E]-D[0-9]{2}-S[0-9]{2}$"
      }
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "not_before": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    }
  }
}
