{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.dev/schemas/cleanup-restoration-contract-v1.schema.json",
  "title": "SUNDERKEY cleanup and restoration contract version 1",
  "oneOf": [
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/observation" },
    { "$ref": "#/$defs/assessment" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.]+)?$"
    },
    "reference": {
      "type": "string",
      "pattern": "^(?:tenantref|missionref|principalref|reviewerref|stepref|targetstateref|evidenceref|actionref|artifactref|observationref|riskref|approvalref):[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization", "cleanup", "deletion", "network", "persistence",
        "qualification", "restore", "target_action"
      ],
      "properties": {
        "authorization": { "const": "none" },
        "cleanup": { "const": "none" },
        "deletion": { "const": "none" },
        "network": { "const": "none" },
        "persistence": { "const": "none" },
        "qualification": { "const": "none" },
        "restore": { "const": "none" },
        "target_action": { "const": "none" }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ref", "evidence_sha256", "evidence_version"],
      "properties": {
        "evidence_ref": { "$ref": "#/$defs/reference" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_version": { "$ref": "#/$defs/version" }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_sha256", "required_state", "target_ref", "target_sha256",
        "target_state_ref", "verification_sha256"
      ],
      "properties": {
        "baseline_sha256": { "$ref": "#/$defs/sha256" },
        "required_state": { "enum": ["absent", "restored", "retained"] },
        "target_ref": { "$ref": "#/$defs/reference" },
        "target_sha256": { "$ref": "#/$defs/sha256" },
        "target_state_ref": { "$ref": "#/$defs/reference" },
        "verification_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "compensatingAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_ref", "action_sha256", "action_version", "reason_code"],
      "properties": {
        "action_ref": { "$ref": "#/$defs/reference" },
        "action_sha256": { "$ref": "#/$defs/sha256" },
        "action_version": { "$ref": "#/$defs/version" },
        "reason_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_ref", "action_sha256", "compensating_actions",
        "evidence_requirements", "failure_behavior", "kind", "sequence",
        "step_ref", "target_state_ref", "timeout_seconds"
      ],
      "properties": {
        "action_ref": { "$ref": "#/$defs/reference" },
        "action_sha256": { "$ref": "#/$defs/sha256" },
        "compensating_actions": {
          "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/compensatingAction" }
        },
        "evidence_requirements": {
          "type": "array", "minItems": 1, "maxItems": 2048,
          "items": { "$ref": "#/$defs/evidenceRequirement" }
        },
        "failure_behavior": { "enum": ["halt", "rollback", "compensate_then_halt"] },
        "kind": { "enum": ["remove", "restore", "verify", "release"] },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "step_ref": { "$ref": "#/$defs/reference" },
        "target_state_ref": { "$ref": "#/$defs/reference" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "stepObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_at", "compensation_observed", "observed_evidence", "outcome",
        "reason_code", "sequence", "started_at", "step_ref"
      ],
      "properties": {
        "completed_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "compensation_observed": { "type": "boolean" },
        "observed_evidence": {
          "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/evidenceRequirement" }
        },
        "outcome": { "enum": ["succeeded", "failed", "timed_out", "not_observed"] },
        "reason_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "step_ref": { "$ref": "#/$defs/reference" }
      }
    },
    "residualArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref", "disposition", "expected_sha256", "observed_sha256",
        "reason", "risk_ref", "separate_authority_ref"
      ],
      "properties": {
        "artifact_ref": { "$ref": "#/$defs/reference" },
        "disposition": {
          "enum": ["unresolved", "accepted_by_separate_authority", "quarantined_by_separate_authority"]
        },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "observed_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "reason": { "type": "string", "minLength": 3, "maxLength": 500 },
        "risk_ref": { "$ref": "#/$defs/reference" },
        "separate_authority_ref": {
          "oneOf": [{ "$ref": "#/$defs/reference" }, { "type": "null" }]
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_sha256", "approval_ref", "approval_sha256", "contract_version",
        "contract_version_sha256",
        "created_at", "effects", "expires_at", "kind", "mission_ref", "obligations",
        "mission_sha256",
        "plan_id", "plan_sha256", "schema_version", "scope_sha256", "steps",
        "target_sha256", "tenant_ref", "tenant_sha256", "worker_profile_sha256", "worker_ref"
      ],
      "properties": {
        "action_sha256": { "$ref": "#/$defs/sha256" },
        "approval_ref": { "$ref": "#/$defs/reference" },
        "approval_sha256": { "$ref": "#/$defs/sha256" },
        "contract_version": { "$ref": "#/$defs/version" },
        "contract_version_sha256": { "$ref": "#/$defs/sha256" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "effects": { "$ref": "#/$defs/effects" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "kind": { "const": "sunderkey.cleanup-restoration-plan.v1" },
        "mission_ref": { "$ref": "#/$defs/reference" },
        "mission_sha256": { "$ref": "#/$defs/sha256" },
        "obligations": {
          "type": "array", "minItems": 1, "maxItems": 2048,
          "items": { "$ref": "#/$defs/obligation" }
        },
        "plan_id": { "type": "string", "pattern": "^CRP-[0-9A-F]{32}$" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": 1 },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "steps": {
          "type": "array", "minItems": 1, "maxItems": 2048,
          "items": { "$ref": "#/$defs/step" }
        },
        "target_sha256": { "$ref": "#/$defs/sha256" },
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "tenant_sha256": { "$ref": "#/$defs/sha256" },
        "worker_profile_sha256": { "$ref": "#/$defs/sha256" },
        "worker_ref": { "$ref": "#/$defs/reference" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_sha256", "contract_version", "contract_version_sha256", "effects", "kind",
        "mission_ref", "mission_sha256",
        "observation_id", "observation_sha256", "observations", "observed_at",
        "observer_ref", "plan_id", "plan_sha256", "residual_artifacts",
        "reviewer_ref", "schema_version", "scope_sha256", "target_sha256",
        "tenant_ref", "tenant_sha256", "worker_profile_sha256", "worker_ref"
      ],
      "properties": {
        "action_sha256": { "$ref": "#/$defs/sha256" },
        "contract_version": { "$ref": "#/$defs/version" },
        "contract_version_sha256": { "$ref": "#/$defs/sha256" },
        "effects": { "$ref": "#/$defs/effects" },
        "kind": { "const": "sunderkey.cleanup-restoration-observation.v1" },
        "mission_ref": { "$ref": "#/$defs/reference" },
        "mission_sha256": { "$ref": "#/$defs/sha256" },
        "observation_id": { "type": "string", "pattern": "^CRO-[0-9A-F]{32}$" },
        "observation_sha256": { "$ref": "#/$defs/sha256" },
        "observations": {
          "type": "array", "minItems": 1, "maxItems": 2048,
          "items": { "$ref": "#/$defs/stepObservation" }
        },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "observer_ref": { "$ref": "#/$defs/reference" },
        "plan_id": { "type": "string", "pattern": "^CRP-[0-9A-F]{32}$" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "residual_artifacts": {
          "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/residualArtifact" }
        },
        "reviewer_ref": { "$ref": "#/$defs/reference" },
        "schema_version": { "const": 1 },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "target_sha256": { "$ref": "#/$defs/sha256" },
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "tenant_sha256": { "$ref": "#/$defs/sha256" },
        "worker_profile_sha256": { "$ref": "#/$defs/sha256" },
        "worker_ref": { "$ref": "#/$defs/reference" }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_sha256", "assessment_id", "assessment_sha256", "contract_version",
        "contract_version_sha256", "effects", "kind", "mission_ref", "mission_sha256",
        "observation_id", "observation_sha256",
        "plan_id", "plan_sha256", "reason_codes", "reviewed_at", "reviewer_ref",
        "schema_version", "scope_sha256", "status", "target_sha256", "tenant_ref",
        "tenant_sha256", "worker_profile_sha256", "worker_ref"
      ],
      "properties": {
        "action_sha256": { "$ref": "#/$defs/sha256" },
        "assessment_id": { "type": "string", "pattern": "^CRA-[0-9A-F]{32}$" },
        "assessment_sha256": { "$ref": "#/$defs/sha256" },
        "contract_version": { "$ref": "#/$defs/version" },
        "contract_version_sha256": { "$ref": "#/$defs/sha256" },
        "effects": { "$ref": "#/$defs/effects" },
        "kind": { "const": "sunderkey.cleanup-restoration-assessment.v1" },
        "mission_ref": { "$ref": "#/$defs/reference" },
        "mission_sha256": { "$ref": "#/$defs/sha256" },
        "observation_id": { "type": "string", "pattern": "^CRO-[0-9A-F]{32}$" },
        "observation_sha256": { "$ref": "#/$defs/sha256" },
        "plan_id": { "type": "string", "pattern": "^CRP-[0-9A-F]{32}$" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "reason_codes": {
          "type": "array", "minItems": 1, "maxItems": 2048, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "reviewed_at": { "$ref": "#/$defs/timestamp" },
        "reviewer_ref": { "$ref": "#/$defs/reference" },
        "schema_version": { "const": 1 },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["incomplete", "contract_complete_unverified"] },
        "target_sha256": { "$ref": "#/$defs/sha256" },
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "tenant_sha256": { "$ref": "#/$defs/sha256" },
        "worker_profile_sha256": { "$ref": "#/$defs/sha256" },
        "worker_ref": { "$ref": "#/$defs/reference" }
      }
    }
  }
}
