{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sunderkey:remediation-case-review:v1",
  "title": "Source-replayed offline remediation case review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "context_id",
    "context_sha256",
    "tenant_ref",
    "assessment_ref",
    "scope_sha256",
    "plan_id",
    "plan_sha256",
    "retest_plan_sha256",
    "retest_observation_sha256",
    "closure_decision_sha256",
    "exception_sha256",
    "case_status",
    "review_stage",
    "historical_closure_disposition",
    "declared_source_windows_open",
    "live_source_freshness",
    "retest_gate_summary",
    "exception_summary",
    "proposed_risk_points",
    "workflow",
    "reason_codes",
    "claims",
    "effects",
    "case_review_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "as_of": {
      "$ref": "#/$defs/time"
    },
    "context_id": {
      "type": "string",
      "pattern": "^RMC-[0-9A-F]{32}$"
    },
    "context_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "tenant_ref": {
      "type": "string",
      "pattern": "^tenantref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "assessment_ref": {
      "type": "string",
      "pattern": "^assessmentref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
    },
    "scope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^RMP-[0-9A-F]{32}$"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "retest_plan_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "retest_observation_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "closure_decision_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "exception_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "case_status": {
      "const": "review_required"
    },
    "review_stage": {
      "enum": [
        "planning_only",
        "awaiting_retest_observation",
        "awaiting_closure_review",
        "historical_recommendation_replayed"
      ]
    },
    "historical_closure_disposition": {
      "enum": [
        "not_supplied",
        "closed_nonqualified",
        "open",
        "exception_active_nonqualified"
      ]
    },
    "declared_source_windows_open": {
      "type": "boolean"
    },
    "live_source_freshness": {
      "const": "not_established"
    },
    "retest_gate_summary": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/gateSummary"
        }
      ]
    },
    "exception_summary": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/exceptionSummary"
        }
      ]
    },
    "proposed_risk_points": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inherent",
        "residual",
        "reduction"
      ],
      "properties": {
        "inherent": {
          "type": "integer",
          "minimum": 0
        },
        "residual": {
          "type": "integer",
          "minimum": 0
        },
        "reduction": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "workflow": {
      "$ref": "urn:sunderkey:remediation-workflow-review:v1"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "independent_live_evidence_not_established",
          "retest_plan_not_supplied",
          "retest_observation_not_supplied",
          "closure_recommendation_not_supplied",
          "declared_exception_window_expired",
          "declared_compensating_control_window_expired",
          "asserted_exception_control_coverage_incomplete",
          "declared_source_window_expired",
          "required_retest_evidence_missing",
          "rollback_cleanup_evidence_missing",
          "regression_gate_not_passed"
        ]
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_authenticated",
        "source_provenance_authenticated",
        "retest_execution_verified",
        "risk_acceptance_verified",
        "remediation_verified"
      ],
      "properties": {
        "identity_authenticated": {
          "type": "boolean",
          "const": false
        },
        "source_provenance_authenticated": {
          "type": "boolean",
          "const": false
        },
        "retest_execution_verified": {
          "type": "boolean",
          "const": false
        },
        "risk_acceptance_verified": {
          "type": "boolean",
          "const": false
        },
        "remediation_verified": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "closure",
        "execution",
        "integration",
        "network",
        "notification",
        "persistence",
        "qualification",
        "ticketing",
        "finding_publication"
      ],
      "properties": {
        "authorization": {
          "const": "none"
        },
        "closure": {
          "const": "none"
        },
        "execution": {
          "const": "none"
        },
        "integration": {
          "const": "none"
        },
        "network": {
          "const": "none"
        },
        "notification": {
          "const": "none"
        },
        "persistence": {
          "const": "none"
        },
        "qualification": {
          "const": "none"
        },
        "ticketing": {
          "const": "none"
        },
        "finding_publication": {
          "const": "none"
        }
      }
    },
    "case_review_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "gateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "inconclusive",
        "not_observed",
        "required_evidence_complete",
        "restoration_evidence_complete"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "fail": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "not_observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "required_evidence_complete": {
          "type": "boolean"
        },
        "restoration_evidence_complete": {
          "type": "boolean"
        }
      }
    },
    "exceptionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exception_sha256",
        "approved_at",
        "expires_at",
        "item_refs",
        "control_refs",
        "declared_exception_window_open",
        "declared_control_windows_open",
        "asserted_control_coverage_complete",
        "used_by_historical_closure",
        "effective_risk_acceptance_verified"
      ],
      "properties": {
        "exception_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "approved_at": {
          "$ref": "#/$defs/time"
        },
        "expires_at": {
          "$ref": "#/$defs/time"
        },
        "item_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^itemref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
          }
        },
        "control_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^controlref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"
          }
        },
        "declared_exception_window_open": {
          "type": "boolean"
        },
        "declared_control_windows_open": {
          "type": "boolean"
        },
        "asserted_control_coverage_complete": {
          "type": "boolean"
        },
        "used_by_historical_closure": {
          "type": "boolean"
        },
        "effective_risk_acceptance_verified": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
