{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-plan-replacement-authority-plan-v1.json",
  "title": "SUNDERKEY Collaboration Plan Replacement Authority Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_plan_id",
    "authority_plan_sha256",
    "document_sha256",
    "source_preflight",
    "source_policies",
    "source_registry",
    "mission_id",
    "issued_at",
    "expires_at",
    "authority_requirement_coverage",
    "operation_contracts",
    "authentication_contract",
    "assertion_requirements",
    "replay_policy",
    "verification_status",
    "authentication_status",
    "assertions_authenticated",
    "runtime_authority_effect",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "authority_plan_id": {
      "type": "string",
      "pattern": "^APA-[0-9A-F]{32}$"
    },
    "authority_plan_sha256": {"$ref": "#/$defs/sha256"},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "source_preflight": {"$ref": "#/$defs/sourcePreflight"},
    "source_policies": {"$ref": "#/$defs/sourcePolicies"},
    "source_registry": {"$ref": "#/$defs/sourceRegistry"},
    "mission_id": {"$ref": "#/$defs/identifier"},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "authority_requirement_coverage": {
      "$ref": "#/$defs/authorityRequirementCoverage"
    },
    "operation_contracts": {
      "const": [
        {
          "operation": "sunderkey.collaboration.plan-replacement.owner-authorize.v1",
          "role": "mission_owner",
          "authority_kind": "principal_profile",
          "work_item_binding": "forbidden"
        },
        {
          "operation": "sunderkey.collaboration.plan-replacement.control-approve.v1",
          "role": "independent_control",
          "authority_kind": "principal_profile",
          "work_item_binding": "forbidden"
        },
        {
          "operation": "sunderkey.collaboration.plan-replacement.current-owner-authorize.v1",
          "role": "current_owner",
          "authority_kind": "principal_profile",
          "work_item_binding": "required"
        },
        {
          "operation": "sunderkey.collaboration.plan-replacement.current-owner-cancel.v1",
          "role": "current_owner",
          "authority_kind": "principal_profile",
          "work_item_binding": "required"
        },
        {
          "operation": "sunderkey.collaboration.plan-replacement.proposed-owner-accept.v1",
          "role": "proposed_owner",
          "authority_kind": "principal_profile",
          "work_item_binding": "required"
        },
        {
          "operation": "sunderkey.collaboration.plan-replacement.source-command-review.v1",
          "role": "source_technical_command",
          "authority_kind": "command",
          "work_item_binding": "required"
        },
        {
          "operation": "sunderkey.collaboration.plan-replacement.destination-command-review.v1",
          "role": "destination_technical_command",
          "authority_kind": "command",
          "work_item_binding": "required"
        },
        {
          "operation": "sunderkey.collaboration.plan-replacement.assurance-approve.v1",
          "role": "independent_assurance",
          "authority_kind": "principal_profile",
          "work_item_binding": "forbidden"
        },
        {
          "operation": "sunderkey.collaboration.plan-replacement.second-control-approve.v1",
          "role": "second_control",
          "authority_kind": "principal_profile",
          "work_item_binding": "forbidden"
        }
      ]
    },
    "authentication_contract": {
      "const": {
        "assertion_format": "sunderkey_principal_assertion_v1",
        "trust_policy_verification_required": true,
        "scope_grant_verification_required": true,
        "assertion_signature_verification_required": true,
        "exact_operation_intent_required": true,
        "all_requirements_required": true,
        "partial_authorization_effect": "none"
      }
    },
    "assertion_requirements": {
      "type": "array",
      "minItems": 2,
      "maxItems": 50000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/assertionRequirement"}
    },
    "replay_policy": {
      "const": {
        "mode": "consume_once_per_requirement_and_authority_plan",
        "durable_atomic_consumption_required": true,
        "reject_any_consumed_replay_key": true,
        "partial_consumption_effect": "none"
      }
    },
    "verification_status": {"const": "source_verification_required"},
    "authentication_status": {"const": "authenticated_assertions_required"},
    "assertions_authenticated": {"const": false},
    "runtime_authority_effect": {"const": "none"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^AOE-(G[A-E]-D[0-9]{2}-(S[0-9]{2}|CMD)|HQ-[0-9]{2})$"
    },
    "commandId": {
      "type": "string",
      "pattern": "^AOE-G[A-E]-D[0-9]{2}$"
    },
    "workItemId": {
      "type": "string",
      "pattern": "^WIT-[A-Z]{2,16}-[0-9A-F]{16}$"
    },
    "sourcePreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight_id", "preflight_sha256", "selection_sha256"],
      "properties": {
        "preflight_id": {
          "type": "string",
          "pattern": "^PRF-[0-9A-F]{32}$"
        },
        "preflight_sha256": {"$ref": "#/$defs/sha256"},
        "selection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_sha256"],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^(RAP|MRP)-[0-9A-F]{32}$"
        },
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "missionPolicyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_sha256",
        "policy_selection_sha256"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^MRP-[0-9A-F]{32}$"
        },
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "policy_selection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "missionPolicyCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_sha256",
        "policy_selection_sha256",
        "authentication_id",
        "authentication_sha256",
        "committed_at",
        "mission_owner_assertion_id",
        "mission_owner_assertion_sha256",
        "mission_owner_ledger_entry_sha256",
        "independent_control_assertion_id",
        "independent_control_assertion_sha256",
        "independent_control_ledger_entry_sha256",
        "commit_status"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^MRP-[0-9A-F]{32}$"
        },
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "policy_selection_sha256": {"$ref": "#/$defs/sha256"},
        "authentication_id": {
          "type": "string",
          "pattern": "^MPA-[0-9A-F]{32}$"
        },
        "authentication_sha256": {"$ref": "#/$defs/sha256"},
        "committed_at": {"$ref": "#/$defs/timestamp"},
        "mission_owner_assertion_id": {
          "type": "string",
          "pattern": "^PAS-[0-9A-F]{32}$"
        },
        "mission_owner_assertion_sha256": {"$ref": "#/$defs/sha256"},
        "mission_owner_ledger_entry_sha256": {"$ref": "#/$defs/sha256"},
        "independent_control_assertion_id": {
          "type": "string",
          "pattern": "^PAS-[0-9A-F]{32}$"
        },
        "independent_control_assertion_sha256": {"$ref": "#/$defs/sha256"},
        "independent_control_ledger_entry_sha256": {"$ref": "#/$defs/sha256"},
        "commit_status": {"const": "committed_inactive"}
      }
    },
    "sourcePolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconfiguration_authority_policy",
        "mission_reconfiguration_policy",
        "mission_policy_commit"
      ],
      "properties": {
        "reconfiguration_authority_policy": {"$ref": "#/$defs/policyReference"},
        "mission_reconfiguration_policy": {
          "$ref": "#/$defs/missionPolicyReference"
        },
        "mission_policy_commit": {"$ref": "#/$defs/missionPolicyCommit"}
      }
    },
    "sourceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "catalog_version",
        "file_sha256",
        "content_sha256"
      ],
      "properties": {
        "catalog_id": {"$ref": "#/$defs/identifier"},
        "catalog_version": {"$ref": "#/$defs/identifier"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorityRequirementCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_count",
        "ordered_requirement_tuples",
        "coverage_id",
        "coverage_sha256"
      ],
      "properties": {
        "requirement_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 50000
        },
        "ordered_requirement_tuples": {
          "type": "array",
          "minItems": 2,
          "maxItems": 50000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/authorityRequirementTuple"}
        },
        "coverage_id": {
          "type": "string",
          "pattern": "^ARC-[0-9A-F]{32}$"
        },
        "coverage_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorityRequirementTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "operation",
        "role",
        "authority_id",
        "authority_kind",
        "work_item_id"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^PAR-[0-9A-F]{32}$"
        },
        "operation": {
          "enum": [
            "sunderkey.collaboration.plan-replacement.owner-authorize.v1",
            "sunderkey.collaboration.plan-replacement.control-approve.v1",
            "sunderkey.collaboration.plan-replacement.current-owner-authorize.v1",
            "sunderkey.collaboration.plan-replacement.current-owner-cancel.v1",
            "sunderkey.collaboration.plan-replacement.proposed-owner-accept.v1",
            "sunderkey.collaboration.plan-replacement.source-command-review.v1",
            "sunderkey.collaboration.plan-replacement.destination-command-review.v1",
            "sunderkey.collaboration.plan-replacement.assurance-approve.v1",
            "sunderkey.collaboration.plan-replacement.second-control-approve.v1"
          ]
        },
        "role": {
          "enum": [
            "mission_owner",
            "independent_control",
            "current_owner",
            "proposed_owner",
            "source_technical_command",
            "destination_technical_command",
            "independent_assurance",
            "second_control"
          ]
        },
        "authority_id": {"$ref": "#/$defs/identifier"},
        "authority_kind": {"enum": ["principal_profile", "command"]},
        "work_item_id": {
          "oneOf": [
            {"$ref": "#/$defs/workItemId"},
            {"type": "null"}
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "role": {"const": "mission_owner"},
            "authority_id": {"$ref": "#/$defs/profileId"},
            "authority_kind": {"const": "principal_profile"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.owner-authorize.v1"},
            "work_item_id": {"type": "null"}
          }
        },
        {
          "properties": {
            "role": {"const": "independent_control"},
            "authority_id": {"$ref": "#/$defs/profileId"},
            "authority_kind": {"const": "principal_profile"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.control-approve.v1"},
            "work_item_id": {"type": "null"}
          }
        },
        {
          "properties": {
            "role": {"const": "current_owner"},
            "authority_id": {"$ref": "#/$defs/profileId"},
            "authority_kind": {"const": "principal_profile"},
            "operation": {
              "enum": [
                "sunderkey.collaboration.plan-replacement.current-owner-authorize.v1",
                "sunderkey.collaboration.plan-replacement.current-owner-cancel.v1"
              ]
            },
            "work_item_id": {"$ref": "#/$defs/workItemId"}
          }
        },
        {
          "properties": {
            "role": {"const": "proposed_owner"},
            "authority_id": {"$ref": "#/$defs/profileId"},
            "authority_kind": {"const": "principal_profile"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.proposed-owner-accept.v1"},
            "work_item_id": {"$ref": "#/$defs/workItemId"}
          }
        },
        {
          "properties": {
            "role": {"const": "source_technical_command"},
            "authority_id": {"$ref": "#/$defs/commandId"},
            "authority_kind": {"const": "command"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.source-command-review.v1"},
            "work_item_id": {"$ref": "#/$defs/workItemId"}
          }
        },
        {
          "properties": {
            "role": {"const": "destination_technical_command"},
            "authority_id": {"$ref": "#/$defs/commandId"},
            "authority_kind": {"const": "command"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.destination-command-review.v1"},
            "work_item_id": {"$ref": "#/$defs/workItemId"}
          }
        },
        {
          "properties": {
            "role": {"const": "independent_assurance"},
            "authority_id": {"$ref": "#/$defs/profileId"},
            "authority_kind": {"const": "principal_profile"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.assurance-approve.v1"},
            "work_item_id": {"type": "null"}
          }
        },
        {
          "properties": {
            "role": {"const": "second_control"},
            "authority_id": {"$ref": "#/$defs/profileId"},
            "authority_kind": {"const": "principal_profile"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.second-control-approve.v1"},
            "work_item_id": {"type": "null"}
          }
        }
      ]
    },
    "assertionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "role",
        "authority_id",
        "authority_kind",
        "resolved_profile_id",
        "operation",
        "work_item_id",
        "preflight_operation_intent_sha256",
        "assertion_valid_after",
        "assertion_expires_at",
        "replay_status",
        "principal_operation_intent_sha256",
        "replay_key_sha256"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^PAR-[0-9A-F]{32}$"
        },
        "role": {
          "enum": [
            "mission_owner",
            "independent_control",
            "current_owner",
            "proposed_owner",
            "source_technical_command",
            "destination_technical_command",
            "independent_assurance",
            "second_control"
          ]
        },
        "authority_id": {"$ref": "#/$defs/identifier"},
        "authority_kind": {"enum": ["principal_profile", "command"]},
        "resolved_profile_id": {"$ref": "#/$defs/profileId"},
        "operation": {
          "enum": [
            "sunderkey.collaboration.plan-replacement.owner-authorize.v1",
            "sunderkey.collaboration.plan-replacement.control-approve.v1",
            "sunderkey.collaboration.plan-replacement.current-owner-authorize.v1",
            "sunderkey.collaboration.plan-replacement.current-owner-cancel.v1",
            "sunderkey.collaboration.plan-replacement.proposed-owner-accept.v1",
            "sunderkey.collaboration.plan-replacement.source-command-review.v1",
            "sunderkey.collaboration.plan-replacement.destination-command-review.v1",
            "sunderkey.collaboration.plan-replacement.assurance-approve.v1",
            "sunderkey.collaboration.plan-replacement.second-control-approve.v1"
          ]
        },
        "work_item_id": {
          "oneOf": [
            {"$ref": "#/$defs/workItemId"},
            {"type": "null"}
          ]
        },
        "preflight_operation_intent_sha256": {"$ref": "#/$defs/sha256"},
        "assertion_valid_after": {"$ref": "#/$defs/timestamp"},
        "assertion_expires_at": {"$ref": "#/$defs/timestamp"},
        "replay_status": {"const": "unused_required"},
        "principal_operation_intent_sha256": {"$ref": "#/$defs/sha256"},
        "replay_key_sha256": {"$ref": "#/$defs/sha256"}
      },
      "oneOf": [
        {
          "properties": {
            "role": {"const": "mission_owner"},
            "authority_id": {"$ref": "#/$defs/profileId"},
            "authority_kind": {"const": "principal_profile"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.owner-authorize.v1"},
            "work_item_id": {"type": "null"}
          }
        },
        {
          "properties": {
            "role": {"const": "independent_control"},
            "authority_id": {"$ref": "#/$defs/profileId"},
            "authority_kind": {"const": "principal_profile"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.control-approve.v1"},
            "work_item_id": {"type": "null"}
          }
        },
        {
          "properties": {
            "role": {"const": "current_owner"},
            "authority_id": {"$ref": "#/$defs/profileId"},
            "authority_kind": {"const": "principal_profile"},
            "operation": {
              "enum": [
                "sunderkey.collaboration.plan-replacement.current-owner-authorize.v1",
                "sunderkey.collaboration.plan-replacement.current-owner-cancel.v1"
              ]
            },
            "work_item_id": {"$ref": "#/$defs/workItemId"}
          }
        },
        {
          "properties": {
            "role": {"const": "proposed_owner"},
            "authority_id": {"$ref": "#/$defs/profileId"},
            "authority_kind": {"const": "principal_profile"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.proposed-owner-accept.v1"},
            "work_item_id": {"$ref": "#/$defs/workItemId"}
          }
        },
        {
          "properties": {
            "role": {"const": "source_technical_command"},
            "authority_id": {"$ref": "#/$defs/commandId"},
            "authority_kind": {"const": "command"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.source-command-review.v1"},
            "work_item_id": {"$ref": "#/$defs/workItemId"}
          }
        },
        {
          "properties": {
            "role": {"const": "destination_technical_command"},
            "authority_id": {"$ref": "#/$defs/commandId"},
            "authority_kind": {"const": "command"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.destination-command-review.v1"},
            "work_item_id": {"$ref": "#/$defs/workItemId"}
          }
        },
        {
          "properties": {
            "role": {"const": "independent_assurance"},
            "authority_id": {"$ref": "#/$defs/profileId"},
            "authority_kind": {"const": "principal_profile"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.assurance-approve.v1"},
            "work_item_id": {"type": "null"}
          }
        },
        {
          "properties": {
            "role": {"const": "second_control"},
            "authority_id": {"$ref": "#/$defs/profileId"},
            "authority_kind": {"const": "principal_profile"},
            "operation": {"const": "sunderkey.collaboration.plan-replacement.second-control-approve.v1"},
            "work_item_id": {"type": "null"}
          }
        }
      ]
    }
  }
}
