          ],
          "properties": {
            "binding": {"$ref": "#/$defs/binding"},
            "binding_sha256": {"$ref": "#/$defs/digest"},
            "chain_id": {"$ref": "#/$defs/chain_id"},
            "collector_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
            "collector_id": {"$ref": "#/$defs/identifier"},
