{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/capability-catalog-v2.json",
  "title": "SUNDERKEY Army v2 Capability Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_version",
    "expert_catalog_id",
    "expert_catalog_version",
    "capabilities",
    "profile_assignments"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "profile_scope"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "profile_scope"
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "profile_scope": {
      "const": "all_specialists"
    },
    "catalog_id": {
      "const": "sunderkey-army-capabilities-v2"
    },
    "catalog_version": {
      "const": "2.0.0"
    },
    "expert_catalog_id": {
      "const": "sunderkey-offensive-expert-army"
    },
    "expert_catalog_version": {
      "const": "2.0.0"
    },
    "capabilities": {
      "type": "array",
      "minItems": 391,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "name": {
            "$ref": "#/$defs/asciiText"
          }
        }
      },
      "maxItems": 391
    },
    "profile_assignments": {
      "type": "array",
      "minItems": 391,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "primary_capability_ids",
          "supporting_capability_ids"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^AOE-G[A-E]-D[0-9]{2}-S[0-9]{2}$"
          },
          "primary_capability_ids": {
            "$ref": "#/$defs/primaryCapabilityIds"
          },
          "supporting_capability_ids": {
            "$ref": "#/$defs/capabilityIds",
            "minItems": 1
          }
        }
      },
      "maxItems": 391
    }
  },
  "$defs": {
    "asciiText": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "^[\\u0009\\u000A\\u000D\\u0020-\\u007E]+$"
        },
        {
          "pattern": "[\\u0021-\\u007E]"
        }
      ]
    },
    "primaryCapabilityIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "capabilityIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    }
  }
}
