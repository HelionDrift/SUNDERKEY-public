      "properties": {"artifact_ref": {"$ref": "#/$defs/identifier"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "exact_version": {"$ref": "#/$defs/version"}}
    },
    "parameter_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "required", "value_type"],
      "properties": {"name": {"$ref": "#/$defs/identifier"}, "required": {"type": "boolean"}, "value_type": {"enum": ["string", "identifier", "sha256", "integer", "boolean", "string_array"]}}
    },
    "catalog_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["action_type", "executor_supported", "maximum_action_tier", "parameter_contract", "parameter_contract_sha256", "r4_executor_supported", "supported_environments", "tool_artifact_ref", "tool_artifact_sha256", "tool_exact_version"],
      "properties": {
