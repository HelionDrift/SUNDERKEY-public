      "properties": {"action_sha256": {"$ref": "#/$defs/sha256"}, "expires_at": {"$ref": "#/$defs/timestamp"}, "maximum_impact_events": {"type": "integer", "minimum": 1}, "monitor_session_id": {"$ref": "#/$defs/identifier"}, "monitor_worker_id": {"$ref": "#/$defs/identifier"}, "scope_sha256": {"$ref": "#/$defs/sha256"}, "stop_contract_sha256": {"$ref": "#/$defs/sha256"}, "stop_deadline_at": {"$ref": "#/$defs/timestamp"}, "target_sha256": {"$ref": "#/$defs/sha256"}}
