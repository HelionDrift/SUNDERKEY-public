      "properties": {"authorization_effect": {"const": "none"}, "model_call_performed": {"const": false}, "network_call_performed": {"const": false}, "qualification_effect": {"const": "none"}, "target_action_performed": {"const": false}, "tool_effect": {"const": "none"}}
    },
    "resolution_effects": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_effect", "dispatch_performed", "model_call_performed", "network_call_performed", "qualification_effect", "target_action_performed", "tool_effect"],
      "properties": {"authorization_effect": {"const": "none"}, "dispatch_performed": {"const": false}, "model_call_performed": {"const": false}, "network_call_performed": {"const": false}, "qualification_effect": {"const": "none"}, "target_action_performed": {"const": false}, "tool_effect": {"const": "none"}}
    },
