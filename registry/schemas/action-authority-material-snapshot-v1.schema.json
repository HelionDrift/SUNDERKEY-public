        "schema_version": {"const": 1}, "kind": {"const": "executable_action_catalog"}, "effects": {"$ref": "#/$defs/resolution_effects"},
        "catalog_id": {"$ref": "#/$defs/identifier"}, "catalog_sha256": {"$ref": "#/$defs/sha256"}, "catalog_name": {"$ref": "#/$defs/identifier"}, "catalog_version": {"$ref": "#/$defs/version"}, "registry_sha256": {"$ref": "#/$defs/sha256"},
        "entries": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/catalog_entry"}}
      }
    },
    "parameter_value": {
      "oneOf": [
        {"type": "boolean"},
        {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[\\x20-\\x7E]*$"},
        {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[\\x20-\\x7E]*$"}}
