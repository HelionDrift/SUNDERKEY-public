      "properties": {"action_sha256": {"$ref": "#/$defs/sha256"}, "completion_evidence_required": {"const": true}, "owner_profile_id": {"$ref": "#/$defs/identifier"}, "required": {"const": true}, "restoration_plan_sha256": {"$ref": "#/$defs/sha256"}, "scope_sha256": {"$ref": "#/$defs/sha256"}, "target_sha256": {"$ref": "#/$defs/sha256"}, "verifier_profile_id": {"$ref": "#/$defs/identifier"}}
    }
  }
}
