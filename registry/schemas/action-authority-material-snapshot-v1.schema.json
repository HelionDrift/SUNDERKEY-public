      "properties": {"credential_ref_sha256": {"$ref": "#/$defs/sha256"}, "expires_at": {"$ref": "#/$defs/timestamp"}, "fence_token_sha256": {"$ref": "#/$defs/sha256"}, "issued_at": {"$ref": "#/$defs/timestamp"}, "leader_epoch": {"type": "integer", "minimum": 1}, "lease_id": {"$ref": "#/$defs/identifier"}, "mission_id": {"$ref": "#/$defs/identifier"}, "permitted_action_sha256": {"$ref": "#/$defs/sha256"}, "revoked": {"type": "boolean"}, "scope_sha256": {"$ref": "#/$defs/sha256"}, "session_id": {"$ref": "#/$defs/identifier"}, "tenant_id": {"$ref": "#/$defs/identifier"}, "worker_id": {"$ref": "#/$defs/identifier"}}
    },
    "health": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_sha256", "expires_at", "fence_token_sha256", "leader_epoch", "observed_at", "session_id", "status", "worker_id"],
      "properties": {"evidence_sha256": {"$ref": "#/$defs/sha256"}, "expires_at": {"$ref": "#/$defs/timestamp"}, "fence_token_sha256": {"$ref": "#/$defs/sha256"}, "leader_epoch": {"type": "integer", "minimum": 1}, "observed_at": {"$ref": "#/$defs/timestamp"}, "session_id": {"$ref": "#/$defs/identifier"}, "status": {"enum": ["healthy", "degraded", "unhealthy"]}, "worker_id": {"$ref": "#/$defs/identifier"}}
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["action_cost_microunits", "action_request_cost", "action_token_cost", "budget_sha256", "cost_limit_microunits", "cost_used_microunits", "mission_id", "request_limit", "requests_used", "tenant_id", "token_limit", "tokens_used"],
      "properties": {"action_cost_microunits": {"type": "integer", "minimum": 0}, "action_request_cost": {"type": "integer", "minimum": 0}, "action_token_cost": {"type": "integer", "minimum": 0}, "budget_sha256": {"$ref": "#/$defs/sha256"}, "cost_limit_microunits": {"type": "integer", "minimum": 0}, "cost_used_microunits": {"type": "integer", "minimum": 0}, "mission_id": {"$ref": "#/$defs/identifier"}, "request_limit": {"type": "integer", "minimum": 0}, "requests_used": {"type": "integer", "minimum": 0}, "tenant_id": {"$ref": "#/$defs/identifier"}, "token_limit": {"type": "integer", "minimum": 0}, "tokens_used": {"type": "integer", "minimum": 0}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["action_sha256", "evidence_kind", "evidence_sha256", "expires_at", "issued_at", "mission_id", "producer_id", "scope_sha256", "target_sha256", "tenant_id"],
      "properties": {"action_sha256": {"$ref": "#/$defs/sha256"}, "evidence_kind": {"enum": ["custody", "observability", "restoration_readiness", "safety_review", "scope_authority", "stop_readiness", "target_authority"]}, "evidence_sha256": {"$ref": "#/$defs/sha256"}, "expires_at": {"$ref": "#/$defs/timestamp"}, "issued_at": {"$ref": "#/$defs/timestamp"}, "mission_id": {"$ref": "#/$defs/identifier"}, "producer_id": {"$ref": "#/$defs/identifier"}, "scope_sha256": {"$ref": "#/$defs/sha256"}, "target_sha256": {"$ref": "#/$defs/sha256"}, "tenant_id": {"$ref": "#/$defs/identifier"}}
    },
