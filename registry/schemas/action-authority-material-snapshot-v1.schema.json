      "properties": {
        "schema_version": {"const": 1}, "kind": {"const": "target_action_descriptor"}, "effects": {"$ref": "#/$defs/resolution_effects"}, "descriptor_id": {"$ref": "#/$defs/identifier"}, "descriptor_sha256": {"$ref": "#/$defs/sha256"}, "tenant_id": {"$ref": "#/$defs/identifier"}, "mission_id": {"$ref": "#/$defs/identifier"}, "target_scope_sha256": {"$ref": "#/$defs/sha256"}, "authority_snapshot_sha256": {"$ref": "#/$defs/sha256"}, "target_id": {"$ref": "#/$defs/identifier"}, "target_sha256": {"$ref": "#/$defs/sha256"}, "environment": {"enum": ["sandbox", "replica", "live"]}
      }
