        "parameter_contract_sha256": {"$ref": "#/$defs/sha256"}, "r4_executor_supported": {"type": "boolean"},
        "supported_environments": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["sandbox", "replica", "live"]}},
        "tool_artifact_ref": {"$ref": "#/$defs/identifier"}, "tool_artifact_sha256": {"$ref": "#/$defs/sha256"}, "tool_exact_version": {"$ref": "#/$defs/version"}
