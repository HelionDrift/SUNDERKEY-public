{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/action-authority-material-snapshot-v1.schema.json",
  "title": "SUNDERKEY action authority material snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "material_snapshot_id", "material_snapshot_sha256", "tenant_id", "mission_id", "plan_id", "proposal_import_id", "proposal_import_sha256", "catalog", "parameters", "target", "resolver_profile_id", "resolver_subject", "context", "worker_session", "credential_lease", "health", "budget", "evidence_obligations", "stop_conditions", "restoration_duties", "resolved_at", "approved_at", "quorum_expires_at", "requested_at", "expires_at", "credential_lease_sha256", "health_observation_sha256", "executor_deployment_sha256", "monitor_observation_sha256", "observed_at", "valid_until", "effects"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "action_authority_material_snapshot"},
    "material_snapshot_id": {"type": "string", "pattern": "^AAM-[0-9A-F]{32}$"},
    "material_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "tenant_id": {"$ref": "#/$defs/identifier"},
    "mission_id": {"$ref": "#/$defs/identifier"},
    "plan_id": {"$ref": "#/$defs/identifier"},
    "proposal_import_id": {"$ref": "#/$defs/identifier"},
    "proposal_import_sha256": {"$ref": "#/$defs/sha256"},
    "catalog": {"$ref": "#/$defs/catalog"},
    "parameters": {"$ref": "#/$defs/parameters"},
    "target": {"$ref": "#/$defs/target"},
    "resolver_profile_id": {"$ref": "#/$defs/identifier"},
    "resolver_subject": {"$ref": "#/$defs/identifier"},
    "context": {"$ref": "#/$defs/context"},
    "worker_session": {"$ref": "#/$defs/worker"},
    "credential_lease": {"$ref": "#/$defs/credential"},
    "health": {"$ref": "#/$defs/health"},
    "budget": {"$ref": "#/$defs/budget"},
    "evidence_obligations": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "stop_conditions": {"$ref": "#/$defs/stop"},
    "restoration_duties": {"$ref": "#/$defs/restoration"},
    "resolved_at": {"$ref": "#/$defs/timestamp"},
    "approved_at": {"$ref": "#/$defs/timestamp"},
    "quorum_expires_at": {"$ref": "#/$defs/timestamp"},
    "requested_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "credential_lease_sha256": {"$ref": "#/$defs/sha256"},
    "health_observation_sha256": {"$ref": "#/$defs/sha256"},
    "executor_deployment_sha256": {"$ref": "#/$defs/sha256"},
    "monitor_observation_sha256": {"$ref": "#/$defs/sha256"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "valid_until": {"$ref": "#/$defs/timestamp"},
    "effects": {"$ref": "#/$defs/effects"}
