{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.example/schemas/api-service-contract-v1.schema.json",
  "title": "SUNDERKEY API service contract version 1",
  "oneOf": [
    { "$ref": "#/$defs/apiRequest" },
    { "$ref": "#/$defs/apiResponse" },
    { "$ref": "#/$defs/webhookSubscription" },
    { "$ref": "#/$defs/webhookDelivery" },
    { "$ref": "#/$defs/webhookAcknowledgement" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nullableIdentifier": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "nullablePositiveVersion": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        { "type": "null" }
      ]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "authority",
        "client",
        "delivery",
        "execution",
        "network",
        "routing",
        "scheduling",
        "server"
      ],
      "properties": {
        "authorization": { "const": "external" },
        "authority": { "const": "none" },
        "client": { "const": "none" },
        "delivery": { "const": "none" },
        "execution": { "const": "none" },
        "network": { "const": "none" },
        "routing": { "const": "none" },
        "scheduling": { "const": "none" },
        "server": { "const": "none" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authentication_context_ref",
        "principal_id",
        "principal_role",
        "tenant_id"
      ],
      "properties": {
        "authentication_context_ref": { "$ref": "#/$defs/identifier" },
        "principal_id": { "$ref": "#/$defs/identifier" },
        "principal_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "tenant_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_body_bytes",
        "max_page_size",
        "max_reference_count",
        "max_requests_per_minute"
      ],
      "properties": {
        "max_body_bytes": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "max_page_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "max_reference_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_requests_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "pageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "size"],
      "properties": {
        "cursor": {
          "oneOf": [
            { "type": "string", "pattern": "^cursor:[A-Za-z0-9_-]{16,512}$" },
            { "type": "null" }
          ]
        },
        "size": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "pageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_cursor", "returned_count"],
      "properties": {
        "next_cursor": {
          "oneOf": [
            { "type": "string", "pattern": "^cursor:[A-Za-z0-9_-]{16,512}$" },
            { "type": "null" }
          ]
        },
        "returned_count": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "kind", "reference", "resource_version"],
      "properties": {
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "kind": {
          "enum": [
            "assessment",
            "scope_admission",
            "schedule",
            "status",
            "evidence",
            "finding",
            "report",
            "cancellation",
            "emergency_stop"
          ]
        },
        "reference": {
          "type": "string",
          "pattern": "^(evidref|findingref|reportref|scoperef|schedref|statusref|assessmentref):[A-Za-z0-9][A-Za-z0-9._:/-]{0,247}$"
        },
        "resource_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "apiError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail_ref", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "authentication_required",
            "authorization_external",
            "body_limit_exceeded",
            "conflict",
            "idempotency_conflict",
            "invalid_cursor",
            "invalid_request",
            "not_found",
            "rate_budget_exceeded",
            "resource_version_conflict",
            "scope_not_admitted",
            "service_unavailable",
            "stop_already_recorded"
          ]
        },
        "detail_ref": { "$ref": "#/$defs/nullableIdentifier" },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 },
        "retryable": { "type": "boolean" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_ref", "signature"],
      "properties": {
        "algorithm": { "enum": ["ed25519", "ecdsa_p256_sha256"] },
        "key_ref": {
          "type": "string",
          "pattern": "^secretref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,245}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,684}$"
        }
      }
    },
    "retryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dead_letter_after_attempts", "delays_seconds"],
      "properties": {
        "dead_letter_after_attempts": {
          "type": "integer",
          "minimum": 2,
          "maximum": 11
        },
        "delays_seconds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "integer", "minimum": 1, "maximum": 86400 }
        }
      }
    },
    "operation": {
      "enum": [
        "create_assessment",
        "admit_scope",
        "create_schedule",
        "get_status",
        "list_evidence",
        "list_findings",
        "get_report",
        "cancel_assessment",
        "emergency_stop"
      ]
    },
    "eventType": {
      "enum": [
        "assessment.created",
        "scope_admission.recorded",
        "schedule.created",
        "status.changed",
        "evidence.available",
        "finding.changed",
        "report.available",
        "assessment.cancelled",
        "emergency_stop.recorded"
      ]
    },
    "apiRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "body_size_bytes",
        "budget",
        "content_references",
        "effects",
        "expected_resource_version",
        "idempotency_key",
        "issued_at",
        "kind",
        "operation",
        "page",
        "reason_code",
        "request_contract_id",
        "request_id",
        "request_sha256",
        "resource_id",
        "schema_version"
      ],
      "properties": {
        "binding": { "$ref": "#/$defs/binding" },
        "body_size_bytes": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "budget": { "$ref": "#/$defs/budget" },
        "content_references": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/resource" }
        },
        "effects": { "$ref": "#/$defs/effects" },
        "expected_resource_version": { "$ref": "#/$defs/nullablePositiveVersion" },
        "idempotency_key": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^idem:[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"
            },
            { "type": "null" }
          ]
        },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "kind": { "const": "sunderkey.api-request.v1" },
        "operation": { "$ref": "#/$defs/operation" },
        "page": {
          "oneOf": [
            { "$ref": "#/$defs/pageRequest" },
            { "type": "null" }
          ]
        },
        "reason_code": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
            { "type": "null" }
          ]
        },
        "request_contract_id": {
          "type": "string",
          "pattern": "^ASR-[0-9A-F]{32}$"
        },
        "request_id": { "$ref": "#/$defs/identifier" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "resource_id": { "$ref": "#/$defs/nullableIdentifier" },
        "schema_version": { "const": 1 }
      }
    },
    "apiResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "effects",
        "error",
        "kind",
        "operation",
        "page",
        "request_contract_id",
        "request_sha256",
        "resources",
        "responded_at",
        "response_contract_id",
        "response_sha256",
        "schema_version",
        "status"
      ],
      "properties": {
        "binding": { "$ref": "#/$defs/binding" },
        "effects": { "$ref": "#/$defs/effects" },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/apiError" },
            { "type": "null" }
          ]
        },
        "kind": { "const": "sunderkey.api-response.v1" },
        "operation": { "$ref": "#/$defs/operation" },
        "page": {
          "oneOf": [
            { "$ref": "#/$defs/pageResult" },
            { "type": "null" }
          ]
        },
        "request_contract_id": {
          "type": "string",
          "pattern": "^ASR-[0-9A-F]{32}$"
        },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "resources": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/resource" }
        },
        "responded_at": { "$ref": "#/$defs/timestamp" },
        "response_contract_id": {
          "type": "string",
          "pattern": "^ASP-[0-9A-F]{32}$"
        },
        "response_sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": 1 },
        "status": { "enum": ["accepted", "completed", "rejected"] }
      }
    },
    "webhookSubscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "created_at",
        "effects",
        "endpoint_ref",
        "event_filters",
        "kind",
        "max_in_flight",
        "schema_version",
        "signature",
        "signing_key_ref",
        "subscription_id",
        "subscription_sha256"
      ],
      "properties": {
        "binding": { "$ref": "#/$defs/binding" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "effects": { "$ref": "#/$defs/effects" },
        "endpoint_ref": {
          "type": "string",
          "pattern": "^endpointref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,243}$"
        },
        "event_filters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/eventType" }
        },
        "kind": { "const": "sunderkey.webhook-subscription.v1" },
        "max_in_flight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "schema_version": { "const": 1 },
        "signature": { "$ref": "#/$defs/signature" },
        "signing_key_ref": {
          "type": "string",
          "pattern": "^secretref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,245}$"
        },
        "subscription_id": { "$ref": "#/$defs/identifier" },
        "subscription_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "webhookDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "delivery_id",
        "delivery_sha256",
        "effects",
        "event_type",
        "expires_at",
        "kind",
        "nonce",
        "occurred_at",
        "resource",
        "retry_plan",
        "schema_version",
        "sequence",
        "signature",
        "state",
        "subscription_id",
        "subscription_sha256"
      ],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1, "maximum": 11 },
        "delivery_id": { "$ref": "#/$defs/identifier" },
        "delivery_sha256": { "$ref": "#/$defs/sha256" },
        "effects": { "$ref": "#/$defs/effects" },
        "event_type": { "$ref": "#/$defs/eventType" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "kind": { "const": "sunderkey.webhook-delivery.v1" },
        "nonce": {
          "type": "string",
          "pattern": "^nonce:[A-Za-z0-9_-]{22,128}$"
        },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "resource": { "$ref": "#/$defs/resource" },
        "retry_plan": { "$ref": "#/$defs/retryPlan" },
        "schema_version": { "const": 1 },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "signature": { "$ref": "#/$defs/signature" },
        "state": { "enum": ["planned", "attempted", "dead_lettered"] },
        "subscription_id": { "$ref": "#/$defs/identifier" },
        "subscription_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "webhookAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acknowledged_at",
        "acknowledgement_id",
        "acknowledgement_sha256",
        "delivery_id",
        "delivery_sha256",
        "effects",
        "kind",
        "schema_version",
        "sequence",
        "signature",
        "subscription_id"
      ],
      "properties": {
        "acknowledged_at": { "$ref": "#/$defs/timestamp" },
        "acknowledgement_id": { "$ref": "#/$defs/identifier" },
        "acknowledgement_sha256": { "$ref": "#/$defs/sha256" },
        "delivery_id": { "$ref": "#/$defs/identifier" },
        "delivery_sha256": { "$ref": "#/$defs/sha256" },
        "effects": { "$ref": "#/$defs/effects" },
        "kind": { "const": "sunderkey.webhook-acknowledgement.v1" },
        "schema_version": { "const": 1 },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "signature": { "$ref": "#/$defs/signature" },
        "subscription_id": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
