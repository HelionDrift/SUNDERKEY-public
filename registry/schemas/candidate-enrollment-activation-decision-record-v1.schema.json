{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/candidate-enrollment-activation-decision-record-v1.json",
  "title": "SUNDERKEY Candidate Enrollment Activation Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_sha256",
    "decision_id",
    "decision_status",
    "decision_effect",
    "source_dossier",
    "approval",
    "selected_options",
    "recommendation_alignment",
    "nonnegotiable_requirements",
    "authorized_next_steps",
    "prohibited_effects",
    "implementation_status",
    "qualification_effect",
    "registry_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "pattern": "^CAR-[0-9A-F]{32}$"},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "decision_id": {"const": "D011"},
    "decision_status": {"const": "approved_operator_asserted_unsigned"},
    "decision_effect": {"const": "checkpoint_and_release_contract_implementation_authorized"},
    "source_dossier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "sha256"],
      "properties": {
        "report_id": {"type": "string", "pattern": "^CAD-[0-9A-F]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_status",
        "authority_role",
        "approver_id",
        "approved_at",
        "rationale",
        "identity_assurance"
      ],
      "properties": {
        "decision_status": {"const": "approved"},
        "authority_role": {"const": "repository_owner"},
        "approver_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -~]+$"},
        "approved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[ -~]+$"},
        "identity_assurance": {"const": "operator_asserted_unsigned"}
      }
    },
    "selected_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_authority",
        "local_checkpoint_storage",
        "release_transaction",
        "commit_and_recovery_authority",
        "partial_failure_and_recovery",
        "catalog_distribution",
        "initial_activation_scope",
        "release_chain_retention"
      ],
      "properties": {
        "checkpoint_authority": {"const": "append_only_release_ledger_with_local_mirror"},
        "local_checkpoint_storage": {"const": "atomic_versioned_file_with_protected_acl_and_backup"},
        "release_transaction": {"const": "verify_intent_checkpoint_promote_completion"},
        "commit_and_recovery_authority": {"const": "automatic_advance_dual_control_initialization_and_recovery"},
        "partial_failure_and_recovery": {"const": "fail_closed_same_digest_retry_and_ledger_recovery"},
        "catalog_distribution": {"const": "organization_content_addressed_artifact_repository"},
        "initial_activation_scope": {"const": "single_candidate_canary"},
        "release_chain_retention": {"const": "full_chain_for_deployment_lifetime_plus_audit_period"}
      }
    },
    "recommendation_alignment": {
      "const": {
        "all_recommended_options_selected": true,
        "selected_option_count": 8,
        "selected_recommended_option_count": 8
      }
    },
    "nonnegotiable_requirements": {
      "const": [
        "no_checkpoint_version_or_digest_decrease",
        "same_version_requires_same_catalog_digest",
        "checkpoint_commit_precedes_catalog_promotion",
        "missing_corrupt_or_ambiguous_checkpoint_fails_closed",
        "recovery_never_trusts_self_declared_current_catalog_state",
        "private_keys_credentials_and_endpoints_remain_outside_checkpoint_records",
        "every_release_binds_the_phase72_verification_receipt",
        "no_live_evidence_acceptance_before_controlled_release_completion"
      ]
    },
    "authorized_next_steps": {
      "const": [
        "define_checkpoint_store_and_release_ledger_contracts",
        "implement_atomic_local_checkpoint_adapter",
        "implement_release_intent_promotion_and_completion_protocol",
        "implement_fail_closed_crash_and_recovery_state_machine",
        "add_adversarial_rollback_corruption_and_partial_failure_tests",
        "prepare_single_candidate_canary_activation_packet"
      ]
    },
    "prohibited_effects": {
      "const": [
        "does_not_create_a_checkpoint_store_or_release_ledger",
        "does_not_persist_or_initialize_a_checkpoint",
        "does_not_publish_or_promote_a_catalog",
        "does_not_select_live_candidate_keys_repositories_or_reviewers",
        "does_not_enroll_a_live_candidate_or_accept_live_evidence",
        "does_not_create_keys_credentials_signatures_or_attestations",
        "does_not_qualify_a_specialist_or_change_routing",
        "does_not_make_network_requests_or_mutate_sqlite"
      ]
    },
    "implementation_status": {"const": "not_started"},
    "qualification_effect": {"const": "none"},
    "registry_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
