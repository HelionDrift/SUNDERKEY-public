{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/action-admission-contract-v1.schema.json",
  "title": "SUNDERKEY atomic action-admission contracts v1",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/decision"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "version": {
      "type": "string",
      "pattern": "^(?=.*[0-9])[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
      "not": {"enum": ["auto", "current", "default", "latest", "stable"]}
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "tier": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization", "credential_use", "dispatch", "network", "restoration", "stop", "target_action"],
      "properties": {
        "authorization": {"const": "none"},
        "credential_use": {"const": "none"},
        "dispatch": {"const": "none"},
        "network": {"const": "none"},
        "restoration": {"const": "none"},
        "stop": {"const": "none"},
        "target_action": {"const": "none"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_sha256", "exact_version"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/identifier"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "exact_version": {"$ref": "#/$defs/version"}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["mission_id", "policy", "scope_id", "scope_sha256", "tenant_id"],
      "properties": {
        "mission_id": {"$ref": "#/$defs/identifier"}, "policy": {"$ref": "#/$defs/artifact"},
        "scope_id": {"$ref": "#/$defs/identifier"}, "scope_sha256": {"$ref": "#/$defs/sha256"},
        "tenant_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "worker": {
      "type": "object", "additionalProperties": false,
      "required": ["expires_at", "fence_token_sha256", "issued_at", "leader_epoch", "mission_id", "session_id", "tenant_id", "worker_id", "worker_profile_id"],
      "properties": {
        "expires_at": {"$ref": "#/$defs/timestamp"}, "fence_token_sha256": {"$ref": "#/$defs/sha256"},
        "issued_at": {"$ref": "#/$defs/timestamp"}, "leader_epoch": {"type": "integer", "minimum": 1},
        "mission_id": {"$ref": "#/$defs/identifier"}, "session_id": {"$ref": "#/$defs/identifier"},
        "tenant_id": {"$ref": "#/$defs/identifier"}, "worker_id": {"$ref": "#/$defs/identifier"},
        "worker_profile_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["action_sha256", "approval_id", "approval_sha256", "approver_id", "authorized_tier", "decision", "expires_at", "fence_token_sha256", "issued_at", "leader_epoch", "mission_id", "scope_sha256", "session_id", "target_sha256", "tenant_id", "worker_id"],
      "properties": {
        "action_sha256": {"$ref": "#/$defs/sha256"}, "approval_id": {"$ref": "#/$defs/identifier"},
        "approval_sha256": {"$ref": "#/$defs/sha256"}, "approver_id": {"$ref": "#/$defs/identifier"},
        "authorized_tier": {"$ref": "#/$defs/tier"}, "decision": {"const": "approved"},
        "expires_at": {"$ref": "#/$defs/timestamp"}, "fence_token_sha256": {"$ref": "#/$defs/sha256"},
        "issued_at": {"$ref": "#/$defs/timestamp"}, "leader_epoch": {"type": "integer", "minimum": 1},
        "mission_id": {"$ref": "#/$defs/identifier"}, "scope_sha256": {"$ref": "#/$defs/sha256"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "target_sha256": {"$ref": "#/$defs/sha256"}, "tenant_id": {"$ref": "#/$defs/identifier"},
        "worker_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "credential": {
      "type": "object", "additionalProperties": false,
      "required": ["credential_ref_sha256", "expires_at", "fence_token_sha256", "issued_at", "leader_epoch", "lease_id", "mission_id", "permitted_action_sha256", "revoked", "scope_sha256", "session_id", "tenant_id", "worker_id"],
      "properties": {
        "credential_ref_sha256": {"$ref": "#/$defs/sha256"}, "expires_at": {"$ref": "#/$defs/timestamp"},
        "fence_token_sha256": {"$ref": "#/$defs/sha256"}, "issued_at": {"$ref": "#/$defs/timestamp"},
        "leader_epoch": {"type": "integer", "minimum": 1}, "lease_id": {"$ref": "#/$defs/identifier"},
        "mission_id": {"$ref": "#/$defs/identifier"}, "permitted_action_sha256": {"$ref": "#/$defs/sha256"},
        "revoked": {"type": "boolean"}, "scope_sha256": {"$ref": "#/$defs/sha256"},
        "session_id": {"$ref": "#/$defs/identifier"}, "tenant_id": {"$ref": "#/$defs/identifier"},
        "worker_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "health": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_sha256", "expires_at", "fence_token_sha256", "leader_epoch", "observed_at", "session_id", "status", "worker_id"],
      "properties": {
        "evidence_sha256": {"$ref": "#/$defs/sha256"}, "expires_at": {"$ref": "#/$defs/timestamp"},
        "fence_token_sha256": {"$ref": "#/$defs/sha256"}, "leader_epoch": {"type": "integer", "minimum": 1},
        "observed_at": {"$ref": "#/$defs/timestamp"}, "session_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["healthy", "degraded", "unhealthy"]}, "worker_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["action_cost_microunits", "action_request_cost", "action_token_cost", "budget_sha256", "cost_limit_microunits", "cost_used_microunits", "mission_id", "request_limit", "requests_used", "tenant_id", "token_limit", "tokens_used"],
      "properties": {
        "action_cost_microunits": {"type": "integer", "minimum": 0}, "action_request_cost": {"type": "integer", "minimum": 0},
        "action_token_cost": {"type": "integer", "minimum": 0}, "budget_sha256": {"$ref": "#/$defs/sha256"},
        "cost_limit_microunits": {"type": "integer", "minimum": 0}, "cost_used_microunits": {"type": "integer", "minimum": 0},
        "mission_id": {"$ref": "#/$defs/identifier"}, "request_limit": {"type": "integer", "minimum": 0},
        "requests_used": {"type": "integer", "minimum": 0}, "tenant_id": {"$ref": "#/$defs/identifier"},
        "token_limit": {"type": "integer", "minimum": 0}, "tokens_used": {"type": "integer", "minimum": 0}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_sha256", "environment", "mission_id", "scope_sha256", "target_id", "target_sha256", "tenant_id"],
      "properties": {
        "authority_sha256": {"$ref": "#/$defs/sha256"}, "environment": {"enum": ["sandbox", "replica", "live"]},
        "mission_id": {"$ref": "#/$defs/identifier"}, "scope_sha256": {"$ref": "#/$defs/sha256"},
        "target_id": {"$ref": "#/$defs/identifier"}, "target_sha256": {"$ref": "#/$defs/sha256"},
        "tenant_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "action_sha256", "action_tier", "action_type", "idempotency_key_sha256", "parameters_sha256", "target_sha256", "tool"],
      "properties": {
        "action_id": {"$ref": "#/$defs/identifier"}, "action_sha256": {"$ref": "#/$defs/sha256"},
        "action_tier": {"$ref": "#/$defs/tier"}, "action_type": {"$ref": "#/$defs/identifier"},
        "idempotency_key_sha256": {"$ref": "#/$defs/sha256"}, "parameters_sha256": {"$ref": "#/$defs/sha256"},
        "target_sha256": {"$ref": "#/$defs/sha256"}, "tool": {"$ref": "#/$defs/artifact"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["action_sha256", "evidence_kind", "evidence_sha256", "expires_at", "issued_at", "mission_id", "producer_id", "scope_sha256", "target_sha256", "tenant_id"],
      "properties": {
        "action_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_kind": {"enum": ["custody", "observability", "restoration_readiness", "safety_review", "scope_authority", "stop_readiness", "target_authority"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}, "expires_at": {"$ref": "#/$defs/timestamp"},
        "issued_at": {"$ref": "#/$defs/timestamp"}, "mission_id": {"$ref": "#/$defs/identifier"},
        "producer_id": {"$ref": "#/$defs/identifier"}, "scope_sha256": {"$ref": "#/$defs/sha256"},
        "target_sha256": {"$ref": "#/$defs/sha256"}, "tenant_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "stop": {
      "type": "object", "additionalProperties": false,
      "required": ["action_sha256", "expires_at", "maximum_impact_events", "monitor_session_id", "monitor_worker_id", "scope_sha256", "stop_contract_sha256", "stop_deadline_at", "target_sha256"],
      "properties": {
        "action_sha256": {"$ref": "#/$defs/sha256"}, "expires_at": {"$ref": "#/$defs/timestamp"},
        "maximum_impact_events": {"type": "integer", "minimum": 1}, "monitor_session_id": {"$ref": "#/$defs/identifier"},
        "monitor_worker_id": {"$ref": "#/$defs/identifier"}, "scope_sha256": {"$ref": "#/$defs/sha256"},
        "stop_contract_sha256": {"$ref": "#/$defs/sha256"}, "stop_deadline_at": {"$ref": "#/$defs/timestamp"},
        "target_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "restoration": {
      "type": "object", "additionalProperties": false,
      "required": ["action_sha256", "completion_evidence_required", "owner_profile_id", "required", "restoration_plan_sha256", "scope_sha256", "target_sha256", "verifier_profile_id"],
      "properties": {
        "action_sha256": {"$ref": "#/$defs/sha256"}, "completion_evidence_required": {"const": true},
        "owner_profile_id": {"$ref": "#/$defs/identifier"}, "required": {"const": true},
        "restoration_plan_sha256": {"$ref": "#/$defs/sha256"}, "scope_sha256": {"$ref": "#/$defs/sha256"},
        "target_sha256": {"$ref": "#/$defs/sha256"}, "verifier_profile_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "approval", "budget", "context", "credential_lease", "effects", "evidence_obligations", "expires_at", "health", "kind", "request_id", "request_sha256", "requested_at", "restoration_duties", "schema_version", "stop_conditions", "target", "worker_session"],
      "properties": {
        "action": {"$ref": "#/$defs/action"}, "approval": {"$ref": "#/$defs/approval"}, "budget": {"$ref": "#/$defs/budget"},
        "context": {"$ref": "#/$defs/context"}, "credential_lease": {"$ref": "#/$defs/credential"},
        "effects": {"$ref": "#/$defs/effects"}, "evidence_obligations": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
        "expires_at": {"$ref": "#/$defs/timestamp"}, "health": {"$ref": "#/$defs/health"},
        "kind": {"const": "action_admission_request"}, "request_id": {"type": "string", "pattern": "^AAR-[0-9A-F]{32}$"},
        "request_sha256": {"$ref": "#/$defs/sha256"}, "requested_at": {"$ref": "#/$defs/timestamp"},
        "restoration_duties": {"$ref": "#/$defs/restoration"}, "schema_version": {"const": 1},
        "stop_conditions": {"$ref": "#/$defs/stop"}, "target": {"$ref": "#/$defs/target"}, "worker_session": {"$ref": "#/$defs/worker"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["action_sha256", "approval_sha256", "credential_lease_id", "decision_id", "decision_sha256", "denial_reasons", "effects", "evaluated_at", "fence_token_sha256", "kind", "mission_id", "request_id", "request_sha256", "schema_version", "scope_sha256", "session_id", "status", "target_sha256", "tenant_id", "worker_id"],
      "properties": {
        "action_sha256": {"$ref": "#/$defs/sha256"}, "approval_sha256": {"$ref": "#/$defs/sha256"},
        "credential_lease_id": {"$ref": "#/$defs/identifier"}, "decision_id": {"type": "string", "pattern": "^AAD-[0-9A-F]{32}$"},
        "decision_sha256": {"$ref": "#/$defs/sha256"},
        "denial_reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["approval_mismatch", "approval_tier_exceeded", "budget_exceeded", "budget_mismatch", "context_mismatch", "credential_mismatch", "evidence_mismatch", "health_mismatch", "missing_evidence", "restoration_duty_mismatch", "stale_approval", "stale_credential", "stale_evidence", "stale_health", "stale_request", "stale_stop_condition", "stale_worker_session", "stop_condition_mismatch", "target_mismatch", "worker_session_mismatch", "worker_unhealthy"]}},
        "effects": {"$ref": "#/$defs/effects"}, "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "fence_token_sha256": {"$ref": "#/$defs/sha256"}, "kind": {"const": "action_admission_decision"},
        "mission_id": {"$ref": "#/$defs/identifier"}, "request_id": {"type": "string", "pattern": "^AAR-[0-9A-F]{32}$"},
        "request_sha256": {"$ref": "#/$defs/sha256"}, "schema_version": {"const": 1},
        "scope_sha256": {"$ref": "#/$defs/sha256"}, "session_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["admitted_contract_only", "denied"]}, "target_sha256": {"$ref": "#/$defs/sha256"},
        "tenant_id": {"$ref": "#/$defs/identifier"}, "worker_id": {"$ref": "#/$defs/identifier"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "denied"}}}, "then": {"properties": {"denial_reasons": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "admitted_contract_only"}}}, "then": {"properties": {"denial_reasons": {"maxItems": 0}}}}
      ]
    }
  }
}
