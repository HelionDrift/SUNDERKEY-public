{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-ownership-revocation-preflight-v1.json",
  "title": "SUNDERKEY Collaboration Ownership Revocation Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revocation",
    "entry",
    "evaluated_at",
    "store_id",
    "mission_context_sha256",
    "policy_binding",
    "work_fence",
    "planned_owner_qualification",
    "chain_projection",
    "admission_status",
    "authentication_status",
    "runtime_effect",
    "preflight_id",
    "preflight_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "revocation": {
      "$ref": "collaboration-ownership-revocation-v1.schema.json"
    },
    "entry": {
      "$ref": "collaboration-ownership-chain-entry-v1.schema.json"
    },
    "evaluated_at": {"$ref": "#/$defs/timestamp"},
    "store_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "mission_context_sha256": {"$ref": "#/$defs/sha256"},
    "policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_sha256",
        "policy_version",
        "maximum_delegation_depth"
      ],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^MRP-[0-9A-F]{32}$"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "policy_version": {"type": "integer", "minimum": 1},
        "maximum_delegation_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "work_fence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_generation",
        "previous_transition_id",
        "expected_lease_expires_at"
      ],
      "properties": {
        "expected_generation": {"type": "integer", "minimum": 0},
        "previous_transition_id": {
          "type": ["string", "null"],
          "minLength": 3,
          "maxLength": 128
        },
        "expected_lease_expires_at": {
          "oneOf": [
            {"$ref": "#/$defs/timestamp"},
            {"type": "null"}
          ]
        }
      }
    },
    "planned_owner_qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "registry_status",
        "qualification_basis",
        "command_id",
        "group_id"
      ],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^AOE-[A-Z0-9-]+$"},
        "profile_version": {"type": "string", "minLength": 1},
        "registry_status": {"const": "qualified"},
        "qualification_basis": {"const": "assigned_qualified_same_command_v1"},
        "command_id": {"type": "string", "pattern": "^AOE-[A-Z0-9-]+$"},
        "group_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"}
      }
    },
    "chain_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "head_entry_id",
        "head_sha256",
        "current_owner_id",
        "owner_epoch",
        "active_delegation_depth",
        "entry_count"
      ],
      "properties": {
        "chain_id": {"type": "string", "pattern": "^OCN-[0-9A-F]{32}$"},
        "head_entry_id": {"type": "string", "pattern": "^OCE-[0-9A-F]{32}$"},
        "head_sha256": {"$ref": "#/$defs/sha256"},
        "current_owner_id": {"type": "string", "pattern": "^AOE-[A-Z0-9-]+$"},
        "owner_epoch": {"type": "integer", "minimum": 2},
        "active_delegation_depth": {"const": 0},
        "entry_count": {"type": "integer", "minimum": 2}
      }
    },
    "admission_status": {"const": "admissible_pending_dual_authenticated_commit"},
    "authentication_status": {"const": "not_performed"},
    "runtime_effect": {"const": "none"},
    "preflight_id": {"type": "string", "pattern": "^ORF-[0-9A-F]{32}$"},
    "preflight_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
