{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-execution-acknowledgement-v1.json",
  "title": "SUNDERKEY Collaboration Execution Acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acknowledgement_id",
    "acknowledgement_sha256",
    "request",
    "channel_policy",
    "acknowledgement_kind",
    "session",
    "external_acknowledger",
    "revocation_proof",
    "acknowledged_at",
    "authentication_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "acknowledgement_id": {"type": "string", "pattern": "^EAK-[0-9A-F]{32}$"},
    "acknowledgement_sha256": {"$ref": "#/$defs/sha256"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "request_sha256"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^ETR-[0-9A-F]{32}$"},
        "request_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "channel_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_policy_id", "channel_policy_sha256"],
      "properties": {
        "channel_policy_id": {"type": "string", "pattern": "^ECP-[0-9A-F]{32}$"},
        "channel_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "acknowledgement_kind": {
      "enum": ["source_released", "target_accepted", "source_cancelled"]
    },
    "session": {"$ref": "#/$defs/session"},
    "external_acknowledger": {"$ref": "#/$defs/assertion"},
    "revocation_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_reference_id",
        "credential_sha256",
        "revocation_reference_id",
        "revocation_sha256"
      ],
      "properties": {
        "credential_reference_id": {"$ref": "#/$defs/optionalIdentifier"},
        "credential_sha256": {"$ref": "#/$defs/optionalSha256"},
        "revocation_reference_id": {"$ref": "#/$defs/optionalIdentifier"},
        "revocation_sha256": {"$ref": "#/$defs/optionalSha256"}
      }
    },
    "acknowledged_at": {"$ref": "#/$defs/timestamp"},
    "authentication_status": {"const": "assertion_pending_verification"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "optionalIdentifier": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "optionalSha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "assertion_id", "assertion_sha256"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/identifier"},
        "assertion_id": {"type": "string", "pattern": "^PAS-[0-9A-F]{32}$"},
        "assertion_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "session_sha256",
        "worker_principal_id",
        "fence_generation",
        "credential_reference_id",
        "credential_sha256"
      ],
      "properties": {
        "session_id": {"type": "string", "pattern": "^ECS-[0-9A-F]{32}$"},
        "session_sha256": {"$ref": "#/$defs/sha256"},
        "worker_principal_id": {"$ref": "#/$defs/identifier"},
        "fence_generation": {"type": "integer", "minimum": 1},
        "credential_reference_id": {"$ref": "#/$defs/identifier"},
        "credential_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
