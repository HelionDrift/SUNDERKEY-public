{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.example/schemas/local-api-service-v1.schema.json",
  "title": "SUNDERKEY Local API Service Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_audit_ref",
    "authorization_ref",
    "integration_event",
    "mutation_audit_ref",
    "page",
    "request_id",
    "request_sha256",
    "resource",
    "schema_version",
    "status"
  ],
  "properties": {
    "authorization_audit_ref": {"$ref": "#/$defs/auditRef"},
    "authorization_ref": {
      "type": "string",
      "pattern": "^authzref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,246}$"
    },
    "integration_event": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/integrationEvent"}]
    },
    "mutation_audit_ref": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/auditRef"}]
    },
    "page": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/page"}]
    },
    "request_id": {"$ref": "#/$defs/identifier"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "resource": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/resource"}]
    },
    "schema_version": {"const": 1},
    "status": {"enum": ["completed", "replayed"]}
  },
  "oneOf": [
    {
      "properties": {
        "page": {"$ref": "#/$defs/page"},
        "resource": {"type": "null"},
        "integration_event": {"type": "null"},
        "mutation_audit_ref": {"type": "null"}
      }
    },
    {
      "properties": {
        "page": {"type": "null"},
        "resource": {"$ref": "#/$defs/resource"}
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "auditRef": {
      "type": "string",
      "pattern": "^auditref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,247}$"
    },
    "resourceKind": {
      "enum": [
        "asset",
        "mission",
        "finding",
        "evidence",
        "report",
        "remediation",
        "approval",
        "health",
        "operator_projection",
        "target_context"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_refs",
        "concurrency_token",
        "context_id",
        "created_at",
        "payload",
        "payload_sha256",
        "resource_id",
        "resource_kind",
        "tenant_id",
        "updated_at",
        "version"
      ],
      "properties": {
        "audit_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/auditRef"}
        },
        "concurrency_token": {
          "type": "string",
          "pattern": "^ct:[0-9a-f]{64}$"
        },
        "context_id": {"$ref": "#/$defs/identifier"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "payload": {"type": "object"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "resource_id": {"$ref": "#/$defs/identifier"},
        "resource_kind": {"$ref": "#/$defs/resourceKind"},
        "tenant_id": {"$ref": "#/$defs/identifier"},
        "updated_at": {"$ref": "#/$defs/timestamp"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/resource"}
        },
        "next_cursor": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^cursor:[A-Za-z0-9_-]+\\.[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "integrationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_ref",
        "context_id",
        "event_id",
        "event_type",
        "occurred_at",
        "resource_id",
        "resource_kind",
        "resource_sha256",
        "resource_version",
        "tenant_id"
      ],
      "properties": {
        "audit_ref": {"$ref": "#/$defs/auditRef"},
        "context_id": {"$ref": "#/$defs/identifier"},
        "event_id": {"$ref": "#/$defs/identifier"},
        "event_type": {
          "type": "string",
          "pattern": "^[a-z_]+\\.[a-z_]+$"
        },
        "occurred_at": {"$ref": "#/$defs/timestamp"},
        "resource_id": {"$ref": "#/$defs/identifier"},
        "resource_kind": {"$ref": "#/$defs/resourceKind"},
        "resource_sha256": {"$ref": "#/$defs/sha256"},
        "resource_version": {"type": "integer", "minimum": 1},
        "tenant_id": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
