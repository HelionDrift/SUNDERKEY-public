{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/candidate-enrollment-deployment-preparation-v1.json",
  "title": "SUNDERKEY Candidate Enrollment Deployment Preparation Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "packet_sha256",
    "implementation_report",
    "deployment_status",
    "external_inputs",
    "ceremonies",
    "readiness",
    "prohibited_content",
    "prohibited_effects",
    "network_call_performed",
    "qualification_effect",
    "registry_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"type": "string", "pattern": "^CDP-[0-9A-F]{32}$"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "implementation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "sha256", "implementation_status"],
      "properties": {
        "report_id": {"type": "string", "pattern": "^CEI-[0-9A-F]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "implementation_status": {"const": "contract_implementation_complete"}
      }
    },
    "deployment_status": {"const": "awaiting_external_inputs"},
    "external_inputs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id",
          "input_kind",
          "accountable_roles",
          "completion_evidence",
          "status"
        ],
        "properties": {
          "input_id": {"type": "string", "pattern": "^[a-z0-9_]{8,128}$"},
          "input_kind": {"type": "string", "pattern": "^[a-z0-9_]{8,64}$"},
          "accountable_roles": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_]{8,64}$"}
          },
          "completion_evidence": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_]{8,96}$"}
          },
          "status": {"const": "external_input_required"}
        }
      }
    },
    "ceremonies": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ceremony_id",
          "sequence",
          "depends_on",
          "input_ids",
          "acceptance_checks"
        ],
        "properties": {
          "ceremony_id": {"type": "string", "pattern": "^[a-z0-9_]{8,80}$"},
          "sequence": {"type": "integer", "minimum": 1, "maximum": 5},
          "depends_on": {
            "type": "array",
            "maxItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_]{8,80}$"}
          },
          "input_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_]{8,128}$"}
          },
          "acceptance_checks": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_]{8,128}$"}
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready_for_live_enrollment",
        "pending_input_count",
        "pending_input_ids",
        "next_action"
      ],
      "properties": {
        "ready_for_live_enrollment": {"const": false},
        "pending_input_count": {"const": 9},
        "pending_input_ids": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]{8,128}$"}
        },
        "next_action": {
          "const": "complete_external_inputs_under_organization_change_control"
        }
      }
    },
    "prohibited_content": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{8,96}$"}
    },
    "prohibited_effects": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^does_not_[a-z0-9_]{8,128}$"}
    },
    "network_call_performed": {"const": false},
    "qualification_effect": {"const": "none"},
    "registry_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
