{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-execution-transfer-completion-v1.json",
  "title": "SUNDERKEY Collaboration Execution Transfer Completion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "completion_id",
    "completion_sha256",
    "request_authentication",
    "transfer_request",
    "channel_policy",
    "mission_id",
    "work_item_id",
    "transfer_kind",
    "required_acknowledgement_kinds",
    "completed_acknowledgements",
    "completed_at",
    "completion_outcome",
    "source_session_disposition",
    "target_session_disposition",
    "durable_commit_required",
    "activation_status",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "completion_id": {"type": "string", "pattern": "^ETC-[0-9A-F]{32}$"},
    "completion_sha256": {"$ref": "#/$defs/sha256"},
    "request_authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authentication_id", "authentication_sha256"],
      "properties": {
        "authentication_id": {"type": "string", "pattern": "^ERA-[0-9A-F]{32}$"},
        "authentication_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "transfer_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "request_sha256"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^ETR-[0-9A-F]{32}$"},
        "request_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "channel_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_policy_id", "channel_policy_sha256"],
      "properties": {
        "channel_policy_id": {"type": "string", "pattern": "^ECP-[0-9A-F]{32}$"},
        "channel_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mission_id": {"$ref": "#/$defs/identifier"},
    "work_item_id": {"$ref": "#/$defs/identifier"},
    "transfer_kind": {"enum": ["ownership_handoff", "work_cancellation"]},
    "required_acknowledgement_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/acknowledgementKind"}
    },
    "completed_acknowledgements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/completedAcknowledgement"}
    },
    "completed_at": {"$ref": "#/$defs/timestamp"},
    "completion_outcome": {"const": "acknowledged_complete"},
    "source_session_disposition": {"const": "revoked_unavailable"},
    "target_session_disposition": {
      "enum": ["eligible_after_atomic_commit", "not_applicable"]
    },
    "durable_commit_required": {"const": true},
    "activation_status": {"const": "pending_atomic_durable_commit"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "acknowledgementKind": {
      "enum": ["source_released", "target_accepted", "source_cancelled"]
    },
    "completedAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acknowledgement_kind",
        "acknowledgement_id",
        "acknowledgement_sha256",
        "authentication_id",
        "authentication_sha256",
        "session_id",
        "session_sha256",
        "acknowledged_at"
      ],
      "properties": {
        "acknowledgement_kind": {"$ref": "#/$defs/acknowledgementKind"},
        "acknowledgement_id": {"type": "string", "pattern": "^EAK-[0-9A-F]{32}$"},
        "acknowledgement_sha256": {"$ref": "#/$defs/sha256"},
        "authentication_id": {"type": "string", "pattern": "^EAA-[0-9A-F]{32}$"},
        "authentication_sha256": {"$ref": "#/$defs/sha256"},
        "session_id": {"type": "string", "pattern": "^ECS-[0-9A-F]{32}$"},
        "session_sha256": {"$ref": "#/$defs/sha256"},
        "acknowledged_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
