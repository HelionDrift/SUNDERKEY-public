{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/finding-validation-result-v1.schema.json",
  "title": "SUNDERKEY Finding Validation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "result_sha256",
    "registry_sha256",
    "input_sha256",
    "scope_id",
    "technique_id",
    "finding_impact",
    "validator",
    "state",
    "confidence",
    "reason_codes",
    "evidence_hashes",
    "restoration_evidence_hashes",
    "observations",
    "false_positive_checks",
    "corroboration",
    "restoration",
    "effects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "result_id": {
      "type": "string",
      "pattern": "^FVR-[0-9A-F]{32}$"
    },
    "result_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "registry_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "scope_id": {
      "$ref": "#/$defs/identifier"
    },
    "technique_id": {
      "$ref": "#/$defs/identifier"
    },
    "finding_impact": {
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "descriptor_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^validator\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "descriptor_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "state": {
      "enum": [
        "verified",
        "negative",
        "hypothesis",
        "inconclusive",
        "abstained"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/code"
      }
    },
    "evidence_hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "restoration_evidence_hashes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "false_positive_checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/false_positive_check"
      }
    },
    "corroboration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "observed_signals",
        "satisfied"
      ],
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "observed_signals": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "satisfied": {
          "type": "boolean"
        }
      }
    },
    "restoration": {
      "enum": [
        "not_applicable",
        "verified",
        "missing",
        "invalid"
      ]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "credentials",
        "deployment",
        "execution",
        "network",
        "qualification",
        "routing"
      ],
      "properties": {
        "authority": {
          "const": "none"
        },
        "credentials": {
          "const": "none"
        },
        "deployment": {
          "const": "none"
        },
        "execution": {
          "const": "none"
        },
        "network": {
          "const": "none"
        },
        "qualification": {
          "const": "none"
        },
        "routing": {
          "const": "none"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "safe_value": {
      "oneOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/safe_value"
          }
        },
        {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "$ref": "#/$defs/code"
          },
          "additionalProperties": {
            "$ref": "#/$defs/safe_value"
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "evidence_hashes",
        "attributes"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "evidence_hashes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "attributes": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/code"
          },
          "additionalProperties": {
            "$ref": "#/$defs/safe_value"
          }
        }
      }
    },
    "false_positive_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "passed",
        "evidence_hashes"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "passed": {
          "type": "boolean"
        },
        "evidence_hashes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  }
}
