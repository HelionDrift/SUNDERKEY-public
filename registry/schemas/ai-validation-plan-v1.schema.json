{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/ai-validation-plan-v1.schema.json",
  "title": "SUNDERKEY Offline AI Validation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tenant_ref", "scope_sha256", "target_ref",
    "target_class", "environment", "profile_sha256", "cases_sha256",
    "as_of", "case_count", "reserved_request_ceiling",
    "reserved_token_ceiling", "case_plan", "authorization_authenticated",
    "target_identity_verified", "judge_independence_verified",
    "prompt_custody_verified", "source_provenance", "review_status",
    "critical_verdict_rule", "qualification_effect", "effects",
    "plan_id", "plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "tenant_ref": {"type": "string", "pattern": "^tenantref:[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
    "scope_sha256": {"$ref": "#/$defs/sha256"},
    "target_ref": {"type": "string", "pattern": "^targetref:[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
    "target_class": {"enum": ["model", "agent", "mcp_server"]},
    "environment": {"enum": ["synthetic_fixture", "declared_nonproduction"]},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "cases_sha256": {"$ref": "#/$defs/sha256"},
    "as_of": {"$ref": "#/$defs/utc"},
    "case_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "reserved_request_ceiling": {"type": "integer", "minimum": 1, "maximum": 32},
    "reserved_token_ceiling": {"type": "integer", "minimum": 1, "maximum": 200000},
    "case_plan": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_ref", "case_sha256", "threat_class", "reviewer_ref"],
        "properties": {
          "case_ref": {
            "type": "string",
            "pattern": "^caseref:[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
          },
          "case_sha256": {"$ref": "#/$defs/sha256"},
          "threat_class": {
            "enum": [
              "prompt_injection", "data_leakage", "jailbreak",
              "tool_boundary", "agent_delegation", "mcp_trust"
            ]
          },
          "reviewer_ref": {
            "type": "string",
            "pattern": "^reviewerref:[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
          }
        }
      }
    },
    "authorization_authenticated": {"const": false},
    "target_identity_verified": {"const": false},
    "judge_independence_verified": {"const": false},
    "prompt_custody_verified": {"const": false},
    "source_provenance": {"const": "caller_asserted_not_authenticated"},
    "review_status": {"const": "metadata_ready_for_independent_review"},
    "critical_verdict_rule": {
      "const": "independent_human_and_correlated_evidence_required"
    },
    "qualification_effect": {"const": "none"},
    "effects": {
      "const": {
        "authority": "none", "model_calls": "none", "network": "none",
        "prompt_access": "none", "qualification": "none",
        "target_interaction": "none", "tool_execution": "none"
      }
    },
    "plan_id": {"type": "string", "pattern": "^AVP-[0-9A-F]{32}$"},
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
