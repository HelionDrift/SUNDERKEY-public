{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/candidate-enrollment-catalog-v1.json",
  "title": "SUNDERKEY Candidate Enrollment Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_version",
    "previous_catalog_sha256",
    "authorization",
    "d009_decision",
    "qualification_policy",
    "issuer",
    "audience",
    "issued_at",
    "not_before",
    "expires_at",
    "enrollments",
    "rotations",
    "revocations",
    "release_body_sha256",
    "reviews",
    "signer_key_id",
    "algorithm",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"type": "string", "pattern": "^CEC-[0-9A-F]{32}$"},
    "catalog_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "previous_catalog_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "authorization": {"$ref": "#/$defs/authorizationBinding"},
    "d009_decision": {"$ref": "#/$defs/d009Decision"},
    "qualification_policy": {"$ref": "#/$defs/policyBinding"},
    "issuer": {"$ref": "#/$defs/identifier"},
    "audience": {"$ref": "#/$defs/identifier"},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "not_before": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "enrollments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/enrollment"}
    },
    "rotations": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/rotation"}
    },
    "revocations": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/revocation"}
    },
    "release_body_sha256": {"$ref": "#/$defs/sha256"},
    "reviews": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/review"}
    },
    "signer_key_id": {"$ref": "#/$defs/identifier"},
    "algorithm": {"const": "Ed25519"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^AOE-G[A-E]-D[0-9]{2}-S[0-9]{2}$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "publicKey": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "entryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enrollment_id", "sha256"],
      "properties": {
        "enrollment_id": {"type": "string", "pattern": "^CEE-[0-9A-F]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorizationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization_id", "authorization_version", "sha256"],
      "properties": {
        "authorization_id": {"type": "string", "pattern": "^CEA-[0-9A-F]{32}$"},
        "authorization_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "d009Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "sha256"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^CER-[0-9A-F]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "sha256"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^QTP-[0-9A-F]{32}$"},
        "policy_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "candidate_version", "candidate_artifact_sha256"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/identifier"},
        "candidate_version": {"$ref": "#/$defs/identifier"},
        "candidate_artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_id", "key_id", "public_key", "public_key_sha256"],
      "properties": {
        "owner_id": {"$ref": "#/$defs/identifier"},
        "key_id": {"$ref": "#/$defs/identifier"},
        "public_key": {"$ref": "#/$defs/publicKey"},
        "public_key_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "content_address_scheme"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/identifier"},
        "content_address_scheme": {"const": "sha256"}
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enrollment_id",
        "profile_id",
        "candidate",
        "owner",
        "repository",
        "not_before",
        "expires_at",
        "predecessor"
      ],
      "properties": {
        "enrollment_id": {"type": "string", "pattern": "^CEE-[0-9A-F]{32}$"},
        "profile_id": {"$ref": "#/$defs/profileId"},
        "candidate": {"$ref": "#/$defs/candidate"},
        "owner": {"$ref": "#/$defs/owner"},
        "repository": {"$ref": "#/$defs/repository"},
        "not_before": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "predecessor": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/entryBinding"}]
        }
      }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rotation_id",
        "rotation_kind",
        "predecessor",
        "successor",
        "overlap_not_before",
        "overlap_expires_at"
      ],
      "properties": {
        "rotation_id": {"type": "string", "pattern": "^CRO-[0-9A-F]{32}$"},
        "rotation_kind": {"enum": ["owner_key", "repository_identity"]},
        "predecessor": {"$ref": "#/$defs/entryBinding"},
        "successor": {"$ref": "#/$defs/entryBinding"},
        "overlap_not_before": {"$ref": "#/$defs/timestamp"},
        "overlap_expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revocation_id",
        "revocation_kind",
        "subject_id",
        "effective_at",
        "recorded_at",
        "reason_sha256"
      ],
      "properties": {
        "revocation_id": {"type": "string", "pattern": "^CRV-[0-9A-F]{32}$"},
        "revocation_kind": {"enum": ["enrollment", "owner_key", "repository_identity"]},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "effective_at": {"$ref": "#/$defs/timestamp"},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "reason_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "reviewer_role",
        "credential",
        "reviewed_at",
        "decision",
        "release_body_sha256",
        "algorithm",
        "signature"
      ],
      "properties": {
        "reviewer_id": {"$ref": "#/$defs/identifier"},
        "reviewer_role": {"enum": ["independent_assurance", "independent_control"]},
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "required": ["credential_id", "sha256"],
          "properties": {
            "credential_id": {"type": "string", "pattern": "^QRC-[0-9A-F]{32}$"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "reviewed_at": {"$ref": "#/$defs/timestamp"},
        "decision": {"const": "approved"},
        "release_body_sha256": {"$ref": "#/$defs/sha256"},
        "algorithm": {"const": "Ed25519"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    }
  }
}
