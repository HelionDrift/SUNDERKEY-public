{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sunderkey:remediation-workflow-review:v1",
  "title": "Offline remediation workflow visibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "as_of", "plan_id", "plan_sha256", "context_sha256",
    "max_observation_age_seconds", "source_plan_stale", "target_set_sha256",
    "observation_set_sha256", "items", "claims", "effects", "review_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "as_of": {"$ref": "#/$defs/time"},
    "plan_id": {"type": "string", "pattern": "^RMP-[0-9A-F]{32}$"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "max_observation_age_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
    "source_plan_stale": {"type": "boolean"},
    "target_set_sha256": {"$ref": "#/$defs/sha256"},
    "observation_set_sha256": {"$ref": "#/$defs/sha256"},
    "review_sha256": {"$ref": "#/$defs/sha256"},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 2048,
      "items": {"$ref": "#/$defs/item"}
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["deadline_enforced", "delivery_verified", "owner_authenticated", "remediation_verified"],
      "properties": {
        "deadline_enforced": {"const": false, "type": "boolean"},
        "delivery_verified": {"const": false, "type": "boolean"},
        "owner_authenticated": {"const": false, "type": "boolean"},
        "remediation_verified": {"const": false, "type": "boolean"}
      }
    },
    "effects": {
      "type": "object", "additionalProperties": false,
      "required": [
        "authorization", "closure", "execution", "integration", "network",
        "notification", "persistence", "qualification", "ticketing"
      ],
      "properties": {
        "authorization": {"const": "none"},
        "closure": {"const": "none"},
        "execution": {"const": "none"},
        "integration": {"const": "none"},
        "network": {"const": "none"},
        "notification": {"const": "none"},
        "persistence": {"const": "none"},
        "qualification": {"const": "none"},
        "ticketing": {"const": "none"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "digestList": {
      "type": "array", "maxItems": 4096, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": [
        "item_ref", "owner_ref", "target_sha256", "due_at", "deadline_state",
        "delivery_state", "ticket_state", "latest_observation_sha256s",
        "observation_sha256s", "remediation_state", "review_required", "reason_codes"
      ],
      "properties": {
        "item_ref": {"type": "string", "pattern": "^itemref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"},
        "owner_ref": {"type": "string", "pattern": "^principalref:[A-Za-z0-9][A-Za-z0-9._/-]{0,190}$"},
        "target_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "due_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]},
        "deadline_state": {"enum": ["unknown", "not_due", "overdue"]},
        "delivery_state": {"enum": ["unknown", "pending", "delivered", "failed", "stale", "conflict"]},
        "ticket_state": {"enum": ["unknown", "open", "closed", "stale", "conflict"]},
        "latest_observation_sha256s": {"$ref": "#/$defs/digestList"},
        "observation_sha256s": {"$ref": "#/$defs/digestList"},
        "remediation_state": {"const": "unverified"},
        "review_required": {"const": true, "type": "boolean"},
        "reason_codes": {
          "type": "array", "maxItems": 10, "uniqueItems": true,
          "items": {
            "enum": [
              "service_target_missing", "asserted_service_target_overdue", "source_plan_stale",
              "delivery_evidence_missing", "delivery_evidence_stale", "ticket_lineage_ambiguous",
              "delivery_metadata_conflict", "reported_delivery_failed", "delivery_not_reported_complete",
              "ticket_closed_is_not_remediation_evidence"
            ]
          }
        }
      }
    }
  }
}
