{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/collaboration-execution-session-activation-commit-receipt-v1.json",
  "title": "SUNDERKEY Collaboration Execution Session Activation Commit Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_authority",
    "activation_request",
    "activation_authentication",
    "committed_at",
    "control_plane_requester",
    "worker_acceptor",
    "authority_state",
    "runtime_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "session_authority": {"type": "object"},
    "activation_request": {"type": "object"},
    "activation_authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authentication_id",
        "authentication_sha256",
        "activation_selection_sha256",
        "authenticated_at"
      ],
      "properties": {
        "authentication_id": {"type": "string", "pattern": "^EAS-[0-9A-F]{32}$"},
        "authentication_sha256": {"$ref": "#/$defs/sha256"},
        "activation_selection_sha256": {"$ref": "#/$defs/sha256"},
        "authenticated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "committed_at": {"$ref": "#/$defs/timestamp"},
    "control_plane_requester": {"$ref": "#/$defs/principalCommit"},
    "worker_acceptor": {"$ref": "#/$defs/principalCommit"},
    "authority_state": {"const": "committed_available_for_executor"},
    "runtime_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "principalCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "assertion_sha256",
        "ledger_entry_sha256"
      ],
      "properties": {
        "assertion_id": {"type": "string", "pattern": "^PAS-[0-9A-F]{32}$"},
        "assertion_sha256": {"$ref": "#/$defs/sha256"},
        "ledger_entry_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
