{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/candidate-enrollment-checkpoint-record-v1.json",
  "title": "SUNDERKEY Candidate Enrollment Checkpoint Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "checkpoint_sha256",
    "deployment_id",
    "checkpoint_sequence",
    "release_id",
    "catalog_checkpoint",
    "verification_receipt",
    "release_intent",
    "predecessor_checkpoint",
    "committed_at",
    "state",
    "custody_model",
    "contains_secret_material"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "checkpoint_id": {"type": "string", "pattern": "^CPC-[0-9A-F]{32}$"},
    "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_id": {"$ref": "#/$defs/identifier"},
    "checkpoint_sequence": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "release_id": {"type": "string", "pattern": "^CRL-[0-9A-F]{32}$"},
    "catalog_checkpoint": {"$ref": "#/$defs/catalogCheckpoint"},
    "verification_receipt": {"$ref": "#/$defs/receiptBinding"},
    "release_intent": {"$ref": "#/$defs/entryBinding"},
    "predecessor_checkpoint": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/checkpointBinding"}
      ]
    },
    "committed_at": {"$ref": "#/$defs/timestamp"},
    "state": {"const": "committed"},
    "custody_model": {"const": "atomic_versioned_file_with_protected_acl_and_backup"},
    "contains_secret_material": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "catalogCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "catalog_version", "catalog_sha256"],
      "properties": {
        "catalog_id": {"type": "string", "pattern": "^CEC-[0-9A-F]{32}$"},
        "catalog_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "catalog_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "receiptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "sha256"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^CVR-[0-9A-F]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "entryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "sha256"],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^CLE-[0-9A-F]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "checkpointBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "sha256", "checkpoint_sequence"],
      "properties": {
        "checkpoint_id": {"type": "string", "pattern": "^CPC-[0-9A-F]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_sequence": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    }
  }
}
