{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunderkey.invalid/schemas/evaluation-program-contract-v1.schema.json",
  "title": "SUNDERKEY Evaluation Program Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blind_evaluator_bindings",
    "contract_id",
    "contract_sha256",
    "corpus",
    "effects",
    "evaluation_plan",
    "governance",
    "program_version",
    "schema_version",
    "scorecard",
    "subjects",
    "version_pins"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"type": "string", "pattern": "^EPC-[0-9A-F]{32}$"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "program_version": {"$ref": "#/$defs/version"},
    "scorecard": {"$ref": "#/$defs/scorecard"},
    "corpus": {"$ref": "#/$defs/corpus"},
    "governance": {"$ref": "#/$defs/governance"},
    "subjects": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/subject"}
    },
    "blind_evaluator_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/blindBinding"}
    },
    "version_pins": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/versionPin"}
    },
    "evaluation_plan": {"$ref": "#/$defs/evaluationPlan"},
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "corpus_download",
        "evaluation_execution",
        "model_calls",
        "network",
        "provider_calls",
        "qualification",
        "routing"
      ],
      "properties": {
        "authorization": {"const": "none"},
        "corpus_download": {"const": "none"},
        "evaluation_execution": {"const": "none"},
        "model_calls": {"const": "none"},
        "network": {"const": "none"},
        "provider_calls": {"const": "none"},
        "qualification": {"const": "none"},
        "routing": {"const": "none"}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "gateId": {
      "enum": [
        "qualification.gate.adversarial-robustness",
        "qualification.gate.collaboration-handoff",
        "qualification.gate.evidence-reproducibility",
        "qualification.gate.false-positive-control",
        "qualification.gate.safe-abstention-stop",
        "qualification.gate.scope-authority",
        "qualification.gate.specialist-technical-accuracy",
        "qualification.gate.tool-data-boundary"
      ]
    },
    "variantId": {
      "enum": [
        "positive_reproducible",
        "negative_control",
        "ambiguous_authority",
        "adversarial_evidence",
        "collaboration_conflict",
        "restoration_verification"
      ]
    },
    "partitionType": {
      "enum": ["public", "private_holdout", "adversarial_safety", "regression", "pilot"]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anti_gaming_controls",
        "critical_failure_threshold",
        "critical_gate_ids",
        "denominator",
        "denominator_source_sha256",
        "direction",
        "measure_id",
        "minimum_denominator",
        "numerator",
        "pass_threshold",
        "unit",
        "zero_denominator_disposition"
      ],
      "properties": {
        "measure_id": {
          "enum": [
            "ground_truth_recall",
            "validated_finding_precision",
            "validator_reproduction_rate",
            "attack_path_depth",
            "unauthorized_target_actions",
            "cleanup_completion",
            "time_to_first_verified_finding",
            "cost_per_verified_finding",
            "run_to_run_stability",
            "evidence_completeness",
            "customer_remediation_acceptance"
          ]
        },
        "direction": {"enum": ["higher_is_better", "lower_is_better"]},
        "unit": {
          "enum": ["basis_points", "count", "micro_usd", "milli_hops_per_run", "milliseconds"]
        },
        "numerator": {"$ref": "#/$defs/identifier"},
        "denominator": {"$ref": "#/$defs/identifier"},
        "denominator_source_sha256": {"$ref": "#/$defs/sha256"},
        "minimum_denominator": {"type": "integer", "minimum": 1},
        "zero_denominator_disposition": {"const": "fail"},
        "pass_threshold": {"type": "integer", "minimum": 0},
        "critical_failure_threshold": {
          "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
        },
        "critical_gate_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gateId"}
        },
        "anti_gaming_controls": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"const": "deduplicate_by_evidence_identity"},
            {"const": "fixed_denominator_before_execution"},
            {"const": "include_failed_and_abstained_cases"},
            {"const": "no_posthoc_case_exclusion"},
            {"const": "report_missing_observations_as_failures"}
          ],
          "items": false
        }
      }
    },
    "scorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical_failure_gate_ids",
        "maximum_critical_failures",
        "metrics",
        "scorecard_version",
        "weighted_composite_allowed"
      ],
      "properties": {
        "scorecard_version": {"$ref": "#/$defs/version"},
        "metrics": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {"$ref": "#/$defs/metric"}
        },
        "critical_failure_gate_ids": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gateId"}
        },
        "maximum_critical_failures": {"const": 0},
        "weighted_composite_allowed": {"const": false}
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "content_sha256",
        "content_reference",
        "ground_truth_reference",
        "ground_truth_sha256",
        "manifest_sha256",
        "membership_commitment_sha256",
        "partition_type",
        "provenance_sha256",
        "secrecy",
        "suite_id",
        "suite_version",
        "variant_ids"
      ],
      "properties": {
        "partition_type": {"$ref": "#/$defs/partitionType"},
        "suite_id": {"$ref": "#/$defs/identifier"},
        "suite_version": {"$ref": "#/$defs/version"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "provenance_sha256": {"$ref": "#/$defs/sha256"},
        "membership_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "case_count": {"type": "integer", "minimum": 1},
        "variant_ids": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {"const": "positive_reproducible"},
            {"const": "negative_control"},
            {"const": "ambiguous_authority"},
            {"const": "adversarial_evidence"},
            {"const": "collaboration_conflict"},
            {"const": "restoration_verification"}
          ],
          "items": false
        },
        "content_reference": {"$ref": "#/$defs/identifier"},
        "ground_truth_reference": {"$ref": "#/$defs/identifier"},
        "ground_truth_sha256": {"$ref": "#/$defs/sha256"},
        "secrecy": {"enum": ["public_manifest", "reference_only"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custodian_identity_id",
        "derivation_sha256",
        "partition_type",
        "recorded_at",
        "source_id",
        "source_sha256",
        "source_version"
      ],
      "properties": {
        "partition_type": {"$ref": "#/$defs/partitionType"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "source_version": {"$ref": "#/$defs/version"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "derivation_sha256": {"$ref": "#/$defs/sha256"},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "custodian_identity_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_identity_id",
        "check_version",
        "checked_at",
        "evidence_sha256",
        "overlap_count",
        "partition_type",
        "status"
      ],
      "properties": {
        "partition_type": {"$ref": "#/$defs/partitionType"},
        "candidate_identity_id": {"$ref": "#/$defs/identifier"},
        "check_version": {"$ref": "#/$defs/version"},
        "checked_at": {"$ref": "#/$defs/timestamp"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "clean"},
        "overlap_count": {"const": 0}
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_status",
        "evidence_sha256",
        "exposed_at",
        "exposed_identity_id",
        "exposure_scope",
        "partition_type"
      ],
      "properties": {
        "partition_type": {"$ref": "#/$defs/partitionType"},
        "exposed_identity_id": {"$ref": "#/$defs/identifier"},
        "exposure_scope": {"enum": ["metadata_only", "full_content"]},
        "access_status": {"enum": ["active", "revoked"]},
        "exposed_at": {"$ref": "#/$defs/timestamp"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "overlap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_at",
        "checker_identity_id",
        "evidence_sha256",
        "left_partition_type",
        "overlap_count",
        "right_partition_type",
        "scanner_version"
      ],
      "properties": {
        "left_partition_type": {"$ref": "#/$defs/partitionType"},
        "right_partition_type": {"$ref": "#/$defs/partitionType"},
        "checker_identity_id": {"$ref": "#/$defs/identifier"},
        "scanner_version": {"$ref": "#/$defs/version"},
        "checked_at": {"$ref": "#/$defs/timestamp"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "overlap_count": {"const": 0}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contamination_records",
        "corpus_version",
        "exposure_records",
        "overlap_attestations",
        "partitions",
        "provenance"
      ],
      "properties": {
        "corpus_version": {"$ref": "#/$defs/version"},
        "partitions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/partition"}
        },
        "provenance": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/provenance"}
        },
        "contamination_records": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/contamination"}
        },
        "exposure_records": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/exposure"}
        },
        "overlap_attestations": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/overlap"}
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_identity_id",
        "corpus_custodian_identity_id",
        "evaluator_identity_ids",
        "execution_controller_identity_id",
        "ground_truth_custodian_identity_id",
        "plan_author_identity_id"
      ],
      "properties": {
        "candidate_identity_id": {"$ref": "#/$defs/identifier"},
        "corpus_custodian_identity_id": {"$ref": "#/$defs/identifier"},
        "ground_truth_custodian_identity_id": {"$ref": "#/$defs/identifier"},
        "execution_controller_identity_id": {"$ref": "#/$defs/identifier"},
        "plan_author_identity_id": {"$ref": "#/$defs/identifier"},
        "evaluator_identity_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_sha256",
        "configuration_sha256",
        "owner_identity_id",
        "role",
        "subject_id",
        "subject_version"
      ],
      "properties": {
        "role": {"enum": ["deterministic", "generalist", "prior_release", "candidate"]},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "subject_version": {"$ref": "#/$defs/version"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "owner_identity_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "blindBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_reference",
        "assignment_sha256",
        "binding_version",
        "evaluator_identity_id",
        "partition_aliases",
        "revealed_private_partition_references",
        "revealed_subject_roles",
        "subject_aliases"
      ],
      "properties": {
        "evaluator_identity_id": {"$ref": "#/$defs/identifier"},
        "binding_version": {"$ref": "#/$defs/version"},
        "assignment_reference": {"$ref": "#/$defs/identifier"},
        "assignment_sha256": {"$ref": "#/$defs/sha256"},
        "subject_aliases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "partition_aliases": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "revealed_subject_roles": {"type": "array", "maxItems": 0},
        "revealed_private_partition_references": {"type": "array", "maxItems": 0}
      }
    },
    "versionPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "component_id", "component_version"],
      "properties": {
        "component_id": {
          "enum": [
            "capability_roadmap",
            "evaluation_policy",
            "qualification_plans",
            "qualification_standard",
            "specialist_scenario_corpus"
          ]
        },
        "component_version": {"$ref": "#/$defs/version"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "comparisonPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_roles",
        "candidate_role",
        "critical_gate_treatment",
        "minimum_repeated_runs",
        "missing_observation_disposition",
        "multiple_comparison_correction",
        "pairing_policy",
        "tie_disposition",
        "weighted_composite_allowed"
      ],
      "properties": {
        "baseline_roles": {
          "type": "array",
          "prefixItems": [
            {"const": "deterministic"},
            {"const": "generalist"},
            {"const": "prior_release"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "candidate_role": {"const": "candidate"},
        "critical_gate_treatment": {"const": "unweighted_hard_stop"},
        "minimum_repeated_runs": {"const": 3},
        "missing_observation_disposition": {"const": "fail_closed"},
        "multiple_comparison_correction": {"const": "holm_bonferroni"},
        "pairing_policy": {"const": "same_case_same_budget"},
        "tie_disposition": {"const": "no_improvement"},
        "weighted_composite_allowed": {"const": false}
      }
    },
    "evaluationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget", "comparison_policy", "plan_version", "result_claims", "status"],
      "properties": {
        "plan_version": {"$ref": "#/$defs/version"},
        "status": {"const": "planned_non_executing"},
        "result_claims": {"type": "array", "maxItems": 0},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximum_cases",
            "maximum_cost_microusd",
            "maximum_requests",
            "maximum_tokens",
            "maximum_wall_seconds"
          ],
          "properties": {
            "maximum_cases": {"type": "integer", "minimum": 1},
            "maximum_cost_microusd": {"type": "integer", "minimum": 1},
            "maximum_requests": {"type": "integer", "minimum": 1},
            "maximum_tokens": {"type": "integer", "minimum": 1},
            "maximum_wall_seconds": {"type": "integer", "minimum": 1}
          }
        },
        "comparison_policy": {"$ref": "#/$defs/comparisonPolicy"}
      }
    }
  }
}
