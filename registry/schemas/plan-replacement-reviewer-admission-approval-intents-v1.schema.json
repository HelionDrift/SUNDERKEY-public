{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sunderkey.dev/plan-replacement-reviewer-admission-approval-intents-v1.json",
  "title": "SUNDERKEY unsigned reviewer admission approval intent packet",
  "description": "Unsigned inputs for external signing. Assignment, signatures, current eligibility, and authority are not verified by this packet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "packet_id", "packet_sha256", "admission", "approval_intents",
    "approval_status", "approver_assignment", "authority_effect", "runtime_effect",
    "target_authority", "qualification_effect"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "packet_id": {"type": "string", "pattern": "^RAI-[0-9A-F]{32}$"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "admission": {
      "$ref": "https://schemas.sunderkey.dev/plan-replacement-reviewer-admission-v1.json",
      "properties": {
        "active_plan_version": {"maximum": 9223372036854775807},
        "admission_sequence": {"maximum": 9223372036854775807},
        "principal_ledger": {
          "properties": {
            "assertion_count": {"maximum": 9223372036854775807},
            "effect_count": {"maximum": 9223372036854775807}
          }
        },
        "reviewer": {
          "properties": {
            "scope_grant": {"properties": {"policy_version": {"maximum": 9223372036854775807}}}
          }
        }
      }
    },
    "approval_intents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_owner", "independent_control"],
      "properties": {
        "mission_owner": {
          "allOf": [
            {"$ref": "#/$defs/approval"},
            {
              "properties": {
                "operation": {"const": "sunderkey.collaboration.plan-replacement.reviewer-admission.owner-authorize.v1"},
                "operation_intent": {"properties": {"role": {"const": "mission_owner"}}}
              }
            }
          ]
        },
        "independent_control": {
          "allOf": [
            {"$ref": "#/$defs/approval"},
            {
              "properties": {
                "operation": {"const": "sunderkey.collaboration.plan-replacement.reviewer-admission.control-approve.v1"},
                "operation_intent": {"properties": {"role": {"const": "independent_control"}}}
              }
            }
          ]
        }
      }
    },
    "approval_status": {"const": "unsigned"},
    "approver_assignment": {"const": "not_verified"},
    "authority_effect": {"const": "none"},
    "runtime_effect": {"const": "none"},
    "target_authority": {"const": "none"},
    "qualification_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profileId": {
      "type": "string", "maxLength": 64,
      "pattern": "^AOE-(?:HQ-[0-9]{2}|G[A-E]-D[0-9]{2}-(?:CMD|S[0-9]{2}))$"
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": [
        "operation", "principal_profile_id", "operation_intent", "operation_intent_sha256"
      ],
      "properties": {
        "operation": {"type": "string"},
        "principal_profile_id": {"$ref": "#/$defs/profileId"},
        "operation_intent_sha256": {"$ref": "#/$defs/sha256"},
        "operation_intent": {
          "type": "object", "additionalProperties": false,
          "required": [
            "mission_id", "mission_context_sha256", "admission_id", "admission_sha256",
            "principal_profile_id", "role"
          ],
          "properties": {
            "mission_id": {
              "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
            },
            "mission_context_sha256": {"$ref": "#/$defs/sha256"},
            "admission_id": {"type": "string", "pattern": "^RVA-[0-9A-F]{32}$"},
            "admission_sha256": {"$ref": "#/$defs/sha256"},
            "principal_profile_id": {"$ref": "#/$defs/profileId"},
            "role": {"enum": ["mission_owner", "independent_control"]}
          }
        }
      }
    }
  }
}
